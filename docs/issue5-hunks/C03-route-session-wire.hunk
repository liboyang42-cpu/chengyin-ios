Unapplied recognizer, same file, not `PlayReadRoute`. Query is `sessionId`, `memberId`, `actionId` on GET `api/play/route-action`. Do not apply.

```swift
private func routeActionReadRoute(_ request: URLRequest, baseURL: URL) -> Bool {
    guard request.httpMethod == "GET", request.httpBody == nil, request.httpBodyStream == nil,
          let url = request.url, let parts = URLComponents(url: url, resolvingAgainstBaseURL: false),
          parts.scheme == "https", parts.user == nil, parts.password == nil, parts.fragment == nil,
          parts.path == baseURL.appendingPathComponent("api/play/route-action").path,
          let items = parts.queryItems, items.count == 3 else { return false }
    let values = Dictionary(items.map { ($0.name, $0.value ?? "") }, uniquingKeysWith: { _, _ in "" })
    guard values.count == 3, let session = Int64(values["sessionId"] ?? ""), session > 0, String(session) == values["sessionId"],
          let member = Int64(values["memberId"] ?? ""), member > 0, String(member) == values["memberId"],
          let action = values["actionId"]?.trimmingCharacters(in: .whitespacesAndNewlines), !action.isEmpty else { return false }
    return true
}
```

Unapplied method, beside `playExperience(for:)` (App/AppSession.swift around line 363). Do not apply. `serviceResult` is not an argument.

```swift
func routeActionPageRead(model: PlayExperienceCoordinator) -> RouteActionPageReadRequest? {
    guard let held = model.heldRouteActionIdentity else { return nil }
    guard let configuration = regionalConfiguration?.apiConfiguration, configuration.baseURL.scheme == "https",
          let account, account.id != 0, let token, AuthRequestBuilder.isValidToken(token),
          let context = currentRuntimeDependencyContext else { return nil }
    guard let approval = compositionTransport.routeActionReadApproval(context),
          approval.allows(configuration: configuration, namespace: context.session.namespace,
            accountID: account.id, path: "api/play/route-action") else { return nil }
    return RouteActionPageReadRequest(
        sessionID: held.routeSessionID,
        memberID: Int64(account.id),
        actionID: held.actionID,
        apiBaseURL: configuration.baseURL,
        transport: compositionTransport,
        token: token,
        accountID: account.id,
        approval: approval,
        approvalNamespace: context.session.namespace)
}
```

`account.id` is the same member as currentMemberId and AppUser.userId. Do not read a staff id. Do not call `playReadConfiguration`. A nil approval returns nil and refuses the send.

