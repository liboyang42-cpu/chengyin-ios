App/AppSession.swift
App/AppCompositionRoot.swift
Questify.xcodeproj/project.pbxproj
```

Not inserted into `merchantOperationsDestination`. The paste passes this writer
as the publisher into the existing manage flow. publisher stays nil in AppSession.
The factory does not mint a second request id. Submit happens later, on the flow
that already holds the request id. Not inserted.
`Core/MerchantNPCKnowledgeReviewWriter.swift` is not added to the Xcode project from this branch.

```swift
if destination == .character,
   let merchantID = access.identity.merchantID,
   let row = PublicMerchantRowID(merchantID),
   let scope = merchantNPCScope(row: row) {
    var writer: MerchantNPCKnowledgeReviewWriter? = nil
    if let api = regionalConfiguration?.apiConfiguration {
        writer = MerchantNPCKnowledgeReviewWriter(
            configuration: api,
            transport: runtimeHTTPTransport,
            memberID: { [weak self] in self?.account.map { Int64($0.id) } },
            token: { [weak self] in self?.token })
    }
    let flow = MerchantNPCKnowledgeAuthorFlow(
        scope: scope,
        publisher: writer,
        currentScope: { [weak self] in self?.merchantNPCScope(row: row) })
    return AnyView(MerchantOperationsDocumentView(
        reader: merchantOperationsReader,
        destination: destination,
        imageHost: retainedMerchantImages,
        templateAssistFactory: { [weak self] coordinator in
            self?.merchantTemplateAssistFlow(coordinator: coordinator) ?? MerchantTemplateAssistFlow(coordinator: coordinator, client: nil)
        },
        authorFlow: flow))
}
```

The paste passes `writer` as `publisher` into the existing manage flow. It does
not drop that value. It does not call `submitForOriginalReview` or `publishApproved`
from the session. Not inserted. publisher stays nil in AppSession.

