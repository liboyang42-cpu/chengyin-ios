Not inserted into `merchantOperationsDestination`. `publisher` stays nil, so the
existing waiting-source publisher is the one the flow already owns. Do not add a
grant, a policy version, or a second writer.

```swift
if destination == .character,
   let merchantID = access.identity.merchantID,
   let row = PublicMerchantRowID(merchantID),
   let scope = merchantNPCScope(row: row) {
    let flow = MerchantNPCKnowledgeAuthorFlow(
        scope: scope,
        publisher: nil,
        currentScope: { [weak self] in self?.merchantNPCScope(row: row) })
    return AnyView(MerchantOperationsDocumentView(
        reader: merchantOperationsReader,
        destination: destination,
        imageHost: retainedMerchantImages,
        templateAssistFactory: { [weak self] coordinator in
            self?.merchantTemplateAssistFlow(coordinator: coordinator) ?? MerchantTemplateAssistFlow(coordinator: coordinator, client: nil)
        },
        authorFlow: flow))
}
```

