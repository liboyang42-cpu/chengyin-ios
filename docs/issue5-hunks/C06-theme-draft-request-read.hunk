    let flow = MerchantNPCKnowledgeAuthorFlow(
        scope: scope,
        publisher: nil,
        currentScope: { [weak self] in self?.merchantNPCScope(row: row) })
    let caller = MerchantNPCThemeDraftRequestRead(
        configuration: api,
        transport: runtimeHTTPTransport,
        memberID: { [weak self] in self?.account.map { Int64($0.id) } },
