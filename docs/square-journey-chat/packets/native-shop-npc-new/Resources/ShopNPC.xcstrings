{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "shopNPC.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop conversation is not enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "店铺分身对话还没开放"
          }
        }
      }
    },
    "shopNPC.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session changed. Reopen the conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已变更，请重新打开对话"
          }
        }
      }
    },
    "shopNPC.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a reply…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在回答…"
          }
        }
      }
    },
    "shopNPC.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your question or recording again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新检查问题或录音"
          }
        }
      }
    },
    "shopNPC.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候再试"
          }
        }
      }
    },
    "shopNPC.unknownOutcome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery is uncertain. Confirm retry to resend the same request ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送结果未知，确认重试将沿用同一请求编号"
          }
        }
      }
    },
    "shopNPC.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable answer was returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到有效回答"
          }
        }
      }
    },
    "shopNPC.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service could not answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务暂时无法回答"
          }
        }
      }
    },
    "shopNPC.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI replies may be inaccurate and do not complete game tasks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 回答可能不准确，且不会完成游戏任务"
          }
        }
      }
    },
    "shopNPC.conversation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话"
          }
        }
      }
    },
    "shopNPC.you": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "shopNPC.assistant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "店铺 AI"
          }
        }
      }
    },
    "shopNPC.regenerate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a new answer request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新回答前检查"
          }
        }
      }
    },
    "shopNPC.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Question"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题"
          }
        }
      }
    },
    "shopNPC.reviewText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review question"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查问题"
          }
        }
      }
    },
    "shopNPC.voiceDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording requires microphone permission. Stopping only prepares a review; nothing is sent automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音需要麦克风权限，停止仅准备审核，不会自动发送"
          }
        }
      }
    },
    "shopNPC.stopReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop and review recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并检查录音"
          }
        }
      }
    },
    "shopNPC.record": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音"
          }
        }
      }
    },
    "shopNPC.discard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃录音"
          }
        }
      }
    },
    "shopNPC.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before sending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送前检查"
          }
        }
      }
    },
    "shopNPC.voiceReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded voice will be sent for transcription and an AI reply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音将发送用于语音识别及 AI 回复"
          }
        }
      }
    },
    "shopNPC.transmissionDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm to send this question or voice to the configured shop AI service. Voice can incur transcription and AI processing costs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后将问题或语音发送至配置的店铺 AI 服务，语音可能产生转写及 AI 处理费用"
          }
        }
      }
    },
    "shopNPC.confirmSend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认发送"
          }
        }
      }
    },
    "shopNPC.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "shopNPC.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop conversation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "店铺分身对话"
          }
        }
      }
    },
    "shopNPC.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to this shop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与店铺分身对话"
          }
        }
      }
    }
  }
}
