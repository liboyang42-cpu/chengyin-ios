+import SwiftUI
+
+/// Production-capable view with no built-in service, approval or storage fallback.
+struct NativeTextDraftEditorView: View {
+    let editor: NativeTextDraftEditor
+    @Environment(\.dismiss) private var dismiss
+    var body: some View {
+        Form {
+            Section {
+                Text("nativeText.scope").font(.footnote).foregroundStyle(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+                if let version = editor.version { LabeledContent("nativeText.version", value: String(version)) }
+            }
+            if let payload = editor.payload {
+                Section("nativeText.content") {
+                    TextField("nativeText.title", text: Binding(get: { editor.payload?.title ?? "" }, set: editor.setTitle), axis: .vertical)
+                        .accessibilityIdentifier("nativeText.title")
+                    ForEach(payload.nodes) { node in
+                        TextField("nativeText.node", text: Binding(get: {
+                            editor.payload?.nodes.first(where: { $0.id == node.id })?.text ?? ""
+                        }, set: { editor.setText($0, nodeID: node.id) }), axis: .vertical)
+                            .lineLimit(3...12).accessibilityIdentifier("nativeText.node." + node.id)
+                    }
+                }.disabled(!editor.canEdit)
+            }
+            switch editor.phase {
+            case .idle, .loading, .sending:
+                ProgressView("nativeText.working").accessibilityIdentifier("nativeText.working")
+            case .ready:
+                Button("nativeText.review") { editor.prepareReview() }
+                    .disabled(!editor.canReview).accessibilityIdentifier("nativeText.review")
+            case .review:
+                Section("nativeText.reviewTitle") {
+                    if editor.isNew { Text("nativeText.newDraft") }
+                    ForEach(editor.changes) { change in
+                        VStack(alignment: .leading, spacing: 4) {
+                            Text(LocalizedStringKey(change.id == "title" ? "nativeText.title" : "nativeText.node")).font(.headline)
+                            Text("nativeText.before").font(.caption)
+                            Text(verbatim: change.before).foregroundStyle(.secondary)
+                            Text("nativeText.after").font(.caption)
+                            Text(verbatim: change.after)
+                        }.fixedSize(horizontal: false, vertical: true)
+                    }
+                    Button("nativeText.confirm") { Task { await editor.confirmSave() } }.accessibilityIdentifier("nativeText.confirm")
+                    Button("nativeText.cancelReview") { editor.cancelReview() }.accessibilityIdentifier("nativeText.cancelReview")
+                }
+            case .conflict, .unknown:
+                Section {
+                    Text(LocalizedStringKey(editor.phase == .conflict ? "nativeText.conflict" : "nativeText.unknown"))
+                        .fixedSize(horizontal: false, vertical: true).accessibilityIdentifier("nativeText.conflictState")
+                    Button("nativeText.fetchLatest") { Task { await editor.fetchConflict() } }.accessibilityIdentifier("nativeText.fetchLatest")
+                    if let cloud = editor.cloudPayload {
+                        Text("nativeText.cloudTitle").font(.caption)
+                        Text(verbatim: cloud.title)
+                        ForEach(cloud.nodes) { node in Text(verbatim: node.text) }
+                        if editor.phase == .conflict {
+                            Button("nativeText.useCloud") { editor.useCloud() }.accessibilityIdentifier("nativeText.useCloud")
+                            Button("nativeText.keepEdits") { editor.retainEditedFields() }.accessibilityIdentifier("nativeText.keepEdits")
+                        }
+                    }
+                    if editor.canRetry {
+                        Button("nativeText.retryExact") { Task { await editor.retryExact() } }.accessibilityIdentifier("nativeText.retryExact")
+                    }
+                }
+            case .blocked:
+                Text("nativeText.unavailable").accessibilityIdentifier("nativeText.unavailable")
+            case .invalidated, .deleted:
+                Text("nativeText.closed").accessibilityIdentifier("nativeText.closed")
+            }
+            if editor.validationIssue != nil { Text("nativeText.validation").foregroundStyle(.red).accessibilityIdentifier("nativeText.validation") }
+        }
+        .appNavigationTitle("nativeText.editor")
+        .task { await editor.open() }
+        .toolbar { ToolbarItem(placement: .cancellationAction) {
+            Button("nativeText.close") { editor.close(); dismiss() }.accessibilityIdentifier("nativeText.close")
+        } }
+        .onDisappear { editor.close() }
+    }
+}
