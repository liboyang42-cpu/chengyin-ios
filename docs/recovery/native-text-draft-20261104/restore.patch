+import XCTest
+
+final class NativeTextDraftEditorFlowTests: XCTestCase {
+    private var runningApp: XCUIApplication?
+    override func setUpWithError() throws { continueAfterFailure = false }
+    override func tearDownWithError() throws { attachFailureScreenshot(self, app: runningApp); runningApp?.terminate(); runningApp = nil }
+    private func launch(_ mode: String = "create") -> XCUIApplication {
+        let app = XCUIApplication(); runningApp = app
+        app.launchArguments = ["--native-text-draft-fixture", mode, "--uitesting-reset-language", "-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
+        app.launch(); tap("nativeText.fixture.open", app); return app
+    }
+    private func tap(_ id: String, _ app: XCUIApplication) {
+        let button = app.buttons[id]; XCTAssertTrue(revealFixtureElement(button, in: app)); button.tap()
+    }
+    private func input(_ id: String, _ value: String, _ app: XCUIApplication) {
+        let field = app.descendants(matching: .any).matching(identifier: id).firstMatch
+        XCTAssertTrue(revealFixtureElement(field, in: app)); field.tap(); field.typeText(value)
+    }
+    private func title(_ app: XCUIApplication) -> XCUIElement { app.descendants(matching: .any).matching(identifier: "nativeText.title").firstMatch }
+    private func expectValue(_ value: String, _ element: XCUIElement) {
+        let ready = expectation(for: NSPredicate(format: "value == %@", value), evaluatedWith: element)
+        wait(for: [ready], timeout: 5)
+    }
+    func testNewDraftFieldDiffCancelSaveCloseAndReopen() {
+        let app = launch(); input("nativeText.title", "Created title", app); input("nativeText.node.node-1", "Created text", app)
+        tap("nativeText.review", app); XCTAssertTrue(app.staticTexts["Confirm draft changes"].waitForExistence(timeout: 5))
+        tap("nativeText.cancelReview", app); expectValue("Created title", title(app))
+        tap("nativeText.review", app); tap("nativeText.confirm", app)
+        XCTAssertTrue(app.buttons["nativeText.review"].waitForExistence(timeout: 5)); tap("nativeText.close", app)
+        XCTAssertEqual(app.staticTexts["nativeText.fixture.saves"].label, "1")
+        tap("nativeText.fixture.open", app); expectValue("Created title", title(app))
+        let node = app.descendants(matching: .any).matching(identifier: "nativeText.node.node-1").firstMatch
+        expectValue("Created text", node); tap("nativeText.close", app)
+        XCTAssertEqual(app.staticTexts["nativeText.fixture.restores"].label, "1")
+    }
+    func testUnknownOutcomeAllowsOnlyExactRetry() {
+        let app = launch("unknown"); input("nativeText.title", "Uncertain draft", app)
+        tap("nativeText.review", app); tap("nativeText.confirm", app)
+        XCTAssertTrue(app.buttons["nativeText.retryExact"].waitForExistence(timeout: 5))
+        XCTAssertFalse(app.buttons["nativeText.review"].exists); tap("nativeText.retryExact", app)
+        XCTAssertTrue(app.buttons["nativeText.review"].waitForExistence(timeout: 5)); tap("nativeText.close", app)
+        XCTAssertEqual(app.staticTexts["nativeText.fixture.saves"].label, "2")
+    }
+    func testKnown409RequiresReadChoiceAndFreshReview() {
+        let app = launch("conflict"); input("nativeText.title", " local", app)
+        tap("nativeText.review", app); tap("nativeText.confirm", app)
+        tap("nativeText.fetchLatest", app); tap("nativeText.keepEdits", app)
+        XCTAssertTrue(app.buttons["nativeText.review"].waitForExistence(timeout: 5)); XCTAssertFalse(app.buttons["nativeText.confirm"].exists)
+        tap("nativeText.review", app); tap("nativeText.confirm", app)
+        XCTAssertTrue(app.buttons["nativeText.review"].waitForExistence(timeout: 5)); tap("nativeText.close", app)
+        XCTAssertEqual(app.staticTexts["nativeText.fixture.saves"].label, "2")
+    }
+    func testReplacedLifetimeClearsTitleAndReview() {
+        let app = launch(); input("nativeText.title", "Private old title", app); tap("nativeText.review", app)
+        tap("nativeText.fixture.invalidate", app)
+        XCTAssertTrue(app.staticTexts["nativeText.closed"].waitForExistence(timeout: 5)); XCTAssertFalse(title(app).exists)
+        XCTAssertFalse(app.buttons["nativeText.confirm"].exists)
+    }
+}
