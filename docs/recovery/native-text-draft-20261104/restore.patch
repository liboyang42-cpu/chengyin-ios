+import Foundation
+import Observation
+
+/// Validated owner/key selection, never the W18 installation ID or a publication subject ID.
+public struct NativeTextDraftSelection: Equatable {
+    public let identity: ContentDraftIdentity
+    public let serverDraftID: Int64
+    init?(record: ContentDraftRecord, identity: ContentDraftIdentity) {
+        guard identity.scope == .personal, identity.businessType == .topic, record.status == .draft,
+              (try? ContentDraftDocument<NativeTextDraftPayload>(record: record, identity: identity)) != nil else { return nil }
+        self.identity = identity; serverDraftID = record.id
+    }
+}
+
+/// Single owner/draft/display lifetime. The host supplies a fresh lease and reviewed service;
+/// neither an editor constructor nor the new schema creates a production route approval.
+@available(macOS 14.0, *)
+@MainActor @Observable public final class NativeTextDraftEditor {
+    public typealias Phase = ContentDraftCoordinator<NativeTextDraftPayload>.Phase
+    public private(set) var payload: NativeTextDraftPayload?
+    public private(set) var changes: [NativeTextDraftPayload.Change] = []
+    public private(set) var validationIssue: ContentDraftIssue?
+    public let identity = UUID()
+    private let coordinator: ContentDraftCoordinator<NativeTextDraftPayload>
+    private let lease: ContentDraftSessionLease
+    private let deviceID: String
+    private var baseline: NativeTextDraftPayload?
+    private var closed = false
+    public init(identity: ContentDraftIdentity, serverDraftID: Int64? = nil,
+                initialPayload: NativeTextDraftPayload? = nil, deviceID: String,
+                service: any ContentDraftServing, lease: ContentDraftSessionLease,
+                journal: (any ContentDraftSecureJournal)? = nil) throws {
+        guard identity.scope == .personal, identity.businessType == .topic,
+              identity.ownerMemberID == Int64(lease.context.session.accountID),
+              serverDraftID == nil || serverDraftID! > 0,
+              ContentDraftIdentity.validKey(deviceID) else { throw ContentDraftIssue.invalid }
+        try identity.validate(); self.lease = lease; self.deviceID = deviceID
+        let initial: NativeTextDraftPayload?
+        if serverDraftID == nil { initial = try (initialPayload ?? NativeTextDraftPayload()) }
+        else { initial = nil }
+        coordinator = .init(identity: identity, serverDraftID: serverDraftID, initialPayload: initial,
+                            service: service, lease: lease, journal: journal)
+    }
+    public var phase: Phase { current() ? coordinator.phase : .invalidated }
+    public var issue: ContentDraftIssue? { current() ? (validationIssue ?? coordinator.issue) : .staleSession }
+    public var version: Int64? { current() ? coordinator.document?.record.version : nil }
+    public var isNew: Bool { current() && coordinator.document == nil }
+    public var canEdit: Bool { current() && coordinator.phase == .ready && payload != nil && !coordinator.hasUncertainMutation }
+    public var canReview: Bool { canEdit && coordinator.canPrepare }
+    public var canRetry: Bool { current() && coordinator.canRetryExact }
+    public var cloudPayload: NativeTextDraftPayload? { current() ? coordinator.cloudConflict?.payload : nil }
+    private func current() -> Bool {
+        guard !closed else { return false }
+        guard lease.isCurrent else { close(); return false }; return true
+    }
+    /// Dismissal retires late reads/writes and drops private content. Pending journal data stays.
+    public func close() {
+        guard !closed else { return }; closed = true; coordinator.invalidate()
+        payload = nil; baseline = nil; changes = []; validationIssue = nil
+    }
+    public func open() async {
+        guard current(), !Task.isCancelled else { close(); return }
+        // Repeated presentation/setup must not replace unreviewed local fields with
+        // the coordinator's last acknowledged payload when initialize would be a no-op.
+        guard coordinator.phase == .idle || coordinator.phase == .blocked else { return }
+        await coordinator.initialize()
+        guard current() else { return }
+        guard !Task.isCancelled else { close(); return }
+        if coordinator.phase == .ready { adoptAcknowledgedPayload() }
+    }
+    public func setTitle(_ text: String) {
+        guard canEdit, var value = payload else { return }
+        do { try value.setTitle(text); payload = value; validationIssue = nil }
+        catch { validationIssue = .invalid }
+    }
+    public func setText(_ text: String, nodeID: String) {
+        guard canEdit, var value = payload else { return }
+        do { try value.setText(text, nodeID: nodeID); payload = value; validationIssue = nil }
+        catch { validationIssue = .invalid }
+    }
+    public func prepareReview() {
+        guard canReview, let payload, let baseline else { return }
+        do {
+            try payload.validateForSave(); let diff = try payload.changes(from: baseline)
+            guard isNew || !diff.isEmpty else { throw ContentDraftIssue.invalid }
+            coordinator.prepareSave(payload, subjectID: coordinator.document?.record.subjectId, deviceID: deviceID)
+            guard coordinator.phase == .review else { throw ContentDraftIssue.invalid }
+            changes = diff; validationIssue = nil
+        } catch { changes = []; validationIssue = .invalid }
+    }
+    public func cancelReview() {
+        guard current() else { return }; coordinator.cancelReview(); changes = []
+    }
+    public func confirmSave() async {
+        guard current(), !Task.isCancelled, coordinator.phase == .review else { return }
+        await coordinator.confirm(); finishWrite()
+    }
+    public func retryExact() async {
+        guard current(), !Task.isCancelled, coordinator.canRetryExact else { return }
+        await coordinator.retryExact(); finishWrite()
+    }
+    private func finishWrite() {
+        guard current() else { return }
+        guard !Task.isCancelled else { close(); return }
+        if coordinator.phase == .ready { adoptAcknowledgedPayload() }
+        changes = []
+    }
+    private func adoptAcknowledgedPayload() {
+        payload = coordinator.localPayload; baseline = coordinator.localPayload; validationIssue = nil
+    }
+    public func fetchConflict() async {
+        guard current(), !Task.isCancelled else { return }
+        await coordinator.fetchLatestForConflict()
+        if Task.isCancelled { close() }
+    }
+    /// Available only after a definitive first-attempt 409. Unknown writes cannot be unlocked.
+    public func useCloud() {
+        guard current(), coordinator.phase == .conflict, coordinator.cloudConflict != nil else { return }
+        coordinator.resolveConflict(useCloudPayload: true); adoptAcknowledgedPayload(); changes = []
+    }
+    public func retainEditedFields() {
+        guard current(), coordinator.phase == .conflict, let local = payload, let baseline,
+              let cloud = coordinator.cloudConflict?.payload else { return }
