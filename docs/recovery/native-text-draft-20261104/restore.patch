+import SwiftUI
+
+/// The normal owner-draft navigation reaches this seam. Default nil means NO writer, journal or
+/// endpoint approval. Any future host must separately review its scoped service/storage factory.
+typealias NativeTextDraftEditorFactory = @MainActor (NativeTextDraftSelection?) throws -> NativeTextDraftEditor
+private struct NativeTextDraftEditorFactoryKey: EnvironmentKey {
+    static let defaultValue: NativeTextDraftEditorFactory? = nil
+}
+extension EnvironmentValues {
+    var nativeTextDraftEditorFactory: NativeTextDraftEditorFactory? {
+        get { self[NativeTextDraftEditorFactoryKey.self] }
+        set { self[NativeTextDraftEditorFactoryKey.self] = newValue }
+    }
+}
+
+struct NativeTextDraftEntryView: View {
+    let selection: NativeTextDraftSelection?
+    @Environment(\.nativeTextDraftEditorFactory) private var factory
+    @State private var editor: NativeTextDraftEditor?
+    @State private var attempted = false
+    var body: some View {
+        Group {
+            if let editor { NativeTextDraftEditorView(editor: editor).id(editor.identity) }
+            else if !attempted { ProgressView("nativeText.working") }
+            else {
+                Form {
+                    Text("nativeText.writerUnavailable").fixedSize(horizontal: false, vertical: true)
+                        .accessibilityIdentifier("nativeText.writerUnavailable")
+                    Text("nativeText.scope").font(.footnote).foregroundStyle(.secondary)
+                    Button("nativeText.review") {}.disabled(true)
+                    Button("nativeText.confirm") {}.disabled(true)
+                }.appNavigationTitle("nativeText.editor")
+            }
+        }
+        .task {
+            guard !attempted else { return }; attempted = true
+            if let factory { editor = try? factory(selection) }
+        }
+        .onDisappear { editor?.close(); editor = nil; attempted = false }
+    }
+}
