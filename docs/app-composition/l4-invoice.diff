+    // Disabled until the frozen invoice contract and test deployment are reviewed.
+    // Login/server flags do not create these local route approvals.
+    var invoiceLaunchReadsApproved: @MainActor (RuntimeDependencyContext) -> Bool = { _ in false }
+    var invoiceLaunchWritesApproved: @MainActor (RuntimeDependencyContext) -> Bool = { _ in false }
+    func makeInvoiceLaunchService(context: RuntimeDependencyContext,
+                                  current: @escaping () -> RuntimeDependencyContext?,
+                                  unauthorized: @escaping () -> Void) -> InvoiceLaunchService? {
+        guard case .reviewed(let reviewed) = deployment, context.market == .china,
+              reviewed.regional.market == context.market,
+              reviewed.regional.apiConfiguration?.baseURL == context.baseURL,
+              reviewed.storageScope.service == context.session.namespace,
+              let session = try? InvoiceLaunchSession(baseURL: context.baseURL, namespace: context.session.namespace,
+                  accountID: Int64(context.session.accountID), role: context.role, epoch: context.session.epoch,
+                  token: context.session.token) else { return nil }
+        return InvoiceLaunchService(session: session, transport: makeTransport(),
+            enabled: { current() == context && self.invoiceLaunchReadsApproved(context) },
+            mutationsEnabled: { current() == context && self.invoiceLaunchWritesApproved(context) },
+            current: {
+                guard let value = current(), value.market == .china else { return nil }
+                return try? InvoiceLaunchSession(baseURL: value.baseURL, namespace: value.session.namespace,
+                    accountID: Int64(value.session.accountID), role: value.role, epoch: value.session.epoch,
+                    token: value.session.token)
+            }, unauthorized: unauthorized)
+    }
