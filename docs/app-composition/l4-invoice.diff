+    private var retainedInvoiceLaunch: (session: InvoiceLaunchSession, viewer: UInt64, coordinator: InvoiceLaunchCoordinator)?
+    private func invalidateInvoiceLaunch() {
+        retainedInvoiceLaunch?.coordinator.service.revoke()
+        retainedInvoiceLaunch = nil // Durable pending record survives logout.
+    }
+    func makeInvoiceLaunchCoordinator() -> InvoiceLaunchCoordinator? {
+        guard let context = currentRuntimeDependencyContext, context.market == .china, let storageScope,
+              let session = try? InvoiceLaunchSession(baseURL: context.baseURL, namespace: context.session.namespace,
+                  accountID: Int64(context.session.accountID), role: context.role, epoch: context.session.epoch,
+                  token: context.session.token) else { invalidateInvoiceLaunch(); return nil }
+        let viewer = compositionViewerRevision
+        if let retainedInvoiceLaunch, retainedInvoiceLaunch.session == session, retainedInvoiceLaunch.viewer == viewer {
+            return retainedInvoiceLaunch.coordinator
+        }
+        invalidateInvoiceLaunch()
+        let current: () -> RuntimeDependencyContext? = { [weak self] in
+            guard let self, self.compositionViewerRevision == viewer else { return nil }
+            return self.currentRuntimeDependencyContext
+        }
+        guard let service = composition.makeInvoiceLaunchService(context: context, current: current, unauthorized: { [weak self] in
+            guard let self, current() == context else { return }
+            self.expireIfMatching(error: APIError.unauthorized, stamp: context.session.epoch, credential: context.session.token)
+        }), let coordinator = try? InvoiceLaunchCoordinator(service: service,
+            store: InvoiceLaunchPendingStore(session: session, storage: TemplateAuthoringSecureStorage(scope: storageScope))) else { return nil }
+        retainedInvoiceLaunch = (session, viewer, coordinator)
+        return coordinator
+    }
