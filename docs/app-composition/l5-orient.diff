+    func orientSession(topicID: Int, activityID: Int, productType: Int, contract: OrientSessionContract = .frozen58) -> OrientSessionCoordinator? {
+        guard !committingAuthenticatedSession,
+              let scope = try? OrientSessionScope(topicID: topicID, activityID: activityID, productType: productType),
+              let api = regionalConfiguration?.apiConfiguration, let storageScope,
+              let captured = currentRuntimeDependencyContext,
+              let factory = runtimeDependencyFactory, let approved = factory.accepted,
+              approved.play.contains(.reads),
+              let owner = try? OrientSessionRecoveryOwner(namespace: storageScope.service,
+                  accountID: captured.session.accountID, role: captured.role),
+              let identity = try? OrientSessionIdentity(owner: owner, epoch: captured.session.epoch,
+                  token: captured.session.token) else { return nil }
+        var required: Set<String> = ["api/play/orient/session", "api/play/orient/session/prepare",
+            "api/play/orient/session/start", "api/play/orient/session/abandon", "api/play/orient/session/receipt",
+            "api/orient/safety/check", "api/orient/team/lobby", "api/orient/team/ranking"]
+        if contract == .currentC6 { required.insert("api/play/orient/session/current") }
+        let contractKey = contract == .currentC6 ? "c6" : "58"
+        guard required.isSubset(of: approved.endpoints.paths) else { return nil }
+        let viewer = compositionViewerRevision
+        let key = playRuntimeKey(.topic(topicID), suffix: "orient:\(contractKey):\(activityID):\(viewer):\(approved.endpoints.paths.sorted().joined(separator: "|"))")
+        if let retained = retainedOrientSessions[key] { return retained }
+        let current: () -> OrientSessionIdentity? = { [weak self] in
+            guard let self, self.compositionViewerRevision == viewer,
+                  self.currentRuntimeDependencyContext == captured,
+                  self.runtimeDependencyFactory?.accepted?.endpoints.paths == approved.endpoints.paths else { return nil }
+            return identity
+        }
+        do {
+            let support = try FileManager.default.url(for: .applicationSupportDirectory,
+                in: .userDomainMask, appropriateFor: nil, create: true)
+            let namespaceDigest = SHA256.hash(data: Data(owner.namespace.utf8))
+                .map { String(format: "%02x", $0) }.joined()
+            let slot = support.appendingPathComponent("OrientSessions", isDirectory: true)
+                .appendingPathComponent(namespaceDigest, isDirectory: true)
+                .appendingPathComponent(String(owner.accountID), isDirectory: true)
+                .appendingPathComponent(owner.role, isDirectory: true)
+                .appendingPathComponent("\(topicID)-\(activityID).json")
+            let recovery = try OrientSessionFileRecovery(fileURL: slot)
+            let coordinator = try OrientSessionCoordinator(scope: scope,
+                service: OrientSessionService(configuration: api, transport: factory.transport, contract: contract),
+                recovery: recovery, currentIdentity: current, onUnauthorized: { [weak self] lease in
+                    guard current() == lease else { return }
+                    self?.expireIfMatching(error: APIError.unauthorized, stamp: lease.epoch, credential: lease.token)
+                })
+            retainedOrientSessions[key] = coordinator
+            return coordinator
+        } catch { return nil }
