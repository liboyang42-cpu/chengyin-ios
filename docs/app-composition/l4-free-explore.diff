+    }
+    // L4 free-explore factory. Reservation dispatch remains closed pending L2 review.
+    private var currentFreeExploreLaunchSession: FreeExploreLaunchSession? {
+        guard let context = currentRuntimeDependencyContext else { return nil }
+        return try? FreeExploreLaunchSession(baseURL: context.baseURL,
+            accountID: Int64(context.session.accountID), market: context.market.rawValue,
+            namespace: context.session.namespace, role: context.role,
+            epoch: context.session.epoch, token: context.session.token)
+    }
+    func makeFreeExploreLaunchCoordinator() throws -> FreeExploreLaunchCoordinator? {
+        guard storageScope != nil, let captured = currentFreeExploreLaunchSession else { return nil }
+        let viewer = compositionViewerRevision
+        let current: () -> FreeExploreLaunchSession? = { [weak self] in
+            guard let self, self.compositionViewerRevision == viewer else { return nil }
+            return self.currentFreeExploreLaunchSession
+        }
+        let service = FreeExploreLaunchService(session: captured, transport: compositionTransport,
+            currentSession: current, reservationAllowed: { false },
+            onUnauthorized: { [weak self] session in
+                guard let self, current() == session else { return }
+                self.expireIfMatching(error: APIError.unauthorized, stamp: session.epoch,
+                    credential: self.token)
+            })
+        let pending = FreeExploreLaunchPendingStore(storage: templateAuthoringSecureStorage, session: captured)
+        return try FreeExploreLaunchCoordinator(service: service, pending: pending)
