        "stringUnit": {
          "state": "translated",
          "value": "确认取消订单"
        }
      }
    }
  },
  "orderLifecycle.production.confirm.refund": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Confirm cancellation and refund request"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "确认取消并申请退款"
        }
      }
    }
