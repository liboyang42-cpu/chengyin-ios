      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show local sample"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看本地样例"
          }
        }
      }
    },
    "templateD6.sampleResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local sample result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地样例结果"
          }
        }
      }
