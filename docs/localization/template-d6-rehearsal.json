{
  "sourceLanguage": "en",
  "strings": {
    "templateD6.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "D6 local samples"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "D6 本地样例"
          }
        }
      }
    },
    "templateD6.sampleOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose example die values to inspect this configuration. These local samples are not actual rolls, scores, rewards or server receipts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择示例点数，检查当前配置。这里仅展示本地样例，不代表正式掷骰、得分、奖励或服务端回执。"
          }
        }
      }
    },
    "templateD6.configuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置"
          }
        }
      }
    },
    "templateD6.oneDie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One die"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一颗骰子"
          }
        }
      }
    },
    "templateD6.twoDice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two dice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两颗骰子"
          }
        }
      }
    },
    "templateD6.sumOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two dice show the sum only; it does not select a face action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两颗骰子只展示点数之和，不对应某一面的任务。"
          }
        }
      }
    },
    "templateD6.exampleValues": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose example values"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择示例点数"
          }
        }
      }
    },
    "templateD6.dieNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 颗骰子"
          }
        }
      }
    },
