      }
    },
    "templateD6.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload current configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入当前配置"
          }
        }
      }
    }
  },
  "version": "1.0"
}
