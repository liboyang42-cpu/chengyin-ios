{
  "sourceLanguage": "en",
  "strings": {
    "templatePictures.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture choices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "猜图选项"
          }
        }
      }
    },
    "templatePictures.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add and name the pictures, then choose exactly one correct answer. Removing the answer leaves it unset until you choose again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图片并填写名称，再选定唯一正确答案。删除正确项后，需要重新选择答案。"
          }
        }
      }
    },
    "templatePictures.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Reload these choices before editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已变化，请重新载入选项后编辑。"
          }
        }
      }
    },
    "templatePictures.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload choices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入选项"
          }
        }
      }
    },
    "templatePictures.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older list uses a different format. Its original data has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份旧选项使用不同格式，原始数据已保留。"
          }
        }
      }
    },
    "templatePictures.correctCount %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct answers selected: %lld (choose one)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选正确答案：%lld 个（应为 1 个）"
          }
        }
      }
    },
    "templatePictures.number %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片 %lld"
          }
        }
      }
    },
    "templatePictures.addressHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: an HTTPS address or a site path. This editor saves the address without loading the image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选填 HTTPS 地址或站内路径。此处仅保存地址，不加载图片。"
          }
        }
      }
    },
    "templatePictures.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the correct answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张是正确答案"
          }
        }
      }
    },
    "templatePictures.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose as the correct answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为正确答案"
          }
        }
      }
    },
    "templatePictures.up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上移"
          }
        }
      }
    },
    "templatePictures.down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下移"
          }
        }
      }
    },
    "templatePictures.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a picture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一张"
          }
        }
      }
    },
    "templatePictures.count %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pictures · 3–8 required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张图片 · 需 3–8 张"
          }
        }
      }
    }
  },
  "version": "1.0"
}
