          "stringUnit": {
            "state": "translated",
            "value": "Rehearse coin flip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抛硬币本地排练"
          }
        }
      }
    },
    "templateCoin.sample": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a coin-flip sample"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验抛硬币样例"
          }
        }
      }
    },
    "templateCoin.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local author simulation only. No player result, payment, coin, completion or reward is created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为作者本地模拟，不产生玩家结果、付款、发币、任务达成或奖励。"
          }
        }
      }
    },
    "templateCoin.deterministic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads is the source preview default. Choose either face to inspect its text; repeating never rolls a real or random outcome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原预览默认正面。可选择正反面核对文案；再次演示不会生成真实或随机结果。"
          }
        }
      }
    },
    "templateCoin.exampleOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Examples are filled only in this temporary copy. Their wording creates no payment or treat commitment. Your draft stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样例只填入临时副本。演示文案不构成付款或请客承诺，原稿不会改变。"
          }
        }
      }
    },
