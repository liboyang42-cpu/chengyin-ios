    "templateTimer.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author-local timing only. No real task result, completion evidence, score or reward is submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为作者本地计时，不提交真实任务结果、完成证据、得分或奖励。"
          }
        }
      }
    },
    "templateTimer.background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving or backgrounding retires this rehearsal. Returning begins a fresh session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开或进入后台会结束本次预演；回来后从新一轮开始。"
          }
        }
      }
    },
    "templateTimer.exampleOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pristine fields in a temporary copy receive source examples. Actual target values below are read from your configuration; your draft is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在临时副本的默认字段中填入原样例。下方目标值读取实际配置，原稿不变。"
          }
        }
      }
    },
