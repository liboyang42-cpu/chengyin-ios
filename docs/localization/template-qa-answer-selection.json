{
  "sourceLanguage": "en",
  "strings": {
    "templateQAAnswers.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct answers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正确答案"
          }
        }
      }
    },
    "templateQAAnswers.singleHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one correct option. Choosing another replaces it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选一个正确答案；选择另一个时会自动替换。"
          }
        }
      }
    },
    "templateQAAnswers.multipleHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select every correct option. Turning multiple selection off keeps the first selected option."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐项勾选正确答案；关闭多选时保留排在最前的已选答案。"
          }
        }
      }
    },
    "templateQAAnswers.optionNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选项 %lld"
          }
        }
      }
    },
    "templateQAAnswers.emptyLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled option"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未填写选项文字"
          }
        }
      }
    },
    "templateQAAnswers.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct answer selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选为正确答案"
          }
        }
      }
    },
    "templateQAAnswers.notSelected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not selected as a correct answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选为正确答案"
          }
        }
      }
    },
    "templateQAAnswers.noAnswer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one correct answer before rehearsal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选择一个正确答案，再进行演练。"
          }
        }
      }
    },
    "templateQAAnswers.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved fields are retained. Adjust the option list or multiple-selection field to use the answer selector."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留原有内容。请先调整选项列表或多选字段，再使用答案选择器。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
