{
  "sourceLanguage": "en",
  "strings": {
    "templateSamples.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore local samples"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看本地样例"
          }
        }
      }
    },
    "templateSamples.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try these text-based examples before configuring a game. This browser uses the existing local rehearsal screens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先体验这些文字交互样例，再配置玩法。此处复用已有本地试玩界面。"
          }
        }
      }
    },
    "templateSamples.configureScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open editor uses your original draft. It does not enable a game, switch a mode, or copy sample values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入配置会打开原草稿，不自动启用玩法、切换模式或复制样例。"
          }
        }
      }
    },
    "templateSamples.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This configuration cannot be read safely. The original draft is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份配置无法安全读取，原草稿没有改变。"
          }
        }
      }
    },
    "templateSamples.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View sample"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看样例"
          }
        }
      }
    },
    "templateSamples.configure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open editor"
          }
