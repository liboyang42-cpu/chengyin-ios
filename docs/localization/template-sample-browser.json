    },
    "templateSamples.previewScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary copy: examples fill fields currently equal to defaults; other values are retained. Native local feedback creates no real task or reward. Source example text remains in Chinese."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时副本：当前仍等于默认值的字段会填入样例，其他值原样保留。本地试玩反馈不产生真实任务或奖励。原始样例文案保留中文。"
          }
        }
      }
    },
    "templateSamples.filled %lld": {
