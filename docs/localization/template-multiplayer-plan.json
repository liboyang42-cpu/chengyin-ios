{
  "sourceLanguage": "en",
  "strings": {
    "templateTeam.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles and turn order"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色与轮次顺序"
          }
        }
      }
    },
    "templateTeam.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure the roles, then enter their IDs in turn order. Renaming or removing a role does not change the order automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先配置角色，再按轮次输入角色 ID。修改或删除角色后，轮次顺序不会自动改写。"
          }
        }
      }
    },
    "templateTeam.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Reload this plan before editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已变化，请重新载入配置后编辑。"
          }
        }
      }
    },
    "templateTeam.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入配置"
          }
        }
      }
    },
    "templateTeam.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older configuration uses a different format. Its original data has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份旧配置格式不同，原始数据已保留。"
          }
        }
      }
    },
    "templateTeam.roleNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Role %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色 %lld"
          }
        }
      }
    },
    "templateTeam.up": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上移"
          }
        }
      }
    },
    "templateTeam.down": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move down"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下移"
          }
        }
      }
    },
    "templateTeam.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add role"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加角色"
          }
        }
      }
    },
    "templateTeam.roleCount %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld roles · 1–20 required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个角色 · 需 1–20 个"
          }
        }
      }
    },
    "templateTeam.order": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn order"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮次顺序"
          }
        }
      }
    },
    "templateTeam.orderHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate role IDs with commas, Chinese commas, spaces or newlines. Repeated IDs are kept; 1–100 turns are allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色 ID 可用逗号、中文逗号、空格或换行分隔。重复 ID 会保留，需 1–100 个轮次。"
          }
        }
      }
    },
    "templateTeam.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parsed turn-order preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析后的轮次预览"
          }
        }
      }
    },
    "templateTeam.emptyOrder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter at least one role ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入至少一个角色 ID。"
          }
        }
      }
    },
    "templateTeam.unresolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Role missing or ID duplicated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色不存在或 ID 重复"
          }
        }
      }
    }
  },
  "version": "1.0"
}
