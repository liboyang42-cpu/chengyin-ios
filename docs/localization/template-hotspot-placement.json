{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "templateHotspots.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place hidden targets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图上标目标"
          }
        }
      }
    },
    "templateHotspots.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the scene, select a target, then tap its location. Tap the selected target again to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先加载场景，选择一个目标，再点图上的位置。再次选择同一目标可取消。"
          }
        }
      }
    },
    "templateHotspots.loadScene": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load / retry scene"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载／重试场景图"
          }
        }
      }
    },
    "templateHotspots.sceneUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the form and enter a supported HTTPS scene address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回表单填写可用的 HTTPS 场景图地址。"
          }
        }
      }
    },
    "templateHotspots.targetNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标 %lld"
          }
        }
      }
    },
    "templateHotspots.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选中"
          }
        }
      }
    },
    "templateHotspots.mark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标位置"
          }
        }
      }
    },
    "templateHotspots.unplaced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a position"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没标"
          }
        }
      }
    },
    "templateHotspots.placed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有位置"
          }
        }
      }
    },
    "templateHotspots.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加目标"
          }
        }
      }
    },
    "templateHotspots.countBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep 3–5 targets. Detection radius is managed by the system."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 3–5 个目标，判定半径由系统管理。"
          }
        }
      }
    },
    "templateHotspots.canvas": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scene: tap to place the selected target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景图：点按以标记选中目标的位置"
          }
        }
      }
    },
    "templateHotspots.loadFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scene could not load. Use Load / retry scene to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景图加载失败，请点击“加载／重试场景图”重试。"
          }
        }
      }
    },
    "templateHotspots.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading scene"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载场景图"
          }
        }
      }
    }
  }
}
