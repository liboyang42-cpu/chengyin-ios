+#if canImport(Security) && canImport(Darwin)
+import Foundation
+
+/// Fixed QA-only OS roots; reuses the existing reviewed storage primitives.
+/// Construction performs no I/O or network grant. No caller-supplied filesystem
+/// path, blind Keychain upsert, plaintext file or generic completion journal.
+@MainActor enum PlayQATextRestartSystemFactory {
+    static func make(session: PlayExperienceSession, scope: PlaySessionScope,
+                     activityID: Int, topicID: Int, nodeID: Int,
+                     regionalConfiguration: RegionalConfiguration,
+                     storageScope: RegionalSessionStorageScope) throws -> PlayQATextDurableRestartJournal {
+        guard PlayRecoveryAccountRole(rawValue: session.role) != nil, scope.isValid,
+              storageScope.matches(configuration: regionalConfiguration),
+              session.namespace.utf8.elementsEqual(storageScope.service.utf8),
+              let configuration = regionalConfiguration.apiConfiguration else { throw PlayExperienceError.persistenceUnavailable }
+        let context = try PlayQATextRestartContext(configuration: configuration, session: session, scope: scope,
+            activityID: activityID, topicID: topicID, nodeID: nodeID)
+        let root = URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true).resolvingSymlinksInPath()
+            .appendingPathComponent("Library", isDirectory: true)
+            .appendingPathComponent("Application Support", isDirectory: true)
+            .appendingPathComponent("PlayQATextReceipt-v1", isDirectory: true)
+        return try .init(context: context,
+            anchors: ContentDraftSystemAnchors(service: "questify.play.qa-text.receipt.v1"),
+            ciphertexts: ContentDraftSystemCiphertexts(root: root, createApplicationSupport: true))
+    }
+}
+#endif
