{
  "sourceLanguage": "en",
  "strings": {
    "platform.audio.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频"
          }
        }
      }
    },
    "platform.audio.gated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio playback is not enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频播放尚未启用"
          }
        }
      }
    },
    "platform.audio.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备播放"
          }
        }
      }
    },
    "platform.audio.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载音频"
          }
        }
      }
    },
    "platform.audio.playing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在播放"
          }
        }
      }
    },
    "platform.audio.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        }
      }
    },
    "platform.audio.ended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished; play again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已播完，可重新播放"
          }
        }
      }
    },
    "platform.audio.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio unavailable; try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频暂不可用，请重试"
          }
        }
      }
    },
    "platform.audio.disposed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Player closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器已关闭"
          }
        }
      }
    },
    "platform.audio.pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "platform.audio.play": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放音频"
          }
        }
      }
    },
    "platform.audio.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this audio host to receive the playback request?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此音频服务接收播放请求？"
          }
        }
      }
    },
    "platform.audio.allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow and play"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许并播放"
          }
        }
      }
    },
    "platform.audio.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback does not complete a task or earn a reward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放音频不会完成任务或获得奖励。"
          }
        }
      }
    },
    "platform.map.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Apple Maps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 地图中打开"
          }
        }
      }
    },
    "platform.map.copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy selected address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制所选地址"
          }
        }
      }
    },
    "platform.map.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this destination to Apple Maps?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此目的地发送到 Apple 地图？"
          }
        }
      }
    },
    "platform.map.gated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External maps are not enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部地图尚未启用"
          }
        }
      }
    },
    "platform.map.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected destination only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅打开所选目的地"
          }
        }
      }
    },
    "platform.map.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Maps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开地图"
          }
        }
      }
    },
    "platform.map.opened": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps opened"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开地图"
          }
        }
      }
    },
    "platform.map.noCoordinates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This place has no usable coordinates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地点暂无可用坐标"
          }
        }
      }
    },
    "platform.map.copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address copied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址已复制"
          }
        }
      }
    },
    "platform.map.launchFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maps could not open; you can copy the address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开地图，可复制地址"
          }
        }
      }
    },
    "platform.map.copyFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not copy; select the address to copy manually"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制失败，请选择地址手动复制"
          }
        }
      }
    },
    "platform.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "platform.audio.source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频来源"
          }
        }
      }
    },
    "platform.audio.narration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter narration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节旁白"
          }
        }
      }
    },
    "platform.audio.guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node audio guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点语音导览"
          }
        }
