    "merchant.publicHome.createConsequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this review for moderation. A receipt does not mean it is publicly visible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交评价审核，收到回执不代表已公开展示"
          }
        }
      }
    },
    "merchant.publicHome.reportConsequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this report for platform review. Reporting does not delete the review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交平台复核，举报不会删除评价"
          }
        }
      }
    },
    "merchant.publicHome.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认发送"
