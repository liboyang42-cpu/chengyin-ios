    "merchant.publicHome.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outcome is unknown. This operation is locked to prevent duplicates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知，为避免重复提交，此操作已锁定"
          }
        }
      }
    },
    "merchant.publicHome.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation history could not be saved. Submission is blocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存操作记录，已阻止提交"
