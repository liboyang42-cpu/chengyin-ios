+
+enum NativeChannelRuntimeRoute: Equatable {
+    case incremental(conversationID: Int, after: Int)
+    case readThrough(conversationID: Int, target: Int)
+    init?(request: URLRequest, baseURL: URL) {
+        let prefix = "multipart/form-data; boundary="
+        guard !request.httpShouldHandleCookies,
+              ["Cookie", "Cookie2", "Proxy-Authorization"].allSatisfy({ request.value(forHTTPHeaderField: $0) == nil }),
+              let url = request.url, url.query == nil, url.fragment == nil,
+              request.httpMethod == "POST", request.httpBodyStream == nil,
+              request.value(forHTTPHeaderField: "Accept") == "application/json",
+              let type = request.value(forHTTPHeaderField: "Content-Type"), type.hasPrefix(prefix),
+              let body = request.httpBody, body.count <= 4096,
+              let text = String(data: body, encoding: .utf8) else { return nil }
+        let boundary = String(type.dropFirst(prefix.count))
+        func value(_ key: String) -> String? {
+            let marker = "Content-Disposition: form-data; name=\"\(key)\"\r\n\r\n"
+            guard let range = text.range(of: marker), let end = text[range.upperBound...].range(of: "\r\n") else { return nil }
+            return String(text[range.upperBound..<end.lowerBound])
+        }
+        let fields: [String: String]
+        let route: Self
+        if url.absoluteString.utf8.elementsEqual(baseURL.appendingPathComponent("api/im/messages").absoluteString.utf8) {
+            guard let cid = value("conversation_id"), let id = Int(cid), id > 0, String(id) == cid,
+                  let aid = value("after_id"), let after = Int(aid), after >= 0, String(after) == aid,
+                  let size = value("size"), size == "30" else { return nil }
+            fields = ["conversation_id": cid, "after_id": aid, "size": size]
+            route = .incremental(conversationID: id, after: after)
+        } else if url.absoluteString.utf8.elementsEqual(baseURL.appendingPathComponent("api/native/channels/read-through").absoluteString.utf8) {
+            guard let cid = value("conversation_id"), let id = Int(cid), id > 0, String(id) == cid,
+                  let rto = value("read_to"), let target = Int(rto), target > 0, String(target) == rto else { return nil }
+            fields = ["conversation_id": cid, "read_to": rto]
+            route = .readThrough(conversationID: id, target: target)
+        } else { return nil }
+        guard let canonical = try? AuthRequestBuilder.makeFormRequest(url: url, fields: fields,
+            token: request.value(forHTTPHeaderField: "Authorization"), boundary: boundary), canonical.httpBody == body else { return nil }
+        self = route
+    }
+}
+
+struct NativeChannelFeatureRule {
+    fileprivate let path: String
+    func accepts(_ route: BusinessRuntimeRoute) -> Bool {
+        route.method == "POST" && route.path == path
+    }
+}
+
+extension BusinessRuntimeFeature {
+    static var nativeChannelIncrementalRead: NativeChannelFeatureRule { .init(path: "api/im/messages") }
+    static var nativeChannelReadReceipt: NativeChannelFeatureRule { .init(path: "api/native/channels/read-through") }
+}
