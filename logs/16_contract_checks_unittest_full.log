iled': {'en': 'Could not load the next page. Retry or refresh the list.', 'zh-Hans': '下一页加载失败，请重试或刷新列表。'}, 'templateAuthor.shelf.pageLimit': {'en': 'Search limit reached. Narrow your search or refresh.', 'zh-Hans': '已达到搜索上限，请缩小搜索范围或刷新。'}, 'templateAuthor.field.medalStyle': {'en': 'Medal style', 'zh-Hans': '勋章样式'}, 'templateAuthor.medalStyle.glow': {'en': '2D glow', 'zh-Hans': '二维发光'}, 'templateAuthor.medalStyle.enamel': {'en': '3D enamel', 'zh-Hans': '3D 珐琅'}, 'templateAuthor.preference.title': {'en': 'Preference results (read-only)', 'zh-Hans': '偏好结果（只读）'}, 'templateAuthor.preference.partial': {'en': 'Partial preview. Questions, scoring, tie-breaking and extensions are preserved without editing.', 'zh-Hans': '部分预览。题目、评分、决胜规则及扩展内容保留原文，不可编辑。'}, 'templateAuthor.preference.days': {'en': 'Follow-up days', 'zh-Hans': '后续周期（天）'}, 'templateAuthor.preference.recipient': {'en': 'Tag recipient', 'zh-Hans': '标签接收方'}, 'templateAuthor.preference.purpose': {'en': 'Tag purpose', 'zh-Hans': '标签用途'}, 'templateAuthor.preference.revocable': {'en': 'The source declares this tag revocable.', 'zh-Hans': '原配置声明此标签可撤回。'}, 'templateAuthor.preference.unsupported': {'en': 'This configuration cannot be previewed. The original is retained unchanged.', 'zh-Hans': '此配置暂不能预览，原文已完整保留。'}, 'templateAuthor.localConfigurationOnly': {'en': 'This completion method can be edited and saved only on this device. Remote draft and publishing are unavailable.', 'zh-Hans': '此完成方式仅支持本机编辑与保存，不能提交远端草稿或发布。'}, 'templateAuthor.method.6': {'en': 'Preference questionnaire (local)', 'zh-Hans': '偏好题组（本地）'}, 'templateAuthor.method.7': {'en': 'Sensor challenge (local)', 'zh-Hans': '传感器挑战（本地）'}, 'templateAuthor.preference.instructions': {'en': 'Edit the source questionnaire JSON: steps/options/scores, dimensions, tiebreak, results and tags. Keys belong to the author; nothing is automatically reordered. Invalid text can still be saved locally.', 'zh-Hans': '编辑原始题组 JSON：步骤、选项及分值、维度、并列取舍题、结果和标签。key 由作者维护，不自动重排。格式错误的文本也可保存本地。'},