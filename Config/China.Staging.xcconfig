// Build inputs only. This profile never grants authentication or feature capabilities.
#include "China.xcconfig"
// Reset earlier local inputs so deployments cannot inherit another environment's address.
QUESTIFY_API_BASE_URL =
QUESTIFY_SESSION_REALM =
#include? "Local.China.Staging.xcconfig"
// Bind environment and market after optional overrides; endpoints and realms remain local inputs.
QUESTIFY_DEPLOYMENT_ENVIRONMENT = staging
QUESTIFY_MARKET = CN
