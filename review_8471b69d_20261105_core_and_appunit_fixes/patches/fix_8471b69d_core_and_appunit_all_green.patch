+            fields = ["conversation_id": cid, "after_id": aid, "size": size]
+            route = .incremental(conversationID: id, after: after)
+        } else if url.absoluteString.utf8.elementsEqual(baseURL.appendingPathComponent("api/native/channels/read-through").absoluteString.utf8) {
+            guard let cid = value("conversation_id"), let id = Int(cid), id > 0, String(id) == cid,
+                  let rto = value("read_to"), let target = Int(rto), target > 0, String(target) == rto else { return nil }
