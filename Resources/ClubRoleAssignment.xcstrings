{
  "sourceLanguage": "en",
  "strings": {
    "roleAssign.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Role assignment history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色委派历史"
          }
        }
      }
    },
    "roleAssign.history.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical assignments are separate from current roles. Unknown outcomes are never resent; old opaque intent markers remain locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史委派与当前角色分开。未知结果不会重新发送；旧的不含请求身份的记录仍保持锁定。"
          }
        }
      }
    },
    "roleAssign.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading original receipts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取原始回执…"
          }
        }
      }
    },
    "roleAssign.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt unavailable. Saved unknown intents are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法读取回执。已保存的未知请求仍保留。"
          }
        }
      }
    },
    "roleAssign.applied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original assignment confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认原委派结果"
          }
        }
      }
    },
    "roleAssign.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome unknown — do not submit again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知 — 请勿再次提交"
          }
        }
      }
    },
    "roleAssign.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未发送"
          }
        }
      }
    },
    "roleAssign.reconcile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read receipts and refresh roles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取回执并刷新角色"
          }
        }
      }
    },
    "roleAssign.unconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical receipt reading is not configured for this scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此范围尚未配置历史回执读取。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
