{
  "sourceLanguage": "en",
  "strings": {
    "projectTeamConfiguration.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme team settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题组队设置"
          }
        }
      }
    },
    "projectTeamConfiguration.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These team settings can't be edited here. Reload the editor before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组队设置无法在此编辑，请重新载入编辑器后继续。"
          }
        }
      }
    },
    "projectTeamConfiguration.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when players can form a team for this topic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置玩家何时可以组队。"
          }
        }
      }
    },
    "projectTeamConfiguration.mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team entry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组队入口"
          }
        }
      }
    },
    "projectTeamConfiguration.modeOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "projectTeamConfiguration.modeAtRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报名时组队"
          }
        }
      }
    },
    "projectTeamConfiguration.modeAfterRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite after registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报名后邀请"
          }
        }
      }
    },
    "projectTeamConfiguration.maximum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum selectable team size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选队伍人数上限"
          }
        }
      }
    },
    "projectTeamConfiguration.defaults": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default teams are off, up to 4 players."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认不开启组队，最多 4 人。"
          }
        }
      }
    },
    "projectTeamConfiguration.capacityScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not change ticket pricing, ticket team size, or any existing team membership."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处不会修改门票价格、门票组队人数或现有队伍成员。"
          }
        }
      }
    },
    "projectTeamConfiguration.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor changed. Reopen team settings from the current draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器已发生变化，请从当前草稿重新打开组队设置。"
          }
        }
      }
    },
    "projectTeamConfiguration.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "projectTeamConfiguration.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到草稿"
          }
        }
      }
    }
  },
  "version": "1.0"
}
