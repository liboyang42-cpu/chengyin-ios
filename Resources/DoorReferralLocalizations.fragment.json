{
  "sourceLanguage": "en",
  "strings": {
    "door.inviter.once": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inviter can only be bound once. Check the code before confirming."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请人只能绑定一次，请确认邀请码无误后再提交。"
          }
        }
      }
    },
    "door.inviter.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请人编号"
          }
        }
      }
    },
    "door.inviter.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review binding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认绑定信息"
          }
        }
      }
    },
    "door.inviter.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind inviter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写邀请人"
          }
        }
      }
    },
    "door.inviter.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind this inviter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定此邀请人"
          }
        }
      }
    },
    "door.inviter.remoteFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not bind. The code may not exist, or you may already have an inviter. Binding is one-time; retrying will not change this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能绑定。可能这个邀请码不存在，也可能你之前已经绑过邀请人了。邀请人只能绑一次，重试不会有变化。"
          }
        }
      }
    },
    "door.inviter.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid inviter ID other than your own. Sign in first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录，输入有效的邀请人编号，不能填写自己的编号。"
          }
        }
      }
    },
    "door.inviter.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Do not submit again; this attempt is locked to your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚不确定，请勿重复提交，此次操作已锁定在当前账号。"
          }
        }
      }
    },
    "door.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is not enabled in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本尚未启用此功能。"
          }
        }
      }
    },
    "door.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "door.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "door.resolving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening entry…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开入口…"
          }
        }
      }
    },
    "door.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code cannot be opened right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张码暂时打不开"
          }
        }
      }
    },
    "door.fixture.offline": {
      "localizations": {
