{
  "sourceLanguage": "en",
  "strings": {
    "topicReview.sources.capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check selected merchant details and prepare for review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对所选商家信息并准备提交审核"
          }
        }
      }
    },
    "topicReview.sources.captured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These merchant confirmations are included in your review request. Whether it's approved will be decided during review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下商家确认信息已包含在本次审核申请中，是否通过以审核结果为准。"
          }
        }
      }
    },
    "topicReview.sources.confirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的事实确认"
          }
        }
      }
    },
    "topicReview.sources.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the saved shop confirmation for each merchant draft. The server will check the current content, shop facts and ownership before preparing your review request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每份商家草稿选择已保存的店内事实确认。准备审核请求前，服务端会重新核验当前内容、店内事实及权属。"
          }
        }
      }
    },
    "topicReview.sources.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft has no verified saved shop confirmation. Confirm its facts before requesting a review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份草稿尚无核验通过的店内事实确认。请先确认事实，再申请审核。"
          }
        }
      }
    },
    "topicReview.sources.older": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the eight most recent saved confirmations for this draft. Older confirmations are not shown here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处显示这份草稿最近保存的八条事实确认，不展示更早记录。"
          }
        }
      }
    },
    "topicReview.sources.selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择"
          }
        }
      }
    },
    "topicReview.sources.template": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家草稿"
          }
        }
      }
    }
  },
  "version": "1.0"
}
