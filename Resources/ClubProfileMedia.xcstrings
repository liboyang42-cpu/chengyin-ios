{
  "sourceLanguage": "en",
  "strings": {
    "media.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部图片"
          }
        }
      }
    },
    "media.selectLogo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose logo · 1:1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Logo · 1:1"
          }
        }
      }
    },
    "media.selectCover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose cover · 16:9"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择封面 · 16:9"
          }
        }
      }
    },
    "media.staged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is uploaded and staged. Club details have not been saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已上传并暂存；尚未保存俱乐部资料。"
          }
        }
      }
    },
    "media.discard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this image change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销此图片更改"
          }
        }
      }
    },
    "media.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image selection and upload have not been separately enabled. Existing images will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片选择和上传尚未单独启用；已有图片会保留。"
          }
        }
      }
    },
    "media.uploadHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload the cropped image to your account, then return to the original details form to save. Uploading does not save club details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传裁切后的图片到本人账号，再回到原资料表单保存。上传不等于资料已保存。"
          }
        }
      }
    },
    "media.upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload and stage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传并暂存"
          }
        }
      }
    },
    "media.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting lookup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待查询"
          }
        }
      }
    },
    "media.readReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original image review and stage the approved image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询原图片审核并暂存已通过图片"
          }
        }
      }
    },
    "media.retryReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resubmit this image for review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新提交这张图片审核"
          }
        }
      }
    },
    "media.reviewHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file will not be uploaded again. The review result does not confirm a club details save or the current public state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会重复上传原文件。审核结果不是俱乐部资料保存或当前公开状态。"
          }
        }
      }
    },
    "media.album": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from photo library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册选择"
          }
        }
      }
    },
    "media.camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照"
          }
        }
      }
    },
    "media.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload result is unconfirmed. It will not be retried automatically. Reopening keeps the protection lock for this account, club and image field."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传结果未确认。不会自动重传；重新打开仍保留该账号、俱乐部及图片位置的保护锁。"
          }
        }
      }
    },
    "media.revoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload authentication or permission is no longer valid. The original upload protection lock has not been cleared. Confirm your identity again before checking the known original asset. Uploads will not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传认证或权限已失效。未据此清除原上传保护锁；请重新确认身份后查询已知的原资产，不会自动重传。"
          }
        }
      }
    },
    "media.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image was not sent. Select it again to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片未发送，请重新选择后重试。"
          }
        }
      }
    },
    "media.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload was rejected. The original club image is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传被拒绝；原俱乐部图片未变。"
          }
        }
      }
    },
    "media.uploaded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is staged. Return to the details form to review and save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已暂存。请回到资料表单检查并保存。"
          }
        }
      }
    },
    "media.logo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo · 1:1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo · 1:1"
          }
        }
      }
    },
    "media.cover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover · 16:9"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封面 · 16:9"
          }
        }
      }
    },
    "media.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "media.unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be read. Choose a standard image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这张图片，请选择普通图片。"
          }
        }
      }
    },
    "media.asset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your uploaded asset #%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人上传资产 #%@ · %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
