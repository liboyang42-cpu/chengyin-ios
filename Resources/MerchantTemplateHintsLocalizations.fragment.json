  "merchant.hints.unsupported": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This completion method does not support hint editing. Existing hints are preserved until you explicitly disable them or switch to a supported method."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "当前完成方式不支持编辑提示。已有提示会保留，直到你明确关闭提示或切换到支持的完成方式。"
        }
      }
    }
  },
  "merchant.hints.methodConflict": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This completion method does not support enabled hints. Switch back or explicitly disable hints before saving."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "当前完成方式不支持已启用的提示。请换回支持的方式，或明确关闭提示后再保存。"
        }
      }
    }
  },
  "merchant.hints.clearHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Disabling hints empties all three fields. Saving an empty field clears that saved text; review the changes before confirming."
        }
