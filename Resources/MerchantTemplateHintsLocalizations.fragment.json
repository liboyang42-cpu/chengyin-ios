    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Hints are supported for written answers, multiple-choice questions and GPS arrival. Only the three text fields are saved."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
