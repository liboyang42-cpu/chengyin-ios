{
  "sourceLanguage": "en",
  "strings": {
    "cityRules.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published public rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布公开规则"
          }
        }
      }
    },
    "cityRules.entry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read published rules and participation requirements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已发布规则与参与要求"
          }
        }
      }
    },
    "cityRules.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the complete published rule text and the public policies from this exact frozen version. Viewing them does not join a team, accept an offer or authorize any game action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整查看当前冻结版本的已发布规则原文与公开政策。查看不会加入队伍、接受报价或授权任何游戏动作。"
          }
        }
      }
    },
    "cityRules.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading current rules…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前规则…"
          }
        }
      }
    },
    "cityRules.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh this version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新当前版本"
          }
        }
      }
    },
    "cityRules.back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to selected board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回已选棋盘"
          }
        }
      }
    },
    "cityRules.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact published version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前发布版本"
          }
        }
      }
    },
    "cityRules.eligibility.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current participation facts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人的当前参与状态"
          }
        }
      }
    },
    "cityRules.noActionGrant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team confirmation is not permission to act. Each action still requires its own current rules, evidence, budget and explicit confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍确认不等于获准执行动作。每项动作仍须检查其当前规则、证据、预算及明确确认。"
          }
        }
      }
    },
    "cityRules.excluded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private budgets, permission matrices, source references, hidden targets, answer keys and verification settings are not disclosed here. This is not a personal quote. Monetary amounts are shown in their published minor currency units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页不公开内部资金预算、权限矩阵、来源引用、隐藏目标、答案或校验设置。这里不是个人报价；货币金额按已发布的最小货币单位显示。"
          }
        }
      }
    },
    "cityRules.phase.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published rules are unavailable. No cached rule text or eligibility is being used. Return to the board and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布规则暂不可用，不会使用缓存规则或旧资格。请返回棋盘后重试。"
          }
        }
      }
    },
    "cityRules.phase.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board, release or your participation has changed. Return to refresh and explicitly select the current board if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘、规则版本或本人参与状态已变化。请返回刷新，必要时重新明确选择当前棋盘。"
          }
        }
      }
    },
    "cityRules.phase.notPublished": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no current published board. Return to the board selector."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有已发布棋盘，请返回棋盘选择页。"
          }
        }
      }
    },
    "cityRules.phase.accessWithdrawn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to these rules has been withdrawn. Previous content has been cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前规则读取权限已失效，旧内容已清除。"
          }
        }
      }
    },
    "cityRules.disclosure.NOT_CONFIGURED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This optional policy is not configured in this frozen version. No default is assumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前冻结版本未配置此可选政策，不推断默认值。"
          }
        }
      }
    },
    "cityRules.disclosure.NOT_PUBLISHED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version does not publish an effective start/end interval. Being readable now does not establish permanent validity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本未发布生效起止时段；当前可读不代表永久有效。"
          }
        }
      }
    },
    "cityRules.disclosure.INTERNAL_BUDGET_ONLY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current schema stores internal settlement budgets, not public player settlement terms. This does not establish an available settlement service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前结构仅保存内部结算预算，未提供可公开的玩家结算条款；不代表已开放结算服务。"
          }
        }
      }
    },
    "cityRules.disclosure.CONTEXTUAL_READ_ONLY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the existing task or map entry for currently permitted details. This rules page does not reveal hidden content or grant access to a location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从现有任务或地图入口查看当前获准的详情。规则页不会解锁隐藏内容或授予现实地点进入权。"
          }
        }
      }
    },
    "cityRules.eligibility.NOT_CONFIGURED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No published participation policy is configured for this board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前棋盘未配置已发布参与政策。"
          }
        }
      }
    },
    "cityRules.eligibility.PREVIOUS_RELEASE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your retained participation belongs to a different release. It cannot authorize participation under these rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人保留的参与记录属于其他发布版本，不能用来取得当前规则下的参与资格。"
          }
        }
      }
    },
    "cityRules.eligibility.NO_QUALIFICATION": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No participation record exists for you in this published round. Reading this page will not create one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人在当前已发布回合中没有参与记录；查看本页不会自动创建记录。"
          }
        }
      }
    },
    "cityRules.eligibility.ABSENT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are currently absent from the original participation unit. The published reentry policy still applies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人当前已退出原参与单元；重进仍须遵守已发布的原会话恢复政策。"
          }
        }
      }
    },
    "cityRules.eligibility.FORMING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The team roster is still forming. The captain must lock it before members can confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍仍在组建。须先由队长锁定名单，再由成员各自确认。"
          }
        }
      }
    },
    "cityRules.eligibility.CONFIRMATION_REQUIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The roster is locked, but your personal confirmation is still required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍名单已锁定，但本人尚未完成确认。"
          }
        }
      }
    },
    "cityRules.eligibility.TEAM_WAITING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your personal confirmation is recorded, but the team is not currently ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人已确认，但队伍当前尚未就绪。"
          }
        }
      }
    },
    "cityRules.eligibility.MEMBERSHIP_CONFIRMED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your membership and the current team session are confirmed. This is not a gameplay authorization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人参与记录与当前队伍会话已确认。这不构成游戏动作授权。"
          }
        }
      }
    },
