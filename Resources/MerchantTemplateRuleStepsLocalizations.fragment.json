  "merchant.ruleSteps.limits": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Add up to 12 steps, with 60 characters per step. Existing longer rules are kept until you edit them."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "最多添加 12 步，每步 60 字。已有超限规则在编辑前保留原文。"
        }
      }
    },
    "extractionState": "manual"
  },
  "merchant.ruleSteps.emptyHint": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Blank steps are omitted. Clearing every step clears the saved instructions after you confirm."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "空步骤不会写入。清空所有步骤并确认保存后，会清除已保存的玩法规则。"
        }
      }
    },
    "extractionState": "manual"
