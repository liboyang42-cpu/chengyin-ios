    "localDraft.field.cover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封面"
          }
        },
        "zh-Hant": {
