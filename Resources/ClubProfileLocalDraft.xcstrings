        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介紹"
          }
        }
      }
    },
    "localDraft.field.logo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像"
          }
        }
      }
