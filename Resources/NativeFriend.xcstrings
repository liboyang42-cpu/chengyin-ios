{
  "sourceLanguage": "en",
  "strings": {
    "friend.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        }
      }
    },
    "friend.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends aren't available for this account right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该账号暂时无法使用好友功能。"
          }
        }
      }
    },
    "friend.storageFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this request. Don't send it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请保存失败，请勿重复发送。"
          }
        }
      }
    },
    "friend.loadFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load friends. Pull down to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友加载失败，请下拉重试。"
          }
        }
      }
    },
    "friend.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm your last request. Check the result before sending again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次申请结果未确认，请先查看结果，不要重复发送。"
          }
        }
      }
    },
    "friend.recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看结果"
          }
        }
      }
    },
    "friend.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the member ID and message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查会员 ID 和验证消息。"
          }
        }
      }
    },
    "friend.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request wasn't sent. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请未发送，请重试。"
          }
        }
      }
    },
    "friend.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request has changed. Refresh before acting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请状态已变化，请先刷新后操作。"
          }
        }
      }
    },
    "friend.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't go through. Pull down to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未成功，请下拉刷新。"
          }
        }
      }
    },
    "friend.noConversation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have a chat with this friend yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你和对方还没有聊天。"
          }
        }
      }
    },
    "friend.peer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会员 ID"
          }
        }
      }
    },
    "friend.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say hello (up to 60 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打个招呼（最多60字）"
          }
        }
      }
    },
