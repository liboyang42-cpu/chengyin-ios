{
  "sourceLanguage": "en",
  "strings": {
    "friend.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends and requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友与申请"
          }
        }
      }
    },
    "friend.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend requests are not available for this account yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号暂未开放好友申请。"
          }
        }
      }
    },
    "friend.storageFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending request could not be safely saved or recovered. Do not send it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请状态无法安全保存或恢复，请勿重复发送。"
          }
        }
      }
    },
    "friend.loadFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not refresh the latest result. Refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法刷新最新结果，请稍后刷新。"
          }
        }
      }
    },
    "friend.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not yet confirmed. Check the original request instead of sending again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认，请查询原申请，不要重复发送。"
          }
        }
      }
    },
    "friend.recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询原请求结果"
          }
        }
      }
    },
    "friend.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the member ID and message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查会员 ID 和验证消息。"
          }
        }
      }
    },
    "friend.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was not sent. Check your account and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未发送，请检查账号后重试。"
          }
        }
      }
    },
    "friend.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request has changed. Refresh before acting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请状态已变化，请先刷新后操作。"
          }
        }
      }
    },
    "friend.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was not accepted. Refresh to check the current relationship."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未被接受，请刷新查看当前关系。"
          }
        }
      }
    },
    "friend.noConversation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no available existing conversation. This entry does not create a new chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可进入的现有会话，此入口不会新建聊天。"
          }
        }
      }
    },
    "friend.peer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会员 ID"
          }
        }
      }
    },
    "friend.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification message (1–60 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证消息（1～60 字）"
          }
        }
      }
    },
    "friend.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send friend request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送好友申请"
          }
        }
      }
    },
    "friend.new": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a friend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加好友"
          }
        }
      }
    },
    "friend.result": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest relationship"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新关系"
          }
        }
      }
    },
    "friend.emptyIncoming": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No incoming requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无收到的申请"
          }
        }
      }
    },
    "friend.emptyOutgoing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No outgoing requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无发出的申请"
          }
        }
      }
    },
    "friend.emptyFriends": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No friends to show"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无好友"
          }
        }
      }
    },
    "friend.incoming": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的申请"
          }
        }
      }
    },
    "friend.outgoing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出的申请"
          }
        }
      }
    },
    "friend.friends": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        }
      }
    },
    "friend.accept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        }
      }
    },
    "friend.reject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "friend.withdraw": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回"
          }
        }
      }
    },
    "friend.more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更多"
          }
        }
      }
    },
    "friend.openChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有会话"
          }
        }
      }
    },
    "friend.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非好友"
          }
        }
      }
    },
    "friend.accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已成为好友"
          }
        }
      }
    },
    "friend.incomingState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你的处理"
          }
        }
      }
    },
    "friend.outgoingState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for their response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待对方处理"
          }
        }
      }
    },
    "friend.sessionExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in has expired. Sign in again; this request was not applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已失效，请重新登录；本次操作未执行。"
          }
        }
      }
    },
    "friend.review.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application reviews (private)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请审核记录（仅本人可见）"
          }
        }
      }
    },
    "friend.review.PENDING_REVIEW": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received for human review; not yet sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收件，等待人工审核，尚未发送给对方"
          }
        }
      }
    },
    "friend.review.APPLIED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed and delivered; see current relationship"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核通过，申请已投递；关系以当前结果为准"
          }
        }
      }
    },
    "friend.review.REJECTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application text was not approved; edit and apply again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请文字未通过审核，可修改后重新申请"
          }
        }
      }
    },
    "friend.review.CANCELLED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review withdrawn; not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审申请已撤回，未发送给对方"
          }
        }
      }
    },
    "friend.review.EXPIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review expired; not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待审申请已过期，未发送给对方"
          }
        }
      }
    },
    "friend.review.INVALIDATED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligibility changed; not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请条件已变化，未发送给对方"
          }
        }
      }
    },
    "friend.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review friend request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅好友申请"
          }
        }
      }
    },
    "friend.confirmVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请版本"
          }
        }
      }
    },
    "friend.confirm.request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this message to this member?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向这位会员发送这条申请？"
          }
        }
      }
    },
    "friend.confirm.accept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept this exact application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过这一个版本的申请？"
          }
        }
      }
    },
    "friend.confirm.reject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline this exact application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝这一个版本的申请？"
          }
        }
      }
    },
    "friend.confirm.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw this exact application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回这一个版本的申请？"
          }
        }
      }
    },
    "friend.confirmContinue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
    "friend.confirmCancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back without changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回，不作更改"
          }
        }
      }
    },
    "friend.reciprocalNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this member has already applied to you, sending your request can make you friends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果对方已经向你申请，发送申请可能会直接成为好友。"
          }
        }
      }
    },
    "friend.retryOriginal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the original request (check its result first)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原申请重试（先查询原结果）"
          }
        }
      }
    },
    "friend.defaultGroup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认分组"
          }
        }
      }
    },
    "friend.teamInvites": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My team invitations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的原队伍邀请"
          }
        }
      }
    },
    "friend.channelInvites": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My channel invitations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的原频道邀请"
          }
        }
      }
    },
    "friend.channelRecoveryHome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Friends and check the original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开好友首页，查看原请求"
          }
        }
      }
    }
  },
  "version": "1.0"
}
