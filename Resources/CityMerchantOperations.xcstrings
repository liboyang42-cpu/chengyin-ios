{
  "sourceLanguage": "en",
  "strings": {
    "cityMerchant.entry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My store: CITY access and pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店 CITY 接入与暂停"
          }
        }
      }
    },
    "cityMerchant.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My store: CITY access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店 CITY 接入"
          }
        }
      }
    },
    "cityMerchant.merchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门店"
          }
        }
      }
    },
    "cityMerchant.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fact version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事实版本"
          }
        }
      }
    },
    "cityMerchant.state.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operational fact: paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经营事实：暂停"
          }
        }
      }
    },
    "cityMerchant.state.inherit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operational fact: follows platform rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经营事实：沿用平台规则"
          }
        }
      }
    },
    "cityMerchant.board": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布棋盘"
          }
        }
      }
    },
    "cityMerchant.rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules release"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则发布"
          }
        }
      }
    },
    "cityMerchant.reload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取"
          }
        }
      }
    },
    "cityMerchant.intent.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit my store’s intention"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交本店意愿"
          }
        }
      }
    },
    "cityMerchant.reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写原因"
          }
        }
      }
    },
    "cityMerchant.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a pause for my store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请暂停本店"
          }
        }
      }
    },
    "cityMerchant.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request restoration for my store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请恢复本店"
          }
        }
      }
    },
    "cityMerchant.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting creates a request only. Authorized review and application of the operational fact come later. This does not confirm that gameplay has been paused or restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交只是申请。授权审查与事实生效是后续步骤，不能据此认定游戏运行已暂停或恢复。"
          }
        }
      }
    },
    "cityMerchant.original": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求"
          }
        }
      }
    },
    "cityMerchant.recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original request only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只查询原请求结果"
          }
        }
      }
    },
    "cityMerchant.receipt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对回执"
          }
        }
      }
    },
    "cityMerchant.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to brand center"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回品牌中心"
          }
        }
      }
    },
    "cityMerchant.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this intention for my store?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认提交本店意愿？"
          }
        }
      }
    },
    "cityMerchant.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "cityMerchant.confirm.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm submission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认提交"
          }
        }
      }
    },
    "cityMerchant.confirm.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请暂停"
          }
        }
      }
    },
    "cityMerchant.confirm.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request restoration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请恢复"
          }
        }
      }
    },
    "cityMerchant.confirm.detail %@ %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store: %1$@\nVersion: %2$@\nReason: %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门店：%1$@\n版本：%2$@\n原因：%3$@"
          }
        }
      }
    },
    "cityMerchant.confirm.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes only my store’s operational intention and awaits authorized review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改本店经营意愿，等待授权审查。"
          }
        }
      }
    },
    "cityMerchant.status.initial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My store’s CITY access has not been loaded yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取本店 CITY 接入关系"
          }
        }
      }
    },
    "cityMerchant.status.checkInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your store’s status, authorization and reason."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认本店状态、授权和申请原因"
          }
        }
      }
    },
    "cityMerchant.status.left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left this page. Refresh before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面已离开，请重新读取"
          }
        }
      }
    },
    "cityMerchant.status.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CITY access for this store is not yet approved for deployment and is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店 CITY 接入尚未获部署审批，暂不可用"
          }
        }
      }
    },
    "cityMerchant.status.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous result needs checking. Only the original request will be queried, never resent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次提交结果待核对，仅查询原请求，不会重发"
          }
        }
      }
    },
    "cityMerchant.status.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This confirmation has expired. Refresh and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认已过期，请重新读取"
          }
        }
      }
    },
    "cityMerchant.status.recoverFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original request first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先核对原请求"
          }
        }
      }
    },
    "cityMerchant.status.submitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request submitted. Checking its original receipt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请已提交，正在核对原请求回执"
          }
        }
      }
    },
    "cityMerchant.status.notApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request did not take effect. Refresh your store’s status before confirming a new request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申请未生效。请重新读取本店状态后确认新申请"
          }
        }
      }
    },
    "cityMerchant.status.journalFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request was checked, but its local receipt is not saved. Do not submit again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申请已核对，但本地回执尚未保存，请勿重复提交"
          }
        }
      }
    },
    "cityMerchant.status.contextChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account, authorization or approval has changed. Reopen this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号、授权或审批已变化，请重新进入"
          }
        }
      }
    },
    "cityMerchant.status.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in has expired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已失效"
          }
        }
      }
    },
    "cityMerchant.status.accessWithdrawn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your store access has been withdrawn. You cannot continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店权限已撤回，不能继续操作"
          }
        }
      }
    },
    "cityMerchant.status.readFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to load right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取，请稍后重试"
          }
        }
      }
    },
    "cityMerchant.status.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The submission result is still unknown. Only check the original request; do not send it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交结果仍未知。只能查询原请求，不能重复发送"
          }
        }
      }
    },
    "cityMerchant.status.sourceMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid published store relation or location permission is available. Submission is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无有效的已发布本店关联或地点许可，不能提交"
          }
        }
      }
    },
    "cityMerchant.status.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your store’s intention is recorded and awaits authorized review. Runtime state has not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店意愿已记录，等待授权审查；尚未改变运行状态"
          }
        }
      }
    },
    "cityMerchant.status.applied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your store’s operational fact is updated. CITY runtime integration is not yet complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店运营事实已更新；CITY 运行层接入尚未完成"
          }
        }
      }
    },
    "cityMerchant.status.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was not approved. The existing operational fact is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请未获批准，原经营事实保持不变"
          }
        }
      }
    },
    "cityMerchant.status.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may request a pause or restoration for your store only. Rates, rules and other teams’ assets will not change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可申请本店暂停或恢复，不会修改费率、规则或其他队伍资产"
          }
        }
      }
    },
    "cityMerchant.status.knownCurrentUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original submission result is known, but the current store fact could not be read. Check the original request again; do not submit another intent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原提交结果已明确，但当前门店事实读取未完成。请继续核对原请求，不要重复提交意愿。"
          }
        }
      }
    },
    "cityMerchant.receipt.recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the original submission result, not approval or proof that CITY runtime has paused. Current operational facts are shown separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是原提交回执，不代表已获批准或 CITY 运行层已暂停。当前经营事实另行显示。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
