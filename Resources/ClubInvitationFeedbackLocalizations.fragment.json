    "club.inviteFeedback.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club invitations and feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合作邀约与反馈"
          }
        }
      }
