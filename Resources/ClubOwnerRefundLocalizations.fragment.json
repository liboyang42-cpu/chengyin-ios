    "club.refund.scopeWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source policy may cancel linked tickets in the same order. A refund amount is not quoted here; an already checked-in ticket may require manual review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源政策可能影响同单关联票。这里不承诺退款金额；同单有票已核销时可能转人工处理。"
          }
