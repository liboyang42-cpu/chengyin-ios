    "club.refund.policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation, cash payout and points return are separate outcomes. Eligibility and refunds follow the policy frozen at purchase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报名取消、现金到账与积分返还是不同结果。资格与退款按购买时冻结的政策执行。"
          }
        }
      }
    },
