    "playStoreDay.modal.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For on-site queueing and redemption, you agree to share your name, avatar, arrival/redemption status and registration phone number with “%@”. No other store is authorized, and you can withdraw at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为现场叫号与核销，同意向「%@」提供你的姓名、头像、到店/核销状态和报名手机号。不会授权其他门店，可随时撤回。"
          }
        }
      }
    },
    "playStoreDay.modal.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意并继续"
          }
        }
      }
    },
    "playStoreDay.modal.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize this store only"
