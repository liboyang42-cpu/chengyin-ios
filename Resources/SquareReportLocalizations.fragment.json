  "squareReport.noAttachments": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Text only. Attachments aren't supported for reports."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "仅可提交文字，举报暂不支持附件。"
        }
      }
    }
  },
  "squareReport.noRemoval": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A received report is not a moderation decision and does not mean the content was removed."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "收到举报不等于作出处置决定，也不代表内容已下架。"
        }
      }
    }
  },
  "squareReport.synthetic": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Example report. Reasons, cases and outcomes aren't real; nothing is sent."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "举报示例。原因、案件与结果均非真实，不会实际发送。"
        }
      }
    }
  },
  "squareReport.boundary": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Reporting isn't available right now."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "举报暂不可用。"
        }
      }
    }
  },
  "squareReport.emergency": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "If someone is in immediate danger, contact local emergency services. This report is not an emergency response channel."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "如有人正面临紧急危险，请联系当地紧急救助服务。举报不是紧急救援渠道。"
        }
      }
    }
  },
  "squareReport.sourceLabels": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
