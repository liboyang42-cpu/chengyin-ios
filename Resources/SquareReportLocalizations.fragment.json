  "squareReport.noAttachments": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Text only. Evidence attachments are not supported by this report contract."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "仅可提交文字。此举报接口暂不支持证据附件。"
        }
      }
    }
  },
  "squareReport.noRemoval": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A received report is not a moderation decision and does not mean the content was removed."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "收到举报不等于作出处置决定，也不代表内容已下架。"
        }
      }
    }
  },
  "squareReport.synthetic": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Offline report example. Reasons, cases and outcomes are synthetic; nothing is sent externally."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "离线举报示例。原因、案件与结果为模拟数据，不会向外部发送。"
        }
      }
    }
  },
  "squareReport.boundary": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Reporting is not enabled for this service. Policy reads and report submissions remain disabled."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此服务尚未开放举报。举报规则读取和提交均保持关闭。"
        }
      }
    }
  },
  "squareReport.emergency": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "If someone is in immediate danger, contact local emergency services. This report is not an emergency response channel."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "如有人正面临紧急危险，请联系当地紧急救助服务。举报不是紧急救援渠道。"
        }
      }
    }
  },
  "squareReport.sourceLabels": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The exact policy labels are shown. English translations are supplementary."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "展示服务端规则原文；英文翻译仅作辅助说明。"
        }
      }
    }
  },
  "squareReport.reviewWarning": {
    "localizations": {
      "en": {
        "stringUnit": {
