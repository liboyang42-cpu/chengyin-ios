      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This legacy action toggles the current post like once. An unconfirmed result remains locked."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "旧版接口会切换一次当前动态点赞状态，结果未确认时继续保持锁定。"
