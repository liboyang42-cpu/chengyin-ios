  "squareReport.locked": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This content has a submitted or unconfirmed report. Another submission is locked to avoid duplicates. Closing, relaunching or signing in again does not retry it."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此内容已有已提交或结果未确认的举报。为防重复，已锁定再次提交；关闭、重启或重新登录都不会重试。"
        }
      }
    }
  },
  "squareReport.stale": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The content or report policy changed. Check the latest details and select a reason again. Nothing was submitted."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "内容或举报规则已变化。请核对最新信息并重新选择原因，尚未提交任何内容。"
        }
      }
    }
  },
  "squareReport.invalid": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Choose a valid reason and enter a description of no more than 2,000 UTF-16 units. You cannot report your own comment."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请选择有效原因并填写不超过2000个UTF-16单元的说明；不能举报自己的评论。"
        }
      }
    }
  },
  "squareReport.rejected": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
