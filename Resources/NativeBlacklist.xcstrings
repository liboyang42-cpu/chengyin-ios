    "blacklist.settleTitle": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel this unblock?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消这次解除拉黑?"}}}},
    "blacklist.settleConfirm": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel unblock"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消解除拉黑"}}}},
    "blacklist.settleImpact": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "If it already went through, you'll see the result. Otherwise nothing changes."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "如果已经生效，会显示结果；否则不做任何更改。"}}}},
    "blacklist.applied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unblocked"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已解除拉黑"}}}},
    "blacklist.rejected": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not unblocked"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未解除拉黑"}}}},
    "blacklist.historical": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This is the historical result. The current state below is read independently."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这是原请求的历史结果。下方当前状态来自独立重新读取。"}}}},
