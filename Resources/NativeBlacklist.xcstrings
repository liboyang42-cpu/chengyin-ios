{
  "sourceLanguage": "en",
  "strings": {
    "blacklist.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Blocked people"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "黑名单"}}}},
    "blacklist.ownerOnly": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Manage only people you blocked, even without a conversation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅管理你主动拉黑的用户，与现有会话无关。"}}}},
    "blacklist.noRestore": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unblocking does not restore friendship, meetups or location sharing, or open a new chat."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "解除拉黑不会自动恢复好友、约见或位置共享，也不会开启新会话。"}}}},
    "blacklist.closed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Blacklist management is unavailable or this access has expired."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "黑名单管理暂未开放，或本次访问授权已失效。"}}}},
    "blacklist.empty": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "You have not blocked anyone."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "你还没有拉黑任何人。"}}}},
    "blacklist.review": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Review unblock"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看解除确认"}}}},
    "blacklist.more": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Load more"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "加载更多"}}}},
    "blacklist.confirmImpact": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Remove only your block of this exact person. Their block and platform restrictions remain unchanged. Check the person and original record."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "只解除你对这位用户的拉黑。对方的拉黑和平台限制不受影响。请核对用户与原记录。"}}}},
    "blacklist.confirm": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Confirm unblock"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认解除拉黑"}}}},
    "blacklist.cancel": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消"}}}},
    "blacklist.retry": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Retry loading"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重新读取"}}}},
    "blacklist.storageFailure": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not safely save or read the original request. No new action was started."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法安全保存或读取原请求，未发起新操作。"}}}},
    "blacklist.readFailure": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not load blocked people. Please retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "黑名单读取失败，请重试。"}}}},
    "blacklist.moreFailure": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Could not load the next page. Current rows are retained; retry Load more."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "下一页读取失败，当前列表保留。可重试加载更多。"}}}},
    "blacklist.changed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This block record changed. Reload it before confirming."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这条拉黑记录已变化，请重新读取后确认。"}}}},
    "blacklist.notSent": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This action was not sent. Reload before confirming again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已确认本次操作未发送。请重新读取后确认。"}}}},
    "blacklist.unknown": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original result is unknown. Nothing will be resent automatically; the current block state does not prove the original outcome."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原请求结果待确认。不会自动重发，也不能用当前是否拉黑推断原结果。"}}}},
    "blacklist.recover": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check original result"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查询原请求结果"}}}},
    "blacklist.settle": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finalize unresolved request"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "结束未确认请求"}}}},
    "blacklist.settleTitle": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finalize this original request?"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认结束这个原请求？"}}}},
    "blacklist.settleConfirm": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Finalize without another unblock"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认结束，不重新解除"}}}},
    "blacklist.settleImpact": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "If already completed, return its original result. Otherwise finalize without a change and fence delayed submissions. Current relationships are not changed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "如原操作已完成，返回其原结果；否则记录不再执行，阻止迟到请求解除拉黑。此操作不会改变当前关系。"}}}},
    "blacklist.applied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Original request: unblocked"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原请求：已解除拉黑"}}}},
    "blacklist.rejected": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Original request: no unblock performed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原请求：未执行解除"}}}},
    "blacklist.historical": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This is the historical result. The current state below is read independently."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这是原请求的历史结果。下方当前状态来自独立重新读取。"}}}},
    "blacklist.currentBlocked": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Current state: you are blocking this person, possibly again since that request."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前状态：你仍在拉黑这位用户，或后来重新拉黑。"}}}},
    "blacklist.currentUnblocked": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Current state: you are not blocking this person."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前状态：你没有拉黑这位用户。"}}}},
    "blacklist.currentFailure": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original result is known, but current state could not be read. Please retry."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原结果已确认，但当前状态尚未读回，请重试。"}}}},
    "blacklist.listReadbackFailure": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The original result and this person’s current state are known, but the list refresh failed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "原结果和该用户当前状态已确认，但列表刷新失败。"}}}},
    "blacklist.refreshCurrent": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Refresh current state"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新当前状态"}}}},
    "blacklist.returnList": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Return and refresh blocked people"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "返回并刷新黑名单"}}}}
  },
  "version": "1.0"
}
