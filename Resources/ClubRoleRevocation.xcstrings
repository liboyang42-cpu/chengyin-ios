{
  "sourceLanguage": "en",
  "strings": {
    "roleRevoke.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Role revocation history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色撤销历史"
          }
        }
      }
    },
    "roleRevoke.history.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical receipts are separate from current roles. Unknown outcomes are never resent; old opaque intent markers remain locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史回执与当前角色分开。未知结果不会重新发送；旧的不含请求身份的记录仍保持锁定。"
          }
        }
      }
    },
    "roleRevoke.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading original receipts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取原始回执…"
          }
        }
      }
    },
    "roleRevoke.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt unavailable. Saved unknown intents are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法读取回执。已保存的未知请求仍保留。"
          }
        }
      }
    },
    "roleRevoke.applied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original revocation confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认原撤销结果"
          }
        }
      }
    },
    "roleRevoke.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome unknown — do not submit again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知 — 请勿再次提交"
          }
        }
      }
    },
    "roleRevoke.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未发送"
          }
        }
      }
    },
    "roleRevoke.reconcile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read receipts and refresh roles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取回执并刷新角色"
          }
        }
      }
    },
    "roleRevoke.unconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical receipt reading is not configured for this scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此范围尚未配置历史回执读取。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
