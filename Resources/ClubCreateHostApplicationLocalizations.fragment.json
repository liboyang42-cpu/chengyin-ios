{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "club.ops.leaderRequired.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Become a club leader first. Once approved you can create and manage clubs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先成为俱乐部主理人，申请通过后即可创建与管理俱乐部"
          }
        }
      }
    },
    "club.ops.applyHost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to application"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往申请"
          }
        }
      }
    },
    "club.ops.adminNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are an administrator · you can only edit display information"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是管理员 · 只能改展示信息"
          }
        }
      }
    },
    "club.ops.locked.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the host can change membership settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主理人能改经营配置"
          }
        }
      }
    },
    "club.ops.locked.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member priority signup · join approval · member reserved places — these decide how tickets are split and paid once sales open, so they stay with the host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员优先报名 · 入会需要审批 · 成员保留名额 —— 这三项直接决定开卖时票怎么分、钱怎么收,所以留给主理人。"
          }
        }
      }
    },
    "club.ops.locked.current": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前:"
          }
        }
      }
    },
    "club.ops.locked.priority.on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority signup on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先报名 已开"
          }
        }
      }
    },
    "club.ops.locked.priority.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority signup off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先报名 已关"
          }
        }
      }
    },
    "club.ops.locked.join.on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join approval on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会审批 已开"
          }
        }
      }
    },
    "club.ops.locked.join.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join approval off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会审批 已关"
          }
        }
      }
    },
    "club.ops.locked.quota %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 %lld 个"
          }
        }
      }
    }
  }
