{
  "sourceLanguage": "en",
  "strings": {
    "projectAlbumImage.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a photo from this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从设备添加照片"
          }
        }
      }
    },
    "projectAlbumImage.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo, crop it, upload it, then add it to this album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片并裁剪，上传后添加到这个相册。"
          }
        }
      }
    },
    "projectAlbumImage.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't add photos to this album right now. Albums hold up to six photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法向此相册添加照片，相册最多六张。"
          }
        }
      }
    },
    "projectAlbumImage.uploadScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload the photo, then add it to the album."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传照片后添加到相册。"
          }
        }
      }
    },
    "projectAlbumImage.append": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Append photo to this album"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追加照片到此相册"
          }
        }
      }
    },
    "projectAlbumImage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册照片"
          }
        }
      }
    }
  },
  "version": "1.0"
}
