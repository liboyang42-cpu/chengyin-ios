{
  "sourceLanguage": "en",
  "strings": {
    "preferenceRemoval.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review question and option removal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看问题和选项删除"
          }
        }
      }
    },
    "preferenceRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove questionnaire content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问卷内容"
          }
        }
      }
    },
    "preferenceRemoval.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected question or option is removed from this local draft. Tie-break questions and results stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从本地草稿删除所选问题或选项。平局判定题及结果保持原样。"
          }
        }
      }
    },
    "preferenceRemoval.minimum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one question and two options per question."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少保留一个问题，每个问题至少保留两个选项。"
          }
        }
      }
    },
    "preferenceRemoval.recheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores, references and result reachability may change. Run Check JSON again after removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除可能影响评分、引用和结果可达性。完成后请重新检查 JSON。"
          }
        }
      }
    },
    "preferenceRemoval.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this item?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此项？"
          }
        }
      }
    },
    "preferenceRemoval.confirmHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a question also removes its options. Cancel or close to keep the draft unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问题会同时删除其选项。取消或关闭不会修改草稿。"
          }
        }
      }
    },
    "preferenceRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from local draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地草稿删除"
          }
        }
      }
    },
    "preferenceRemoval.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "preferenceRemoval.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove question…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问题…"
          }
        }
      }
    },
    "preferenceRemoval.option": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove option…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除选项…"
          }
        }
      }
    },
    "preferenceRemoval.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "preferenceRemoval.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal is unavailable for this JSON or the review is no longer current. The source has not been changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 暂不支持删除，或当前预览已失效。原文未被修改。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
