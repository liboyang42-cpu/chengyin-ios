{
  "sourceLanguage": "en",
  "strings": {
    "preferenceRemoval.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review question and option removal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看问题和选项删除"
          }
        }
      }
    },
    "preferenceRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove questionnaire content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问卷内容"
          }
        }
      }
    },
    "preferenceRemoval.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this question or option is removed. Tie-break questions and results stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除所选问题或选项，平局题和结果保持不变。"
          }
        }
      }
    },
    "preferenceRemoval.minimum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one question and two options per question."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少保留一个问题，每个问题至少保留两个选项。"
          }
        }
      }
    },
    "preferenceRemoval.recheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scores and results may change. Check the questionnaire again afterwards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评分和结果可能变化，删除后请重新检查问卷。"
          }
        }
      }
    },
    "preferenceRemoval.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this item?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此项？"
          }
        }
      }
    },
    "preferenceRemoval.confirmHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a question also removes its options. Cancel or close to keep the draft unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问题会同时删除其选项。取消或关闭不会修改草稿。"
          }
        }
      }
    },
    "preferenceRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "preferenceRemoval.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "preferenceRemoval.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove question…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除问题…"
          }
        }
      }
    },
    "preferenceRemoval.option": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove option…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除选项…"
          }
        }
      }
    },
    "preferenceRemoval.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "preferenceRemoval.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be removed here. Nothing changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项无法在此删除，内容未改变。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
