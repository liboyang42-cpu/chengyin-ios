    "p23.confirm.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道 %@ · 消息 %@ · 版本 %@。仅取消置顶，不删除原消息；结果不明时只查询原请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel %@ · Message %@ · Version %@. This only unpins the message; it does not delete it. If the outcome is unknown, only look up the original request."
          }
        }
      }
    },
    "p23.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message or your permissions changed. Select it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息或权限已变化，请重新选择。"
