{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "source.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading channel messages…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载频道消息…"
          }
        }
      }
    },
    "access.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You no longer have access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已无法访问。"
          }
        }
      }
    },
    "request.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm your last change. Check its status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未确认上次操作的结果，请查看状态。"
