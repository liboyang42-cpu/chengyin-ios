          "stringUnit": {
            "state": "translated",
            "value": "待核原请求：%@ · %@ · 消息 %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request awaiting confirmation: %@ · %@ · Message %@"
          }
        }
      }
    },
    "p23.pending.explanation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前列表不能判定该请求是否执行；仅按原 UUID 查询回执，不重发。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current list cannot establish whether the request was applied. Look up its receipt using the original UUID; do not resend."
          }
        }
      }
    },
    "p23.applied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求结果：已确认 · %@ · 消息 %@"
