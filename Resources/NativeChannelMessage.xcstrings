          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看状态"
          }
        }
      }
    },
    "request.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your change wasn't saved. Your draft is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未成功，草稿已保留。"
