    "cityOnsite.historicalResultBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unique historical task result: the human evidence checked at that time and the actual answer judgment. It does not claim current presence if evidence or permission has expired. No automatic payment, points or operating-right effects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史唯一任务结果：记录当时核验的人工证据与实际答案判定。即使当前证据或权限已失效也不伪称当前到场；没有自动支付、积分或经营权效果。"
          }
        }
      }
    },
    "cityOnsite.originalResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unique original task result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一原任务结果"
          }
        }
      }
    },
    "cityOnsite.closeResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to task list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回任务列表"
          }
        }
