    "cityOnsite.originalRequestHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest original request is retained. Reopen reads its receipt and result only; it does not repeat the action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留最近一次原请求。重开只读原回执和原结果，不重复执行任务。"
          }
        }
      }
    },
    "cityOnsite.rejectionCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original rejection reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求拒绝原因"
          }
        }
      }
    },
    "cityOnsite.status.originalResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result verified. It is not current task eligibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核实原结果，不代表当前任务资格。"
          }
        }
      }
    },
    "cityOnsite.status.currentUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original receipt is verified, but current eligibility could not be read. No new action is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原回执已核实，但当前资格暂无法读取，不能开始新操作。"
          }
        }
      }
    },
    "cityOnsite.status.resultUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original receipt is verified. Its result could not be re-read; keep the original request and retry the read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原回执已核实，原结果暂未读回；已保留原请求，请重试读取。"
          }
        }
      }
    },
    "cityOnsite.status.journalUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original receipt is verified, but its recovery record could not be saved. New actions are blocked; retry the read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原回执已核实，但恢复记录暂无法保存；已阻止新操作，请重试读取。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
