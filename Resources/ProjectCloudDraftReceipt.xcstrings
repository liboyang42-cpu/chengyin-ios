    "status.deferredDraft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft markers retained · Not submitted for publication review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿标记已保留 · 未提交上线审核"
