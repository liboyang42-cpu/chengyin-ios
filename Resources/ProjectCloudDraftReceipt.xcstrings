{
  "sourceLanguage": "en",
  "strings": {
    "intent.ordinary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm submission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认提交"
          }
        }
      }
    },
    "intent.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm cloud draft save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认保存云草稿"
          }
        }
      }
    },
    "intent.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit cloud draft for review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认提交云草稿审核"
          }
        }
      }
    },
    "intent.saveExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the content entered so far as a private cloud draft. This does not publish it or submit it for publication review. Missing publication fields can remain blank."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已填写的内容保存为私有云草稿，不发布，也不提交上线审核。尚未填写的发布完整度字段可保留为空。"
          }
        }
      }
    },
    "intent.submitExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this server-confirmed cloud draft to its review flow. The server still checks access, completeness, media and review requirements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将服务器已确认的云草稿提交审核流程。权限、完整度、媒体和审核要求仍由服务器检查。"
          }
        }
      }
    },
    "cloud.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud draft saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云草稿已保存"
          }
        }
      }
    },
    "cloud.savedFact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request saved a cloud draft. It did not publish the project or grant review approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次请求已确认保存云草稿，未发布，也不代表审核已通过。"
          }
        }
      }
    },
    "cloud.projectID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目编号"
          }
        }
      }
    },
    "cloud.openProjects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen in My Projects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的项目中重新打开"
          }
        }
      }
    },
    "cloud.returnHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this draft from My Projects, or read its current detail before continuing to edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从我的项目打开此草稿，也可读取当前详情后继续编辑。"
          }
        }
      }
    },
    "action.saveCloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save cloud draft · Not published"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存云草稿 · 不发布"
          }
        }
      }
    },
    "action.submitDraft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit cloud draft for review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交云草稿审核"
          }
        }
      }
    },
    "action.refreshProcessing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh this request’s processing record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新本次请求的处理记录"
          }
        }
      }
    },
    "action.resumeProcessing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue unfinished processing · Do not resubmit project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续未完成的处理 · 不重新提交项目"
          }
        }
      }
    },
    "processing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this submission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次提交的后续处理"
          }
        }
      }
    },
    "processing.savedFact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project write is confirmed. These review and media records belong to this request; they do not confirm approval or publication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原项目写入已确认。以下审核与媒体记录关联本次请求，不代表项目已获批准或上线。"
          }
        }
      }
    },
    "processing.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The processing record is not available. The confirmed project write remains recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后续处理记录暂不可用，已确认的原项目写入事实仍保留。"
          }
        }
      }
    },
    "processing.spotCheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot-check record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抽检记录"
          }
        }
      }
    },
    "processing.auditID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit task ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核任务编号"
          }
        }
      }
    },
    "processing.association": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Association with this request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与本次请求的关联"
          }
        }
      }
