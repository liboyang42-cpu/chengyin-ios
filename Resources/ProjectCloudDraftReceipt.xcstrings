    },
    "risk.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No risk finding was provided in this record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本条记录未提供风险判定。"
          }
        }
