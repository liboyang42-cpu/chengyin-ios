        }
      }
    },
    "status.recorded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original processing record saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原处理记录已保存"
          }
        }
      }
    },
    "status.staleSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content changed · Previous processing was not continued"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已变化 · 未继续旧请求处理"
          }
        }
      }
    },
    "status.superseded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A later submission round exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有后续投稿轮次"
          }
