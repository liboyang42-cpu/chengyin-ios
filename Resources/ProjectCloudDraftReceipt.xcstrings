    },
    "risk.notMatched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original callback reported no risk match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原回调报告未命中风险。"
