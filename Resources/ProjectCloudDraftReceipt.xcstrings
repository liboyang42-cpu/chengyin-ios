    "status.recordedDecision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Associated review record read back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读回关联审核记录"
