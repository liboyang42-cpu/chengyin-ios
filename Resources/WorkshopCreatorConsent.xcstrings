{
  "sourceLanguage": "en",
  "strings": {
    "workshopCreator.open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明新包使用授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare package use permission"
          }
        }
      }
    },
    "workshopCreator.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创作者使用授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creator use permission"
          }
        }
      }
    },
    "workshopCreator.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务尚未配置。登录不会自动开启声明权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This service is not configured. Signing in does not enable declarations."
          }
        }
      }
    },
    "workshopCreator.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为本人原创文字包记录明确同意，等待包审核。现有购买条款保持原样。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record explicit consent for your original text package, pending package review. Existing purchases keep their original terms."
          }
        }
      }
    },
    "workshopCreator.source": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人玩法编号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your template ID"
          }
        }
      }
    },
    "workshopCreator.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        }
      }
    },
    "workshopCreator.request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次请求编号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request ID"
          }
        }
      }
    },
    "workshopCreator.exactSource": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本原文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact text for this version"
          }
        }
      }
    },
    "workshopCreator.textOnly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本只包含下列文字。请逐项核对原文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version contains only the text below. Review every field."
          }
        }
      }
    },
    "workshopCreator.omitted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本包未包含的规划资料"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planning information excluded from this package"
          }
        }
      }
    },
    "workshopCreator.selectVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择待声明版本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the intended version"
          }
        }
      }
    },
    "workshopCreator.noTarget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无可选择的包版本和完整条款。可以查看原文；完整条款可用后才能确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No package version with complete terms is available. You can review the source; confirmation requires complete terms."
          }
        }
      }
    },
    "workshopCreator.fullTerms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本完整条款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete terms for this version"
          }
        }
      }
    },
    "workshopCreator.offerVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报价版本标识"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer version reference"
          }
        }
      }
    },
    "workshopCreator.termsVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条款版本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms version"
          }
        }
      }
    },
    "workshopCreator.scope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开主题使用范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use in publicly operated themes"
          }
        }
      }
    },
    "workshopCreator.confirm.0": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对本版本全部原文、未包含资料和完整条款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I reviewed this version’s exact text, exclusions, and complete terms"
          }
        }
      }
    },
    "workshopCreator.confirm.1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明确允许买家在所展示条款范围内用于自己的公开主题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I explicitly allow buyers to use it in their own public themes within the displayed terms"
          }
        }
      }
    },
    "workshopCreator.confirm.2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此授权不含转售或再分发原包，不扩大旧购买授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This excludes resale or redistribution of the original package and does not expand past purchases"
          }
        }
      }
    },
    "workshopCreator.declare": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认并记录本次声明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and record this declaration"
          }
        }
      }
    },
    "workshopCreator.recorded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明已记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaration recorded"
          }
        }
      }
    },
    "workshopCreator.pendingReview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍需包审核，尚未上架或签发购买授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package review is still required. This is not a listing or an issued purchase license."
          }
        }
      }
    },
    "workshopCreator.package": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包标识"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package reference"
          }
        }
      }
    },
    "workshopCreator.version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "workshopCreator.record": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaration record"
          }
        }
      }
    },
    "workshopCreator.another": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成本次核对，审阅另一版本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this review and review another version"
          }
        }
      }
    },
    "workshopCreator.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新核对原文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh source review"
          }
        }
      }
    },
    "workshopCreator.checkStatus": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对此前声明结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the previous declaration"
          }
        }
      }
    },
    "workshopCreator.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认。已保留原请求编号，请先核对记录。未找到记录也不会自动重新声明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outcome is unconfirmed. The original request ID is retained. Check the record first; a missing record never causes an automatic resubmission."
          }
        }
      }
    },
    "workshopCreator.storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机恢复记录无法安全读取或保存，声明未继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local recovery record could not be safely read or saved. The declaration cannot continue."
          }
        }
      }
    },
    "workshopCreator.changed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号、权限或页面已变化，请返回后重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, permission, or presentation changed. Go back and open this page again."
          }
        }
      }
    },
    "workshopCreator.failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核对该原创文字源或声明记录。请刷新后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original text source or declaration could not be verified. Refresh to try again."
          }
        }
      }
    },
    "workshopCreator.field.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        }
      }
    },
    "workshopCreator.field.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简介"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        }
      }
    },
    "workshopCreator.field.ruleInstructions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则原文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules"
          }
        }
      }
