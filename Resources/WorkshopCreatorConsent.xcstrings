    "workshopCreator.field.answerReveal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案揭示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer reveal"
          }
        }
      }
    },
    "workshopCreator.omitted.categoryId": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类"
          }
        },
        "en": {
