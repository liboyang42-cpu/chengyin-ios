    "chapterReplacement.verified.application %lld": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Replacement invitation read back as PENDING, application %lld."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "补位邀请已回读确认（状态 PENDING，申请 %lld）。"}}}},
