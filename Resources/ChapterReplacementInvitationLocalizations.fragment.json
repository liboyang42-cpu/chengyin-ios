    "chapterReplacement.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter replacement invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节补位邀约"}}}},
    "chapterReplacement.intro": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Fill a chapter whose supply has exited. A successful invitation only creates a pending invitation. It does not accept, list a replacement supply, or move any payment or refund."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "为已退出供给的章节补位。邀请成功仅生成待处理邀请，不会自动接受、补位上架或涉及付款退款。"}}}},
    "chapterReplacement.section.vacancies": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Exited supply / vacancies"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已退出供给 / 缺位"}}}},
    "chapterReplacement.vacancies.empty": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No replacement vacancies"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂无可补位缺位"}}}},
    "chapterReplacement.vacancy.row %lld %lld": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter %1$lld · original supply %2$lld"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节 %1$lld · 原供给 %2$lld"}}}},
    "chapterReplacement.section.candidates": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Replacement candidates"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "可补位候选"}}}},
