    "chapterReplacement.section.message": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Invitation message (optional)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "邀请留言（可选）"}}}},
    "chapterReplacement.message.label": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Message"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "留言"}}}},
