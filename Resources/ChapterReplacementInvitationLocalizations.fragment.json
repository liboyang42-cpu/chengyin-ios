    "chapterReplacement.review.invite %lld %lld %lld": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This will invite member %1$lld to fill chapter %2$lld, original supply %3$lld."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "将邀请成员 %1$lld 补位章节 %2$lld，原供给 %3$lld。"}}}},
