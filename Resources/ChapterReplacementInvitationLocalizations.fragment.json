    "chapterReplacement.unknown %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The request was sent but the exact result is unknown (%@). Do not send it again; verify only by reading back the full target."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已发送请求但未取得确切结果（%@）。请勿重复发送，只能按完整目标回读核实。"}}}},
