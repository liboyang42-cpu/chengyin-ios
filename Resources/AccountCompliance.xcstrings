{
  "sourceLanguage": "en",
  "strings": {
    "compliance.scope.agree": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and agree to the displayed notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读并同意所示须知"
          }
        }
      }
    },
    "compliance.scope.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认授权"
          }
        }
      }
    },
