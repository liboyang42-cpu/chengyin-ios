{
  "sourceLanguage": "en",
  "strings": {
    "compliance.scope.agree": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and agree to the displayed notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读并同意所示须知"
          }
        }
      }
    },
    "compliance.scope.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认授权"
          }
        }
      }
    },
    "compliance.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account privacy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号隐私"
          }
        }
      }
    },
    "compliance.roam": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam location consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫游定位授权"
          }
        }
      }
    },
    "compliance.marketing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marketing preferences"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营销偏好"
          }
        }
      }
    },
    "compliance.cancellation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销账号"
          }
        }
      }
    },
    "compliance.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载中…"
          }
        }
      }
    },
    "compliance.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "compliance.cancelReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this account-closure application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销此次账号注销申请？"
          }
        }
      }
    },
    "compliance.cancelApplication": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel application"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销申请"
          }
        }
      }
    },
    "compliance.serverStatus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "compliance.executeAfter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled execution"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计执行时间"
          }
        }
      }
    },
    "compliance.agreeNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and agree to the cancellation notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读并同意账号注销须知"
          }
        }
      }
    },
    "compliance.precheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check eligibility and agree"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查资格并同意"
          }
        }
      }
    },
    "compliance.legalMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notice isn't available right now, so this can't continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "须知暂时无法显示，暂不能继续。"
          }
        }
      }
    },
    "compliance.phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bound phone number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已绑定手机号"
          }
        }
      }
    },
    "compliance.sendSMS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send verification code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送验证码"
          }
        }
      }
    },
    "compliance.smsSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification code sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码已发送"
          }
        }
      }
    },
    "compliance.code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码"
          }
        }
      }
    },
    "compliance.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review application"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认申请内容"
          }
        }
      }
    },
    "compliance.reviewWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting may sign you out on all devices. Sign in again to check or cancel a pending application. Eligibility and the deletion date are confirmed by Questify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交后可能会在所有设备上退出登录。请重新登录查询或撤销处理中的申请。注销资格和执行时间以城瘾确认为准。"
          }
        }
      }
    },
    "compliance.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit account closure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交注销申请"
          }
        }
      }
    },
    "compliance.back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "compliance.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An application is pending. See the date and items above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请正在处理中，日期及待处理事项见上方。"
          }
        }
      }
    },
    "compliance.freshLogin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application accepted. Sign in again before checking or cancelling it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请已受理，请重新登录后查询或撤销。"
          }
        }
      }
    },
    "compliance.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outcome is unconfirmed. Do not submit again. Refresh status or contact support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认，请勿重复提交。请刷新状态或联系支持。"
          }
        }
      }
    },
    "compliance.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新状态"
          }
        }
      }
    },
    "compliance.readPrivacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read privacy policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读隐私政策"
          }
        }
      }
    },
    "compliance.roamExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawing stops location tracking and clears location data on this iPhone. If a step doesn't finish, you can continue it later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回后会停止定位，并清除这台 iPhone 上的定位数据。若某一步未完成，可稍后继续。"
          }
        }
      }
    },
    "compliance.revoke": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回授权"
          }
        }
      }
    },
    "compliance.marketingExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply once each merchant and channel is confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个商家和渠道确认后，更改才会生效。"
          }
        }
      }
    },
    "compliance.merchant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家"
          }
        }
      }
    },
    "compliance.channel.IN_APP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app marketing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内营销"
          }
        }
      }
    },
    "compliance.channel.COUPON": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupon marketing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优惠券营销"
          }
        }
      }
    },
    "compliance.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be done right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法操作。"
          }
        }
      }
    },
    "compliance.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't finish. Check the status before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未完成，请先查看状态再重试。"
          }
        }
      }
    },
    "compliance.codeRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid verification code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效验证码"
          }
        }
      }
    },
    "compliance.cleanup.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent has not been revoked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权尚未撤回"
          }
        }
      }
    },
    "compliance.cleanup.serverConfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent revoked; tracking cleanup remains"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权已撤回，仍需停止定位"
          }
        }
      }
    },
    "compliance.cleanup.trackingStopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking stopped; local privacy cleanup remains"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位已停止，仍需清理本地隐私状态"
          }
        }
      }
    },
    "compliance.cleanup.complete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent revoked and local cleanup completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权已撤回，本地清理已完成"
          }
        }
      }
    },
    "compliance.status.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application submitted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销申请已提交"
          }
        }
      }
    },
    "compliance.status.eligible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以申请注销"
          }
        }
      }
    },
    "compliance.status.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't close the account yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法注销"
          }
        }
      }
    }
  },
  "version": "1.0"
}
