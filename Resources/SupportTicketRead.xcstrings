{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My support tickets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的客服工单"
          }
        }
      }
    },
    "boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View your tickets, public messages and historical events only. No ticket changes or attachment access. No requests are sent when this service is not configured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查看本人工单、公开消息和历史事件。不会创建、回复或修改工单，也不读取附件。服务尚未配置时不会发送请求。"
          }
        }
      }
    },
    "reference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original ticket reference, not current business authority or a financial result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原工单关联对象，不代表当前业务授权或资金结果。"
          }
        }
      }
    },
    "attachmentsUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message has attachments. Attachment access is not available here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此消息有关联附件，本只读入口不提供附件读取。"
          }
        }
      }
    },
    "status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态"
          }
        }
      }
    },
    "category": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题类别"
          }
        }
      }
    },
    "timezone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ticket timezone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原工单时区"
          }
        }
      }
    },
    "created": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source creation time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原创建时间"
          }
        }
      }
    },
    "sla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current SLA state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前服务时限状态"
          }
        }
      }
    },
    "firstDue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source first-response deadline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原首响截止时间"
          }
        }
      }
    },
    "resolveDue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source resolution deadline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原解决截止时间"
          }
        }
      }
    },
    "messages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开消息"
          }
        }
      }
    },
    "messagesEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public messages were returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取未返回公开消息。"
          }
        }
      }
    },
    "messagesMore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read more public messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取更多公开消息"
          }
        }
      }
    },
    "reloadDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload this ticket"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取此工单"
          }
        }
      }
    },
    "timeline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original event history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原事件历史"
          }
        }
      }
    },
    "timelineBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event states describe historical records, not current status or a substitute for a request receipt. Not captured or unavailable does not mean an action did not happen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件中的状态属于当时的原记录，不是当前状态，也不能代替某次操作的回执。未捕获或不可用不代表操作未发生。"
          }
        }
      }
    },
    "eventsEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No visible events in this read range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取范围没有可见事件。"
          }
        }
      }
    },
    "loadTimeline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original events"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取原事件历史"
          }
        }
      }
    },
    "eventsMore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read earlier events"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取更早事件"
          }
        }
      }
    },
    "list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tickets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人工单"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tickets were returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取未返回工单。"
          }
        }
      }
    },
    "listMore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read more tickets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取更多工单"
          }
        }
      }
    },
    "reloadList": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload ticket list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取工单列表"
          }
        }
      }
    },
    "error.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read access is unavailable or has changed. Go back and reopen. No new content was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前读取权限不可用或已变化，请返回后重新打开。未发送新内容。"
          }
        }
      }
    },
    "error.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session changed. Previous content was cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已变化，旧内容已清除。"
          }
        }
      }
    },
    "error.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read access was denied. Previous content was cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取权限已被拒绝，旧内容已清除。"
          }
        }
      }
    },
    "error.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response could not be verified. Previous results are not shown as current."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回内容无法核实，未展示旧结果为新结果。"
          }
        }
      }
    },
    "error.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read did not complete. You can retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取未完成，可重新读取。"
          }
        }
      }
    },
    "error.oversized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response exceeds the safe display limit. A partial result is not shown as complete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回内容超过安全展示范围，未截取为完整结果。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
