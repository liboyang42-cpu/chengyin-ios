    "creatorIntro.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry examples"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试示例"
          }
        }
      }
    },
    "creatorIntro.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No featured examples yet. You can still create your own play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有精选示例，你仍可直接创建自己的节点玩法。"
          }
        }
      }
    },
    "creatorIntro.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Examples are unavailable here. You can still start creating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处暂不能读取示例，你仍可开始创建。"
          }
        }
      }
    },
    "creatorIntro.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Examples are for inspiration and will not change your draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例仅供参考，不会填入或改变你的草稿。"
          }
        }
      }
    },
    "creatorIntro.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip examples"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
