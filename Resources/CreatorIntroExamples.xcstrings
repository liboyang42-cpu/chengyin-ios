  "strings": {
    "creatorIntro.examples": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real play examples"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实玩法示例"
          }
        }
      }
    },
    "creatorIntro.unnamed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled example"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名示例"
          }
        }
      }
    },
    "creatorIntro.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading featured examples…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载精选示例…"
          }
        }
      }
    },
    "creatorIntro.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Featured examples could not be loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选示例暂未加载"
          }
        }
      }
