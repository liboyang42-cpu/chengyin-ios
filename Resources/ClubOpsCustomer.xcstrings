    "clubOps.settlement.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credited amounts follow account payout records. Calculated net amounts include executed adjustments; later adjustments do not mean funds have arrived. Voided records keep historical amounts and will not be paid out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已入账以账户打款记录为准；核算净额包含已执行调整，后续调整不代表已到账。作废记录保留历史金额，不再打款。"
          }
        }
      }
    },
