{
  "sourceLanguage": "en",
  "strings": {
    "templateLocalCategories.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved category IDs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选分类"
          }
        }
      }
    },
    "templateLocalCategories.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a category"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除类别"
          }
        }
      }
    },
    "templateLocalCategories.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove a category you chose. Save when you're back in the editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已选的类别，返回编辑器后保存。"
          }
        }
      }
    },
    "templateLocalCategories.unset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved category value"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存分类值"
          }
        }
      }
    },
    "templateLocalCategories.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These saved categories can't be edited here. They are kept as they are."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些已保存的类别无法在此编辑，将原样保留。"
          }
        }
      }
    },
    "templateLocalCategories.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No selected categories"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已选分类"
          }
        }
      }
    },
    "templateLocalCategories.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "templateLocalCategories.removeID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove category"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除分类"
          }
        }
      }
    },
    "templateLocalCategories.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Go back and open this again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已变化，请返回后重新打开。"
          }
        }
      }
    },
    "templateLocalCategories.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload saved selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取已选分类"
          }
        }
      }
    }
  },
  "version": "1.0"
}
