{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "wallet.analysis.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入记录分析"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income record analysis"
          }
        }
      }
    },
    "wallet.analysis.noPayout": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只汇总本次已接收的明细，不是完整账户收入、余额、可提现金额或付款成功证明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This summarizes only records received in this read, not complete account income, a balance, withdrawable funds, or proof of payment."
          }
        }
      }
    },
    "wallet.analysis.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前原收入读取未配置或权限不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original income reading is not configured or access is unavailable."
          }
        }
      }
    },
    "wallet.analysis.login": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在原账号会话有效后重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen this page with a valid account session."
          }
        }
      }
    },
    "wallet.analysis.loading": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取原收入明细…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading original income records…"
          }
        }
      }
    },
    "wallet.analysis.received": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次收到的记录数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records received this time"
          }
        }
      }
    },
    "wallet.analysis.failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取未确认，不按空记录或零金额处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read is unconfirmed. It is not treated as an empty ledger or zero amount."
          }
        }
      }
    },
    "wallet.analysis.retry": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取原明细"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original records again"
          }
        }
      }
    },
    "wallet.analysis.slice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次已读到分页末尾；这些分页仍不是原子快照，也不证明账户完整收入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end of this page sequence was reached. These pages are not an atomic snapshot or proof of complete account income."
          }
        }
      }
    },
    "wallet.analysis.more": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前只显示已接收的分页片段，未收到的记录不计入小计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the received page slice is shown. Records not received are excluded from subtotals."
          }
        }
      }
    },
    "wallet.analysis.mode": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录方向"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record direction"
          }
        }
      }
    },
    "wallet.analysis.income": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入方向记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income-direction records"
          }
        }
      }
    },
    "wallet.analysis.withdrawal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提现申请扣账"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawal request debits"
          }
        }
      }
    },
    "wallet.analysis.currency": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原记录币种"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded currency"
          }
        }
      }
    },
    "wallet.analysis.unknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法归类的记录数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records that cannot be classified"
          }
        }
      }
    },
    "wallet.analysis.excluded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失方向、金额、币种或日期的记录不按零计算；不同币种分别展示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records with missing direction, amount, currency or date are not treated as zero. Currencies are shown separately."
          }
        }
      }
    },
    "wallet.analysis.empty": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次原明细未返回记录；不据此推断余额为零或不存在其他交易。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read returned no records. It does not imply a zero balance or the absence of other transactions."
          }
        }
      }
    },
    "wallet.analysis.months": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近六个北京时间月份的已读小计"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received subtotals for six Beijing-time months"
          }
        }
      }
    },
    "wallet.analysis.knownSubtotal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅已确认字段的小计"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtotal of records with confirmed fields"
          }
        }
      }
    },
    "wallet.analysis.noSources": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次已读记录中未见当月收入来源，不代表完整收入为零。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No current-month income source appears in the received slice. This does not mean complete income is zero."
          }
        }
      }
    },
    "wallet.analysis.sources": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次已读当月记录来源"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources in the received current-month slice"
          }
        }
      }
    },
    "wallet.analysis.currencyUnknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原记录没有可确认的币种，不合并或推断币种。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No currency can be confirmed from these records. Currencies are not inferred or combined."
          }
        }
      }
    },
    "wallet.analysis.unverified": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认，未按零显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unconfirmed, not shown as zero"
          }
        }
      }
    },
    "wallet.analysis.source.topic": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题分成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic share"
          }
        }
      }
    },
    "wallet.analysis.source.activity": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动分成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity share"
          }
        }
      }
    },
    "wallet.analysis.source.returned": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提现驳回退回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returned withdrawal request"
          }
        }
      }
    },
    "wallet.analysis.source.invitation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家推荐"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant referral"
          }
        }
      }
    },
    "wallet.analysis.source.other": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他原记录来源"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other recorded source"
          }
        }
      }
    }
  },
  "version": "1.0"
}
