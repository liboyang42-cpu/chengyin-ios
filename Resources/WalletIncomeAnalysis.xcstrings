{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "wallet.analysis.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析"
          }
        }
      }
    },
    "wallet.analysis.noPayout": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只汇总本次已接收的明细，不是完整账户收入、余额、可提现金额或付款成功证明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This summarizes only records received in this read, not complete account income, a balance, withdrawable funds, or proof of payment."
          }
        }
      }
    },
    "wallet.analysis.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis isn't available right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法查看分析"
          }
        }
      }
    },
    "wallet.analysis.login": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后查看分析"
          }
        }
      }
    },
    "wallet.analysis.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载…"
          }
        }
      }
    },
    "wallet.analysis.received": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次收到的记录数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records received this time"
          }
        }
      }
    },
    "wallet.analysis.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析数据加载失败"
          }
        }
      }
    },
    "wallet.analysis.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "wallet.analysis.slice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次已读到分页末尾；这些分页仍不是原子快照，也不证明账户完整收入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end of this page sequence was reached. These pages are not an atomic snapshot or proof of complete account income."
          }
        }
      }
    },
    "wallet.analysis.more": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前只显示已接收的分页片段，未收到的记录不计入小计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the received page slice is shown. Records not received are excluded from subtotals."
          }
        }
      }
    },
    "wallet.analysis.mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "wallet.analysis.income": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入"
          }
        }
      }
    },
