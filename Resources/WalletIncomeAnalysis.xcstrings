      }
    },
    "wallet.analysis.excluded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺失方向、金额、币种或日期的记录不按零计算；不同币种分别展示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records with missing direction, amount, currency or date are not treated as zero. Currencies are shown separately."
          }
        }
      }
    },
    "wallet.analysis.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records yet"
          }
        },
