{
  "sourceLanguage": "en",
  "strings": {
    "projectNodeImage.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a node photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加节点照片"
          }
        }
      }
    },
    "projectNodeImage.append": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加照片"
          }
        }
      }
    },
    "projectNodeImage.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张照片"
          }
        }
      }
    },
    "projectNodeImage.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "projectNodeImage.confirmCrop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this crop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此裁剪"
          }
        }
      }
    },
    "projectNodeImage.crop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crop to 4:3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪为4:3"
          }
        }
      }
    },
    "projectNodeImage.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo operation is unavailable or could not be completed. Existing photos are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片操作不可用或未能完成。已有照片保持不变。"
          }
        }
      }
    },
    "projectNodeImage.finishLocal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish adding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成添加"
          }
        }
      }
    },
    "projectNodeImage.localFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't add the photo. Try again; it won't upload twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能添加照片，请重试，不会重复上传。"
          }
        }
      }
    },
    "projectNodeImage.persistReceipt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish adding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成添加"
          }
        }
      }
    },
    "projectNodeImage.receiptOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image was uploaded earlier. Its ownership and review status haven't been checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片为之前上传，尚未核实归属和审核状态。"
          }
        }
      }
    },
    "projectNodeImage.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo, crop it to 4:3, upload it, then add it to this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片并裁剪为 4:3，上传后添加到此地点。"
          }
        }
      }
    },
    "projectNodeImage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点照片"
          }
        }
      }
    },
    "projectNodeImage.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm the last upload. Uploading is paused for this stop so the photo isn't added twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认上次上传结果，此地点暂停上传以免重复添加。"
          }
        }
      }
    },
    "projectNodeImage.unstored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo uploaded but isn't added yet. Finish adding it before leaving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片已上传但尚未添加，离开前请完成添加。"
          }
        }
      }
    },
    "projectNodeImage.unsupportedReference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This uploaded photo can't be added to the stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传的照片无法添加到此地点。"
          }
        }
      }
    },
    "projectNodeImage.upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传照片"
          }
        }
      }
    },
    "projectNodeImage.uploadReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload this cropped photo for this stop. Choosing and cropping alone doesn't upload anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传此裁剪后的站点照片。仅选择和裁剪不会上传照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
