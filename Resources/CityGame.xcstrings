{
  "sourceLanguage": "en",
  "strings": {
    "cityGame.action.acceptTask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受任务"
          }
        }
      }
    },
    "cityGame.action.acquire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquire operating right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请经营权"
          }
        }
      }
    },
    "cityGame.action.challenge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start challenge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发起挑战"
          }
        }
      }
    },
    "cityGame.action.completeService": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete service visit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成服务访问"
          }
        }
      }
    },
    "cityGame.action.submitEvidence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit evidence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交证据"
          }
        }
      }
    },
    "cityGame.board.notJoined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team has not joined this board, so actions are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的队伍尚未加入此棋盘，暂不能行动。"
          }
        }
      }
    },
    "cityGame.challenge.accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge accepted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已受理"
          }
        }
      }
    },
    "cityGame.challenge.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge cancelled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已取消"
          }
        }
      }
    },
    "cityGame.challenge.evidenceReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge evidence submitted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战证据已提交"
          }
        }
      }
    },
    "cityGame.challenge.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge expired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已过期"
          }
        }
      }
    },
    "cityGame.challenge.offered": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge offered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已发起"
          }
        }
      }
    },
    "cityGame.challenge.resolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge resolved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已裁决"
          }
        }
      }
    },
    "cityGame.challenge.suspended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge suspended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战已暂停"
          }
        }
      }
    },
    "cityGame.lifecycle.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is closed. History stays available; global points are not reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘已结束，历史可追溯；全局积分不清零。"
          }
        }
      }
    },
    "cityGame.lifecycle.closing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is closing. New actions are closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘正在收束，停止新动作。"
          }
        }
      }
    },
    "cityGame.lifecycle.frozen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is frozen. New actions are closed; in-flight results are settled by the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘已冻结，停止新动作；在途结果由服务端处理。"
          }
        }
      }
    },
    "cityGame.lifecycle.notOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is not open yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘尚未开放。"
          }
        }
      }
    },
    "cityGame.notEnabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City business actions are not enabled yet. You can still view the official board above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市经营动作尚未开放。仍可查看上方官方棋盘。"
          }
        }
      }
    },
    "cityGame.notice.boardNotOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board does not accept new actions right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘当前不接受新动作。"
          }
        }
      }
    },
    "cityGame.notice.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another action is still pending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有动作待确认。"
          }
        }
      }
    },
    "cityGame.notice.invalidQuote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server quote could not be used. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端报价无法使用，未提交任何动作。"
          }
        }
      }
    },
    "cityGame.notice.noReceiptYet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No result yet. Check again later; nothing was charged twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无结果，请稍后再查；不会重复扣分。"
          }
        }
      }
    },
    "cityGame.notice.payerMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This quote names another payer. Only you can confirm your own payment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报价的付款人不是你；只能由付款人本人确认。"
          }
        }
      }
    },
    "cityGame.notice.quoteExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quote expired. Request a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报价已过期，请重新获取。"
          }
        }
      }
    },
    "cityGame.notice.refreshed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board updated from the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已按服务端更新棋盘。"
          }
        }
      }
    },
    "cityGame.notice.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board state could not be read. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取棋盘状态，请稍后再试。"
          }
        }
      }
    },
    "cityGame.notice.unknownOutcome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result not confirmed yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认。"
          }
        }
      }
    },
    "cityGame.outcome.alreadyApplied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was already done earlier. Nothing was repeated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前已完成，未重复执行。"
          }
        }
      }
    },
    "cityGame.outcome.applied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. The board shows the server result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成，棋盘显示服务端结果。"
          }
        }
      }
    },
    "cityGame.outcome.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked by a venue pause, safety closure or frozen board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因商户暂停、安全关闭或棋盘冻结而被阻止。"
          }
        }
      }
    },
    "cityGame.outcome.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board changed before your action. Review the current options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作前棋盘已变化，请查看当前选项。"
          }
        }
      }
    },
    "cityGame.outcome.conflictKept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The property changed, but your completed task is kept. Choose another option."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点位已变化，你已完成的任务仍保留；请选择其他选项。"
          }
        }
      }
    },
    "cityGame.outcome.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected this action. Nothing was charged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端拒绝了此动作，未扣分。"
          }
        }
      }
    },
    "cityGame.outcome.requote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price changed. Nothing was charged; request a new quote to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格已变化，未扣分；如需继续请重新获取报价。"
          }
        }
      }
    },
    "cityGame.phase.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开放"
          }
        }
      }
    },
    "cityGame.phase.invalidated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session changed. Reopen the board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已变化，请重新进入棋盘。"
          }
        }
      }
    },
    "cityGame.phase.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading board…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取棋盘…"
          }
        }
      }
    },
    "cityGame.phase.quoting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting the server quote…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取服务端报价…"
          }
        }
      }
    },
    "cityGame.phase.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可操作"
          }
        }
      }
    },
    "cityGame.phase.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before confirming"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认前请核对"
          }
        }
      }
    },
    "cityGame.phase.sending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在提交…"
          }
        }
      }
    },
    "cityGame.phase.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board state is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "棋盘状态暂不可用"
          }
        }
      }
    },
    "cityGame.phase.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result not confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未确认"
          }
        }
      }
    },
    "cityGame.points.balance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your points"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的积分"
          }
        }
      }
    },
    "cityGame.points.existing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your existing member points. There is no city coin or team wallet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你现有的会员积分，没有城市币或团队钱包。"
          }
        }
      }
    },
    "cityGame.points.zero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With zero points you can still do neutral and free goals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分为零时仍可完成中立目标和免费选项。"
          }
        }
      }
    },
    "cityGame.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A held pin only shows board state. It never means the operating team is on site, and other players' locations are not shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经营图钉只表示棋盘状态，不代表经营队伍正在现场；不显示其他玩家位置。"
          }
        }
      }
    },
    "cityGame.properties.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No board properties are published here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处没有已公布的棋盘点位。"
          }
        }
      }
    },
    "cityGame.property.mine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operated by your team"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你的队伍经营"
          }
        }
      }
    },
    "cityGame.property.protectedUntil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected until"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护至"
          }
        }
      }
    },
    "cityGame.property.taskKept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your completed task here is kept even though the property changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点位状态已变化，你已完成的任务仍保留。"
          }
        }
      }
    },
    "cityGame.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新棋盘"
          }
        }
      }
    },
    "cityGame.review.actionCost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消耗行动"
          }
        }
      }
    },
    "cityGame.review.beneficiaries": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beneficiaries"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受益人数"
          }
        }
      }
    },
    "cityGame.review.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "cityGame.review.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
    "cityGame.review.cost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points cost"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分成本"
          }
        }
      }
    },
    "cityGame.review.expires": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quote valid until"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报价有效至"
          }
        }
      }
    },
    "cityGame.review.free": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action spends no points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作不消耗积分。"
          }
        }
      }
    },
    "cityGame.review.insufficient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough points for this choice. Neutral and free goals remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积分不足以选择此项；中立和免费目标仍可用。"
          }
        }
      }
    },
    "cityGame.review.noTeammate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you pay. Teammates are never charged, and nothing is deducted if it fails."
          }
        },
        "zh-Hans": {
