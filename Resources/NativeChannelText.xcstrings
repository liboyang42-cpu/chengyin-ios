{
  "sourceLanguage": "en",
  "strings": {
    "channelText.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息"
          }
        }
      }
    },
    "channelText.pendingMentions %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentioned: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提及：%@"
          }
        }
      }
    },
    "channelText.mentions %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will mention: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提及：%@"
          }
        }
      }
    },
    "channelText.replying": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replying to a message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在回复一条消息"
          }
        }
      }
    },
    "channelText.cancelReply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消回复"
          }
        }
      }
    },
    "channelText.replyUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That message is no longer available. Cancel the reply to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条消息已不可用，请取消回复后继续。"
          }
        }
      }
    },
    "channelText.sendMentions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send with mentions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送并提及"
          }
        }
      }
    },
    "channelText.sendReply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送回复"
          }
        }
      }
    },
    "channelText.send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "channelText.check": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看发送状态"
          }
        }
      }
    },
    "channelText.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新发送"
          }
        }
      }
    },
    "channelText.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回历史"
          }
        }
      }
    },
    "channelText.directory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to channel list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回频道目录"
          }
        }
      }
    },
    "channelText.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't send messages here right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法在这里发消息。"
          }
        }
      }
    },
    "channelText.sending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发送…"
          }
        }
      }
    },
    "channelText.checking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking status…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认发送状态…"
          }
        }
      }
    },
    "channelText.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm this message was sent. It won't be resent automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未确认消息是否发出，不会自动重发。"
          }
        }
      }
    },
    "channelText.receiptUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check the status. Try again when you're online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确认发送状态，联网后再试。"
          }
        }
      }
    },
    "channelText.storageUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your device to send messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解锁设备后再发消息。"
          }
        }
      }
    },
    "channelText.accessClosed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You no longer have access to this group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已无法访问这个群。"
          }
        }
      }
    },
    "channelText.received": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送"
          }
        }
      }
    },
    "channelText.cleanupPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost done. Check the status before sending another message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将完成，请先查看发送状态再发新消息。"
          }
        }
      }
    },
    "channelText.withheld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message has been hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此消息已被隐藏。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
