{
  "sourceLanguage": "en",
  "strings": {
    "contextPublish.ai.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI route draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 路线草稿"
          }
        }
      }
    },
    "contextPublish.ai.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI helps draft your route. Review all content and confirm every place before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 仅协助起草。请检查内容，并逐个确认地点后继续。"
          }
        }
      }
    },
    "contextPublish.ai.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your route idea"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你想做的路线"
          }
        }
      }
    },
    "contextPublish.ai.promptRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a route idea using up to 300 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写路线灵感，不超过 300 字。"
          }
        }
      }
    },
    "contextPublish.ai.remaining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generations remaining"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余生成次数"
          }
        }
      }
    },
    "contextPublish.ai.exhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI quota is used up. You can still create a route manually."
          }
