{
  "sourceLanguage": "en",
  "strings": {
    "projectChapterAudio.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter narration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节旁白"
          }
        }
      }
    },
    "projectChapterAudio.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chapter narration is set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置章节旁白。"
          }
        }
      }
    },
    "projectChapterAudio.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved audio value has an unsupported format. It has been kept unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现存音频值格式暂不支持，已原样保留。"
          }
        }
      }
    },
    "projectChapterAudio.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current chapter narration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前章节旁白。"
          }
        }
      }
    },
    "projectChapterAudio.tooLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This narration link is too long. It's kept until you clear it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旁白链接过长，清除前会保留。"
          }
        }
      }
    },
    "projectChapterAudio.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear chapter narration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除章节旁白"
          }
        }
      }
    },
    "projectChapterAudio.clearTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear this chapter’s narration?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本章旁白？"
          }
        }
      }
    },
    "projectChapterAudio.clearMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the narration from this chapter. Story audio blocks aren't affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除本章旁白，故事中的音频块不受影响。"
          }
        }
      }
    },
    "projectChapterAudio.replace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose or replace chapter narration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择或替换章节旁白"
          }
        }
      }
    },
    "projectChapterAudio.uploadUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter audio upload isn't available right now. Existing audio stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节音频上传暂不可用，已有音频保持不变。"
          }
        }
      }
    },
    "projectChapterAudio.selectionScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an mp3, m4a or aac file up to 10 MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择不超过 10 MB 的 mp3、m4a 或 aac 文件。"
          }
        }
      }
    },
    "projectChapterAudio.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter or draft has changed. Close and reopen before selecting another file. Existing narration has not been replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本章或草稿已变化，请关闭后重新打开再选择文件。现存旁白尚未被替换。"
          }
        }
      }
    },
    "projectChapterAudio.receiptTooLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The uploaded file's link is too long to use for this chapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传文件的链接过长，无法用于本章。"
          }
        }
      }
    },
    "projectChapterAudio.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use for this chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于本章"
          }
        }
      }
    }
  },
  "version": "1.0"
}
