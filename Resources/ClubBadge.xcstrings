{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club badges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部勋章"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取…"
          }
        }
      }
    },
    "readError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the current details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能读取当前资料。"
          }
        }
      }
    },
    "refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result is unconfirmed. Do not create or award again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作结果尚未确认，请勿重复创建或颁发。"
          }
        }
      }
    },
    "recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看原操作结果"
          }
        }
      }
    },
    "receipt.CREATED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge created"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章已创建"
          }
        }
      }
    },
    "receipt.GRANTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge awarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章已颁发"
          }
        }
      }
    },
    "receipt.ALREADY_GRANTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already awarded; no duplicate award"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前已颁发，本次没有重复颁发"
          }
        }
      }
    },
    "checkResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original result before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次操作前请先查看原结果。"
          }
        }
      }
    },
    "create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建勋章"
          }
        }
      }
    },
    "grant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Award badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颁发勋章"
          }
        }
      }
    },
    "unnamed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名勋章"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "recipient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择成员"
          }
        }
      }
    },
    "confirmGrant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Award this badge to this member?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向这位成员颁发这枚勋章？"
          }
        }
      }
    },
    "name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章名"
          }
        }
      }
    },
    "description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明"
          }
        }
      }
    },
    "limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name: up to 120 UTF-16 units. Description: up to 255. Some emoji use two units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称最多 120 个 UTF-16 单位，说明最多 255 个，部分表情占两个单位。"
          }
        }
      }
    },
    "confirmCreate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认创建"
          }
        }
      }
    },
    "storageUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original operation log could not be verified. Submissions are paused; do not repeat a previous action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核实原操作记录，已暂停提交；请勿重复之前的操作。"
          }
        }
      }
    },
    "actionNeedsReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action did not return a confirmed result. Review the current details before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次操作未返回已确认结果，请核对当前资料后再继续。"
          }
        }
      }
    },
    "notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action was not sent. Refresh your current identity and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次操作未发送，请刷新当前身份后重新确认。"
          }
        }
      }
    },
    "historicalResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous confirmed result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前已确认的结果"
          }
        }
      }
    }
  },
  "version": "1.0"
}
