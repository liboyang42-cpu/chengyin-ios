    "p31.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度总览隐私"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress overview privacy"
          }
        }
      }
    },
    "p31.overview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度总览可见范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress overview visibility"
          }
        }
      }
    },
    "p31.explanation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改总览范围，适用于当前及历史进度。最终展示仍受本人、好友单独设置、真实频道及场次规则中最严格的一项限制。不会展示节点、照片、坐标或解锁更高权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the overview scope changes, for both current and historical progress. Visibility remains subject to the strictest applicable personal, per-friend, channel and session rules. This does not expose nodes, photos or coordinates, or grant additional access."
          }
        }
      }
    },
    "p31.unopened": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情、照片及排行榜设置未在此开放修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail, photo and leaderboard settings cannot be changed here."
          }
        }
      }
    },
    "p31.recovery.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求恢复"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request recovery"
          }
        }
      }
    },
    "p31.recovery.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知时会保留原请求，不会重发，也不会标记为完成。频道权限被撤销后，仍可在个人设置中查看此结果，但不会恢复频道权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the result is unknown, your request is kept and won't be resent or marked as done. If you lose channel access, you can still check this result from your settings; this won't restore channel access."
          }
        }
      }
    },
    "p31.recovery.read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看原请求结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original request"
          }
        }
      }
    },
    "p31.pending.generic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原隐私请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original privacy request"
          }
        }
      }
    },
    "p31.pending.user": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人总览隐私"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My overview privacy"
          }
        }
      }
    },
    "p31.pending.channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道 %@ 总览隐私"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview privacy for channel %@"
          }
        }
      }
    },
    "p31.current.user": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人当前总览设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My current overview settings"
          }
        }
      }
    },
    "p31.current.channel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道当前总览设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current channel overview settings"
          }
        }
      }
    },
    "p31.scope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibility scope"
          }
        }
      }
    },
    "p31.default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认没有政策行：按原规则使用公开默认。不是读取失败时的回退值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server confirmed that no policy row exists, so the original public default applies. This is not a fallback for a failed read."
          }
        }
      }
    },
    "p31.updated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原更新时间"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original update time"
          }
        }
      }
    },
    "p31.revision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道原版本"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original channel revision"
          }
        }
      }
    },
    "p31.factor.default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次服务器读取确认没有策略行；这只说明当前默认因子，不代表所有场景最终公开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server read confirmed that no policy row exists. It establishes the current default factor, not public visibility in every context."
          }
        }
      }
    },
    "p31.factor.confirmed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此总览设置已确认。实际可见范围还取决于查看者、好友单独设置及所在频道和场次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This overview setting is confirmed. Who can actually see it still depends on the viewer, your per-friend settings, and the channel and session."
          }
        }
      }
    },
    "p31.factor.unconfirmed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读到服务器当前设置，但原进度消费者尚未确认此因子。不能把已保存或开关位置当作已经生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current server setting was read, but the original progress consumer has not confirmed this factor. A saved setting or toggle position is not proof that it has taken effect."
          }
        }
      }
    },
    "p31.noGlobalEffective": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不提供单一全局有效范围。好友进度卡只展示服务器对当前查看者、具体活动确认可见的总览；未返回的项目及原因不会在此推测。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no single global effective scope here. Friend progress cards show only overviews the server confirms are visible to the current viewer for a specific activity. Missing items and their reasons are not inferred."
          }
        }
      }
    },
    "p31.noExtraAccess": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情、照片、坐标及排行榜不因总览因子确认而获得读取权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation of an overview factor does not grant access to details, photos, coordinates or leaderboards."
          }
        }
      }
    },
    "p31.noWrite": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有独立写授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No independent write authorization is currently available."
          }
        }
      }
    },
    "p31.prepare": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备修改总览范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare an overview scope change"
          }
        }
      }
    },
    "p31.confirm.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确确认"
          }
