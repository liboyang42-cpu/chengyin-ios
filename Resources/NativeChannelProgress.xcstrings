        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前实际生效范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current effective access"
          }
        }
      }
    },
    "effectiveExplanation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际生效范围来自服务器，并可能受到当前频道限制；公开进度不会公开精确位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effective access comes from the server and may be narrowed by the channel. Public progress does not expose precise location."
          }
        }
      }
    },
    "originalPending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次保存的结果仍待确认，先查询原请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous save is unresolved. Check its original request first."
          }
        }
      }
    },
    "checkOriginal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询原请求结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original result"
          }
        }
