        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this change"
          }
        }
      }
    },
    "p31.confirm.scope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅把总览范围改为：%@。其他字段保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change only the overview scope to %@. All other fields remain unchanged."
          }
        }
      }
    },
    "p31.confirm.submit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认提交这一项"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and submit this change"
          }
        }
      }
    },
    "p31.confirm.cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消未发送修改"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the unsent change"
          }
        }
      }
    },
    "p31.closed": {
