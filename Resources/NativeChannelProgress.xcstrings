        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is unknown. A missing receipt does not prove the save failed."
          }
        }
      }
    },
    "privacyConflict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
