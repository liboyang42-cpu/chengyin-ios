    "p31.result.notSent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未发送；请重新读取当前设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was not sent. Read the current settings again."
          }
        }
      }
    },
    "p31.result.applied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已保存。下方重新读取当前设置，不把旧回执当现行授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request was saved. The current settings are reread below; an old receipt is not current authorization."
          }
        }
      }
    },
    "p31.result.conflict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求因版本冲突未修改设置。请查看当前值后重新确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request did not change the settings because of a version conflict. Review the current values and confirm again."
          }
        }
      }
    },
    "p31.friend.currentVisibility": {
      "localizations": {
        "zh-Hans": {
