{
  "sourceLanguage": "en",
  "strings": {
    "clubOpsEvent.cancel.confirmAction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this occurrence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消本场"
          }
        }
      }
    },
    "clubOpsEvent.cancel.confirmBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This unpublishes the occurrence, processes refunds and ends the waitlist. Parts already checked in are not refunded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会下架本场、处理退款并终止候补。已核销的部分不退。"
          }
        }
      }
    },
    "clubOpsEvent.cancel.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this occurrence?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认取消本场？"
          }
        }
      }
    },
    "clubOpsEvent.cancel.incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation not completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本场取消未完成"
          }
        }
      }
    },
    "clubOpsEvent.cancel.keep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再想想"
          }
        }
      }
    },
    "clubOpsEvent.cancel.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a cancellation reason (at least 2 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入取消原因（至少 2 个字）"
          }
        }
      }
    },
    "clubOpsEvent.cancel.reason %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因：%@"
          }
        }
      }
    },
    "clubOpsEvent.cancel.reasonInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cancellation reason must be 2–255 characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消原因需为 2–255 个字"
          }
        }
      }
    },
    "clubOpsEvent.cancel.reread": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read back again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新回读"
          }
        }
      }
    },
    "clubOpsEvent.cancel.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpublishes this occurrence, processes refunds and ends the waitlist"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会下架本场、处理退款并终止候补"
          }
        }
      }
    },
    "clubOpsEvent.capacity.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom capacity only applies to partner topics with exactly one ticket type; with several ticket types, each keeps its own capacity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义容量只适用于恰有一个票种的合作主题；多票种继续沿用原票种容量。"
          }
        }
      }
    },
    "clubOpsEvent.capacity.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity must be 1–10000"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量需为 1–10000"
          }
        }
      }
    },
    "clubOpsEvent.capacity.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity is optional; when full, the waitlist is first-in, first-out per event and ticket type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量可选；满员后按活动 + 票种先进先出"
          }
        }
      }
    },
    "clubOpsEvent.capacity.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the ticket type’s capacity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用票种"
          }
        }
      }
    },
    "clubOpsEvent.correct.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a correction reason (at least 2 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入更正原因（至少 2 个字）"
          }
