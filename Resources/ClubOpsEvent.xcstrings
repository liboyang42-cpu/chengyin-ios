        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按重复方式批量生成"
          }
        }
      }
    },
    "clubOpsEvent.recurrence.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time zone is fixed to Shanghai; at most 90 days / 64 future occurrences are materialized"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时区固定为上海，最多物化未来 90 天 / 64 期"
          }
        }
      }
    },
