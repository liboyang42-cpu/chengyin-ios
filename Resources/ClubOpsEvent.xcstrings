    "clubOpsEvent.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduling, check-in and attendance corrections need the “Event operations” or “This event’s check-in” permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场次编排、签到与出勤更正需要「活动运营」或「本场核销」权限。"
          }
        }
      }
    },
    "clubOpsEvent.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have event operations permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有活动运营的权限"
          }
        }
      }
    },
    "clubOpsEvent.edit.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic and lead policy are locked; leave editing to switch series"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定主题与负责人策略；退出编辑可换系列"
