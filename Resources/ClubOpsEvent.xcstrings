    "clubOpsEvent.roster.window %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in corrections are only allowed from the start of the event until 48 hours after it ends. Correction window for this occurrence: %@"
