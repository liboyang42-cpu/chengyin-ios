          }
        }
      }
    },
    "clubOpsEvent.offer.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a spot opens up, it is held this long for the first person in line, then passes to the next. However long the window, it never goes past this ticket’s registration deadline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名额空出来后为队首保留这么久，逾期顺延给下一位。窗口再长也不会超过这张票的报名截止时间。"
          }
        }
      }
    },
    "clubOpsEvent.offer.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The waitlist window must be 5–1440 minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候补窗口需为 5–1440 分钟"
          }
        }
      }
    },
    "clubOpsEvent.offer.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes – 1 day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分钟 – 1 天"
          }
        }
      }
    },
    "clubOpsEvent.recurrence.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add dates"
