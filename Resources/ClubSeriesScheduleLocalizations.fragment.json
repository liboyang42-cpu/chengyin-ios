{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "club.schedule.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit schedule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑排期"
          }
        }
      }
    },
    "club.schedule.shanghai": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All dates and assembly times use Shanghai time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期和集合时刻均按上海时间。"
          }
        }
      }
    },
    "club.schedule.newDatesOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing series provide dates, not assembly times. The initial 09:00 is a default for new dates; existing occurrence times are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有系列只提供日期，不提供集合时刻。初始 09:00 是新增日期的默认时刻，不改写已有场次时刻。"
          }
        }
      }
    },
    "club.schedule.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose dates and an assembly time before review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择日期和集合时刻，再进入复核。"
          }
        }
      }
    },
    "club.schedule.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "club.schedule.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日期"
          }
        }
      }
    },
    "club.schedule.reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset this editor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复打开时的排期"
          }
        }
      }
    },
    "club.schedule.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use schedule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此排期"
          }
        }
      }
    },
    "club.schedule.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested dates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拟安排日期"
          }
        }
      }
    },
    "club.schedule.previewNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a local preview, not created sessions. The server determines future availability, the 90-day materialization limit and locked sessions. Duplicate dates are combined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只预览拟安排日期，尚未创建场次。未来可用日期、90 天物化范围及锁定场次以服务器为准。重复日期会合并。"
          }
        }
      }
    },
    "club.schedule.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft or account has changed. Close and reopen the schedule editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿或账号已变化，请关闭后重新打开排期编辑。"
          }
        }
      }
    },
    "club.schedule.error.recurrence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a supported recurrence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择重复方式。"
          }
        }
      }
    },
    "club.schedule.error.date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid calendar date for every session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为每场选择有效日期。"
          }
        }
      }
    },
    "club.schedule.error.time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid assembly time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择有效的集合时刻。"
          }
        }
      }
    },
    "club.schedule.error.count": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between 1 and 64 dates or weekly sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期或每周场次数需为 1–64。"
          }
        }
      }
    },
    "club.schedule.error.past": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assembly date and time must be later than the current Shanghai time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集合日期和时刻必须晚于当前上海时间。"
          }
        }
      }
    }
  }
}
