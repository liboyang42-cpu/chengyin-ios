            "state": "translated",
            "value": "Retry update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试更新"
          }
        }
      }
    },
    "clubOpsJoin.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join applications not updated yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会申请暂未更新"
          }
        }
      }
    },
    "clubOpsNotify.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending club notifications needs the “Notify members” permission. You can ask the owner to delegate it to you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发俱乐部通知需要「通知成员」权限,可以请主理人给你委派。"
          }
        }
      }
    },
    "clubOpsNotify.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have permission to send notifications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有发通知的权限"
          }
        }
      }
    },
    "clubOpsNotify.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification tool is temporarily unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知工具暂时不可用"
          }
        }
      }
    },
    "clubOpsNotify.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    }
