      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拒绝…"
          }
        }
      }
    },
    "clubOpsJoin.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
