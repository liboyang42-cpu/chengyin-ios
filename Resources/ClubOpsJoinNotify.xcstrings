{
  "sourceLanguage": "en",
  "strings": {
    "clubOpsJoin.approving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在通过…"
          }
        }
      }
    },
    "clubOpsJoin.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load join applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会申请加载失败"
          }
        }
      }
    },
    "clubOpsJoin.rejecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拒绝…"
          }
        }
      }
    },
    "clubOpsJoin.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
    "clubOpsJoin.retryStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试更新"
          }
        }
      }
    },
    "clubOpsJoin.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join applications not updated yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会申请暂未更新"
          }
        }
      }
    },
    "clubOpsNotify.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending club notifications needs the “Notify members” permission. You can ask the owner to delegate it to you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发俱乐部通知需要「通知成员」权限,可以请主理人给你委派。"
          }
        }
      }
    },
    "clubOpsNotify.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have permission to send notifications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有发通知的权限"
          }
        }
      }
    },
    "clubOpsNotify.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification tool is temporarily unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知工具暂时不可用"
          }
        }
      }
    },
    "clubOpsNotify.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
    "clubOpsJN.join.approve.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once approved, they become a full member and can view the member list and use member features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过后，对方将成为正式成员，可查看成员名单并使用成员功能。"
          }
        }
      }
    },
    "clubOpsJN.join.intro.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve or reject directly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接通过或拒绝"
          }
        }
      }
    },
    "clubOpsJN.join.intro.pending %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pending · Approve or reject directly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条待审 · 可直接通过或拒绝"
          }
        }
      }
    },
    "clubOpsJN.join.playerFallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chengyin player"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城瘾玩家"
          }
        }
      }
    },
    "clubOpsJN.join.reason.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to them with the not-approved notice; can be left blank"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会随未通过通知告诉对方，可不填"
          }
        }
      }
    },
    "clubOpsJN.join.reason.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason for rejecting (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝原因（选填）"
          }
        }
      }
    },
    "clubOpsJN.join.reason.tooLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reason cannot exceed 500 characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝原因不能超过500字"
          }
        }
      }
    },
    "clubOpsJN.join.reject.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will receive a not-approved notice; you can add an optional reason below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到未通过通知，可选填原因一并告知"
          }
        }
      }
    },
    "clubOpsJN.join.reject.reapply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can still apply again later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方之后仍可以重新提交申请"
          }
        }
      }
    },
    "clubOpsJN.notify.audience.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose audience"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择受众"
          }
        }
      }
    },
    "clubOpsJN.notify.content.section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        }
      }
    },
    "clubOpsJN.notify.eventDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your role cannot notify this event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前角色没有本场通知权限"
          }
        }
      }
    },
    "clubOpsJN.notify.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
          }
        },
        "zh-Hans": {
