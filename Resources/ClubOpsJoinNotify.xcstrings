  "strings": {
    "clubOpsJoin.approving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在通过…"
          }
        }
      }
    },
    "clubOpsJoin.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load join applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会申请加载失败"
          }
        }
      }
    },
