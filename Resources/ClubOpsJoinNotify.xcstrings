    "clubOpsJN.notify.issue.content": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content must be 1–1000 characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容需为 1–1000 字"
          }
        }
      }
    },
    "clubOpsJN.notify.issue.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title must be 1–80 characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题需为 1–80 字"
          }
        }
      }
    },
    "clubOpsJN.notify.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to deliver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待投递"
          }
        }
      }
    },
    "clubOpsJN.notify.people %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld people"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 人"
          }
        }
      }
    },
    "clubOpsJN.notify.phase.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已投递完成"
          }
        }
      }
    },
    "clubOpsJN.notify.phase.delivering": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivering"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投递中"
          }
        }
      }
    },
    "clubOpsJN.notify.phase.partialFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partly undelivered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分未送达"
          }
        }
      }
    },
    "clubOpsJN.notify.placeholder.content": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include the meet-up time, place and what to bring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写清集合时间、地点与需要准备的物品"
          }
        }
      }
    },
    "clubOpsJN.notify.placeholder.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Saturday meet-up reminder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：周六集合提醒"
          }
        }
      }
    },
    "clubOpsJN.notify.preview.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members in this group can be notified right now. Try another group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个分群暂时没有可发送的成员，换一个分群看看。"
          }
        }
      }
    },
    "clubOpsJN.notify.preview.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audience preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览受众"
          }
        }
      }
    },
    "clubOpsJN.notify.processing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still delivering in the background"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台还在投递"
          }
        }
      }
    },
    "clubOpsJN.notify.retried.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed items were retried"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败项已重试"
          }
        }
      }
    },
    "clubOpsJN.notify.retried.stillFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items still failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有失败项"
          }
        }
      }
    },
    "clubOpsJN.notify.retryOnlyFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry failed items only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只重试失败项"
          }
        }
      }
    },
    "clubOpsJN.notify.sent.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app notice sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站内通知已发送"
          }
        }
      }
    },
    "clubOpsJN.notify.sent.delivering": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice submitted and being delivered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已提交，正在投递"
          }
        }
      }
    },
    "clubOpsJN.notify.sent.partialFailed": {
      "localizations": {
