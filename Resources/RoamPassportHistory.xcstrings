{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "roam.serverHistory.open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号漫游历史"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account roaming history"
          }
        }
      }
    },
    "roam.serverHistory.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号漫游历史"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account history"
          }
        }
      }
    },
    "roam.serverHistory.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取本人已结算记录；本机历史仍在原页面。未读完的列表不是全部历史。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only your settled sessions. Local history remains on the original page. A partial list is not your complete history."
          }
        }
      }
    },
    "roam.serverHistory.summary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端护照统计"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server passport totals"
          }
        }
      }
    },
    "roam.serverHistory.records": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结算漫游"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settled sessions"
          }
        }
      }
    },
    "roam.serverHistory.summaryPending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计尚未读取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Totals have not been read"
          }
        }
      }
    },
    "roam.serverHistory.empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号暂无已结算漫游记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No settled sessions found for this account"
          }
        }
      }
    },
    "roam.serverHistory.trips": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips"
          }
        }
      }
    },
    "roam.serverHistory.distance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance"
          }
        }
      }
    },
    "roam.serverHistory.days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活跃天数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active days"
          }
        }
      }
    },
    "roam.serverHistory.shops": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探店"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop visits"
          }
        }
      }
    },
    "roam.serverHistory.duration": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用时（小时:分钟）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration (hours:minutes)"
          }
        }
      }
    },
    "roam.serverHistory.photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机照片数量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local photo count"
          }
        }
      }
    },
    "roam.serverHistory.localSupplement": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同次漫游的本机补充"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local supplement for this session"
          }
        }
      }
    },
    "roam.serverHistory.localBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示本机已有补充，不上传、不读取相册、不加入服务端统计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows existing local data only. No upload, photo-library access, or addition to server totals."
          }
        }
      }
    },
    "roam.serverHistory.trackBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轨迹仅作示意，不代表到场或结算凭据。服务端保留期到期后可无轨迹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sketch is for display, not proof of presence or settlement. Server tracks may expire."
          }
        }
      }
    },
    "roam.serverHistory.recordTitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫游记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session record"
          }
        }
      }
    },
    "roam.serverHistory.dateUnknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期未知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date unknown"
          }
        }
      }
    },
    "roam.serverHistory.changed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或读取权限已变化，请返回重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or read permission changed. Go back and reopen this page."
          }
        }
      }
    }
  },
  "version": "1.0"
}
