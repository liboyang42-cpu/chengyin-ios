{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "workshopPaidInstalledText.entry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已安装原文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review installed text"
          }
        }
      }
    },
    "workshopPaidInstalledText.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装内容审阅"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed content review"
          }
        }
      }
    },
    "workshopPaidInstalledText.notConfigured": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护正文读取尚未配置。已购记录或安装许可不能代替正文读取批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected text reading is not configured. Purchase metadata or installation approval cannot authorize this read."
          }
        }
      }
    },
    "workshopPaidInstalledText.scope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅审阅当前账号已安装的所购版本。原文、答案和执行说明不会进入通用草稿保存或发布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the purchased version installed by this account. Original text, answers and execution notes are not sent to generic draft save or publishing."
          }
        }
      }
    },
    "workshopPaidInstalledText.sessionChanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或读取配置已改变，受保护内容已清除。请返回后重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account or read configuration changed. Protected content was cleared. Return and reopen."
          }
        }
      }
    },
    "workshopPaidInstalledText.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对许可与已提交的安装记录…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the license and committed installation…"
          }
        }
      }
    },
