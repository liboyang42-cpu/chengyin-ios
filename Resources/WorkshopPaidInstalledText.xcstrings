    },
    "workshopPaidInstalledText.termsDocumentHash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始条款资料摘要"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original terms document hash"
          }
        }
      }
    },
    "workshopPaidInstalledText.termsBytes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始条款资料字节数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original terms document bytes"
          }
        }
      }
    },
    "workshopPaidInstalledText.opaqueTerms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始条款资料已校验并保留。服务尚未声明文档格式，此处不擅自按文字、网页或PDF渲染。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original terms bytes are verified and retained. Their format is unspecified, so this view does not interpret them as text, a webpage or PDF."
          }
        }
      }
    },
    "workshopPaidInstalledText.perpetualVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期使用权对应冻结的所购版本，与AI订阅额度分开；后续退款或撤销仍按许可状态处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable use applies to the frozen purchased version, separately from AI subscription allowances. Refunds or revocation still follow the license status."
          }
        }
      }
    },
    "workshopPaidInstalledText.noRedistribution": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不授予转售或再分发权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resale or redistribution is not granted."
          }
        }
      }
    },
    "workshopPaidInstalledText.adaptationAllowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结条款允许本地适配；当前页面仍仅审阅，尚未接入专业目标写入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen terms allow local adaptation. This page remains review-only; professional target writing is not connected."
          }
        }
      }
    },
    "workshopPaidInstalledText.adaptationNotGranted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结条款不授予内容修改权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen terms do not grant content editing."
          }
        }
      }
    },
    "workshopPaidInstalledText.materializationRequired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到专业作品前，还需服务器目标绑定、内容归属与来源权益保护。安装副本编号不是专业玩法模板编号，此处不能保存或发布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying this to a professional project requires server target binding, content ownership and source-rights protection. The installed copy ID is not a professional template ID. Save and publish are unavailable here."
          }
        }
      }
    },
    "workshopPaidInstalledText.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取正文。许可或安装状态可能已改变；保留已购及安装记录，不自动重装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected text is unavailable. The license or installation may have changed. Purchase and installation records are retained; no automatic reinstall occurs."
          }
        }
      }
    },
    "workshopPaidInstalledText.retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新核对"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        }
      }
    },
    "workshopPaidInstalledText.close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    }
  },
  "version": "1.0"
