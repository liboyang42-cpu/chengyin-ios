    "workshopPaidInstalledText.frozenTerms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结授权条款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen license terms"
          }
        }
      }
    },
    "workshopPaidInstalledText.termsVersion": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条款版本"
          }
        },
        "en": {
