            "value": "MOD settlement currencies, states and amounts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原MOD结算币种/状态/金额"
          }
        }
      }
    },
    "c08.display.12": {
      "localizations": {
