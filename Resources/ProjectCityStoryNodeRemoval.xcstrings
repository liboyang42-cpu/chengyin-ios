{
  "sourceLanguage": "en",
  "strings": {
    "projectCityNodeRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove city node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除城市节点"
          }
        }
      }
    },
    "projectCityNodeRemoval.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this node and its story node block? You can undo for five seconds while you remain here and the draft is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除这个节点及其故事节点块吗？停留在此页面且草稿未变化时，可在五秒内撤销。"
          }
        }
      }
    },
    "projectCityNodeRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除节点"
          }
        }
      }
    },
    "projectCityNodeRemoval.removed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除地点。"
          }
        }
      }
    },
    "projectCityNodeRemoval.undo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo removal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销删除"
          }
        }
      }
    },
    "projectCityNodeRemoval.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node removal supports one ordinary, unlinked city node at a time. Graphs, linked story content, unknown dependency data and unsaved access remain protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次仅支持删除一个普通、无关联的城市节点。路线图、关联故事内容、未知依赖数据及未保存的访问状态会受到保护。"
          }
        }
      }
    },
    "projectCityNodeRemoval.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection cannot be safely removed here. Keep linked nodes and unknown route or dependency data unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选择无法在这里安全删除。关联节点、未知路线或依赖数据将保持不变。"
          }
        }
      }
    },
    "projectCityNodeRemoval.saveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm the draft was saved. Removing and undo are paused; reopen the draft to check it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认草稿已保存，删除和撤销已暂停，请重新打开草稿检查。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
