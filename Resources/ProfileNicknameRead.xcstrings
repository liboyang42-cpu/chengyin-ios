{
  "sourceLanguage": "en",
  "strings": {
    "nickname.read.invalid.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nickname."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入昵称"
          }
        }
      }
    },
    "nickname.read.invalid.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 2 Unicode characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称至少 2 个字"
          }
        }
      }
    },
    "nickname.read.invalid.long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use no more than 24 Unicode characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称最多 24 个字"
          }
        }
      }
    },
    "nickname.read.invalid.characters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, numbers, spaces, or _ # - . · only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称只能用文字、数字和 _ # - . · 空格"
          }
        }
      }
    },
    "nickname.read.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking nickname availability…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查昵称是否可用…"
          }
        }
      }
    },
    "nickname.read.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This nickname is available now. The server will check it again when you save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个昵称当前可以用，保存时仍会重新验证"
          }
        }
      }
    },
    "nickname.read.taken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This nickname is taken. Try another one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个昵称已被占用，换一个试试"
          }
        }
      }
    },
    "nickname.read.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability could not be checked. You can retry or continue to save for the server to decide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证昵称，可重试检查或直接提交保存，由服务器裁决"
          }
        }
      }
    },
    "nickname.read.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This nickname does not meet the rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称不符合规则"
          }
        }
      }
    },
    "nickname.read.noSuggestions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestions were received. You can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没拿到推荐，可以再试一次"
          }
        }
      }
    },
    "nickname.read.exhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No suggestion was available in this search. Try a different name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这批候选暂时没有可用昵称，换个写法试试"
          }
        }
      }
    },
    "nickname.read.suggestionInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid nickname before requesting another batch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把昵称改成符合规则的写法，再换一批"
          }
        }
      }
    },
    "nickname.read.suggestionRetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions could not be loaded. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没拿到推荐，可以再点一次"
          }
        }
      }
    },
    "nickname.read.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查昵称"
          }
        }
      }
    },
    "nickname.read.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More suggestions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一批候选"
          }
        }
      }
    },
    "nickname.read.suggesting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding suggestions…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找候选…"
          }
        }
      }
    },
    "nickname.read.notReserved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability is only the result of this check. It does not reserve the nickname; the server decides when you save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用仅代表本次检查结果，不会预留昵称；保存时仍由服务器判断。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
