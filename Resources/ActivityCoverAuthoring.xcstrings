{
  "sourceLanguage": "en",
  "strings": {
    "boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected photos are cropped locally to 16:9. Upload, use in this draft and save the activity are separate actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片会先在本机裁成16:9。上传、填入草稿和保存活动是三个独立动作。"
          }
        }
      }
    },
    "open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an activity cover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择活动封面"
          }
        }
      }
    },
    "preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview current cover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览当前封面"
          }
        }
      }
    },
    "remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove cover from draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除草稿封面"
          }
        }
      }
    },
    "choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片"
          }
        }
      }
    },
    "upload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm image upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认上传这张图片"
          }
        }
      }
    },
    "retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry this image upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试上传这张图片"
          }
        }
      }
    },
    "apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uploaded cover in draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已上传封面填入草稿"
          }
        }
      }
    },
    "cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel cover editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消封面编辑"
          }
        }
      }
    },
    "ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one photo. Your original cover stays unchanged until you use the uploaded result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张照片。明确使用上传结果前，原封面保持不变。"
          }
        }
      }
    },
    "unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity cover photo selection or upload is not configured. You can keep editing the draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动封面选图或上传尚未配置，仍可继续编辑草稿。"
          }
        }
      }
    },
    "review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the cropped image, then explicitly confirm its upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查裁剪结果，再明确确认上传。"
          }
        }
      }
    },
    "uploading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploading the reviewed image…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在上传已确认的图片…"
          }
        }
      }
    },
    "uploaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload acknowledged. Use the result explicitly to change this draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传已确认。明确选择使用后才修改当前草稿。"
          }
        }
      }
    },
    "rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected this upload. The same local image is retained for an explicit retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了此次上传。本机图片已保留，可明确重试。"
          }
        }
      }
    },
    "unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload outcome is unknown or its local record cannot be verified. No automatic or repeat upload is allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传结果未知，或无法核实本地记录。不会自动上传，也不能重复提交。"
          }
        }
      }
    },
    "selectionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo selection or crop failed. The original cover is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选图或裁剪失败，原封面未修改。"
          }
        }
      }
    },
    "changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cover editor no longer belongs to the current draft. Cancel to return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此封面编辑器已不属于当前草稿，请取消返回。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
