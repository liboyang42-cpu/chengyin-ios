    "workshopPurchased.applicationUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected content, paid installation and application to a professional project are not enabled by this metadata record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此元数据记录不启用受保护内容、付费安装或应用到专业项目。"
          }
        }
      }
    },
    "workshopPurchased.purchaseUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An approved App storefront/payment channel is still required for digital purchases. No checkout is available here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字购买仍需经批准的 App 商店地区与支付渠道，本页不提供收银入口。"
          }
        }
      }
    },
