    "workshopPurchased.durationScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchased version does not expire with an AI subscription. Its frozen scope still applies; suspension or lawful revocation can restrict use. Copyright, resale and all future versions are not included automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所购版本不会随 AI 订阅到期而失效，仍受冻结范围约束；暂停或合法撤权可能限制使用，不自动包含著作权、转售权或未来全部版本。"
          }
        }
      }
    },
