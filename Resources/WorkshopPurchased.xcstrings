{
  "sourceLanguage": "en",
  "strings": {
    "workshopPurchased.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchased packages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已购玩法包"
          }
        }
      }
    },
    "workshopPurchased.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified purchased-version license records. FREE claims, player tickets and AI quotas are separate. This page does not make a purchase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证的所购版本许可记录。免费领取、玩家通行证和 AI 额度分别计算，本页不发起购买。"
          }
        }
      }
    },
    "workshopPurchased.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading purchased records"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取已购记录"
          }
        }
      }
    },
    "workshopPurchased.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchased license records are available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可读取的已购许可记录。"
          }
        }
      }
    },
    "workshopPurchased.sessionChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or read approval changed. Return and reopen this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或读取批准已变化，请返回后重新打开。"
          }
        }
      }
    },
    "workshopPurchased.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchased record could not be verified. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证已购记录，请稍后重试。"
          }
        }
      }
    },
    "workshopPurchased.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
