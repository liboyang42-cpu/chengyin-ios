    "workshopPurchased.unavailableDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent purchased-record read approval and a reviewed service are required. Sign-in or FREE claim access cannot enable this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要独立的已购记录读取批准和已审查服务，登录或免费领取读取权限不能启用此页。"
          }
        }
      }
    },
