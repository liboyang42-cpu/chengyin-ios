{
  "sourceLanguage": "en",
  "strings": {
    "templateReasoning.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the current question"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试答当前题目"
          }
        }
      }
    },
    "templateReasoning.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice only. Nothing is recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供试答，不做记录。"
          }
        }
      }
    },
    "templateReasoning.lifecycle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing the draft, changing accounts or leaving this screen clears the practice. Retry clears your choices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改草稿、切换账号或离开此页面会清除本次试答。重新试答会清空选择。"
          }
        }
      }
    },
    "templateReasoning.result": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果"
          }
        }
      }
    },
    "templateReasoning.matched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer matches this author draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的答案与当前作者草稿一致。"
          }
        }
      }
    },
    "templateReasoning.missed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer differs from this author draft. Retry to try another answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的答案与当前作者草稿不一致，可以重新试答。"
          }
        }
      }
    },
    "templateReasoning.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This answer is incomplete. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案不完整，请再试一次。"
          }
        }
      }
    },
    "templateReasoning.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空并重新试答"
          }
        }
      }
    },
    "templateReasoning.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This practice has expired, or the question isn't finished. Reload the draft or go back to editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次试答已失效，或题目尚未填写完整。请重新加载草稿，或返回编辑。"
          }
        }
      }
    },
    "templateReasoning.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload current question"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取当前题目"
          }
        }
      }
    }
  },
  "version": "1.0"
}
