{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera to scan QR codes or take aftercare evidence photos when you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你主动选择时，使用相机扫描二维码或拍摄售后凭证照片。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location only while the app is open and only when you choose to roam, play a location-based activity, or find nearby places. Location is never used in the background and is not shared with other people."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在应用使用期间、且你主动选择漫游、参与基于位置的玩法或查找附近地点时使用你的位置。不会在后台使用位置，也不会与其他人分享。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to record your voice only when you choose to talk to or set up an NPC voice. Recording stops when you finish and never runs in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动与 NPC 语音对话或设置 NPC 声音时使用麦克风录音。结束后即停止录音，不会在后台录音。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read step counts from this iPhone when you choose to review a walking activity. Counts are not proof of walking and do not unlock rewards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动查看步行活动时读取此 iPhone 的步数。步数不能证明实际行走，也不会解锁奖励。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a walk card to Photos when you choose Save to Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你选择“保存到相册”时，将漫游足迹卡添加到相册。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
