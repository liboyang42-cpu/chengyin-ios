{
  "sourceLanguage": "en",
  "strings": {
    "templateSensor.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try sensor challenge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试玩传感器挑战"
          }
        }
      }
    },
    "templateSensor.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice only. No microphone, location or compass is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供试玩，不使用麦克风、定位或罗盘。"
          }
        }
      }
    },
    "templateSensor.virtualTime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tap moves one second forward using the values below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每点一次按下方数值前进一秒。"
          }
        }
      }
    },
    "templateSensor.held": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held for (seconds)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持时长（秒）"
          }
        }
      }
    },
    "templateSensor.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空并重试"
          }
        }
      }
    },
    "templateSensor.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft changed. Reload to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已变化，请重新载入后再试。"
          }
        }
      }
    },
    "templateSensor.reload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入配置"
          }
        }
      }
    },
    "templateSensor.target": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configured target and tolerance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置目标与容差"
          }
        }
      }
    },
    "templateSensor.bearing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方位"
          }
        }
      }
    },
    "templateSensor.accuracy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accuracy error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度误差"
          }
        }
      }
    },
    "templateSensor.peak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound level"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音强度"
          }
        }
      }
    },
    "templateSensor.threshold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loud threshold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响度阈值"
          }
        }
      }
    },
    "templateSensor.baseline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet level is set to 0.10."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静基线为 0.10。"
          }
        }
      }
    },
    "templateSensor.advance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next second"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前进一秒"
          }
        }
      }
    },
    "templateSensor.feedback.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备就绪"
          }
        }
      }
    },
    "templateSensor.feedback.aligned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligned. Keep holding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向已对准，继续保持。"
          }
        }
      }
    },
    "templateSensor.feedback.turn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside tolerance. Continuous hold resets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向超出容差，连续保持已重置。"
          }
        }
      }
    },
    "templateSensor.feedback.inaccurate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accuracy is insufficient. Continuous hold resets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度不足，连续保持已重置。"
          }
        }
      }
    },
    "templateSensor.feedback.loud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loud enough. Keep going."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音足够，继续保持。"
          }
        }
      }
    },
    "templateSensor.feedback.quiet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At or below threshold. Continuous hold resets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未高于阈值，连续保持已重置。"
          }
        }
      }
    },
    "templateSensor.feedback.matched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condition reached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到条件。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
