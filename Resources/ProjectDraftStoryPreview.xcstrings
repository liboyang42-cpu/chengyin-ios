{
  "sourceLanguage": "en",
  "strings": {
    "projectDraftStoryPreview.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story-content preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故事内容预览"
          }
        }
      }
    },
    "projectDraftStoryPreview.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview unsaved story content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览未保存的故事内容"
          }
        }
      }
    },
    "projectDraftStoryPreview.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the story in chapter order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按章节顺序阅读故事。"
          }
        }
      }
    },
    "projectDraftStoryPreview.mediaScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images and audio appear as placeholders here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片和音频在此以占位显示。"
          }
        }
      }
    },
    "projectDraftStoryPreview.pendingExcluded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending materials excluded from this story"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未进入故事的待放置素材"
          }
        }
      }
    },
    "projectDraftStoryPreview.unplacedNodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placed nodes without story markers are not inserted into this reading sequence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少故事标记的已放置节点未插入本次阅读顺序"
          }
        }
      }
    },
    "projectDraftStoryPreview.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft has no chapters yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此草稿还没有章节。"
          }
        }
      }
    },
    "projectDraftStoryPreview.emptyChapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter has no story blocks to read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本章没有可阅读的故事块。"
          }
        }
      }
    },
    "projectDraftStoryPreview.emptyText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text block is empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文本块为空。"
          }
        }
      }
    },
    "projectDraftStoryPreview.emptyAlbum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album has no readable captions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此相册还没有可阅读的图片说明。"
          }
        }
      }
    },
    "projectDraftStoryPreview.emptyCaption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No caption for this image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张图片尚无说明。"
          }
        }
      }
    },
    "projectDraftStoryPreview.unsupportedChapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter’s version or role cannot be represented safely in this preview. Return to the editor to inspect it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本章的版本或角色无法在此安全预览，请返回编辑器检查。"
          }
        }
      }
    },
    "projectDraftStoryPreview.unsupportedBlock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content or metadata cannot be represented here. Any readable authored text is shown without interpreting those fields."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容或元数据无法在此预览。可读取的作者文本仍会显示，但不会解释这些字段。"
          }
        }
      }
    },
    "projectDraftStoryPreview.conditional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional content shown for author review; its condition has not been evaluated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此条件内容为作者检查而展示，触发条件尚未判断。"
          }
        }
      }
    },
    "projectDraftStoryPreview.endingScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an authored ending chapter, not a selected or achieved ending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是作者编写的结局章节，不代表已选中或已达成这个结局。"
          }
        }
      }
    },
    "projectDraftStoryPreview.nodeScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node marker and authored description only; no game or answer is executed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅展示节点标记和作者说明，不运行玩法或提交答案。"
          }
        }
      }
    },
    "projectDraftStoryPreview.effectScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effect marker only; no effect is executed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅展示效果标记，不执行效果。"
          }
        }
      }
    },
    "projectDraftStoryPreview.emptyMedia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No media added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未添加媒体"
          }
        }
      }
    },
    "projectDraftStoryPreview.mediaReference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加媒体"
          }
        }
      }
    },
    "projectDraftStoryPreview.untitledTopic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名草稿"
          }
        }
      }
    },
    "projectDraftStoryPreview.untitledChapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名章节"
          }
        }
      }
    },
    "projectDraftStoryPreview.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft or account changed. Close this preview and open the current draft again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿或账号已变化，请关闭预览后重新打开当前草稿。"
          }
        }
      }
    },
    "projectDraftStoryPreview.chapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节"
          }
        }
      }
    },
    "projectDraftStoryPreview.previous": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一章"
          }
        }
      }
    },
    "projectDraftStoryPreview.next": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next chapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一章"
          }
        }
      }
    },
    "projectDraftStoryPreview.chapterPosition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter position"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节位置"
          }
        }
      }
    },
    "projectDraftStoryPreview.role.chapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节内容"
          }
        }
      }
    },
    "projectDraftStoryPreview.role.opening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening chapter content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "序章内容"
          }
        }
      }
    },
    "projectDraftStoryPreview.role.ending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ending chapter content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结局章节内容"
          }
        }
      }
    },
    "projectDraftStoryPreview.role.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported chapter role"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的章节角色"
          }
        }
      }
    },
    "projectDraftStoryPreview.reason.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some chapters or stops are duplicated, so the story can't be previewed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分章节或地点重复，暂时无法预览故事。"
          }
        }
      }
    },
    "projectDraftStoryPreview.reason.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This story is too long to preview here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故事过长，无法在此预览。"
          }
        }
      }
    },
    "projectDraftStoryPreview.reason.branchRoute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch-route preview is not connected here. Existing branch data is preserved; this screen will not invent a route."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处尚未接通分支路线预览。原有分支数据保留，不会推断一条路线。"
          }
        }
      }
    },
    "projectDraftStoryPreview.reason.unsupportedRoute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story preview isn't available for this route type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此路线类型暂不支持故事预览。"
          }
        }
      }
    },
    "projectDraftStoryPreview.kind.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故事文本"
          }
        }
      }
    },
    "projectDraftStoryPreview.kind.voice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
