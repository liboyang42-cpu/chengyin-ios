          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "氛围标记"
          }
        }
      }
    },
    "projectDraftStoryPreview.kind.odd": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effect marker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果标记"
          }
        }
      }
    },
    "projectDraftStoryPreview.kind.reveal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
