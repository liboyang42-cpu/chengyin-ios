    "personalLocationShare.status.03": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        }
      }
    },
    "personalLocationShare.status.04": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This member is not currently eligible. Mutual following, valid accounts, and no blocking are required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此成员暂不具备共享资格。需双方互关、账号有效且无屏蔽。"
          }
        }
      }
    },
    "personalLocationShare.status.05": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select precision and duration, then confirm each disclosure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择精度、时长并逐项确认。"
          }
        }
      }
    },
    "personalLocationShare.status.06": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        }
      }
    },
    "personalLocationShare.status.07": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        }
      }
    },
    "personalLocationShare.status.08": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing status loaded. Location sharing doesn't resume automatically after a restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加载共享状态。重启后不会自动恢复位置采集或共享。"
          }
        }
      }
    },
    "personalLocationShare.status.09": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation has changed or expired. Recheck this recipient and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认内容已变化或已过期，请重新核验此接收者并确认。"
          }
        }
      }
    },
    "personalLocationShare.status.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认共享。"
          }
        }
      }
    },
    "personalLocationShare.status.11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request journal cannot be read safely. New sharing is blocked until the journal is repaired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求日志无法安全读取。已禁止新建共享，需修复日志后恢复。"
          }
        }
      }
    },
    "personalLocationShare.status.12": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is still active, but this device isn't sending your location. Stop the existing share before sharing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享仍有效，但本机未恢复位置采集。请先停止原共享，再重新确认共享。"
          }
        }
      }
    },
    "personalLocationShare.status.13": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device, but the stop couldn't be saved and isn't confirmed. New sharing is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，但停止操作未能保存，尚未确认。已暂停新建共享。"
          }
        }
      }
    },
    "personalLocationShare.status.14": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device; the stop isn't confirmed yet. Try again once you're back online with the same account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，停止待确认。请使用原账号恢复联网后重试。"
          }
        }
      }
    },
    "personalLocationShare.status.15": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device, but the stop intent still cannot be saved. No revocation request was sent. New sharing is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止；停止意图仍无法保存，未发起撤销请求。已禁止新建共享。"
          }
        }
      }
    },
    "personalLocationShare.status.16": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device; waiting to confirm the stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，停止待确认。"
          }
        }
      }
    },
    "personalLocationShare.status.17": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing has ended. Information already seen can't be recalled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已结束。已经看到的信息无法收回。"
          }
        }
      }
    },
    "personalLocationShare.status.18": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find the original request; that doesn't mean it was stopped. Stop the original request to make sure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未找到原请求，不等于已停止。请停止原请求以确保共享结束。"
          }
        }
      }
    },
    "personalLocationShare.status.19": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is set up. Waiting for your current location; it hasn't been shared yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已建立，正在获取当前位置；尚未确认已共享位置。"
          }
        }
      }
    },
    "personalLocationShare.status.20": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location was shared. It updates only at set intervals and stops when you go offline or leave the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已共享当前位置。之后按固定间隔更新；断网或离开应用时会停止。"
          }
        }
      }
    },
    "personalLocationShare.status.21": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device, but the stop couldn't be saved. It isn't confirmed yet, and new sharing is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，但停止操作保存失败，尚未确认。已暂停新建共享。"
          }
        }
      }
    },
    "personalLocationShare.status.22": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing has stopped on this device and received locations were cleared. Any unconfirmed stops are kept. When you return to the app, check and confirm again; earlier shares don't resume automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机位置采集已停止，收到的位置已清除。未确认的停止操作仍会保留。回到应用后须重新核验并确认，之前的共享不会自动恢复。"
          }
        }
      }
    },
    "personalLocationShare.status.23": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing with this person isn't allowed. Location sharing stopped and received locations were cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法与此成员共享位置。已停止采集并清除收到的位置。"
          }
        }
      }
    },
    "personalLocationShare.status.24": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing isn't allowed under the current sharing rules. Location sharing stopped and received locations were cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前共享规则不允许共享。已停止采集并清除收到的位置。"
          }
        }
      }
    },
    "personalLocationShare.status.25": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用，未发送任何信息。"
          }
        }
      }
    },
    "personalLocationShare.status.26": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now. Your location wasn't sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用，未发送位置。"
          }
        }
      }
    },
    "personalLocationShare.status.27": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recipient needs to accept first, but that isn't available right now. Sharing is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要对方先接受，但此功能暂不可用，无法共享。"
          }
        }
      }
    },
    "personalLocationShare.status.28": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now. Simulated locations can't be shared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用，模拟位置无法共享。"
          }
        }
      }
    },
    "personalLocationShare.status.29": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only existing foreground location permission is used; denied or restricted permission is not bypassed. First-time permission must be explicitly selected during confirmation. Sharing is currently stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用已有前台定位权限，不会绕过拒绝或受限状态。首次授权须在确认中明确选择，当前已停止共享。"
          }
        }
      }
    },
    "personalLocationShare.status.30": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system provides only reduced-accuracy location, which cannot be represented as original sample precision. This exact sharing was stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统仅提供降低精度的位置，不能冒充原采样精度；已停止此精确共享。"
          }
        }
      }
    },
    "personalLocationShare.status.31": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available on this version of the app. Your location won't be collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本应用暂不支持位置共享，不会采集位置。"
          }
        }
      }
    },
    "personalLocationShare.status.32": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation window or selected sharing duration expired. Recheck and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认窗口或已选共享时长已到期，请重新核验并确认。"
          }
        }
      }
    },
    "personalLocationShare.status.33": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        }
      }
    },
    "personalLocationShare.status.34": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sharing policy changed or is unavailable. Capture stopped and received locations were hidden. Original requests remain for verification and will not be recreated automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享政策已变更或不可用，已停止采集并隐藏接收位置。保留原请求待核验；不会自动重建。"
          }
        }
      }
    },
    "personalLocationShare.status.35": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current relationship or account no longer permits sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前关系或账号不再允许共享。"
          }
        }
      }
    },
    "personalLocationShare.status.36": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or session changed. Location sharing stopped; the original request will not be retried under the new account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或会话已变化。位置已停止，不会在新账号下重试原请求。"
          }
        }
      }
    },
    "personalLocationShare.status.37": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing status cannot currently be verified. Capture will not resume and unverified locations will not be shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证共享状态。不会恢复采集或显示未经验证的位置。"
          }
        }
      }
    },
    "personalLocationShare.overview": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享状态与隐私"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing status and privacy"
          }
        }
      }
    },
    "personalLocationShare.loadingEligibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核验此接收者的资格…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking this recipient’s eligibility…"
          }
        }
      }
    },
    "personalLocationShare.journal.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取并核验原请求…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading and checking original requests…"
          }
        }
      }
    },
    "personalLocationShare.journal.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核对之前的请求，可能仍有待处理请求，已暂停新建共享。请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check your earlier requests. There may still be some pending, so new sharing is blocked. Try again."
          }
        }
      }
    },
    "personalLocationShare.journal.unread": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未核验原请求日志。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original requests have not been checked yet."
          }
        }
      }
    },
    "personalLocationShare.journal.stopUnpersisted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止共享，但停止操作未能保存。停止尚未确认，新共享暂时锁定。请重试停止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing has stopped on this device, but we couldn't save that you stopped it. The stop isn't confirmed yet, so new sharing is blocked. Try stopping again."
          }
        }
      }
    },
    "personalLocationShare.restoreHint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查询原请求，不恢复定位或重放创建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads original requests only. Does not resume location collection or replay creation."
          }
        }
      }
    },
    "personalLocationShare.requestsFooter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的请求会保留至结果确认。当前授权和收到的位置不能证明之前的请求已结束。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier requests are kept until their result is confirmed. Current shares and received locations don't prove an earlier request has ended."
          }
        }
      }
    },
    "personalLocationShare.currentFooter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处为上次加载的共享授权。刷新不会解除因停止未确认而锁定的共享。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the shares as last loaded. Refreshing doesn't unlock sharing that's blocked by an unconfirmed stop."
          }
        }
      }
    },
    "personalLocationShare.emptyGrants": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无共享授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active shares."
          }
        }
      }
    },
    "personalLocationShare.read.notRead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取当前状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current state has not been read yet."
          }
        }
      }
    },
    "personalLocationShare.read.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前状态…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading current state…"
          }
        }
      }
    },
    "personalLocationShare.read.loaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次刷新结果，并非实时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As of last refresh, not live."
          }
        }
      }
    },
    "personalLocationShare.read.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态无法核验。若下方仍有记录，仅代表上次读取；未经验证的接收位置已隐藏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current state could not be verified. Any records below are from the last read; unverified received locations are hidden."
          }
        }
      }
    },
    "personalLocationShare.grant.active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权有效"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active"
          }
        }
      }
    },
    "personalLocationShare.grant.stopped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        }
      }
    },
    "personalLocationShare.grant.revoked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoked"
          }
        }
      }
    },
    "personalLocationShare.grant.expired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已到期"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired"
          }
        }
      }
    },
    "personalLocationShare.grant.notFound": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未找到"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found"
          }
        }
      }
    },
    "personalLocationShare.status.createUnknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建结果未知。保留原请求，请查询或停止；不会换新请求重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The creation outcome is unknown. Keep the original request and query or stop it; creation will not be retried with a new request."
          }
        }
      }
    },
    "personalLocationShare.status.revokePending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止尚未确认，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stop isn't confirmed yet. Try again."
          }
        }
      }
    },
    "personalLocationShare.status.stoppedPending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，停止尚未确认，可重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device; the stop isn't confirmed yet. You can try again."
          }
        }
      }
    },
    "personalLocationShare.status.locationsHidden": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收位置已隐藏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received locations are hidden."
          }
        }
      }
    },
    "personalLocationShare.status.authorizationRejected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享访问被拒绝（%@）。已停止采集并清除收到的位置；请重新登录并核对授权。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing access was denied (%@). Location sharing stopped and received locations were cleared. Sign in again and check your permissions."
          }
        }
      }
    },
    "personalLocationShare.status.journalRecovered": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重新读取原请求日志；不会自动恢复采集或重放创建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original-request journal has been read again. Collection will not resume automatically and creation will not be replayed."
          }
        }
      }
    },
    "personalLocationShare.unavailable.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now"
          }
        }
      }
    },
    "personalLocationShare.unavailable.description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用，需先登录。除非你开启共享，否则不会请求定位权限或发送位置；开启后也需逐项确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now. You need to be signed in. We won't ask for location access or send your location unless you turn sharing on, and you'll confirm each step before sharing."
          }
        }
      }
    }
  },
  "version": "1.0"
}
