{
  "sourceLanguage": "en",
  "strings": {
    "personalLocationShare.title.management": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享管理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing"
          }
        }
      }
    },
    "personalLocationShare.title.person": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向此人共享位置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with this person"
          }
        }
      }
    },
    "personalLocationShare.disclosure.summary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许定位不等于同意共享。你的最新位置会上传至城瘾；模糊模式下对方只能看到大致区域，精确位置会按隐私政策短暂保存。仅在应用打开时共享，对方已看到的信息无法收回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing location access isn't the same as agreeing to share. Your latest location is sent to Questify; in approximate mode the recipient sees a less precise area, while your exact location is kept temporarily under our privacy policy. Only while the app is open. What the recipient has already seen can't be taken back."
          }
        }
      }
    },
    "personalLocationShare.unconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now. Your location won't be collected or sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用，不会采集或发送位置。"
          }
        }
      }
    },
    "personalLocationShare.recipient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit recipient"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确接收者"
          }
        }
      }
    },
    "personalLocationShare.memberID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员 ID"
          }
        }
      }
    },
    "personalLocationShare.eligibilityNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligibility is checked again. A public profile or one-way follow doesn't count as permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资格会重新核验，公开主页或单向关注不构成授权。"
          }
        }
      }
    },
    "personalLocationShare.recheck": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recheck eligibility and policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新核验资格与政策"
          }
        }
      }
    },
    "personalLocationShare.choices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precision and duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度与时长"
          }
        }
      }
    },
    "personalLocationShare.precision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度"
          }
        }
      }
    },
    "personalLocationShare.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an option"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择"
          }
        }
      }
    },
    "personalLocationShare.exact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original sample (meter-level accuracy is not guaranteed)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原采样点（不保证米级精度）"
          }
        }
      }
    },
    "personalLocationShare.coarse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大致位置"
          }
        }
      }
    },
    "personalLocationShare.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续时长"
          }
        }
      }
    },
    "personalLocationShare.precisionNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both modes send your latest location. In approximate mode, the recipient sees only a general area. Your exact location is kept temporarily under our privacy policy and for the sharing period—not just the blurred area. Location may not be accurate to the meter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种模式都会上传你的最新位置。模糊模式下对方只能看到大致区域；精确位置会按隐私政策在共享期间短暂保存，并非只上传模糊位置。定位不一定精确到米。"
          }
        }
      }
    },
    "personalLocationShare.acknowledgements": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm each disclosure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐项确认"
          }
        }
      }
    },
    "personalLocationShare.firstPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If not already authorized, allow a foreground location permission prompt after this confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如尚未授权，允许本次确认后询问前台定位权限"
          }
        }
      }
    },
    "personalLocationShare.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and start sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认开始共享"
          }
        }
      }
    },
    "personalLocationShare.requests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original requests and pending revocations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求与待撤销"
          }
        }
      }
    },
    "personalLocationShare.emptyRequests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No original requests are pending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的原请求。"
          }
        }
      }
    },
    "personalLocationShare.readRequest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询原请求"
          }
        }
      }
    },
    "personalLocationShare.retryStop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry original request revocation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试原请求撤销"
          }
        }
      }
    },
    "personalLocationShare.stop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即停止"
          }
        }
      }
    },
    "personalLocationShare.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore original requests (without resuming capture)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复原请求（不恢复采集）"
          }
        }
      }
    },
    "personalLocationShare.grants": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active shares"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享授权"
          }
        }
      }
    },
    "personalLocationShare.refreshManagement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh management status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新管理状态"
          }
        }
      }
    },
    "personalLocationShare.stopGrant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop this grant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止此授权"
          }
        }
      }
    },
    "personalLocationShare.received": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received locations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收到的位置"
          }
        }
      }
    },
    "personalLocationShare.refreshReceived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh shared locations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新收到的位置"
          }
        }
      }
    },
    "personalLocationShare.emptyLocations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verifiable, valid locations are available. Locations are hidden immediately when offline, in the background, or when the lease expires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可验证且仍有效的位置。断网、后台或租约到期会立即隐藏。"
          }
        }
      }
    },
    "personalLocationShare.coarseObservation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Representative coarse-area point, not the original location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粗略区域代表点，非原始位置"
          }
        }
      }
    },
    "personalLocationShare.exactObservation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized original sample; not a statement of measurement accuracy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权原采样点，不代表测量精度"
          }
        }
      }
    },
    "personalLocationShare.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This observation is stale and is not the current location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观测已陈旧，不代表当前位置"
          }
        }
      }
    },
    "personalLocationShare.snapshot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the latest shared location and may not be real-time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最近一次共享的位置，不保证实时"
          }
        }
      }
    },
    "personalLocationShare.confirmFirstPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm sharing and allow the first foreground permission prompt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认共享并允许首次前台权限询问"
          }
        }
      }
    },
    "personalLocationShare.confirmExistingPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm sharing using existing location permission only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认共享，仅使用已有定位权限"
          }
        }
      }
    },
    "personalLocationShare.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "personalLocationShare.state.creating": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating; you can stop immediately"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建中；可以立即停止"
          }
        }
      }
    },
    "personalLocationShare.state.active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享中"
          }
        }
      }
    },
    "personalLocationShare.state.stopPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped on this device; waiting to confirm the stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已停止，停止待确认"
          }
        }
      }
    },
    "personalLocationShare.state.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing has ended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已结束"
          }
        }
      }
    },
    "personalLocationShare.state.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request awaits verification; capture will not resume automatically"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求待核验；不会自动恢复采集"
          }
        }
      }
    },
    "personalLocationShare.disclosure.audience": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share only with the explicitly identified member above"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅向上方明确成员共享"
          }
        }
      }
    },
    "personalLocationShare.disclosure.precision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to share my device's latest location at the selected precision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意按所选精度共享设备的最新位置"
          }
        }
      }
    },
    "personalLocationShare.disclosure.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree to the selected duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意所选持续时长"
          }
        }
      }
    },
    "personalLocationShare.disclosure.foreground": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand that sharing is foreground-only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理解仅在前台共享"
          }
        }
      }
    },
    "personalLocationShare.disclosure.stop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand that sharing can be stopped at any time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道可以随时停止"
          }
        }
      }
    },
    "personalLocationShare.disclosure.recall": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand that information already seen cannot be recalled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理解已看见的信息无法收回"
          }
        }
      }
    },
    "personalLocationShare.seconds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒"
          }
        }
      }
    },
    "personalLocationShare.policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy: %@, version %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "政策：%@，版本 %@"
          }
        }
      }
    },
    "personalLocationShare.recipientValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipient: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收成员：%@"
          }
        }
      }
    },
    "personalLocationShare.requestValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求：%@"
          }
        }
      }
    },
    "personalLocationShare.recipientGrant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipient: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收成员：%@"
          }
        }
      }
    },
    "personalLocationShare.expires": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期：%@"
          }
        }
      }
    },
    "personalLocationShare.grantStatus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last read status: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次读取状态：%@"
          }
        }
      }
    },
    "personalLocationShare.owner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing member: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享成员：%@"
          }
        }
      }
    },
    "personalLocationShare.coordinates": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude %@, longitude %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纬度 %@，经度 %@"
          }
        }
      }
    },
    "personalLocationShare.observed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观测时间：%@"
          }
        }
      }
    },
    "personalLocationShare.grantExpires": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant expires: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权到期：%@"
          }
        }
      }
    },
    "personalLocationShare.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start sharing with member %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向成员 %@ 开始共享？"
          }
        }
      }
    },
    "personalLocationShare.confirmationSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing with %@, mode %@, for up to %@ seconds; policy %@ v%@. The time limit starts now, so waiting to confirm uses it up. Your latest location is sent to Questify. The recipient only sees the precision you chose; your exact location is kept temporarily under our privacy policy. Sharing works only while the app is open, and what the recipient has already seen can't be taken back. If your phone limits location accuracy, you can't share an exact location. If a permission prompt takes you out of the app, check and confirm again when you return; sharing won't restart on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收成员 %@，模式 %@，最多 %@ 秒；政策 %@ v%@。时长从现在开始计算，等待确认也会占用时间。你的最新位置会上传至城瘾；接收方只能看到你选择的精度，精确位置会按隐私政策短暂保存。仅在应用打开时共享，对方已看到的信息无法收回。如手机限制了定位精度，则无法共享精确位置。若权限弹窗让你离开了应用，返回后需重新检查并确认，不会自动恢复共享。"
          }
        }
      }
    },
    "personalLocationShare.status.01": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂不可用"
          }
        }
      }
    },
    "personalLocationShare.status.02": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in and choose another member. Location sharing isn't on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录并选择其他成员。位置共享尚未开启。"
