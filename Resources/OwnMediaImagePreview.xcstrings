{
  "sourceLanguage": "en",
  "strings": {
    "open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview my image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人图片预览"
          }
        }
      }
    },
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private image preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人图片预览"
          }
        }
      }
    },
    "privateOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the selected image from your own media list. Previewing it does not mean it passed review or is public."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自当前本人媒体记录。能够预览不代表审核通过或已经公开。"
          }
        }
      }
    },
    "unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent image-preview access is unavailable. Existing list and status actions are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立图片预览权限暂不可用，媒体列表及查询状态仍按原权限使用。"
          }
        }
      }
    },
    "loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your private image…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取本人图片…"
          }
        }
      }
    },
    "failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be previewed. Retry only if you want to request a new preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片预览失败。需要时可明确重试，重新请求本人预览。"
          }
        }
      }
    },
    "expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local preview window ended. You can explicitly request a new preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次本地预览时间已结束，可明确重新请求预览。"
          }
        }
      }
    },
    "changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current record or preview access changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前记录或预览权限已变化。"
          }
        }
      }
    },
    "limitations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image preview only. Animated, oversized or unsupported images may not display. No upload, review retry, sharing or saving to Photos is performed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅预览图片。动画、过大或不支持的图片可能无法显示；不会上传、重新提审、分享或保存到相册。"
          }
        }
      }
    },
    "retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a new preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新请求预览"
          }
        }
      }
    },
    "close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭预览"
          }
        }
      }
    }
  },
  "version": "1.0"
}
