{
  "sourceLanguage": "en",
  "strings": {
    "projectNodeTemplate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My saved gameplay drafts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人已有玩法草稿"
          }
        }
      }
    },
    "projectNodeTemplate.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a saved personal gameplay draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本人已有玩法草稿"
          }
        }
      }
    },
    "projectNodeTemplate.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one of your saved gameplay drafts. We'll check it again when you confirm. This only changes the gameplay for this stop and doesn't publish anything or grant any rights."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你已保存的玩法草稿，确认时会再次核对。此操作只更改当前站点的玩法，不会发布内容或授予任何权限。"
          }
        }
      }
    },
    "projectNodeTemplate.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use on this node and save locally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定到此节点并保存到本机"
          }
        }
      }
    },
    "projectNodeTemplate.gameplay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When changing the reference, the existing node, coordinates and story stay in place; a blank node name uses the selected title. Prior template cache is cleared for a changed ID; private gameplay configuration is not copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换玩法时保留当前节点、坐标和故事；节点名为空时使用玩法标题。换 ID 会清除旧模板缓存，不复制私有玩法配置。"
          }
        }
      }
    },
    "projectNodeTemplate.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your drafts aren't available here right now. Your current selection is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处暂不可使用你的草稿，当前选择保持不变。"
          }
        }
      }
    },
    "projectNodeTemplate.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft can't be used as gameplay for this stop. Photo albums are added in the story editor. Your current choice is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该草稿不能用作此站点的玩法；相册请在故事编辑中添加。当前选择保持不变。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
