    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Edit the timeline text and labels. Existing images are retained; this editor does not upload or replace them."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可编辑剧情片段和时刻标签。已有图片会保留；此处不上传或替换图片。"
        }
      }
    }
  },
