{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑活动"
          }
        }
      }
    },
    "entry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit activity content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑活动内容"
          }
        }
      }
    },
    "ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the current activity before editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑前请读取当前活动。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading current activity…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前活动…"
          }
        }
      }
    },
    "load": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取当前活动"
          }
        }
      }
    },
    "editing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are local until reviewed and explicitly saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改仅在本地，审核后需显式保存。"
          }
        }
      }
    },
    "review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the exact update below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请审核下方此次更新的准确内容。"
          }
        }
      }
    },
    "sending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the reviewed update…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存已审核的更新…"
          }
        }
      }
    },
    "acknowledged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update acknowledged. Read current activity to begin another edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到更新回执。再次编辑前请读取当前活动。"
          }
        }
      }
    },
    "rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update rejected. Your draft is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新被拒绝，草稿已保留。"
          }
        }
      }
    },
    "notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update was not sent. Review the current activity again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送更新，请重新读取并审核。"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome unknown. The original request remains locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未知，原请求保持锁定。"
          }
        }
      }
    },
    "unknownBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readback is independent evidence, not a receipt. Matching content does not unlock or resend this request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读回仅提供独立信息，并非更新回执。内容相同也不会解锁或重发请求。"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable or invalid input. Your current draft is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可用或输入无效，当前草稿已保留。"
          }
        }
      }
    },
    "conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current activity differs from your source. Keep your draft or explicitly use the latest readback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前活动与原稿已不同。可保留草稿，或显式使用最新读回。"
          }
        }
      }
    },
    "readback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest readback is shown separately. Your draft has not been replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新读回单独显示，草稿未被替换。"
          }
        }
      }
    },
    "localSaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft saved locally. No update was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存到本地，未发送更新。"
          }
        }
      }
    },
    "saveLocal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save local draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存本地草稿"
          }
        }
      }
    },
    "reviewAction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核更新"
          }
        }
      }
    },
    "reviewBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the displayed activity content will be updated. No ticket, payment, collaborator or publication-status change is included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅更新所列活动内容。不更改票务、支付、协作者或发布状态。"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save reviewed update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存已审核的更新"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回编辑"
          }
        }
      }
    },
    "useReadback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard local edits and use this readback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃本地修改并使用此读回"
          }
        }
      }
    },
    "latest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest independent readback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新独立读回"
          }
        }
      }
    },
    "timeLocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sales lock the activity time and location. Text and cover edits remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有订单锁定活动时间和地点，文字及封面仍可编辑。"
          }
        }
      }
    },
    "ticketBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing tickets and collaborators are preserved. This editor does not modify them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已有票务和协作者，此编辑器不修改它们。"
          }
        }
      }
    },
    "name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述"
          }
        }
      }
    },
    "imgUrl": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封面地址"
          }
        }
      }
    },
    "imgArr": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallery URLs, separated by semicolons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮播图地址，用分号分隔"
          }
        }
      }
    },
    "categoryIds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category IDs, separated by commas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类编号，用逗号分隔"
          }
        }
      }
    },
    "addressName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场所名称"
          }
        }
      }
    },
    "longitude": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longitude"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经度"
          }
        }
      }
    },
    "latitude": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纬度"
          }
        }
      }
    },
    "address": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详细地址"
          }
        }
      }
    },
    "startDate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start, yyyy-MM-dd HH:mm:ss (Beijing)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间，yyyy-MM-dd HH:mm:ss（北京时间）"
          }
        }
      }
    },
    "endDate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End, yyyy-MM-dd HH:mm:ss (Beijing)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间，yyyy-MM-dd HH:mm:ss（北京时间）"
          }
        }
      }
    },
    "templateId": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play template ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩法模板编号"
          }
        }
      }
    }
  },
  "version": "1.0"
}
