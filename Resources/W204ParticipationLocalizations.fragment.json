    "playerJourney.parity.fixedRules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit and pause rules: Merchants may only apply to exit at least 3 days before a route session starts. Once a session has started, because it is centrally scheduled and involves several parties, merchants cannot exit midway or pause on their own. For emergencies such as force majeure, please contact customer service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出与暂停规则说明： 商家仅可在路线场次开始前3天申请退出。一旦场次启动，鉴于官方统一调度及多方协作的特性，商家不可中途退出或自行暂停。如遇不可抗力等紧急情况，请务必联系客服介入处理。"
          }
        }
      }
    }
