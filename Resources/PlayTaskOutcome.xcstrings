{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task result and next step"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务结果与下一步"
          }
        }
      }
    },
    "refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check current progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对当前进度"
          }
        }
      }
    },
    "back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回任务"
          }
        }
      }
    },
    "state.awaitingRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for current progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待当前进度"
          }
        }
      }
    },
    "state.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking current progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对当前进度"
          }
        }
      }
    },
    "state.reviewing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before sending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认后提交"
          }
        }
      }
    },
    "state.submitting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending your response"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在提交"
          }
        }
      }
    },
    "state.needsReadback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the recorded result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对记录结果"
          }
        }
      }
    },
    "state.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result is not yet confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认"
          }
        }
      }
    },
    "state.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read current progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取当前进度"
          }
        }
      }
    },
    "state.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is recorded as complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务已记录为完成"
          }
        }
      }
    },
    "state.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is not recorded as complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务尚未记录为完成"
          }
        }
      }
    },
    "state.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is currently locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务当前未解锁"
          }
        }
      }
    },
    "state.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current task status is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务状态不可用"
          }
        }
      }
    },
    "detail.awaitingRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the current record before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先核对当前记录再继续。"
          }
        }
      }
    },
    "detail.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh read is in progress. Nothing is being submitted again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取最新进度，不会重新提交。"
          }
        }
      }
    },
    "detail.reviewing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the existing confirmation to send or cancel your response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在原确认框中提交或取消。"
          }
        }
      }
    },
    "detail.submitting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the response and a fresh progress check. Do not submit again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待响应和最新进度核对，不要重复提交。"
          }
        }
      }
    },
    "detail.needsReadback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A response alone does not establish the current task state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅收到响应不能确定任务当前状态。"
          }
        }
      }
    },
    "detail.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earlier action may have reached the service. Checking progress only reads the record and does not resend it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前操作可能已到达服务端。核对进度只读取记录，不会重新提交。"
          }
        }
      }
    },
    "detail.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a fresh progress read. A read error does not mean that an earlier action failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可重新读取当前进度。读取出错不代表此前操作失败。"
          }
        }
      }
    },
    "detail.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This status comes from the current progress record, not from a local animation or receipt alone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此状态来自当前进度记录，不由本机动画或单独回执推断。"
          }
        }
      }
    },
    "detail.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current record has not marked this task complete. Continue using the existing task controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前记录尚未标记此任务完成，请使用原任务操作继续。"
          }
        }
      }
    },
    "detail.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the task list to see the currently available choices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回任务列表查看当前可选任务。"
          }
        }
      }
    },
    "detail.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check progress or return to the task list. No completion is assumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可核对进度或返回任务列表，不会推定任务完成。"
          }
        }
      }
    },
    "continue.nextTask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One next task is currently available. Return to tasks to open it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前有一个可继续的任务。请返回任务列表打开。"
          }
        }
      }
    },
    "continue.chooseTask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several tasks are available. Return to tasks and choose where to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前有多个可选任务。请返回任务列表自行选择。"
          }
        }
      }
    },
    "continue.finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current record marks the journey complete. Return to its overview for results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前记录已标记旅程完成。请返回概览查看结果。"
          }
        }
      }
    },
    "continue.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to tasks to check the available next steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回任务列表查看可用的下一步。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
