    "storeCharacter.consent.agree": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separately consent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独同意"
          }
        }
      }
    },
    "storeCharacter.consent.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording will be sent to the Alibaba Cloud voice model (Tongyi CosyVoice) to create a dedicated voice for speech synthesis. If the recording is not your own voice, you must have told the voice owner and obtained their separate consent. The generated speech will be played to players during play. Do you confirm and separately consent? Declining does not affect other features."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段录音将发送给阿里云语音模型（通义 CosyVoice），用于生成可合成语音的专属音色。如录音不是你本人的声音，你必须已告知声音本人并取得其单独同意；生成的语音会在游玩中播放给玩家。是否确认并单独同意？拒绝不会影响其他功能。"
          }
        }
      }
    },
    "storeCharacter.consent.decline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "storeCharacter.consent.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice cloning processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音克隆处理"
          }
        }
      }
    },
