    "context.rules.leaveClub.chat.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat access is removed together"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群聊清理与退出一起完成"
          }
        }
      }
    },
    "context.rules.leaveClub.membership.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result lists cancelled periods, blocked bills, pending reviews and non-refundable items, and reports whether payouts have completed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会一并处理未到期的会籍：列出已取消的期数、被拦下的账单、待审条数与不可退条数，并告诉你打款是否已完成。"
          }
        }
      }
    },
    "context.rules.leaveClub.membership.title": {
      "extractionState": "manual",
      "localizations": {
