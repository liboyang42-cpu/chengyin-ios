    "merchant.onboarding.identity.regionalGate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current source service requires a mainland Chinese resident ID with an 18-character checksum. A supported US registration process has not been verified, so this app cannot complete new identity enrollment. No SSN or EIN is requested here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前源服务要求具有校验位的 18 位中国大陆居民身份证号。美国登记流程尚未核实，因此本应用暂不能完成新的实名登记。此处不会要求 SSN 或 EIN。"
          }
        }
      }
    },
