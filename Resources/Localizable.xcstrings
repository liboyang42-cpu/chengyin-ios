          "stringUnit": {
            "state": "translated",
            "value": "Control your location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位由你控制"
          }
        }
      }
    },
    "roam.live.rules": {
