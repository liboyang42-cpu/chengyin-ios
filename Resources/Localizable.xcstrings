    "squareReport.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid reason and enter a description of no more than 2,000 UTF-16 units. You cannot report your own comment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择有效原因并填写不超过2000个UTF-16单元的说明；不能举报自己的评论。"
          }
        }
      }
    },
    "squareReport.legacyBookmarkBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks use the versioned community contract. Legacy post IDs cannot be mapped to it safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏使用新版社区接口，旧版动态编号不能安全地映射到该接口。"
          }
        }
      }
    },
    "squareReport.legacyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy post report: your selected reason is sent with the post ID. This does not create a versioned-policy case."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版动态举报：内容编号与所选原因一起提交，不会生成版本化规则案件。"
          }
        }
      }
    },
    "squareReport.legacyLikeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This legacy action toggles the current post like once. An unconfirmed result remains locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版接口会切换一次当前动态点赞状态，结果未确认时继续保持锁定。"
          }
        }
      }
    },
