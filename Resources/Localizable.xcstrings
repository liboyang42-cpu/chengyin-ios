    "merchant.operations.exampleSaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline example saved. No real business change was made."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线示例已保存，未产生真实业务变更。"
          }
        }
      }
    },
    "merchant.operations.localDraftOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your edits stay in memory and are not submitted or persisted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改仅保留在内存中，不会提交或持久保存。"
          }
        }
      }
    },
    "merchant.operations.unknownOutcome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The example outcome is unknown. Saving is locked; reading again does not prove that the earlier operation failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例结果未确认，保存已锁定；再次读取不能证明之前的操作失败。"
          }
        }
      }
    },
    "merchant.operations.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed while you were reviewing. Reload before preparing another draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查草稿期间来源已变更，请重新读取后再编辑。"
          }
        }
      }
    },
    "merchant.operations.confirmExampleBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this frozen draft only to the offline example for this session?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否仅将这份草稿保存到本次会话的离线示例？"
          }
        }
      }
    },
    "merchant.operations.reviewNoApproval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved draft does not mean content approval, public visibility, or activation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿保存不代表内容审核通过、公开可见或业务生效。"
          }
        }
      }
    },
    "merchant.operations.profileWhitelist": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only name, introduction, merchandise, website, preferences and the existing logo belong to this source contract."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此来源接口仅包含名称、简介、衍生品、网站、偏好及原有标志。"
          }
        }
      }
    },
    "merchant.operations.decorPreserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category, featured content, service details and location fields remain as read. Their selectors need separate verified contracts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行业、精选内容、服务信息及位置字段按读取值保留；相关选择器需要独立验证的契约。"
          }
        }
      }
    },
    "merchant.operations.tagsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate tags with semicolons. The request preview uses a JSON array string."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以分号分隔标签，请求预览使用 JSON 数组字符串。"
          }
        }
      }
    },
    "merchant.operations.galleryHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 9 images. Removing an item only edits this local draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 9 张图片，移除操作只修改本地草稿。"
          }
        }
      }
    },
    "merchant.operations.uploadDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image selection, permissions and real uploads are not enabled. Existing references are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未开放图片选择、权限申请和真实上传，原有图片引用会保留。"
          }
        }
      }
    },
    "merchant.operations.storyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story body only, up to 300 UTF-16 units. The existing hidden title is preserved; the source save uses two separate operations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅编辑故事正文，最多 300 个 UTF-16 单元。保留原有隐藏标题，来源保存涉及两个独立操作。"
          }
        }
      }
    },
    "merchant.operations.coopPreserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity types and cooperation availability are hidden source fields and will be preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合活动类型与合作开放状态为隐藏来源字段，会原样保留。"
          }
        }
      }
    },
    "merchant.operations.characterReviewHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the private store character. Its review state is independent from public visibility, voice and 3D generation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是门店私有形象配置，其审核状态与公开展示、声音及 3D 生成分别独立。"
          }
        }
      }
    },
    "merchant.operations.templateOwnerOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private template answers are read from the owner-only detail endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板答案仅从所有者专用详情接口读取。"
          }
        }
      }
    },
    "merchant.operations.templateOmissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank optional fields are omitted by the source contract; blanking one does not request deletion of its saved value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源契约会省略空的可选字段；清空输入不代表删除已存值。"
          }
        }
      }
    },
    "merchant.operations.templatePageLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source reads page 1 with up to 100 templates. This is not a complete or paginated inventory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源读取第 1 页，最多 100 个模板；这不是完整或可翻页的清单。"
          }
        }
      }
    },
    "merchant.operations.cityReadOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location claims, placement, withdrawal, online status changes and redemption are unavailable here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处尚未开放据点认领、投放、撤回、上下架和核销操作。"
          }
        }
      }
    },
    "merchant.operations.quotaExhausted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reported location limit has been reached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端报告的据点配额已用完。"
          }
        }
      }
    },
    "merchant.operations.resourcesBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-reported resources only. No recording, cloning, generation, playback, download or automatic polling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅展示来源报告的资源状态，不录音、克隆、生成、播放、下载或自动轮询。"
          }
        }
      }
    },
    "merchant.operations.voiceDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice consent, microphone access, sample upload and revocation are not enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音授权、麦克风权限、样本上传及撤销尚未开放。"
          }
        }
      }
    },
    "merchant.operations.avatarDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image upload, 3D generation and model downloads are not enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片上传、3D 生成及模型下载尚未开放。"
          }
        }
      }
    },
    "merchant.operations.galleryLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at most 9 gallery images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册最多保留 9 张图片。"
          }
        }
      }
    },
    "merchant.operations.featuredIncomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Featured type and ID must be present together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精选类型和编号必须同时存在。"
          }
        }
      }
    },
