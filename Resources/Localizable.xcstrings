      }
    },
    "playx.prefab.ending.0.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准版本"
          }
        }
      }
    },
    "playx.prefab.ending.0.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Look, I am standing straight, my hands by my sides.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“你看，我现在站得直直的，双手贴在裤缝边。”"
          }
        }
      }
    },
    "playx.prefab.ending.0.condition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing diverged. You lived the life arranged for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都没有偏离，你过完了被安排好的一生"
          }
        }
      }
    },
    "playx.prefab.ending.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交接"
          }
        }
      }
    },
    "playx.prefab.ending.1.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“A younger you takes over. They stand straighter than you.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“接手的是一个更年轻的你，他站得比你更直。”"
          }
        }
      }
    },
    "playx.prefab.ending.1.condition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After chapter three, there were many clicks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在第三章之后，“咔哒”了很多次"
          }
        }
      }
    },
    "playx.prefab.ending.2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boundary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边界"
          }
        }
      }
    },
    "playx.prefab.ending.2.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The world allows you to exist, but will not fully accept you.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“世界允许你存在，却不会完全接纳你。”"
          }
        }
      }
    },
    "playx.prefab.ending.2.condition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You approached many times without opening the final boundary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你靠近过很多次，但没有推开最后那道边界"
          }
        }
      }
    },
    "playx.prefab.ending.3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coexistence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共处"
          }
        }
      }
    },
    "playx.prefab.ending.3.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Unattached, the mind arises.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“他无所住，生其心。”"
          }
        }
      }
    },
    "playx.prefab.ending.3.condition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See enough people, read every dream, then choose to stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看见足够多的人，读完所有的梦，然后选择留下"
          }
        }
      }
    },
    "playx.prefab.ending.4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出走"
          }
        }
      }
    },
    "playx.prefab.ending.4.quote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Look. I am standing straight.” Then it leaves the screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“你看，我现在站得直直的。”然后它走出了屏幕"
          }
        }
      }
    },
    "playx.prefab.ending.4.condition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the final boundary, having truly seen the city."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推开最后那道边界，也需要你真的看过这座城市"
          }
        }
      }
    },
    "playx.prefab.ending.5.title": {
