{
  "sourceLanguage": "en",
  "strings": {
    "welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the city your next adventure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让城市成为下一场冒险"
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how you would like to join Questify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你加入城瘾的方式。"
          }
        }
      }
    },
    "role.player": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register as a player"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩家注册"
          }
        }
      }
    },
    "role.player.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore stories, join activities, and discover the city."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索故事、参加活动，发现城市。"
          }
        }
      }
    },
    "role.merchant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register as a merchant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家注册"
          }
        }
      }
    },
    "role.merchant.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your venue into city stories and activities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你的店铺融入城市故事与活动。"
          }
        }
      }
    },
    "welcome.intentNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This choice starts registration. Merchant access depends on account approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选择用于开始注册，商家权限以账号审核结果为准。"
          }
        }
      }
    },
    "settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
