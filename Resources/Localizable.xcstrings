    "context.rules.leaveClub.owner.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer ownership through member governance, or dissolve the club before leaving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
