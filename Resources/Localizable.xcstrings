    "merchant.onboarding.submitConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the reviewed store details, contact phone, address, business hours and uploaded license reference to the configured Chengyin service for review. Submission does not grant approval or merchant access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已核对的门店资料、联系电话、地址、营业时间和已上传执照信息发送给已配置的城瘾服务审核。提交不代表审核通过，也不会获得商家权限。"
          }
        }
      }
    },
