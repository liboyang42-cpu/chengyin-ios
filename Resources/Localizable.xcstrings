{
  "sourceLanguage": "en",
  "strings": {
    "welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the city your next adventure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让城市成为下一场冒险"
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how you would like to join Questify."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你加入城瘾的方式。"
          }
        }
      }
    },
    "role.player": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register as a player"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩家注册"
          }
        }
      }
    },
    "role.player.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore stories, join activities, and discover the city."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索故事、参加活动，发现城市。"
          }
        }
      }
    },
    "role.merchant": {
      "extractionState": "manual",
