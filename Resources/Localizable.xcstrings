          "stringUnit": {
            "state": "translated",
            "value": "未向附近玩家上报状态"
          }
        }
      }
    },
    "roam.live.presenceOn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby visibility is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在向附近玩家展示状态"
          }
        }
      }
    },
    "roam.live.presencePrivacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the server receives your fix and shows nearby players your approximate location (rounded to three decimals), nickname, avatar, exploration percent, shop count and walk duration. Pausing or leaving stops reports. Existing presence can remain visible for up to five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，服务器接收定位，向附近玩家展示约三位小数精度的位置、昵称、头像、探索比例、探店数和在走时长。暂停或离开会停止上报；已上报的状态最多仍可能显示五分钟。"
          }
        }
      }
    },
    "roam.live.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you choose Start, foreground location is used to measure this walk, reveal visited tiles and verify arrivals you choose. Your precise fixes and route stay in memory. Pending tiles and measured distance are protected on this device for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择开始后，仅在前台使用定位，记录本次步行距离、点亮经过的格子，并核验你主动选择的到点操作。精确定位和轨迹仅保留在内存中；待确认格子与实测距离受保护地保存在本机，用于恢复核对。"
          }
        }
      }
    },
    "roam.live.purposeTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk and discover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行探索城市"
          }
        }
      }
    },
    "roam.live.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready when you are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备出发"
          }
        }
      }
    },
    "roam.live.recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check server status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对服务器状态"
          }
        }
      }
    },
    "roam.live.recoveryHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier operation needs checking. Keep this record. Checking reads the server status and does not repeat a discovery or award rewards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的操作需要核对，请保留这份记录。核对只读取服务器状态，不会重复提交发现操作或发放奖励。"
          }
        }
      }
    },
    "roam.live.resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume this walk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续本次漫游"
          }
        }
      }
    },
    "roam.live.ruleArrival": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a nearby verified place to confirm arrival, or record a merchant visit. The server checks the place, session and distance. Browse-only examples cannot be checked in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择附近的真实地点确认到达，或记录探店。服务器会核验地点、会话与距离。仅供浏览的演示点不能打卡。"
          }
        }
      }
    },
    "roam.live.ruleArrivalTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an arrival to confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动确认到点"
          }
        }
      }
    },
    "roam.live.ruleExplore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no fixed route. Start explicitly, then walk to reveal visited blocks. Distance excludes paused gaps, poor fixes and large GPS jumps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不绑定固定路线。主动开始后，步行点亮经过的街区。暂停期间、低精度定位和明显跳点不会计入距离。"
          }
        }
      }
    },
    "roam.live.ruleExploreTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore at your own pace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由探索"
          }
        }
      }
    },
    "roam.live.ruleFinish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish to check server-confirmed exploration XP and shop totals. Displayed rule values are not an award. Saved history contains measured totals; live exact route samples are not archived."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束后核对服务器确认的探索值与探店总数。规则中的数值不等于已获奖励。本机历史保存实测汇总，不存档实时精确轨迹。"
          }
        }
      }
    },
    "roam.live.ruleFinishTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish and keep the result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束与记录"
          }
        }
      }
    },
    "roam.live.rulePrivacyTitle": {
