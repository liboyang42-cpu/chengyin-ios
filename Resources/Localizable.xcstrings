    "creator.validation.state": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a permitted state key, operation and value. sys.luck allows only INC 1–3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用允许的状态键、操作和值。sys.luck 仅允许 INC 1–3。"
