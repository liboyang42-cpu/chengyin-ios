    "playx.prefab.endings.fixed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the source story’s fixed ending descriptions, not a server-awarded result or live player statistics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
