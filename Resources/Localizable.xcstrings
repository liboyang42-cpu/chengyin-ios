    "team.create.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating a team does not register anyone, buy tickets or change refund rules. Public teams appear in nearby teams and require captain approval for applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建队不代替报名或购票，也不改变退款规则。公开队伍会出现在附近的队伍，申请需要队长逐个同意。"
          }
        }
      }
    },
    "team.create.privateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only players with an invitation can join"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅持有邀请的玩家可以加入"
          }
        }
      }
    },
    "team.create.publicHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public by default. Nearby players can apply and the captain reviews each application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认公开，附近玩家可以申请，由队长逐个审核。"
