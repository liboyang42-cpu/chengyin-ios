          }
        }
      }
    },
    "merchant.operations.liveDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live saving is unavailable. These forms only prepare local drafts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实保存尚未开放，这些表单仅用于准备本地草稿。"
