    "context.rules.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules explain the current workflow. Each action still checks current permissions, orders and service windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里说明当前流程的规则。实际操作仍以当时的权限、订单和服务窗口核验为准。"
          }
        }
      }
    },
    "context.rules.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausing a station"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停一个站点"
          }
        }
      }
    },
    "context.rules.pause.backup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup station cannot be assigned directly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能直接指定备用站点。"
          }
        }
      }
    },
    "context.rules.pause.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an approved backup plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须绑定已批准的备用方案"
          }
        }
      }
    },
    "context.rules.pause.blocked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players cannot submit and merchants cannot verify there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩家提交不了，商家也核验不了。"
          }
        }
      }
    },
    "context.rules.pause.blocked.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The station stops while paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间这一站停摆"
          }
        }
      }
    },
    "context.rules.pause.fallback.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a pause is linked to a plan, reaching the backup station automatically records fallback completion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点暂停并绑定方案后，玩家走到备用站点时会自动记为兜底完成，不需要手动操作。"
          }
        }
      }
    },
    "context.rules.pause.fallback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallback completion is automatic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兜底完成是自动的"
          }
        }
      }
    },
    "context.rules.pause.reason.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both fields must be supplied before submission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个都要填，否则提交不了。"
          }
        }
      }
    },
    "context.rules.pause.reason.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason and estimated recovery are required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因和预计恢复时间都必填"
          }
        }
      }
    },
    "context.rules.pause.resume.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event and station must both be within their service windows before recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动服务窗和站点服务窗都得在窗内才恢复得了。"
          }
        }
      }
    },
    "context.rules.pause.resume.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both service windows must be open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复要过两个服务窗"
          }
        }
      }
    },
    "context.rules.pause.scope.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issued benefits and completed submissions remain unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不改变已发放的权益，也不动已经完成的提交。"
          }
        }
      }
    },
    "context.rules.pause.scope.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this station is affected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停只影响本站"
          }
        }
      }
    },
    "context.rules.refund": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds after leaving"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出以后的钱"
          }
        }
      }
    },
    "context.rules.refund.deadline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City routes use meeting time, free exploration uses topic validity, and activities use their start time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市定向按集合时间、自由探索按主题有效期、活动按开始时间，各有一个截止时点。"
          }
        }
      }
    },
    "context.rules.refund.deadline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund deadlines depend on the product"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过了时点不退"
          }
        }
      }
    },
    "context.rules.refund.missing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A missing refund cutoff goes to manual review rather than an automatic refusal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款截止时间缺失时转人工核实，不由系统自行决定。"
          }
        }
      }
    },
    "context.rules.refund.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing deadlines require review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算不出来不代表不该退"
          }
        }
      }
    },
    "context.rules.refund.redeemed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free exploration is the exception and requires manual support review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核销的报名不可退款；自由探索是唯一例外，需人工核实，请联系客服。"
          }
        }
      }
