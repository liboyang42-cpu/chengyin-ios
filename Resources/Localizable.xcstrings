      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving this screen, locking the phone or moving the app to the background pauses collection and nearby visibility. Return and choose Resume to continue. Unconfirmed operations are kept for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开此页、锁屏或切到后台会暂停定位采集与附近状态上报。返回后需主动选择继续。未确认的操作会保留以便恢复核对。"
          }
        }
      }
    },
