    "nativePlatform.reminder.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow an alert and sound on this device for the exact service time shown. No push token is sent. Delivery depends on iPhone settings. If the service changes while this app is closed, the reminder may be outdated; reopening the app checks the time again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在所示的服务时间于本机显示提醒并播放声音。不发送推送令牌。送达取决于 iPhone 设置。应用关闭期间若服务时间更改，提醒可能过时；重新打开应用会再次核对。"
          }
        }
      }
    },
