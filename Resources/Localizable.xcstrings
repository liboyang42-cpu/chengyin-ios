    "context.rules.leaveClub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving a club"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出俱乐部"
          }
        }
      }
    },
    "context.rules.leaveClub.chat.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving will not complete unless club chat access is also removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群聊权限没清理干净就不会退出，不会出现「退了但群还在」。"
          }
        }
      }
