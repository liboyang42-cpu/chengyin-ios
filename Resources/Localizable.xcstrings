      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This activity uses motion readings to move the ball as you tilt your phone and count wall contacts. Keep a firm grip and stay still."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此玩法使用运动读数，让球随手机倾斜移动并记录撞墙次数。请握稳手机，站在安全的位置。"
          }
        }
      }
    },
    "playkit.sensor.purpose.compass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This activity uses the compass to read the magnetic direction of the top of your phone and requires location permission. No location coordinates are read or sent. Hold the phone upright in portrait and keep it aligned with the target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此玩法使用罗盘读取手机顶部的磁北方位角，需要位置权限，但不会读取或发送位置坐标。请竖屏握住手机并持续对准目标方向。"
          }
        }
      }
    },
    "playkit.sensor.purpose.quietHold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This activity uses the microphone to measure ambient peak volume. Keep quiet for the required time after the server confirms the start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此玩法使用麦克风测量环境声音峰值。服务器确认开始后，请在要求的时间内保持安静。"
          }
        }
      }
    },
