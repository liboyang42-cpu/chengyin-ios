    "social.explicitActionHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the requested state, not a claim about the current saved state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处是希望设置的状态，不代表服务端当前状态。"
          }
        }
      }
    },
    "social.toggleHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source action toggles the existing comment like. An uncertain result must not be retried automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会切换评论点赞状态。结果未确认时不能自动重试。"
          }
        }
      }
    },
    "social.reportHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this item to the review queue. The source endpoint accepts the item ID only, with no reason or evidence fields."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此内容提交审核队列。源接口只接受内容编号，不接受理由或证据字段。"
          }
        }
      }
    },
    "social.followToggleHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the current follow relationship once. The server must confirm the resulting relationship; an uncertain result stays locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换一次当前关注关系。结果必须由服务端确认，未确认时保留锁定。"
          }
        }
      }
    },
    "social.startChatHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a conversation with this member. Navigation requires a positive conversation ID from the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
