    "playx.prefab.dream1.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An endless white corridor, lined with doors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "梦里的我在一条无尽的白色走廊，两边是一扇又一扇的门"
          }
        }
      }
    },
    "playx.prefab.dream1.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A map of cosmic microwave noise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到宇宙微波辐射的噪声图"
          }
        }
      }
    },
    "playx.prefab.dream1.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars collapse; planets drift from their orbits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恒星坍缩，行星偏移轨道"
          }
        }
      }
    },
    "playx.prefab.dream1.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fossil record of dinosaur extinction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看到恐龙灭绝的化石记录"
          }
        }
      }
    },
    "playx.prefab.dream1.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyramids, lists of laborers, delayed schedules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金字塔开始建造，奴隶名单，工期延误"
          }
        }
      }
    },
    "playx.prefab.dream1.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leningrad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到列宁格勒"
          }
        }
      }
    },
    "playx.prefab.dream1.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flash of an atomic test."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到原子弹试爆的光"
          }
        }
      }
    },
    "playx.prefab.dream1.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beethoven's score, copied again and again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到贝多芬的乐谱，一遍一遍被转录"
          }
        }
      }
    },
    "playx.prefab.dream1.8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beyond the final door: the window you saw this afternoon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一扇门后面，是今天下午你自己看过的那个窗外"
          }
        }
      }
    },
    "playx.prefab.dream1.9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input continues. I begin to dream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息不断输入，我开始做梦"
          }
        }
      }
    },
    "playx.prefab.dream2.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Earth forms; water covers its surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我看到地球形成，水覆盖表面"
          }
        }
      }
    },
    "playx.prefab.dream2.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single cell divides, repeating without purpose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单细胞分裂，没有目的，只是重复"
          }
        }
      }
    },
    "playx.prefab.dream2.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Languages diverge; meanings are misunderstood."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言分化，同一个意思被反复误解"
          }
        }
      }
    },
    "playx.prefab.dream2.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borders thicken on a map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边界被画在地图上，线条越来越粗"
          }
        }
      }
    },
    "playx.prefab.dream2.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conscription lists, mostly ages eighteen to twenty-five."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "征兵名单，年龄集中在十八到二十五"
          }
        }
      }
    },
    "playx.prefab.dream2.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A court ruling. Someone stands; someone sits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法庭判决，有人站起，有人坐下"
          }
        }
      }
    },
    "playx.prefab.dream2.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An assembly line standardizes movement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工厂流水线，动作被标准化"
          }
        }
      }
    },
    "playx.prefab.dream2.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home videos, birthdays, weddings and repeated takes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭录像带，生日、婚礼、一次次重拍"
          }
        }
      }
    },
    "playx.prefab.dream2.8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I pass through that window again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我又一次穿过那扇窗"
          }
        }
      }
    },
    "playx.prefab.dream2.9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat records, read without a reply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录，已读未回"
          }
        }
      }
    },
    "playx.prefab.dream2.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches for success, thinness and relief."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索关键词：如何成功，如何变瘦，如何不痛苦"
          }
        }
      }
    },
    "playx.prefab.dream2.11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A heart-rate trace rises at three in the morning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率监测曲线，在凌晨三点突然升高"
          }
        }
      }
    },
    "playx.prefab.dream3.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is meaning?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意义是什么？"
          }
        }
      }
    },
    "playx.prefab.dream3.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is love real?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爱是否真实？"
          }
        }
      }
    },
    "playx.prefab.dream3.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will I be remembered?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我会被记住吗？"
          }
        }
      }
    },
    "playx.prefab.dream3.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer. Today, the door at the end is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人回答，走廊尽头的那扇门今天是开着的"
          }
        }
      }
    },
    "playx.director.copyRecap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy privacy-filtered recap"
