{
  "sourceLanguage": "en",
  "strings": {
    "copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy approved link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制已审链接"
          }
        }
      }
    },
    "longLived": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link may remain usable for a long time. Signing out or revoking this page’s access cannot recall a copied link. Share only with people you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可能长期有效。复制后，退出登录或撤销本页授权都无法收回链接，请仅分享给信任的人。"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying is unavailable. Current access to your media list and separate permission for this item are required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法复制。需要有效的本人列表及该媒体的独立复制权限。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechecking approval…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新核验已审状态…"
          }
        }
      }
    },
    "copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied to this device’s clipboard. Nothing was downloaded or shared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制到本机剪贴板；未下载或分享。"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved link is unavailable or copying failed. Check its status or tap Copy again to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已审链接暂不可用或复制失败。请查询状态，或再次点击复制重试。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
