        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集邮相机"
          }
        }
      }
    },
    "media.stamp.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a new photo and review its 4:5 center crop before uploading. Saving to the album is a separate confirmed step. No location is requested."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄新照片后，先预览 4:5 中心裁切，再确认上传。上传成功后另行确认入册。本流程不请求定位。"
          }
        }
      }
    },
    "media.stamp.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and photo upload are not enabled for this deployment"
