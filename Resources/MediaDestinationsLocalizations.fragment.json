    "media.poster.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the place poster"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描据点海报"
          }
        }
      }
    },
    "media.poster.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with the camera and use one fresh foreground location to verify this place. Scanning alone does not complete check-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机扫描，并获取一次当前前台位置核验据点。扫描本身不代表打卡完成。"
          }
        }
      }
    },
    "media.poster.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera, location and check-in are not enabled for this deployment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此环境尚未启用相机、定位与打卡提交"
          }
        }
      }
    },
    "media.poster.consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow this scan and one location check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意本次扫描与一次定位核验"
