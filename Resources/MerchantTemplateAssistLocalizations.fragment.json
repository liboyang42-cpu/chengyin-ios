    }
  },
  "merchant.assist.error.disabled": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "AI generation is not enabled. No request was sent."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "尚未启用 AI 生成，未发送请求。"
