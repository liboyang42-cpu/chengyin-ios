  "merchant.assist.permissionNextStep": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Check your merchant access and active identity in Settings, or sign in again. Repeating this request will not change your permissions."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请在设置中检查商家权限和当前身份，或重新登录。反复重试不会改变权限。"
        }
      }
    }
  },
