  "merchant.assist.unsupportedHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "These fields are shown in full for review but are not saved by this form. A story may supply only the first 30 characters as a description when no description was returned."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这些字段完整展示供检查，但不会由此表单保存。未返回描述时，仅将故事的前 30 个字符用作描述。"
        }
      }
    }
  },
  "merchant.assist.applyHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Only untouched, empty fields will be filled. Your existing values and any changes made since generation began are preserved. Save separately after reviewing the template."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "只填入未编辑过的空字段，保留已有内容及开始生成后所作的修改。请检查模板后另行保存。"
        }
      }
    }
  },
  "merchant.assist.noChanges": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "There are no applicable empty fields. Your draft will stay as it is."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "没有可以填入的空字段，草稿将保持原样。"
        }
      }
    }
  },
  "merchant.assist.apply": {
    "extractionState": "manual",
