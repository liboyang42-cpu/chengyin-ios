  },
  "merchant.assist.error.unknown": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The request outcome is unknown. Do not repeat it; it may have used provider quota. Your draft was not changed."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请求结果未知，请勿重复提交，可能已消耗服务额度。草稿未被修改。"
        }
      }
    }
  },
  "merchant.assist.error.cancelled": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Stopped waiting. Your draft was not changed; a request already sent may still complete."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已停止等待。草稿未被修改，已发送的请求仍可能完成。"
        }
      }
    }
  },
  "merchant.assist.error.stale": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The account, access, or source draft changed. Close this sheet and reopen it from the current draft."
