{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "branchHistory.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View branch history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看分支历史"
          }
        }
      }
    },
    "branchHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run’s branch history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次游玩的分支历史"
          }
        }
      }
    },
    "branchHistory.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only choices recorded by the server for this run appear here, in server order. Times are shown as reported by the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示服务端记录的本次游玩选择，按记录顺序排列。时间按服务端记录展示。"
          }
        }
      }
    },
    "branchHistory.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to summary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回摘要"
          }
        }
      }
    },
    "branchHistory.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No branch choices recorded for this run yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次游玩尚无分支选择记录。"
          }
        }
      }
    },
    "branchHistory.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch history is unavailable for this read. Return to the summary and refresh to check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次读取的分支历史暂不可用。请返回摘要并刷新后再查看。"
          }
        }
      }
    },
    "branchHistory.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read has changed. Return to the summary to view the current run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次读取已更新。请返回摘要查看当前游玩记录。"
          }
        }
      }
    },
    "branchHistory.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some records could not be displayed. This list may be incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分记录无法展示，当前列表可能不完整。"
          }
        }
      }
    },
    "branchHistory.from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从"
          }
        }
      }
    },
    "branchHistory.to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到"
          }
        }
      }
    },
    "branchHistory.nodeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node name unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点名称暂不可用"
          }
        }
      }
    },
    "branchHistory.step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choice %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 次选择"
          }
        }
      }
    },
    "branchHistory.timeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间暂不可用"
          }
        }
      }
    }
  }
}
