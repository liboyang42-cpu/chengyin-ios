{
  "sourceLanguage": "en",
  "strings": {
    "image.retained.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo, review its upload, then attach it. Uploading does not publish your changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片并确认上传后，再将其附加。上传不会发布更改。"
          }
        }
      }
    },
    "image.retained.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片"
          }
        }
      }
    },
    "image.retained.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理照片"
          }
        }
      }
    },
    "image.retained.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected photo preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选照片预览"
          }
        }
      }
    },
    "image.retained.confirmUpload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm photo upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认上传照片"
          }
        }
      }
    },
    "image.retained.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选择"
          }
        }
      }
    },
    "image.retained.uploaded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片已上传"
          }
        }
      }
    },
    "image.retained.use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uploaded photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已上传照片"
          }
        }
      }
    },
    "image.retained.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload outcome is unknown. Do not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传结果未知，请勿自动重试。"
          }
        }
      }
    },
    "image.retained.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo could not be processed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法处理照片"
          }
        }
      }
    },
    "image.retained.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account or destination changed. Select again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或目标已更改，请重新选择。"
          }
        }
      }
    },
    "image.retained.photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        }
      }
    },
    "image.retained.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除照片"
          }
        }
      }
    },
    "image.retained.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭照片"
          }
        }
      }
    },
    "image.retained.reviewBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews may contain up to nine uploaded photos. Publication remains subject to review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评价最多可附加九张已上传照片，发布仍需审核。"
          }
        }
      }
    },
    "image.retained.synthetic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthetic local image example. No library, camera or network access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模拟图片示例，不访问相册、相机或网络。"
          }
        }
      }
    },
    "image.retained.syntheticSelect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select synthetic image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模拟图片"
          }
        }
      }
    }
  },
  "version": "1.0"
}
