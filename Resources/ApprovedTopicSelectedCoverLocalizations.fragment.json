{
  "sourceLanguage": "en",
  "strings": {
    "topicReview.coverSelection.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected cover is available only to its author. Its public-player binding is not configured, so this capture cannot be sent for review or published. The saved legacy cover reference remains unverified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选封面目前仅作者可读，尚未配置玩家读取绑定，因此此快照不能提交审核或发布。原保存的封面引用仍未验证。"
          }
        }
      }
    },
    "topicReview.coverSelection.asset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected asset ID"
          }
        },
        "zh-Hans": {
