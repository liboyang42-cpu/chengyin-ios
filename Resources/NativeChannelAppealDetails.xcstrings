    "result.currentSeparate": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求执行结果已确认；当前申诉状态另行读取，不以历史回执开放新的追加或撤回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request outcome is confirmed. Current appeal status is read separately; a past receipt does not enable a new statement or withdrawal."
          }
        }
      }
    },
    "progress.currentReadFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前申诉进度尚未读回。请刷新原进度；不会重新提交已确认的请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current appeal progress has not been read back. Refresh the original progress; the confirmed request will not be resubmitted."
          }
        }
      }
    },
    "result.acceptedNotReversed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
