    "source.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无法读取或定位原申诉，或原权限、存储不可用；这不表示申诉不存在或操作未发生。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original appeal cannot currently be read or located, or access/storage is unavailable. This does not mean no appeal exists or no action occurred."
          }
        }
      }
    },
    "locator.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机申诉定位暂未保存或读回。已确认的原请求结果不受影响；离开后可能需要从含申诉编号的原通知重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local appeal locator could not be saved or read. Confirmed request results are unchanged; after leaving, you may need the original notice containing the appeal ID."
          }
        }
      }
    },
