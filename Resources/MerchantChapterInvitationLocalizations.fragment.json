    "merchantChapterInvitation.statusUnknown": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation's status couldn't be recognized, so you can't respond right now."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法识别此邀请的状态，暂不能回应。"}}}},
    "merchantChapterInvitation.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节邀请"}}}},
    "merchantChapterInvitation.unknownLock": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The result of your earlier response is unknown. It won't be sent again automatically; check the current status first."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "之前回应的结果未知，不会自动重新提交；请先查看当前状态。"}}}}
