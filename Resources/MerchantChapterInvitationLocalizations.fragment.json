    "merchantChapterInvitation.readbackConflict": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The current status doesn't match this invitation, so the result is still unknown. Nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前状态与此邀请不一致，结果仍未知，未重新提交。"}}}},
    "merchantChapterInvitation.readbackMissing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation couldn't be found, so the result is still unknown. Nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到此邀请，结果仍未知，未重新提交。"}}}},
    "merchantChapterInvitation.readbackOpposite": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation currently shows the opposite result. That result and its reason are shown instead of your response."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此邀请当前为相反结果，现显示该结果及原因，而非你的回应。"}}}},
    "merchantChapterInvitation.readbackPending": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation is still pending, so the result is still unknown. Nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此邀请仍待处理，结果仍未知，未重新提交。"}}}},
    "merchantChapterInvitation.reject": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reject invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝邀请"}}}},
