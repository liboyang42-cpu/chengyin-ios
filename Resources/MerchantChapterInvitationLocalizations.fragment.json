    "merchantChapterInvitation.notInvite": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This record is not a merchant invitation, so it cannot be answered here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此记录不是商家邀请，不能在此回应。"}}}},
    "merchantChapterInvitation.openDetail": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Review invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看邀请详情"}}}},
