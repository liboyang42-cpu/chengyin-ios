  "strings": {
    "merchant.content.chapterInvitations": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter invitations"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节邀请"}}}},
    "merchantChapterInvitation.accept": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Accept invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受邀请"}}}},
    "merchantChapterInvitation.approved": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation has been accepted."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此邀请已接受。"}}}},
    "merchantChapterInvitation.impact.acceptNoRefund": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No payment or refund is made by this response."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本次回应不会产生付款或退款。"}}}},
    "merchantChapterInvitation.impact.acceptNodeReview": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Accepting changes the related node-review state; submitting node content is still a separate step."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受后将改变相关点位审核状态；提交点位内容仍是独立步骤。"}}}},
    "merchantChapterInvitation.impact.acceptRecheck": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recruitment, eligibility, remaining spots and backfill are checked again when you submit. If spots have changed, your acceptance may not go through."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "提交时将重新核对招募状态、资格、剩余名额与补位；名额变化时本次接受可能无法完成。"}}}},
    "merchantChapterInvitation.impact.acceptSlot": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A successful acceptance pre-occupies one acceptance slot for your merchant."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受成功后将为您的商家预占一个承接名额。"}}}},
    "merchantChapterInvitation.impact.rejectNoSlot": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Rejecting does not occupy a slot and makes no payment or refund."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝不会占用名额，也不会产生付款或退款。"}}}},
    "merchantChapterInvitation.impact.rejectTerminal": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Rejecting ends this invitation; it cannot later be changed to an acceptance for the same invitation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝后此邀请结束，不能再改为接受同一邀请。"}}}},
