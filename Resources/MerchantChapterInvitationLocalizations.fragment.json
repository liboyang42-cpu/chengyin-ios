{
  "sourceLanguage": "en",
  "strings": {
    "merchant.content.chapterInvitations": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter invitations"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节邀请"}}}},
    "merchantChapterInvitation.accept": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Accept invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受邀请"}}}},
    "merchantChapterInvitation.approved": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The server currently records this invitation as accepted."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务端当前记录此邀请为已接受。"}}}},
    "merchantChapterInvitation.impact.acceptNoRefund": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No payment or refund is made by this response."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本次回应不会产生付款或退款。"}}}},
    "merchantChapterInvitation.impact.acceptNodeReview": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Accepting changes the related node-review state; submitting node content is still a separate step."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受后将改变相关点位审核状态；提交点位内容仍是独立步骤。"}}}},
    "merchantChapterInvitation.impact.acceptRecheck": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The server rechecks recruitment, eligibility, remaining capacity and backfill at submission; if capacity has changed it may reject this acceptance."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "提交时服务端将重新核对招募状态、资格、剩余名额与补位；名额变化时可能拒绝本次接受。"}}}},
    "merchantChapterInvitation.impact.acceptSlot": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "A successful acceptance pre-occupies one acceptance slot for your merchant."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "接受成功后将为您的商家预占一个承接名额。"}}}},
    "merchantChapterInvitation.impact.rejectNoSlot": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Rejecting does not occupy a slot and makes no payment or refund."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝不会占用名额，也不会产生付款或退款。"}}}},
    "merchantChapterInvitation.impact.rejectTerminal": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Rejecting ends this invitation; it cannot later be changed to an acceptance for the same invitation."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝后此邀请结束，不能再改为接受同一邀请。"}}}},
    "merchantChapterInvitation.missing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation is no longer in your chapter-application list."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此邀请已不在您的章节申请列表中。"}}}},
    "merchantChapterInvitation.notInvite": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This record is not a merchant invitation, so it cannot be answered here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "此记录不是商家邀请，不能在此回应。"}}}},
    "merchantChapterInvitation.openDetail": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Review invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "查看邀请详情"}}}},
    "merchantChapterInvitation.pending": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Awaiting your response"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "等待您回应"}}}},
    "merchantChapterInvitation.readback": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Read back current status"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "回读当前状态"}}}},
    "merchantChapterInvitation.readbackConfirmed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Readback confirms the current server state matches your intended response. This does not by itself prove which submission caused it."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "回读确认服务端当前状态与您的回应意图一致；这本身不能证明是哪一次提交造成的。"}}}},
    "merchantChapterInvitation.readbackConflict": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Readback does not match this invitation exactly, so the unknown state is kept and nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "回读与此邀请不精确匹配，未知状态已保留，且未重新发送。"}}}},
    "merchantChapterInvitation.readbackMissing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This invitation was not found on readback, so the unknown state is kept and nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "回读未找到此邀请，未知状态已保留，且未重新发送。"}}}},
    "merchantChapterInvitation.readbackOpposite": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The server currently records the opposite outcome; that server fact and its reason are shown instead of your intended response."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务端当前记录为相反结果；现展示服务端事实及其原因，而非您的回应意图。"}}}},
    "merchantChapterInvitation.readbackPending": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Readback still shows this invitation as pending, so the unknown state is kept and nothing was resent."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "回读显示此邀请仍待处理，未知状态已保留，且未重新发送。"}}}},
    "merchantChapterInvitation.reject": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reject invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝邀请"}}}},
    "merchantChapterInvitation.rejected": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The server currently records this invitation as rejected."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务端当前记录此邀请为已拒绝。"}}}},
    "merchantChapterInvitation.serverReason": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Server reason"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务端原因"}}}},
    "merchantChapterInvitation.statusUnknown": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The server returned an unrecognized invitation status, so no response is available."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务端返回了无法识别的邀请状态，暂不能回应。"}}}},
    "merchantChapterInvitation.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Chapter invitation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "章节邀请"}}}},
    "merchantChapterInvitation.unknownLock": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The outcome of the earlier response is unknown. It will not be sent again automatically; read back the current status first."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "先前回应的结果未知，不会自动重新发送；请先回读当前状态。"}}}}
  },
  "version": "1.0"
}
