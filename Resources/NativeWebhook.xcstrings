    "上次操作尚未完成结果核对。请先恢复原请求，再发起新操作。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次操作尚未完成结果核对。请先恢复原请求，再发起新操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous operation has not been reconciled. Recover the original request before starting another operation."
          }
        }
      }
    },
    "下次重试": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next retry"
          }
        }
      }
    },
    "事件内容暂不可显示。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件内容暂不可显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event content cannot be displayed right now."
          }
        }
      }
    },
    "事件目录不可用；保留原订阅，暂不能新增或更换事件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件目录不可用；保留原订阅，暂不能新增或更换事件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event catalog is unavailable. Existing subscriptions are preserved; events cannot be added or changed right now."
          }
        }
      }
    },
    "事件编号": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件编号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event ID"
          }
        }
      }
    },
    "仅显示当前仍可查看的原事件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示当前仍可查看的原事件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only events that can still be viewed are shown."
          }
        }
      }
    },
    "仅操作当前频道。提交后会保存原请求用于结果核对。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅操作当前频道。提交后会保存原请求用于结果核对。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This affects only the current channel. The original request will be retained to reconcile the result after submission."
          }
        }
      }
    },
    "仅重放原 method、路径和内容，不创建新请求；已脱敏的首次密钥不能取回。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅重放原 method、路径和内容，不创建新请求；已脱敏的首次密钥不能取回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay only the original method, path, and content without creating a new request. The redacted initial secret cannot be retrieved."
          }
        }
      }
    },
    "停用": {
      "extractionState": "manual",
      "localizations": {
