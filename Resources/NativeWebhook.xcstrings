    "URL 只用于本次提交；恢复原请求时需要重新输入。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 只用于本次提交；恢复原请求时需要重新输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL is used only for this submission. Enter it again when recovering the original request."
          }
        }
      }
    },
