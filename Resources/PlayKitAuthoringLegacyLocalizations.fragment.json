    "playkitAuthor.instructions.sort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter items in the correct order. The server will shuffle them for players."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按正确顺序录入条目，服务端会为玩家打乱顺序。"
          }
        }
      }
    },
    "playkitAuthor.instructions.match": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each entered left/right row is a correct pair. Players receive a shuffled right column."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行的左、右两项组成正确配对，玩家看到的右侧条目由服务端打乱。"
          }
        }
      }
    },
    "playkitAuthor.instructions.classify": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define categories, then assign every item to its correct category."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先定义类别，再为每个条目指定正确类别。"
          }
        }
      }
    },
    "playkitAuthor.compass.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A direction is required. Compass alignment awards configured points only; it is not proof of arrival. Native sensor permission and device acceptance are separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须明确填写目标方位。罗盘对准仅按配置计分，不能作为到店凭证。原生传感器权限与真机验收是独立步骤。"
          }
        }
      }
    },
    "playkitAuthor.shout.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participants must agree to microphone use and sustain the sound continuously. Consider the location and other people before choosing this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与者需要同意使用麦克风并持续发声。选择此玩法前，请考虑现场环境与周围的人。"
          }
        }
      }
    },
