    "playkitAuthor.previewBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author rehearsal only. No request is sent, no live session is created and no reward is awarded. Secret answers are removed from these player controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供作者试用。不会发送请求、创建真实会话或发放奖励。此处的玩家控件已移除答案字段。"
          }
        }
      }
