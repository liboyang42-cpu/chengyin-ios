{
  "sourceLanguage": "en",
  "strings": {
    "club.trend.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrations by participation date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按参与日期 · 报名人数"
          }
        }
      }
    },
    "club.trend.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts use participation dates, not purchase dates. Only dates returned by the server are shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按参与日期统计，不是下单日期。仅展示服务端返回的日期。"
          }
        }
      }
    },
    "club.trend.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading participation counts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取参与人数…"
          }
        }
      }
    },
    "club.trend.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to view this participation trend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无权限查看该项目的参与趋势。"
          }
        }
      }
    },
    "club.trend.signedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to view participation counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录后查看参与人数。"
          }
        }
      }
    },
    "club.trend.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation counts are currently unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与人数暂不可用。"
          }
        }
      }
    },
    "club.trend.error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load participation counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与人数读取失败。"
          }
        }
      }
    },
    "club.trend.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "club.trend.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No registrations with a participation date yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有带参与日期的报名。"
          }
        }
      }
    },
    "club.trend.count": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participants"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人数"
          }
        }
      }
    }
  },
  "version": "1.0"
}
