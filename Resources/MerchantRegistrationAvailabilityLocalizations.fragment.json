    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The update was acknowledged, but its saved details could not be read. Reload the registration; do not submit the same update again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
