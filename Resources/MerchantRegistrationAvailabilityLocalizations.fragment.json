  "merchant.registrationAvailability.civilHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "These are calendar dates and same-day hours, not timezone conversions. Daily end must be after start; overnight hours are unsupported."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此处为日历日期及当日时段，不进行时区换算。结束须晚于开始，不支持跨夜。"
        }
      }
    }
  },
  "merchant.registrationAvailability.invalid": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Use valid dates, with the last day on or after the first. Daily end must be later than start."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请输入有效日期，结束日期不得早于开始日期，每日结束时间须晚于开始时间。"
        }
      }
    }
  },
