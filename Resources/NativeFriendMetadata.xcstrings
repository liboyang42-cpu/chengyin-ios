{"sourceLanguage":"en","strings":{"friendMeta.private":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only you can see your remarks and groups. These settings do not change friendship or permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注与分组仅你可见，不改变好友关系或权限。"}}}},"friendMeta.closed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend management is not available in this environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前环境尚未开放好友管理。"}}}},"friendMeta.unknown":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The previous result is uncertain. Check that original request before making another change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次操作结果未确定。请先查询原请求，不要重复提交。"}}}},"friendMeta.recover":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check original result"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查询原请求结果"}}}},"friendMeta.saved":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The change was applied."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改已执行。"}}}},"friendMeta.confirm":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认修改"}}}},"friendMeta.cancel":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to editing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回编辑"}}}},"friendMeta.reviewTitle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review your changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审阅修改"}}}},"friendMeta.remark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Private remark (up to 30 characters)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"私人备注（最多30字）"}}}},"friendMeta.group":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendMeta.starred":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心"}}}},"friendMeta.notificationUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care is saved as a preference only. Priority notifications are not connected yet; system permissions and limits still apply."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心目前仅保存偏好，优先通知尚未接通，仍受系统权限与限制约束。"}}}},"friendMeta.review":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审阅修改"}}}},"friendMeta.preferences":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友设置"}}}},"friendMeta.rename":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑"}}}},"friendMeta.delete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除分组"}}}},"friendMeta.immutable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cannot edit or delete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不可修改或删除"}}}},"friendMeta.groupName":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group name (up to 12 characters)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组名（最多12字）"}}}},"friendMeta.position":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Order"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排序"}}}},"friendMeta.createGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review new group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审阅新建分组"}}}},"friendMeta.saveGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review group changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审阅分组修改"}}}},"friendMeta.newGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a new group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新建另一分组"}}}},"friendMeta.moveTo":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move members to"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将好友移至"}}}},"friendMeta.reviewDelete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review group deletion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"审阅删除分组"}}}},"friendMeta.groups":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Groups (up to 10 including default)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组（含默认分组最多10个）"}}}},"friendMeta.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage friend"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理好友"}}}},"friendMeta.nicknameFallback":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clear remark and use nickname"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"清空备注并使用昵称"}}}},"friendMeta.starredOn":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care: on"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心：开启"}}}},"friendMeta.starredOff":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care: off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心：关闭"}}}},"friendMeta.moveWarning":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All friends in this group move together. Friendships and special care stay unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此分组内的好友将一并移动，好友关系和特别关心不变。"}}}},"friendMeta.defaultGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认分组"}}}},"friendMeta.storageFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not safely save the request identity. No new change will be sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全保存请求标识，不会发送新的修改。"}}}},"friendMeta.noLongerFriend":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This friend is no longer available. Return to the friends list."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此好友当前不可管理，请返回好友列表。"}}}},"friendMeta.loadFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not load current settings. Refresh to try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取当前设置，请刷新重试。"}}}},"friendMeta.invalidRemark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use up to 30 characters, not emoji only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注最多30字，不能只有表情。"}}}},"friendMeta.invalidGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use a nonempty name of up to 12 characters; default group names are reserved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组名不能为空或超过12字，默认分组名不可重复使用。"}}}},"friendMeta.groupLimit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You already have 10 groups. Edit or delete one first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组已达10个，请先编辑或删除一个。"}}}},"friendMeta.notSent":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The change was not sent. Refresh and review again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改未发送，请刷新后重新审阅。"}}}},"friendMeta.conflict":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Settings changed elsewhere or a limit was reached. Refresh and review again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置已在其他地方变更或已达上限，请刷新后重新审阅。"}}}},"friendMeta.rejected":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The change was not accepted. Refresh to check current settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改未被接受，请刷新查看当前设置。"}}}},"friendMeta.starLimit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care is limited to 20 friends. Turn it off for one friend before adding another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心最多20人，请先取消一位再添加。"}}}},"friendMeta.groupDuplicate":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You already have a group with this name. Choose another name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有同名分组，请换一个名称。"}}}},"friendMeta.settle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resolve or stop original request"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认结果或终止原请求"}}}},"friendMeta.settleTitle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finalize the original request?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认终局化原请求？"}}}},"friendMeta.settleConfirm":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm resolution or cancellation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认查询结果并取消未执行请求"}}}},"friendMeta.keepPending":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep pending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持未决"}}}},"friendMeta.settleExplanation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"If already applied, its result is kept. Otherwise the original request is permanently cancelled, including any delayed arrival. This does not resend your changes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"若原请求已执行，将保留其结果；否则永久取消原请求，迟到请求也不能再执行。此操作不会重新提交修改。"}}}},"friendMeta.finalized":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original request was not applied. Reload current settings before reviewing a new change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原请求未执行。请刷新当前设置后再审阅新的修改。"}}}},"friendMeta.pendingRemark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit friend preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改好友设置"}}}},"friendMeta.pendingGroupCreate":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新建分组"}}}},"friendMeta.pendingGroupEdit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改分组"}}}},"friendMeta.pendingGroupDelete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除分组"}}}},"friendMeta.pendingFriendTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友"}}}},"friendMeta.pendingGroupTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendMeta.pendingNewGroupTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"New group (no ID assigned yet)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新分组（尚未分配ID）"}}}},"friendMeta.pendingRequest":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original request"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原请求"}}}},"friendMeta.pendingIdentityUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original request identity is unavailable; it cannot be finalized."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取原请求身份，不能执行终局化。"}}}},"friendMeta.recoveryEntry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend groups and original setting results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友分组与原备注／设置结果"}}}},"friendMeta.notApplied":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original change was not applied."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原修改未执行。"}}}},"friendMeta.retryCleanup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry local recovery cleanup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试清理本地恢复记录"}}}},"friendMeta.cleanupFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original result is confirmed, but its local recovery record could not be cleared. Retry local cleanup; do not submit another change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原结果已确认，但本地恢复记录未能清理。请重试本地清理，不要另行提交修改。"}}}},"friendMeta.pendingReadFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original result is confirmed, but other local pending requests could not be read. Reload before making another change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原结果已确认，但其他本地待恢复请求暂时无法读取。请刷新后再编辑，不要另行提交修改。"}}}},"friendMeta.currentUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The original result is confirmed. Current friend or group information is unavailable; reload to continue editing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原结果已确认。当前好友或分组信息暂不可用；请刷新后再编辑。"}}}},"friendMeta.noPending":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No original friend-setting request needs recovery on this device for this account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此账号在本机没有待恢复的原好友设置请求。"}}}}},"version":"1.0"}
