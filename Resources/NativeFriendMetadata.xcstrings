{"sourceLanguage":"en","strings":{"friendMeta.private":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only you can see your remarks and groups. These settings do not change friendship or permissions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注与分组仅你可见，不改变好友关系或权限。"}}}},"friendMeta.closed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend settings aren't available right now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友设置暂时无法使用。"}}}},"friendMeta.unknown":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"We couldn't confirm your last change. Check the result before changing again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次修改结果未确认，请先查看结果，不要重复修改。"}}}},"friendMeta.recover":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check result"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看结果"}}}},"friendMeta.saved":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存。"}}}},"friendMeta.confirm":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认"}}}},"friendMeta.cancel":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消"}}}},"friendMeta.reviewTitle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认修改"}}}},"friendMeta.remark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remark"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注"}}}},"friendMeta.group":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendMeta.starred":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心"}}}},"friendMeta.notificationUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care is saved as a preference. Priority notifications aren't available right now; system notification settings still apply."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心已保存为偏好。优先通知暂不可用，仍受系统通知设置限制。"}}}},"friendMeta.review":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存"}}}},"friendMeta.preferences":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remark"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注"}}}},"friendMeta.rename":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑"}}}},"friendMeta.delete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除分组"}}}},"friendMeta.immutable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cannot edit or delete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不可修改或删除"}}}},"friendMeta.groupName":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组名称"}}}},"friendMeta.position":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Order"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排序"}}}},"friendMeta.createGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Create"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"创建"}}}},"friendMeta.saveGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存"}}}},"friendMeta.newGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel editing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消编辑"}}}},"friendMeta.moveTo":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move friends to"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将好友移至"}}}},"friendMeta.reviewDelete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除分组"}}}},"friendMeta.groups":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Groups (up to 10 including default)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组（含默认分组最多10个）"}}}},"friendMeta.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友设置"}}}},"friendMeta.nicknameFallback":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"None"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无"}}}},"friendMeta.starredOn":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"On"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启"}}}},"friendMeta.starredOff":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}}}},"friendMeta.moveWarning":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All friends in this group move together. Friendships and special care stay unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此分组内的好友将一并移动，好友关系和特别关心不变。"}}}},"friendMeta.defaultGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认分组"}}}},"friendMeta.storageFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't save this change. Nothing was sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改保存失败，未提交。"}}}},"friendMeta.noLongerFriend":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This friend is no longer available. Return to the friends list."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此好友当前不可管理，请返回好友列表。"}}}},"friendMeta.loadFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not load current settings. Refresh to try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取当前设置，请刷新重试。"}}}},"friendMeta.invalidRemark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use up to 30 characters, not emoji only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注最多30字，不能只有表情。"}}}},"friendMeta.invalidGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use 1–12 characters and a name other than the default group's."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组名需为1～12字，且不能与默认分组同名。"}}}},"friendMeta.groupLimit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You can have up to 20 groups, including the default group."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组最多20个（含默认分组）。"}}}},"friendMeta.notSent":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The change wasn't sent. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改未提交，请刷新后重试。"}}}},"friendMeta.conflict":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Settings changed elsewhere or a limit was reached. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置已在其他地方变更或已达上限，请刷新后重试。"}}}},"friendMeta.rejected":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The change was not accepted. Refresh to check current settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改未被接受，请刷新查看当前设置。"}}}},"friendMeta.starLimit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care is limited to 20 friends. Turn it off for one friend before adding another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心最多20人，请先取消一位再添加。"}}}},"friendMeta.groupDuplicate":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"You already have a group with this name. Choose another name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有同名分组，请换一个名称。"}}}},"friendMeta.settle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resolve or stop original request"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认结果或终止原请求"}}}},"friendMeta.settleTitle":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finalize the original request?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认终局化原请求？"}}}},"friendMeta.settleConfirm":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm resolution or cancellation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认查询结果并取消未执行请求"}}}},"friendMeta.keepPending":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep pending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持未决"}}}},"friendMeta.settleExplanation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"If already applied, its result is kept. Otherwise the original request is permanently cancelled, including any delayed arrival. This does not resend your changes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"若原请求已执行，将保留其结果；否则永久取消原请求，迟到请求也不能再执行。此操作不会重新提交修改。"}}}},"friendMeta.finalized":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your last change wasn't saved. Refresh before trying again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次修改未保存，请刷新后再试。"}}}},"friendMeta.pendingRemark":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit friend preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改好友设置"}}}},"friendMeta.pendingGroupCreate":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"New group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新建分组"}}}},"friendMeta.pendingGroupEdit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑分组"}}}},"friendMeta.pendingGroupDelete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除分组"}}}},"friendMeta.pendingFriendTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友"}}}},"friendMeta.pendingGroupTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendMeta.pendingNewGroupTarget":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"New group (no ID assigned yet)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新分组（尚未分配ID）"}}}},"friendMeta.pendingRequest":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original request"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原请求"}}}},"friendMeta.pendingIdentityUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Original request identity is unavailable; it cannot be finalized."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取原请求身份，不能执行终局化。"}}}},"friendMeta.recoveryEntry":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Groups"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友分组"}}}},"friendMeta.notApplied":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your last change wasn't saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次修改未保存。"}}}},"friendMeta.retryCleanup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Try again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}}}},"friendMeta.cleanupFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your change went through, but this device couldn't finish updating. Try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改已生效，但本机未能完成更新，请重试。"}}}},"friendMeta.pendingReadFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your change went through. Refresh before making another change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改已生效，请刷新后再修改。"}}}},"friendMeta.currentUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your change went through. Refresh to keep editing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改已生效，请刷新后继续编辑。"}}}},"friendMeta.noPending":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No original friend-setting request needs recovery on this device for this account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此账号在本机没有待恢复的原好友设置请求。"}}}},"d7.friendMeta.remarkPrompt":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remark (up to 30 characters)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注（最多30字）"}}}},"d7.friendMeta.shareProgress":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share my progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"向对方展示我的进度"}}}},"d7.friendMeta.myGroups":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Groups"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友分组"}}}},"d7.friendMeta.friendCount %lld":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld friends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%lld位好友"}}}},"d7.friendMeta.order %lld":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Order: %lld"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排序：%lld"}}}}},"version":"1.0"}
