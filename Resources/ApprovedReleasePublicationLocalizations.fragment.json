{
  "sourceLanguage": "en",
  "strings": {
    "approvedRelease.allocated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an immutable release ID for this captured manifest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端已为本次捕获的清单返回不可变发布版本 ID。"
          }
        }
      }
    },
    "approvedRelease.checkFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm an approved version right now. Review may still be in progress, or the content may have changed. Nothing was published, and your saved request is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确认已通过审核的版本。审核可能仍在进行中，或内容已有变更。本次未发布任何内容，已保存的申请仍会保留。"
          }
        }
      }
    },
    "approvedRelease.checkResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询此请求"
          }
        }
      }
    },
    "approvedRelease.confirmCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "approvedRelease.confirmCreate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create this immutable release"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建此不可变发布版本"
          }
        }
      }
    },
    "approvedRelease.confirmScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the approved version below. We'll check it once more before publishing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认下方已通过审核的版本，发布前我们会再核对一次。"
          }
        }
      }
    },
    "approvedRelease.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm release version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认发布版本"
          }
        }
      }
    },
    "approvedRelease.headRevision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured release-head revision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获的当前发布头版本"
          }
        }
      }
    },
    "approvedRelease.journalUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local publication record could not be safely read or saved. Existing bytes were not cleared. No new request is authorized by this error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全读取或保存本地发布记录。现有字节没有被清除，此错误不授权发送新请求。"
          }
        }
      }
    },
    "approvedRelease.publishScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishing saves this approved version. It doesn't by itself mean it's publicly listed or that players can join yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布将保存这一已通过审核的版本，但不代表已公开展示或玩家已可参与。"
          }
        }
      }
    },
    "approvedRelease.receiptApproved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved at last check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次核对时已通过审核"
          }
        }
      }
    },
    "approvedRelease.receiptChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval couldn't be confirmed at last check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次核对未能确认审核仍有效"
          }
        }
      }
    },
    "approvedRelease.retryExact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the exact saved request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试已保存的准确请求"
          }
        }
      }
    },
    "approvedRelease.reviewPublication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review immutable release"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核不可变发布版本"
          }
        }
      }
    },
    "approvedRelease.unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The publication result is unconfirmed. The exact request is retained; check its result before creating another request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布结果尚未确认。准确请求已保留；请先查询该请求结果，再创建其他请求。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
