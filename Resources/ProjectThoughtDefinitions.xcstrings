{
  "sourceLanguage": "en",
  "strings": {
    "projectThoughts.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreshadowing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伏笔"
          }
        }
      }
    },
    "projectThoughts.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name (up to 20 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称（最多 20 字）"
          }
        }
      }
    },
    "projectThoughts.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description (up to 60 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一句话（最多 60 字）"
          }
        }
      }
    },
    "projectThoughts.steps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps until fulfilled · optional"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走多少步后应验 · 可留空"
          }
        }
      }
    },
    "projectThoughts.when": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtain after this choice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中后得到"
          }
        }
      }
    },
    "projectThoughts.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fulfil after this choice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中后应验"
          }
        }
      }
    },
    "projectThoughts.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add foreshadowing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加伏笔"
          }
        }
      }
    },
    "projectThoughts.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this definition"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此伏笔定义"
          }
        }
      }
    },
    "projectThoughts.removeTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this foreshadowing definition?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这个伏笔定义？"
          }
        }
      }
    },
    "projectThoughts.removeImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These places use it and must be fixed before publishing:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下位置引用了它，发布前须修正："
          }
        }
      }
    },
    "projectThoughts.noKnownImpacts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in this draft uses it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前草稿中没有引用。"
          }
        }
      }
    },
    "projectThoughts.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 8. Each needs a step count (1–100000), a choice, or a stop to be fulfilled. Changes apply when you save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 8 个。每个伏笔需设置步数（1–100000）、选项或到站条件之一，保存后生效。"
          }
        }
      }
    },
    "projectThoughts.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved rules contain an unsupported version, field type or condition. They have been kept unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现存规则含暂不支持的版本、字段类型或条件，已原样保留。"
          }
        }
      }
    },
    "projectThoughts.noOptions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching template option tags are present in this draft. No tags are guessed or fetched automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿中没有同一玩法模板的可用选项标签，不会猜测或自动读取新标签。"
          }
        }
      }
    },
    "projectThoughts.retainedTag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved choice; this option is no longer available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的选择，该选项当前不可用。"
          }
        }
      }
    },
    "projectThoughts.retainedWhenNodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing obtain-at-node conditions · preserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有到站后得到条件 · 保留"
          }
        }
      }
    },
    "projectThoughts.retainedDoneNodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing fulfil-at-node conditions · preserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有到站后应验条件 · 保留"
          }
        }
      }
    },
    "projectThoughts.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check names, descriptions, step/condition limits and initial-state values. Rules must remain within 16 KiB. Nothing has been applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查名称、描述、步数或条件上限及初始状态数值；规则须不超过 16 KiB，尚未应用更改。"
          }
        }
      }
    },
    "projectThoughts.save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save definitions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存伏笔定义"
          }
        }
      }
    },
    "projectThoughts.reference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a defined foreshadowing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已定义伏笔"
          }
        }
      }
    },
    "projectThoughts.noDefinitions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No foreshadowing set up yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无伏笔。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
