    "projectChapterAtmosphere.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter color"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节配色"
          }
        }
      }
    },
    "projectChapterAtmosphere.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter color preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节配色预览"
          }
        }
      }
    },
    "projectChapterAtmosphere.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing a color saves it to this local chapter draft. This preview applies to chapter content; publishing uses the existing review flow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选色会保存到当前章节的本地草稿。此处预览章节内容配色，发布仍沿用现有审核流程。"
          }
        }
      }
    },
    "projectChapterAtmosphere.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter’s saved color is unsupported. It is preserved, and publishing is blocked until you explicitly choose a supported color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下章节保存的配色暂不支持，原值已保留；请明确选择一种支持的配色后再发布。"
          }
        }
      }
    },
    "projectChapterAtmosphere.saveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local saving wasn’t confirmed. The displayed color is unchanged. Choose the color again to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地保存尚未确认，显示的配色未更改。可再次选色重试。"
          }
        }
      }
    },
