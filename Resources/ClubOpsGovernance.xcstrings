    "clubOpsGov.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member governance is only open to owners and co-owners."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员治理只开给主理人与副主理人。"
          }
        }
      }
    },
    "clubOpsGov.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have member governance permission"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有成员治理的权限"
          }
        }
      }
    },
    "clubOpsGov.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ban term"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择期限"
          }
        }
      }
    },
    "clubOpsGov.memberNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member #%lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员 #%lld"
          }
        }
      }
    },
    "clubOpsGov.members.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members to govern"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可治理成员"
          }
        }
      }
    },
    "clubOpsGov.members.emptyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once members join, you can handle safety governance here. Past records are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员加入后可在这里进行安全治理；历史记录也会保留。"
          }
        }
      }
    },
    "clubOpsGov.members.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act on a member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对成员执行"
          }
        }
      }
    },
    "clubOpsGov.platformOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the platform can lift this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅平台可解封"
          }
        }
      }
    },
    "clubOpsGov.platformPermanent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent platform ban"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台永久封禁"
          }
        }
      }
    },
    "clubOpsGov.report.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only submit specific facts that can be verified. Nothing is ruled a violation or banned automatically before platform review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只提交可核实的具体事实。平台审核前，不会自动认定违规或执行封禁。"
          }
        }
      }
    },
    "clubOpsGov.report.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report to the platform"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向平台提交治理举报"
          }
        }
      }
    },
    "clubOpsGov.roles.assign.caption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a member, then assign one fixed role below"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择成员后，从下方分配一个固定角色"
          }
        }
      }
    },
    "clubOpsGov.roles.assign.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a fixed role"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分配固定角色"
          }
        }
      }
    },
    "clubOpsGov.roles.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the owner can assign roles. To help manage roles, ask the owner to make you an owner first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主理人可以分配角色。想帮忙管角色,让主理人先把你提为主理人。"
          }
        }
      }
    },
    "clubOpsGov.roles.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to manage roles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有管理角色的权限"
          }
        }
      }
    },
    "clubOpsGov.roles.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members to delegate yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可委派的成员"
          }
        }
      }
    },
    "clubOpsGov.roles.emptyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite members to the club first, then assign them operating roles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先邀请成员加入俱乐部，再为他们分配运营角色。"
          }
        }
      }
    },
    "clubOpsGov.roles.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking a role needs a second confirmation; the member loses that access immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销角色要二次确认；撤销后该成员立即失去对应入口。"
          }
        }
      }
    },
    "clubOpsGov.roles.ownerSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All permissions, cannot be revoked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部权限，不可撤销"
          }
        }
      }
    },
    "clubOpsGov.roles.revoke.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They immediately lose permissions within this scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销后对方立即失去这个范围内的权限。"
          }
        }
      }
    },
    "clubOpsGov.roles.revoke.consequence1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They lose every management action in this scope right away; operations in progress are interrupted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方立刻失去该范围内的全部管理动作,进行中的操作会被打断"
          }
        }
      }
    },
    "clubOpsGov.roles.revoke.consequence2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They remain a club member, just without this role"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方仍然是俱乐部成员,只是不再有这个角色"
          }
        }
      }
    },
    "clubOpsGov.roles.revoke.consequence3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone; to restore it, assign the role again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销;要恢复只能重新分配一次角色"
          }
        }
      }
    },
    "clubOpsGov.roles.revoke.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销「%@」?"
          }
        }
      }
    },
    "clubOpsGov.roles.roleFallback": {
