{
  "sourceLanguage": "en",
  "strings": {
    "clubOpsGov.appeal.current": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ban in effect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁中的这条"
          }
        }
      }
    },
    "clubOpsGov.appeal.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ban to appeal right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有可申诉的封禁"
          }
        }
      }
    },
    "clubOpsGov.appeal.emptyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can appeal to the platform only while this club has a time-limited ban on you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有被本俱乐部限期封禁时才能向平台提交申诉。"
          }
        }
      }
    },
    "clubOpsGov.appeal.entry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banned by this club? Your platform cases and the ban appeal are still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被本俱乐部封禁时，仍可查看自己的平台工单并提交封禁申诉。"
          }
        }
      }
    },
    "clubOpsGov.appeal.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeals go to the platform governance queue; club owners and co-owners cannot decide them. An upheld appeal lifts the ban but does not restore membership automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉进入平台治理队列；俱乐部主理人和副主理人不能裁决。申诉通过后解除封禁，但不会自动恢复成员身份。"
          }
        }
      }
    },
    "clubOpsGov.appeal.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal your current ban"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对当前有效封禁提出申诉"
          }
        }
      }
    },
    "clubOpsGov.ban.consequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ban immediately removes their membership and group chat access. Lifting it only restores the right to apply; membership is not restored automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁后对方立即失去成员身份与群聊入口；解封只恢复申请资格，成员身份不会自动恢复。"
          }
        }
      }
    },
    "clubOpsGov.ban.reasonHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a ban reason (required)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写封禁原因（必填）"
          }
        }
      }
    },
    "clubOpsGov.ban.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm ban: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认封禁 %@"
          }
        }
