{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore bundle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由探索套票"
          }
        }
      }
    },
    "stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is no longer current. Return and reopen from your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话已失效，请返回后从本人账户重新进入。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading current records…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前记录…"
          }
        }
      }
    },
    "error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request could not be verified. Refresh or recover the original request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求暂未核实，请刷新或回读原请求。"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original reservation result is not yet known. A new reservation is locked until it is recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原预约结果尚未确定，回读核实前不能新建预约。"
          }
        }
      }
    },
    "recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读原结果"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the exact original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原请求重试"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bundle items returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未返回套票项目。"
          }
        }
      }
    },
    "catalog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle catalog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套票目录"
          }
        }
      }
    },
    "order": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报名记录"
          }
        }
      }
    },
    "choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择"
          }
        }
      }
    },
    "unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available entitlement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用权益"
          }
        }
      }
    },
    "offer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant offer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家项目"
          }
        }
      }
    },
    "date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约时间"
          }
        }
      }
    },
    "review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复核预约"
          }
        }
      }
    },
    "legacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record has no bundle ledger. It remains read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录没有套票账本，仅可查看。"
          }
        }
      }
    },
    "disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservation requires separately reviewed authorization and a current eligible record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约需要独立核实的授权与当前有效记录。"
          }
        }
      }
    },
    "confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result verified against the current order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果已与当前订单核实。"
          }
        }
      }
    },
    "notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the registration, entitlement, merchant offer and time. An uncertain result will retain the exact original request for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对报名、权益、商家项目与时间。结果不明时会保留原请求用于回读。"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预约"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消复核"
          }
        }
      }
    }
  },
  "version": "1.0"
}
