    "orderRefundRead.caution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval, queueing and processing do not confirm arrival in the original payment account. Even a completed record is not an independent receipt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请获批、排队和处理中不代表原支付账户已到账；记录为完成也不是独立的到账凭证。"
          }
        }
      }
    },
