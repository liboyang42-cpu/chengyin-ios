    "projectStarter.firstNodeScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This node is temporary until you add it to the chapter. Enter a name and usable coordinates. Cancel keeps the chapter and discards this node. Incomplete-material storage is not connected yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入章节前，此节点仅暂存在当前表单。请填写名称和有效坐标。取消会保留章节并放弃此节点；待编排素材保存尚未接入。"
          }
        }
      }
    },
