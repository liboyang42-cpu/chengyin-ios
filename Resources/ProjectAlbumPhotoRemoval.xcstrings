  "strings": {
    "projectAlbumRemoval.position": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        }
      }
    },
    "projectAlbumRemoval.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this photo reference from the local album draft? Other photos and their captions stay unchanged. The uploaded media itself will not be deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地相册草稿中移除这张照片引用？其他照片及说明保持不变，不会删除已上传的媒体文件。"
          }
        }
      }
    },
    "projectAlbumRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除照片"
          }
        }
      }
    },
    "projectAlbumRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review photo removal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认移除照片"
          }
        }
      }
    }
  },
  "version": "1.0"
}
