      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "清空这条备注正文？"
        }
      }
    }
  },
  "merchant.noteDraft.clearBody": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The correction target stays unchanged. This does not hide or delete any saved note."
        }
