{
  "merchant.noteDraft.localBoundary": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Draft text stays on this customer page only. Closing the editor keeps it; leaving the page, switching identity, or entering review removes it."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "草稿仅保留在当前客户页面。关闭编辑器可继续；离开页面、切换身份或进入复核即清除。"
        }
      }
    }
  },
  "merchant.noteDraft.clear": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Clear text"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "清空正文"
        }
      }
    }
  },
  "merchant.noteDraft.clearTitle": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Clear this note text?"
