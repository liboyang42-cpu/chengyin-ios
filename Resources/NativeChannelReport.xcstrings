{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "directory.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reports waiting for a result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有等待结果的举报"
          }
        }
      }
    },
    "directory.preserved": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未删除或替换原请求，也未发送新的举报。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original requests have not been deleted or replaced. No new report has been sent."
          }
        }
      }
    },
    "directory.readFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some reports couldn't be loaded. Pull to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分举报暂时无法读取，请下拉刷新。"
          }
        }
      }
    },
    "directory.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本页只查询原回执，不重新提交举报，也不读取原频道或消息内容。若原回执允许重试，仍须回到当前有权限的原频道，明确重试同一请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page only reads original receipts. It never resubmits a report or reads the original channel or message. If a receipt permits retry, return to the original channel with current permission and explicitly retry the same request."
          }
        }
      }
    },
    "directory.reload": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取本机原请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload original requests on this device"
          }
        }
      }
    },
    "directory.scope": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只恢复本机当前账号尚待确认的频道举报原请求；不是全部举报历史。已确认或其他设备提交的记录不会列出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover this account’s unconfirmed channel reports saved on this device. This is not a full report history; confirmed reports and reports from other devices are not listed."
          }
        }
      }
    },
    "directory.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report status isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法查看举报进度。"
          }
        }
      }
    },
    "recovery.close": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "recovery.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已收到"
          }
        }
      }
    },
    "recovery.noGrant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report's result can't be checked right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法查看这条举报的结果。"
          }
        }
      }
    },
    "recovery.pending": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待确认的原举报"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unconfirmed original report"
          }
        }
      }
    },
    "recovery.read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看结果"
          }
        }
      }
    },
    "recovery.reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查询…"
          }
        }
      }
    },
    "recovery.reportID": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原举报编号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original report ID"
          }
        }
      }
    },
    "recovery.requestID": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求编号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request ID"
          }
        }
      }
    },
    "recovery.statusAtRead": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次确认时的状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status at this confirmation"
          }
        }
      }
    },
    "recovery.statusBoundary": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是原回执返回的状态，不代表消息已被判定违规或下架，也不是持续更新的审核进度。关闭后，这条已确认请求将不再列在本机待确认列表中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the status returned by the original receipt, not a finding that the message violated rules or was removed, and not live review progress. After closing, this confirmed request will no longer appear in this device’s unconfirmed list."
          }
        }
      }
    },
    "recovery.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原举报结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original report results"
          }
        }
      }
    },
    "recovery.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No result yet. Check again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未查到结果，请稍后再查。"
          }
        }
      }
    },
    "status.ACCEPTED": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已采纳"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report accepted"
          }
        }
      }
    },
    "status.DUPLICATE": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复举报"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate report"
          }
        }
      }
    },
    "status.PENDING": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核处理中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under review"
          }
        }
      }
    },
    "status.REJECTED": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报未采纳"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report not accepted"
          }
        }
      }
    }
  },
  "version": "1.0"
}
