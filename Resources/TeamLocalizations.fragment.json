    "team.create.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating a team does not register anyone, buy tickets or change refund rules. Public teams appear in nearby teams and require captain approval for applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建队不代替报名或购票，也不改变退款规则。公开队伍会出现在附近的队伍，申请需要队长逐个同意。"
          }
        }
      }
    },
    "team.join.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining provides access to the team chat. It does not register you or buy a ticket. Leaving and ticket refunds are separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入后会进入队伍群聊。入队不会代替报名或购票。退队与退票互不联动。"
          }
        }
      }
    },
    "team.leave.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving removes team-chat access and does not refund your ticket. A captain passes leadership to the earliest-joined remaining teammate; a sole-member team disbands. Returning requires a new invitation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退队会失去队伍群聊入口，不会退票。队长将移交给最早加入的队员；只剩一人时队伍解散。此操作不可撤销，重新加入需要新的邀请。"
          }
        }
      }
    },
    "team.remove.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This member loses team-chat access and is notified by the service. Their ticket stays valid. Removal cannot be undone; an invitation code cannot restore them and they must apply again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到站内通知，并失去队伍群聊入口。移出不同步退票，票仍然有效。此操作不可撤销，被移出的人不能用邀请码回来，需要重新申请。"
          }
        }
      }
    },
    "team.disband.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All teammates are removed and the team chat closes. Tickets stay valid and no refund is triggered. The team and chat history cannot be restored. Leaving instead transfers leadership when another teammate remains."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部队员会被移出队伍，群聊同时关闭，不触发退款，各自的票仍然有效。队伍与聊天记录无法恢复。若改为退队，有其他队员时会移交队长。"
          }
        }
      }
    },
