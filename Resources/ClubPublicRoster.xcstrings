{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "club.publicRoster.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public roster reading is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开名单读取暂不可用。"
          }
        }
      }
    },
    "club.publicRoster.revoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The roster could not be verified. Refresh to check current access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认当前名单权限，请刷新重读。"
          }
        }
      }
    },
    "club.publicRoster.emptyRank": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No results for this ranking this week."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周该榜暂无有效成绩。"
          }
        }
      }
    },
    "club.publicRoster.readOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public read-only view. This does not grant club membership or member actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开只读查看，不代表入团，也不开放成员操作。"
          }
        }
      }
    },
    "club.publicRoster.unit.composite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "points"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分"
          }
        }
      }
    },
    "club.publicRoster.unit.mileage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "km"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公里"
          }
        }
      }
    },
    "club.publicRoster.unit.pace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "min/km"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟/公里"
          }
        }
      }
    },
    "club.publicRoster.unit.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "min"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分钟"
          }
        }
      }
    }
  }
}
