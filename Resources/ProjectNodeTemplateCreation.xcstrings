{
  "sourceLanguage": "en",
  "strings": {
    "projectNodeCreate.create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create gameplay for this node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此节点新建玩法"
          }
        }
      }
    },
    "projectNodeCreate.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new play, save it as a draft, then come back to use it on this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建玩法并保存草稿，然后回到此处用于本地点。"
          }
        }
      }
    },
    "projectNodeCreate.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't create a play right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法新建玩法。"
          }
        }
      }
    },
    "projectNodeCreate.draftOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the play as your draft. It isn't published."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将玩法保存为你的草稿，不会发布。"
          }
        }
      }
    },
    "projectNodeCreate.return": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回地点"
          }
        }
      }
    },
    "projectNodeCreate.noReceipt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the play as a draft first to use it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先将玩法保存为草稿，才能在此使用。"
          }
        }
      }
    },
    "projectNodeCreate.retryRead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "projectNodeCreate.reviewTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm new gameplay binding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认新玩法绑定"
          }
        }
      }
    },
    "projectNodeCreate.returnScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved play is ready to use on this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的玩法可用于此地点。"
          }
        }
      }
    },
    "projectNodeCreate.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use on this stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于此地点"
          }
        }
      }
    },
    "projectNodeCreate.readFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm this gameplay draft. The stop wasn't changed. Retrying won't create another copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认该玩法草稿，站点未改动。重试不会另存一份模板。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
