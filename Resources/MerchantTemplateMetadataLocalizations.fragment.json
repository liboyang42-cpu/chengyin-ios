  "merchant.templateMetadata.scopeHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "These are the template's existing fields. The player-count description isn't a venue capacity limit. Participation and exit plans aren't copied here. Existing permissions and save rules still apply."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这是模板现有字段。游戏人数说明不等于现场人数上限；参与安排和退出预案不会自动写入这些字段。仍受现有权限与保存规则约束。"
        }
      }
    }
  },
  "merchant.templateMetadata.omissionHint": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Leaving a field blank won't clear its current value. For a new template, a blank duration is saved as 0."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "留空不会清除已有内容；新模板未填写时长时，默认为0。"
        }
      }
    }
  },
  "merchant.templateMetadata.durationInvalid": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Enter whole minutes from 0 to 2,147,483,647, or leave blank."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请填写0至2,147,483,647之间的整数分钟数，或留空。"
        }
      }
    }
  },
  "merchant.templateMetadata.readback": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved, and the template has been refreshed. This doesn't mean it's published or approved."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已保存，模板已刷新。这不代表已发布或已通过审核。"
        }
      }
    }
  },
  "merchant.templateMetadata.readbackFailed": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Saved, but the latest template details couldn't be loaded. Reload to check; this won't save again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已保存，但最新模板详情未能加载。重新加载可查看，不会重复保存。"
        }
      }
    }
  }
