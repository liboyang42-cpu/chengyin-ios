{
  "sourceLanguage": "en",
  "strings": {
    "topicReview.currentTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核状态"
          }
        }
      }
    },
    "topicReview.currentNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the latest review status, which may differ from the status when you submitted. Passing review doesn't publish the topic automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是最新审核状态，可能与提交时不同。审核通过后不会自动发布。"
          }
        }
      }
    },
    "topicReview.currentFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current task could not be verified. Your saved request is unchanged. Close and reopen if its context has changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法核验当前任务。已保存的请求未改变；如上下文已变更，请关闭后重新打开。"
          }
        }
      }
    },
    "topicReview.currentTask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编号"
          }
        }
      }
    },
    "topicReview.currentVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task version when checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取的任务版本"
          }
        }
      }
    },
    "topicReview.currentState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task state when checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取的任务状态"
          }
        }
      }
    },
    "topicReview.currentHash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed snapshot hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取的快照哈希"
          }
        }
      }
    },
    "topicReview.currentMatches": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task still references your submitted capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务仍对应你提交时捕获的内容。"
          }
        }
      }
    },
    "topicReview.currentDifferent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task now references a different capture. The original submitted request has not been changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务现已对应另一份内容。原提交请求没有被改写。"
          }
        }
      }
    },
    "topicReview.currentRead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check review status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看审核状态"
          }
        }
      }
    },
    "topicReview.currentUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current-task checking is not configured or this saved request is not available for checking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务查询尚未配置，或此保存请求暂不可查询。"
          }
        }
      }
    },
    "topicReview.currentApproved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review passed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核已通过"
          }
        }
      }
    },
    "topicReview.currentRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review not passed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核未通过"
          }
        }
      }
    },
    "topicReview.currentCancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review cancelled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核已取消"
          }
        }
      }
    }
  },
  "version": "1.0"
}
