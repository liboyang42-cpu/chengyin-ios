{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "zeroHP.copy.000": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生命值域 · 归零后"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health · At zero"
          }
        }
      }
    },
    "zeroHP.copy.001": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑生命归零策略"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit zero-health policy"
          }
        }
      }
    },
    "zeroHP.copy.002": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战／等待、恢复值与次数上限、耗尽后策略及归零回复"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge or wait, recovery amount and limit, fallback policy, and reply"
          }
        }
      }
    },
    "zeroHP.copy.003": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生命开关与上限沿用原值域配置；这里不执行挑战、不恢复生命或发奖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing health setting and limit are unchanged. This editor does not run challenges, restore health, or award rewards."
          }
        }
      }
    },
    "zeroHP.copy.004": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前项目不可完整编辑，请返回原项目读取权限与版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full editing is unavailable. Return to the project to reload access and version."
          }
        }
      }
    },
    "zeroHP.copy.005": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原归零配置无法安全编辑；已保留原文，未替换为默认配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This zero-health configuration cannot be edited safely. Its original data is preserved; no defaults were substituted."
          }
        }
      }
    },
    "zeroHP.copy.006": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持矩阵或已绑定玩法详情未读取。只读适配未配置、权限变化或网络失败时不能假定支持；可重试，副本尚未写回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load support information or the linked gameplay. Missing read access, changed permissions, or a network error cannot be treated as support. Retry; your working copy has not been written back."
          }
        }
      }
    },
    "zeroHP.copy.007": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选择不符合原配置约束；副本未改变。请查看该字段的原因。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection does not meet the existing constraints. Your working copy is unchanged. Check the field's explanation."
          }
        }
      }
    },
    "zeroHP.copy.008": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存本主题服务器草稿并回读，再选择真实挑战节点"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and reload this topic's server draft before selecting a saved challenge node."
          }
        }
      }
    },
    "zeroHP.copy.009": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持矩阵或已绑定玩法版本已变化，已读取新版本；请核对提示后再完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support information or linked gameplay has changed. The latest version is loaded. Review the notices before finishing."
          }
        }
      }
    },
    "zeroHP.copy.010": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原本地保存未确认；已保留归零策略与挑战副本，请重试本地保存。尚未保存服务器或发布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local saving wasn't confirmed. Your policy and challenge working copy is retained. Retry local saving. Nothing has been saved to the server or published."
          }
        }
      }
    },
    "zeroHP.copy.011": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限、玩法版本或引用未能确认，未覆盖原草稿。请重试读取；服务器保存尚未发起。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access, gameplay version, or references couldn't be verified. Your original draft is unchanged. Retry loading; no server save has started."
          }
        }
      }
    },
    "zeroHP.copy.012": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先编辑副本，完成后沿原保存器持久保存整份本地草稿；本地保存失败会保留副本。退出或返回放弃未确认副本，之后仍须在原项目保存服务器草稿／发布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit a working copy. Done saves the full local draft through the existing saver; a failed local save retains the copy. Leaving discards unconfirmed edits. You still need to save or publish from the original project."
          }
        }
      }
    },
    "zeroHP.copy.013": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取支持矩阵与已绑定玩法"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading support information and linked gameplay"
          }
        }
      }
    },
    "zeroHP.copy.014": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目、账号、权限、版本或编辑实例已变化，旧副本不能写回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project, account, access, version, or editing session has changed. This old copy cannot be written back."
          }
        }
      }
    },
    "zeroHP.copy.015": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取本项目"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload project"
          }
        }
      }
    },
    "zeroHP.copy.016": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试支持矩阵与玩法详情"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry support and gameplay details"
          }
        }
      }
    },
    "zeroHP.copy.017": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "值域"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " resource"
          }
        }
      }
    },
    "zeroHP.copy.018": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启；仅禁止扣该值的任务不会启用生命"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled. Blocking health-cost tasks does not enable health."
          }
        }
      }
    },
    "zeroHP.copy.019": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容配置 · 只读"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility · Read only"
          }
        }
      }
    },
    "zeroHP.copy.020": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版 BLOCK_PAID／LEGACY_END／旧挑战、原生端未支持的步数恢复及未知版本原样保留；退出与完成都不改写原配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy BLOCK_PAID, LEGACY_END, old challenges, unsupported step recovery, and unknown versions are preserved. Neither Cancel nor Done rewrites them."
          }
        }
      }
    },
    "zeroHP.copy.021": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复到："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore to: "
          }
        }
      }
    },
    "zeroHP.copy.022": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多恢复次数："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery limit: "
          }
        }
      }
    },
    "zeroHP.copy.023": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "次数用完后："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the limit: "
          }
        }
      }
    },
    "zeroHP.copy.024": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微信运动证明未在原生端开放；本机步数不是等价证明，不能启用或修改此恢复项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeRun proof is unavailable in the native app. Device steps are not equivalent proof. This recovery option cannot be enabled or edited."
          }
        }
      }
    },
    "zeroHP.copy.025": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归零时回复"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply at zero"
          }
        }
      }
    },
    "zeroHP.copy.026": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复内容（最多 2000 字）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply (up to 2,000 UTF-16 units)"
          }
        }
      }
    },
    "zeroHP.copy.027": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可留空；不会覆盖普通节点的通过／没通过回复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Does not replace ordinary nodes' pass or fail replies."
          }
        }
      }
    },
    "zeroHP.copy.028": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请修正后完成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve before finishing"
          }
        }
      }
    },
    "zeroHP.copy.029": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未取得当前支持矩阵，不能替换为默认配置。原草稿及未完成请求保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current support information is unavailable. Defaults will not be substituted. The original draft and pending requests are unchanged."
          }
        }
      }
    },
    "zeroHP.copy.030": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生命归零后"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When health reaches zero"
          }
        }
      }
    },
    "zeroHP.copy.031": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "zeroHP.copy.032": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "zeroHP.copy.033": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归零后"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At zero"
          }
        }
      }
    },
    "zeroHP.copy.034": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实恢复挑战节点"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved recovery challenge nodes"
          }
        }
      }
    },
    "zeroHP.copy.035": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本主题已保存节点的已绑定玩法选择，不创建临时模板。挑战不扣费、不发普通奖励、不推进章节；完成后沿原章节同步排除主／备挑战节点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose linked gameplay from this topic's saved nodes; no temporary template is created. Challenges do not charge, award ordinary rewards, or advance chapters. Main and alternative challenge nodes are excluded through the existing chapter synchronization."
          }
        }
      }
    },
    "zeroHP.copy.036": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存主题和挑战节点，并回读服务器草稿，再返回选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the topic and challenge nodes, reload the server draft, then return to choose."
          }
        }
      }
    },
    "zeroHP.copy.037": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主挑战"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main challenge"
          }
        }
      }
    },
    "zeroHP.copy.038": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复玩法："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery gameplay: "
          }
        }
      }
    },
    "zeroHP.copy.039": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择"
          }
        },
        "en": {
