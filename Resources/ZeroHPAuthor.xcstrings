        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未绑定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not linked"
          }
        }
      }
    },
    "zeroHP.copy.041": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 可以移除"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Can be removed"
          }
        }
      }
    },
    "zeroHP.copy.042": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可作答的题目类备选"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answerable question alternative"
          }
        }
      }
    },
    "zeroHP.copy.043": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需完成次数（1–99）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required completions (1–99)"
          }
        }
      }
    },
    "zeroHP.copy.044": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限时秒数（1–86400）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time limit in seconds (1–86400)"
          }
        }
      }
    },
    "zeroHP.copy.045": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复条件与耗尽后"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery and fallback"
          }
        }
      }
    },
    "zeroHP.copy.046": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待分钟（1–10080）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait in minutes (1–10080)"
          }
        }
      }
    },
    "zeroHP.copy.047": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复步数（1–100000）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps to recover (1–100000)"
          }
        }
      }
    },
    "zeroHP.copy.048": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原规则以归零后第一次同步的微信运动步数为起点。原生端不以本地传感器替代；此选项不可启用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original rule starts from the first WeRun sync after reaching zero. Native sensors cannot replace it; this option cannot be enabled."
          }
        }
      }
    },
    "zeroHP.copy.049": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多恢复次数（1–99）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery limit (1–99)"
          }
        }
      }
    },
    "zeroHP.copy.050": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "次数用完后"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the limit"
          }
        }
      }
    },
    "zeroHP.copy.051": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        }
      }
    },
    "zeroHP.copy.052": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题失败"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail the topic"
          }
        }
      }
    },
    "zeroHP.copy.053": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅禁止扣该值的任务"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block only tasks that cost health"
          }
        }
      }
    },
    "zeroHP.copy.054": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成恢复挑战"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete a recovery challenge"
          }
        }
      }
    },
    "zeroHP.copy.055": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走够步数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk enough steps"
          }
