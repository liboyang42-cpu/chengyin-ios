  "strings": {
    "projectNodeDuration.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter node duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入节点时长"
          }
        }
      }
    },
    "projectNodeDuration.minutes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration in minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长（分钟）"
          }
        }
      }
    },
    "projectNodeDuration.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes stay in this sheet until you tap Apply. Enter 1–10 digits, from 0 to 2147483647 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击应用前，更改仅保留在此窗口中。请输入 1 至 10 位数字，范围为 0 至 2147483647 分钟。"
          }
        }
      }
    },
    "projectNodeDuration.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number from 0 to 2147483647."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 0 至 2147483647 之间的整数。"
          }
        }
      }
    },
    "projectNodeDuration.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node duration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点时长"
          }
        }
      }
    },
    "projectNodeDuration.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        },
        "zh-Hans": {
