{
  "sourceLanguage": "en",
  "strings": {
    "profile.complaint.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare a complaint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备投诉内容"
          }
        }
      }
    },
    "profile.complaint.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read eligible activities and prepare text on this screen only. Nothing is submitted or saved. Leaving this screen or moving the app to the background clears the draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取可投诉活动，仅在当前页面准备内容。不会提交或保存；退出页面或将 App 切至后台会清除草稿。"
          }
        }
      }
    },
    "profile.complaint.topic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉活动"
          }
        }
      }
    },
    "profile.complaint.chooseTopic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择活动"
          }
        }
      }
    },
    "profile.complaint.kind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complaint type (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉类型（可选）"
          }
        }
      }
    },
    "profile.complaint.optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not provided"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未填写"
          }
        }
      }
    },
    "profile.complaint.reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉内容"
          }
        }
      }
    },
    "profile.complaint.reasonHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter at least 5 and at most 500 UTF-16 text units. Overlength text is not silently truncated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 5、最多 500 个文本单位（UTF-16）；超长内容不会被静默截断。"
          }
        }
      }
    },
    "profile.complaint.contact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact details (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系方式（可选）"
          }
        }
      }
    },
    "profile.complaint.contactHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 50 UTF-16 text units. Contact details are included in the review text only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 50 个文本单位（UTF-16），仅合并到本页审阅内容。"
          }
        }
      }
    },
    "profile.complaint.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review prepared text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅准备的内容"
          }
        }
      }
    },
    "profile.complaint.reviewTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待提交内容审阅"
          }
        }
      }
    },
    "profile.complaint.notSubmitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This complaint has not been submitted. The platform has not received it. Submission is not available in this version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉尚未提交，平台未收到这些内容。当前版本未开放受理提交。"
          }
        }
      }
    },
    "profile.complaint.continueEditing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "profile.complaint.unnamed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动"
          }
        }
      }
    },
    "profile.complaint.retired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preparation session is closed. Return and reopen to start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次准备已结束，请返回后重新打开。"
          }
        }
      }
    },
    "profile.complaint.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No eligible activities. Eligibility comes from your paid participation records on the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可投诉活动，资格以服务端已支付参与记录为准。"
          }
        }
      }
    },
    "profile.complaint.kind.service": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service and fulfillment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务与履约"
          }
        }
      }
    },
    "profile.complaint.kind.fees": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fees and refunds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用与退款"
          }
        }
      }
    },
    "profile.complaint.kind.safety": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety and disputes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全与纠纷"
          }
        }
      }
    },
    "profile.complaint.kind.advertising": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Misleading advertising"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚假宣传"
          }
        }
      }
    },
    "profile.complaint.kind.other": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他"
          }
        }
      }
    },
    "profile.complaint.validation.topic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an activity from the current list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择当前列表中的活动。"
          }
        }
      }
    },
    "profile.complaint.validation.reasonShort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the issue in at least 5 UTF-16 text units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写至少 5 个文本单位的投诉内容。"
          }
        }
      }
    },
    "profile.complaint.validation.reasonLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The issue exceeds the 500-unit limit. Shorten it before reviewing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉内容超过 500 个文本单位，请缩短后再审阅。"
          }
        }
      }
    },
    "profile.complaint.validation.contactLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact details exceed the 50-unit limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系方式超过 50 个文本单位。"
          }
        }
      }
    },
    "profile.complaint.read.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible activities could not be refreshed. Your local text remains, but review is paused until retry succeeds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可投诉活动暂时没能刷新。本页文字仍保留，重试成功后才能审阅。"
          }
        }
      }
    },
    "profile.complaint.read.signIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again before preparing a complaint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录后准备投诉内容。"
          }
        }
      }
    },
    "profile.complaint.read.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The activity selector is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法读取可投诉活动。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
