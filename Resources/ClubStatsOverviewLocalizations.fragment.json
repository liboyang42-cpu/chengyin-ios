    "club.statsOverview.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only projects hosted by this club are counted, excluding projects accepted from other organizers. Player participations count distinct players who reached a node, not ticket registrations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计本俱乐部自办项目，不含承接来的项目。游玩人次为到过节点的去重玩家，不是报名人数。"
          }
        }
      }
    },
    "club.statsOverview.rateScope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completion rate is completions divided by player participations. Missing figures are shown as unknown."
          }
