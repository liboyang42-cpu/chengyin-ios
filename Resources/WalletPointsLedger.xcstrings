{
  "sourceLanguage": "en",
  "strings": {
    "pointsLedger.rowFacts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each balance belongs to that entry, not the current account balance. Entries retain the source order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔余额仅代表该笔变动后的积分，不代表当前账户余额；记录保留来源顺序。"
          }
        }
      }
    },
    "pointsLedger.filterEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching entries among the records loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加载记录中没有符合筛选条件的流水。"
          }
        }
      }
    },
    "pointsLedger.reasonUnknown": {
      "extractionState": "manual",
      "localizations": {
