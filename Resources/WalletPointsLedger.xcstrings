            "value": "Reason unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变动原因未知"
          }
        }
      }
    },
    "pointsLedger.afterPoints": {
      "extractionState": "manual",
