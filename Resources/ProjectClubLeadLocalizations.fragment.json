{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "projectClubLead.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club-led participation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部承接"
          }
        }
      }
    },
    "projectClubLead.enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite clubs to lead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请俱乐部带队"
          }
        }
      }
    },
    "projectClubLead.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow clubs to apply to lead this city topic. This edits the working draft; clubs are not contacted here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许俱乐部申请承接本城市定向主题。这里仅修改当前草稿，不会联系俱乐部。"
          }
        }
      }
    },
    "projectClubLead.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This club setting can't be edited here. It stays as it is, and the full form can't be submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此俱乐部承接设置暂不支持在此编辑，将保持原样，且无法提交完整表单。"
          }
        }
      }
    },
    "projectClubLead.ineligible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only city topics without an owning club can open club-led applications. This topic submits the setting as off; its stored preference is retained locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅未归属俱乐部的城市定向主题可开放俱乐部承接。此主题提交为关闭，原偏好仍保留在本地草稿。"
          }
        }
      }
    }
  }
}
