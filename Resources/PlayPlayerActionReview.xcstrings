{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review player action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认玩家操作"
          }
        }
      }
    },
    "role": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this role"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认此角色"
          }
        }
      }
    },
    "text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this task answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交此任务答案"
          }
        }
      }
    },
    "choice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this option"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此选项"
          }
        }
      }
    },
    "hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request this hint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求此提示"
          }
        }
      }
    },
    "reveal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal this answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "揭晓此答案"
          }
        }
      }
    },
    "level": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint level"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示级别"
          }
        }
      }
    },
    "authority": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm once. The receipt and fresh server state determine the result. An unknown result must be checked before another action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅确认一次。结果以回执及服务器最新状态为准；结果未知时，请先核对再进行其他操作。"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认操作"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This review is no longer current. Return and review the current action again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次确认已失效，请返回并重新确认当前操作。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
