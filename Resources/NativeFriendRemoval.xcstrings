{
  "sourceLanguage": "en",
  "strings": {
    "friendRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove friend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除好友"
          }
        }
      }
    },
    "friendRemoval.recoveryEntry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending removals"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待确认的删除"
          }
        }
      }
    },
    "friendRemoval.impact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll no longer be friends. Remarks, groups and special care on both sides are cleared. Your chats stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们将不再是好友，双方的备注、分组和特别关心会被清除，聊天记录保留。"
          }
        }
      }
    },
    "friendRemoval.noBlockOrChatDelete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not block them, delete chats or refuse existing non-friend conversations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会拉黑对方、删除聊天记录或拒绝已有非好友会话。"
          }
        }
      }
    },
    "friendRemoval.readd": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To become friends again, use the existing friend-request process. Old friend metadata will not return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新成为好友须走原有申请流程，旧备注、分组归属和星标不会恢复。"
          }
        }
      }
    },
    "friendRemoval.closed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't remove friends right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法删除好友。"
          }
        }
      }
    },
    "friendRemoval.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm the removal. Check the result before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除结果未确认，请先查看结果，不要重复操作。"
          }
        }
      }
    },
    "friendRemoval.recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看结果"
          }
        }
      }
    },
    "friendRemoval.settle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalize original request…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终结原请求…"
          }
        }
      }
    },
    "friendRemoval.noPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待确认的删除"
          }
        }
      }
    },
    "friendRemoval.confirmImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm removal of the person and relationship version shown above?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认移除上方所示对象及这段关系版本？"
          }
        }
      }
    },
    "friendRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "friendRemoval.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "friendRemoval.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove friend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除好友"
          }
        }
      }
    },
    "friendRemoval.applied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除好友。"
          }
        }
      }
    },
    "friendRemoval.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The friend wasn't removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未删除好友。"
          }
        }
      }
    },
    "friendRemoval.historical": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the original receipt, not a claim about the current relationship."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是原请求回执，不代表当前好友状态。"
          }
        }
      }
    },
    "friendRemoval.currentFriend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        }
      }
    },
    "friendRemoval.currentNotFriend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非好友"
          }
        }
      }
    },
    "friendRemoval.currentTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关系状态"
          }
        }
      }
    },
    "friendRemoval.settleTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalize this original request?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终结此原请求？"
          }
        }
      }
    },
    "friendRemoval.settleConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalize the original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认终结原请求"
          }
        }
      }
    },
    "friendRemoval.keepPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        }
      }
    },
    "friendRemoval.settleImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a write, not a status check. If removal already ran, its receipt is kept. Otherwise this original key is closed without removal, preventing a delayed removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是写操作，不是查询。若移除已执行，将保留原回执；否则以未移除终结原 key，阻止迟到移除。"
          }
        }
      }
    },
    "friendRemoval.storageFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this request. Nothing was removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求保存失败，未执行删除。"
          }
        }
      }
    },
    "friendRemoval.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This friendship changed. Go back and refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友关系已变化，请返回刷新。"
          }
        }
      }
    },
    "friendRemoval.readFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check this friendship. Nothing was removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认好友关系，未执行删除。"
          }
        }
      }
    },
    "friendRemoval.notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未执行删除。"
          }
        }
      }
    },
    "friendRemoval.currentUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal confirmed. Couldn't load the current status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除结果已确认，当前关系暂时无法加载。"
          }
        }
      }
    },
    "friendRemoval.journalReadFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result confirmed. Couldn't check other pending removals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果已确认，其他待确认的删除暂时无法检查。"
          }
        }
      }
    },
    "friendRemoval.retryOriginal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "friendRemoval.retryTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try removing again?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新尝试删除？"
          }
        }
      }
    },
    "friendRemoval.retryConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "friendRemoval.retryImpact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll check the last result first, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将先查看上次结果，再重试。"
          }
        }
      }
    },
    "d7.friendRemoval.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this friend?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除该好友？"
          }
        }
      }
    }
  },
  "version": "1.0"
}
