{
  "sourceLanguage": "en",
  "strings": {
    "wordFill.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the prefilled characters. Type only the missing characters in order, then review your answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已有字符，只按顺序输入空缺字符，再确认完整答案。"
          }
        }
      }
    },
    "wordFill.prefilled %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefilled character at position %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 位，已有字符"
          }
        }
      }
    },
    "wordFill.blank %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank at position %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 位空槽"
          }
        }
      }
    },
    "wordFill.input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing characters only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅输入空缺字符"
          }
        }
      }
    }
  },
  "version": "1.0"
}
