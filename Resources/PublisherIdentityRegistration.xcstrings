{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publisher identity registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布者实名登记"
          }
        }
      }
    },
    "notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid activity publishers provide a real name and mainland China ID number to Chengyin for publisher identity checks. These details are not public. Registration is not identity verification. No activity is published here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收费活动发布者向城瘾提供真实姓名与中国大陆身份证号，仅用于发布人身份核验，不对外展示。登记不等于身份认证，此处不会发布活动。"
          }
        }
      }
    },
    "name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实姓名"
          }
        }
      }
    },
    "idCard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainland China ID number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国大陆身份证号"
          }
        }
      }
    },
    "consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I separately consent to providing my real name and ID number to Chengyin solely for publisher identity checks, without public display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我单独同意向城瘾提供真实姓名与身份证号，仅用于发布人身份核验，不对外展示。"
          }
        }
      }
    },
    "open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open registration or check status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登记或查看状态"
          }
        }
      }
    },
    "submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitly submit registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确提交登记"
          }
        }
      }
    },
    "refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current registration status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取登记状态"
          }
        }
      }
    },
    "return": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to activity draft and clear input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回活动草稿并清空输入"
          }
        }
      }
    },
    "status.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取"
          }
        }
      }
    },
    "status.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading current status…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前状态…"
          }
        }
      }
    },
    "status.unregistered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not registered. Your input stays only in this open page until you submit. Leaving clears it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未登记。提交前输入只保留在当前页面内存中，离开即清空。"
          }
        }
      }
    },
    "status.registered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered. To change identity details, contact support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登记。需要变更实名信息请联系平台客服。"
          }
        }
      }
    },
    "status.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status could not be read. Retry the status read before entering details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取状态，请先重新读取，再填写资料。"
          }
        }
      }
    },
    "status.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no separately approved registration access. No details have been sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户尚未配置独立的登记访问许可，未发送资料。"
          }
        }
      }
    },
    "status.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration was not completed. Check your input and consent. Temporary input remains until you leave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登记未完成。请检查输入和单独同意选项，临时输入保留至离开。"
          }
        }
      }
    },
    "status.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain. Do not submit again. You may independently read registration status or contact support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚不确定，请勿再次提交。可独立读取登记状态或联系平台客服。"
          }
        }
      }
    },
    "status.acknowledgedReadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration was acknowledged, but a fresh registered status has not been confirmed. Read status again; do not resubmit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到登记回执，但尚未确认最新已登记状态。请重新读取状态，不重复提交。"
          }
        }
      }
    },
    "unknownReadback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This independent status does not confirm the original request receipt. Its uncertainty marker is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此独立状态不代表原请求回执，原不确定记录仍保留。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
