{
  "sourceLanguage": "en",
  "strings": {
    "mapCore.availability.existing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "mapCore.availability.pendingBackend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available yet: waiting for a reviewed service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可用：等待经审核的服务"
          }
        }
      }
    },
    "mapCore.availability.pendingDecision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available yet: waiting for a product decision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可用：等待产品决定"
          }
        }
      }
    },
    "mapCore.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "mapCore.disclosure.alreadySeen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What others already saw cannot be taken back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方已看到的信息无法撤回"
          }
        }
      }
    },
    "mapCore.disclosure.audience": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the person or team I choose can see it; never strangers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅我选择的个人或队伍可见，陌生人不可见"
          }
        }
      }
    },
    "mapCore.disclosure.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops automatically when the time I choose ends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到我选择的时长后自动停止"
          }
        }
      }
    },
    "mapCore.disclosure.foregroundOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only updates while the app is open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 App 打开时更新"
          }
        }
      }
    },
    "mapCore.disclosure.precision": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I choose exact, approximate or distance only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我选择精确、模糊或仅距离"
          }
        }
      }
    },
    "mapCore.disclosure.stopAnytime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can stop at any time and others stop seeing it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以随时停止，对方随即无法查看"
          }
        }
      }
    },
    "mapCore.entries.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only entries marked available open a screen. Others wait for a reviewed service or a product decision and do nothing yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅“可用”的入口会打开页面；其余入口仍在等待经审核的服务或产品决定，目前不可操作。"
          }
        }
      }
    },
    "mapCore.entries.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from the map"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从地图开始"
          }
        }
      }
    },
    "mapCore.entry.cityOperation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City operations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市经营"
          }
        }
      }
    },
    "mapCore.entry.cityOrienteering": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City orienteering"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市定向主线"
          }
        }
      }
    },
    "mapCore.entry.freeExploration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free exploration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由探索"
          }
        }
      }
    },
    "mapCore.entry.merchantSideQuests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop side quests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商户支线"
          }
        }
      }
    },
    "mapCore.entry.personalFog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My exploration fog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的探索迷雾"
          }
        }
      }
    },
    "mapCore.entry.placeInfo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place information"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点信息"
          }
        }
      }
    },
    "mapCore.entry.sharedLocation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享"
          }
        }
      }
    },
    "mapCore.legend.candidate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors are a proposal under review, not the final design."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配色为待评审方案，并非最终设计。"
          }
        }
      }
    },
    "mapCore.legend.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each state has its own symbol and name, so it can be told apart without color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种状态都有独立图标和名称，不依赖颜色区分。"
          }
        }
      }
    },
    "mapCore.legend.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map legend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图图例"
          }
        }
      }
    },
    "mapCore.share.disclosureFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing would need every item above confirmed each time. These confirmations are not saved or sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享前需逐项确认以上内容；本页确认不会保存或发送。"
          }
        }
      }
    },
    "mapCore.share.explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How sharing would work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解位置共享方式"
          }
        }
      }
    },
    "mapCore.share.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        }
      }
    },
    "mapCore.share.permissionIsNotSharing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing location in Settings only lets this app use your location. It never shows your location to other players. Navigation and the main story work without sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统定位授权仅允许本 App 使用你的位置，不会向其他玩家公开。导航和主线玩法无需共享位置即可使用。"
          }
        }
      }
    },
    "mapCore.share.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始共享"
          }
        }
      }
    },
    "mapCore.share.status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing with others"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向他人共享"
          }
        }
      }
    },
    "mapCore.share.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享"
          }
        }
      }
    },
    "mapCore.share.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location sharing is not available yet. Nothing is shared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置共享暂未开放，当前不会共享任何位置。"
          }
        }
      }
    },
    "mapCore.state.active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行中"
          }
        }
      }
    },
    "mapCore.state.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "mapCore.state.inReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核中"
          }
        }
      }
    },
    "mapCore.state.interactive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can be opened"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看"
          }
        }
      }
    },
    "mapCore.state.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未解锁"
          }
        }
      }
    },
    "mapCore.state.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选中"
          }
        }
      }
    },
    "mapCore.state.standard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点"
          }
        }
      }
    },
    "mapCore.state.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可用"
          }
        }
      }
    },
    "mapCore.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图"
          }
        }
      }
    }
  },
  "version": "1.0"
}
