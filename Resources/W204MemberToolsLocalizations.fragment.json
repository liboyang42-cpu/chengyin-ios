{
  "sourceLanguage": "en",
  "strings": {
    "profile.complaint.pageTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complaints & feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉与建议"
          }
        }
      }
    },
    "profile.complaint.pageSubtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for activities you registered and paid for. The platform will step in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限已报名并支付的活动，平台会介入处理"
          }
        }
      }
    },
    "profile.complaint.sourceEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No activities to report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可投诉的活动"
          }
        }
      }
    },
    "profile.complaint.sourceEmptyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complaints must concern an activity you registered and paid for. After you do, you can start one here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉需针对你已报名并支付的活动；报名并支付后可在这里发起。"
          }
        }
      }
    },
    "profile.complaintProgress.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My case progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的处理进展"
          }
        }
      }
    },
    "profile.complaintProgress.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新进展"
          }
        }
      }
    },
    "profile.complaintProgress.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理进展不可查看"
          }
        }
      }
    },
    "profile.complaintProgress.signIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see your case progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录后查看处理进展"
          }
        }
      }
    },
    "profile.complaintProgress.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account cannot view case progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号无法查看处理进展"
          }
        }
      }
    },
    "profile.complaintProgress.statusUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status to be confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态待确认"
          }
        }
      }
    },
    "profile.complaintProgress.handleNote %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handling note: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理说明：%@"
          }
        }
      }
    },
    "profile.inviteHistory.signIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to see invitation history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后查看邀请记录"
          }
        }
      }
    },
    "profile.inviteHistory.signInHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in you can see your actual invitations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后可查看你的真实邀请关系"
          }
        }
      }
    },
    "profile.inviteHistory.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account cannot view invitation history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号无法查看邀请记录"
          }
        }
      }
    },
    "profile.inviteHistory.deniedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this account's viewing permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认当前账号的查看权限"
          }
        }
      }
    },
    "profile.inviteHistory.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation history did not load"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请记录没加载出来"
          }
        }
      }
    },
    "profile.inviteHistory.failedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network may be unstable. Your invitations are still there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络可能不稳定，你的邀请关系还在"
          }
        }
      }
    },
    "profile.inviteHistory.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one has accepted your invitation yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有人接受你的邀请"
          }
        }
      }
    },
    "profile.inviteHistory.emptyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends appear here by time after they join."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友加入后，会按时间出现在这里"
          }
        }
      }
    },
    "profile.inviteHistory.nicknameUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nickname to be confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称待确认"
          }
        }
      }
    },
    "templateOwnShelf.market.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit for marketplace review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交广场审核"
          }
        }
      }
    },
    "templateOwnShelf.market.withdraw": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw marketplace review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回广场审核"
          }
        }
      }
    },
    "templateOwnShelf.market.delist": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from marketplace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从广场下架"
          }
        }
      }
    },
    "templateOwnShelf.market.list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List in marketplace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上架广场"
          }
        }
      }
    },
    "templateOwnShelf.delete.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete node play “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除节点玩法「%@」?"
          }
        }
      }
    },
    "templateOwnShelf.delete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you only want to stop others from using it, removing it from the play library is enough."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只是不想让别人再用的话,从玩法库下架就够了。"
          }
        }
      }
    },
    "templateOwnShelf.delete.keepsReferences": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodes that already reference this play are unaffected and keep their configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经引用了这个玩法的节点不受影响,继续按原配置跑"
          }
        }
      }
    },
    "templateOwnShelf.delete.irreversible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. The play configuration cannot be recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销,玩法配置无法找回"
          }
        }
      }
    },
    "templateOwnShelf.delete.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete play"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除玩法"
          }
        }
      }
    }
  }
