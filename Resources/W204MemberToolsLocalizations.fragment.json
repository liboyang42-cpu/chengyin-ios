{
  "sourceLanguage": "en",
  "strings": {
    "profile.complaint.pageTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complaints & feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉与建议"
          }
        }
      }
    },
    "profile.complaint.pageSubtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for activities you registered and paid for. The platform will step in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限已报名并支付的活动，平台会介入处理"
          }
        }
      }
    },
    "profile.complaint.sourceEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No activities to report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可投诉的活动"
          }
        }
      }
    },
    "profile.complaint.sourceEmptyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complaints must concern an activity you registered and paid for. After you do, you can start one here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投诉需针对你已报名并支付的活动；报名并支付后可在这里发起。"
          }
        }
      }
    },
    "profile.complaintProgress.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My case progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的处理进展"
          }
        }
      }
    },
    "profile.complaintProgress.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新进展"
          }
        }
      }
    },
    "profile.complaintProgress.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理进展不可查看"
          }
        }
      }
