    "channel.existingOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only existing authorized groups are shown. New channels and joining are not available here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示你已获授权的现有群聊。新建频道与加入功能尚未接入。"
          }
        }
      }
    },
    "channel.spaceUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This space is no longer accessible. Return and refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该空间已不可访问，请返回刷新。"
          }
        }
      }
    },
    "channel.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accessible space groups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可访问的空间群聊。"
