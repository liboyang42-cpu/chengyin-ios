        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My spaces"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的空间"
          }
        }
      }
    },
    "channel.list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space groups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间内群聊"
          }
        }
      }
    },
