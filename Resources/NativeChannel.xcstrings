    "channel.newerUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading newer messages isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载新消息暂不可用。"
          }
        }
      }
    },
    "channel.receiptUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read status isn't available right now. Unread counts won't clear automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读状态暂不可用，未读数不会自动清除。"
          }
        }
      }
    },
    "channel.unreadRemaining": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread remaining"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
