    "channel.older": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load older messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更早消息"
          }
        }
      }
    },
    "channel.receiptUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read result is unknown. Retry the same read point before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读结果尚未确认。请先重试相同阅读位置，再继续加载。"
          }
        }
      }
    },
