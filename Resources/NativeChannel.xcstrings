      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有群聊"
          }
        }
      }
