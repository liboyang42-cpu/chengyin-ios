          "stringUnit": {
            "state": "translated",
            "value": "原开始时间"
          }
        }
      }
    },
    "channel.actionFacts.expiresAt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original expiry time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原到期时间"
          }
        }
      }
    },
    "channel.actionFacts.durationSeconds": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original duration (seconds)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原时长（秒）"
          }
        }
      }
    },
    "channel.actionFacts.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not provided"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供"
          }
        }
      }
    },
    "channel.actionFacts.noTrustedCountdown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A countdown is unavailable without a trusted server clock. The server determines whether the action is still in effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少可信服务端时钟，暂不显示倒计时。处置是否仍生效以服务端为准。"
          }
        }
      }
    },
    "channel.actionFacts.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original moderation details could not be read. Refresh to try again; this does not change the appeal result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原处置详情尚未读回。可刷新重读；这不改变申诉结果。"
          }
        }
      }
    },
    "channel.invitation.code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请码"
          }
        }
      }
    },
    "channel.invitation.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open invitation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开邀请"
          }
        }
      }
    },
    "channel.invitation.codeOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the original code only. A code never grants membership or channel access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅输入原邀请码。邀请码不授予成员资格或频道访问权限。"
          }
        }
      }
    },
    "channel.invitation.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join with an invitation code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过邀请码加入"
          }
        }
      }
    },
    "channel.invitation.unconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original invitation admission is not configured. No request was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原邀请码准入尚未配置，未发送请求。"
          }
        }
      }
    },
    "channel.invitation.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result is unknown. Only the same receipt is checked; no new request is created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果未知。只核对同一原回执，不创建新请求。"
          }
        }
      }
    },
    "channel.invitation.recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读原结果"
          }
        }
      }
    },
    "channel.invitation.review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the original action and frozen content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对原操作与已冻结内容"
          }
        }
      }
    },
    "channel.invitation.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认原请求"
          }
        }
      }
    },
    "channel.invitation.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel unsent action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消未发送操作"
          }
        }
      }
    },
    "channel.invitation.currentState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current server state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端当前状态"
          }
        }
      }
    },
    "channel.invitation.required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept this required rule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意这条必选规则"
          }
        }
      }
    },
    "channel.invitation.optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept this optional rule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意这条可选规则"
          }
        }
      }
    },
    "channel.invitation.termsInformation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are published joining terms, not a consent record. After joining, read and accept the original assigned rules. The original writer rechecks eligibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处为已发布加入条款，并非同意记录。加入后须回读并逐条同意原规则承诺；提交时由原服务端复核资格。"
          }
        }
      }
    },
    "channel.invitation.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application message (up to 60 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请留言（最多60个字符）"
          }
        }
      }
    },
    "channel.invitation.prepareJoin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review join request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对加入申请"
          }
        }
      }
    },
    "channel.invitation.prepareRules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review selected rule acceptance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对选中规则同意"
          }
        }
      }
    },
    "channel.invitation.memberDirectory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the independently authorized space directory"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开独立授权的空间目录"
          }
        }
      }
    },
    "channel.invitation.resultConfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result confirmed. Current membership is read separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果已确认。当前成员资格另行回读。"
          }
        }
      }
    },
    "channel.invitation.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh original current state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新原当前状态"
          }
        }
      }
    },
    "channel.invitation.currentUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current invitation information is unavailable. An original pending request remains protected; no result is inferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前邀请信息不可用。原待定请求仍受保护，不推断结果。"
          }
        }
      }
    },
    "channel.invitation.reviewChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original current information changed. No request was sent; review it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原当前信息已变化，尚未发送，请重新核对。"
          }
        }
      }
    },
    "channel.invitation.signIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to view this invitation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后查看此邀请"
          }
        }
      }
    },
    "channel.invitation.applicationState": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My original application state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的原申请状态"
          }
        }
      }
    }
  },
  "version": "1.0"
}
