{
  "merchant.crmDate.choose": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "选择来源日期"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Choose source dates"
        }
      }
    }
  },
  "merchant.crmDate.localOnly": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这里只修改本地筛选日期，应用筛选或保存分群后才使用。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "These changes update only the local filter. They are used when you apply the filter or save the segment."
        }
      }
    }
  },
  "merchant.crmDate.rangeHint": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可只选一端，也可选择同一天。起止日期相隔不能超过366天。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Either bound may be empty, and both may be the same date. The end date may be at most 366 days after the start."
        }
      }
    }
  },
  "merchant.crmDate.invalid": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请检查日期：结束不能早于开始，两端相隔不能超过366天。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Check the dates: the end must be on or after the start and no more than 366 days later."
        }
      }
    }
  },
  "merchant.crmDate.stale": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "账号、门店权限或原筛选已变化，请重新打开日期选择。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The account, store authorization or original filter changed. Reopen date selection."
        }
      }
    }
  },
  "merchant.crmDate.apply": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "应用到本地筛选"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Apply to local filter"
        }
      }
    }
  },
  "merchant.crmDate.enabled": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用此日期"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Use this date"
        }
      }
    }
  },
  "merchant.crmDate.unrecognized": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "原日期格式暂不识别；重新选择或明确清空后才能应用。取消会保留原文。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This original date format is unrecognized. Select a replacement or explicitly clear it before applying. Cancel preserves the original text."
        }
      }
    }
  },
  "merchant.crmDate.replace": {
    "extractionState": "manual",
