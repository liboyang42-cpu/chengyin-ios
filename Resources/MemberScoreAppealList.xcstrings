{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "score.mine.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的计分申诉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My scoring appeals"
          }
        }
      }
    },
    "score.mine.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅展示本人的计分申诉和成绩争议。当前状态不替代待定原请求的回执。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your scoring appeals and result disputes. Current status does not replace the receipt for an unresolved original request."
          }
        }
      }
    },
    "score.filter.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        }
      }
    },
    "score.filter.all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "score.filter.active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "score.filter.decided": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有结论"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolved"
          }
        }
      }
    },
    "score.kind.appeal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计分申诉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoring appeal"
          }
        }
      }
    },
    "score.kind.dispute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成绩争议"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result dispute"
          }
        }
      }
    },
    "score.status.open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "score.status.accepted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已采纳"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted"
          }
        }
      }
    },
    "score.status.rejected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已驳回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected"
          }
        }
      }
    },
    "score.reputation.normal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号信誉：正常"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account reputation: normal"
          }
        }
      }
    },
    "score.reputation.restricted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号信誉：受限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account reputation: restricted"
          }
        }
      }
    },
    "score.reputation.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信誉信息暂不可确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reputation information cannot be confirmed."
          }
        }
      }
    },
    "score.mine.empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取未返回记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read returned no records."
          }
        }
      }
    },
    "score.mine.more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更多"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load more"
          }
        }
      }
    },
    "score.mine.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取本人申诉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh my appeals"
          }
        }
      }
    },
    "score.time.source": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录时间沿用原来源的北京时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record times retain the source’s Beijing time."
          }
        }
      }
    },
    "score.error.disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人读取尚未配置或已失效，请返回重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal reads are unavailable or have expired. Go back and reopen this page."
          }
        }
      }
    },
    "score.error.denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来源拒绝了这次读取，不能据此确认状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source denied this read. The status cannot be confirmed."
          }
        }
      }
    },
    "score.error.malformed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来源返回的信息无法核实，未据此更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source response could not be verified and was not used."
          }
        }
      }
    },
    "score.error.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前读取未成功。已有列表不是最新确认，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read failed. Any existing list is not a current confirmation. Try again."
          }
        }
      }
    },
    "score.error.stale": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取身份已改变，请返回重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read identity changed. Go back and reopen this page."
          }
        }
      }
    },
    "score.detail.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉详情"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal details"
          }
        }
      }
    },
    "score.detail.missingContext": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原会话或主题信息不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original session or topic information is unavailable."
          }
        }
      }
    },
    "score.detail.centi": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原账本（1/100 分）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original ledger (hundredths of a point)"
          }
        }
      }
    },
    "score.detail.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取原会话结果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the original session result"
          }
        }
      }
    },
    "score.detail.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页只读原会话结论，不开新局、不重发请求、不改变分数。原提交结果未知时仍须沿原请求回读。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page only reads the original session result. It does not start a session, resend a request or change a score. An unresolved submission still requires its original-request recovery."
          }
        }
      }
    }
  },
  "version": "1.0"
}
