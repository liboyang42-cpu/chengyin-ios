    "report.detail.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结论和预计时间均来自原案件。首响时限不是解决期限；本页不下载证据、不发起申诉。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisions and estimates come from the original case. A first-response target is not a resolution deadline. This page does not download evidence or submit an appeal."
          }
        }
      }
    }
