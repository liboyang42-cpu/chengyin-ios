{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "report.history.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的举报"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My reports"
          }
        }
      }
    },
    "report.read.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查看本人的举报及公开进度，不提交举报或申诉，也不替代原请求回执。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your reports and public progress. This does not submit a report or appeal, or replace an original request receipt."
          }
        }
      }
    },
    "report.filter.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report status"
          }
        }
      }
    },
    "report.filter.all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "report.filter.active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        }
      }
    },
    "report.filter.decided": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有结论"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decided"
          }
        }
      }
    },
    "report.history.empty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此筛选下没有举报记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reports in this filter."
          }
        }
      }
    },
    "report.history.more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再显示20条"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show 20 more"
          }
        }
      }
    },
    "report.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        }
      }
    },
    "report.error.disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取未开放或权限已失效，当前不显示举报资料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading is unavailable or access has expired. Report information is hidden."
          }
        }
      }
    },
    "report.error.denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权读取这份举报资料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to this report information was denied."
          }
        }
      }
    },
    "report.error.malformed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料格式或原案件匹配校验未通过，请稍后刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response format or original-case check failed. Try refreshing later."
          }
        }
      }
    },
    "report.error.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取失败，请稍后刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading failed. Try refreshing later."
          }
        }
      }
    },
    "report.error.stale": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已变化，请重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session changed. Reopen this page."
          }
        }
      }
    },
    "report.error.oversized": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料超过安全读取上限，未将截断内容显示为完整记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response exceeds the safe reading limit. Truncated data is not shown as a complete history."
          }
        }
      }
    },
    "report.time.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间未提供或无法识别"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time unavailable or unrecognized"
          }
        }
      }
    },
