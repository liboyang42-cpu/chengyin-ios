{
  "sourceLanguage": "en",
  "strings": {
    "club.materials.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualification materials"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资质材料"
          }
        }
      }
    },
    "club.materials.optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Choose up to 9 images. These selections stay on this page only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选填，最多选择9张图片。所选材料仅暂存在当前页面。"
          }
        }
      }
    },
    "club.materials.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Material upload is not available. You can preview or remove local selections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材料上传暂不可用，你可以预览或移除本地所选图片。"
          }
        }
      }
    },
    "club.materials.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择图片"
          }
        }
      }
    },
    "club.materials.preview %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview image %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览第%lld张图片"
          }
        }
      }
    },
    "club.materials.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "club.materials.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected images have not been uploaded. Remove them before submitting without optional materials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片尚未上传。如需不附选填材料提交，请先移除这些图片。"
          }
        }
      }
    },
    "club.materials.selectionFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The images could not be added. Try choosing fewer or smaller images. Existing selections are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片未能添加，请重新选择较少或较小的图片。原有选择未改变。"
          }
        }
      }
    },
    "club.materials.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    }
  },
  "version": "1.0"
}
