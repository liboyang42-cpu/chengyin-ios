{"sourceLanguage":"en","strings":{"friendDirectory.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Browse friends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友分区"}}}},"friendDirectory.partition":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Section"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分区"}}}},"friendDirectory.together":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Same team or activity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同队伍或同活动"}}}},"friendDirectory.recent":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Active in the last 15 minutes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近15分钟活跃"}}}},"friendDirectory.all":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All friends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部好友"}}}},"friendDirectory.group":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendDirectory.allGroups":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All groups"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有分组"}}}},"friendDirectory.defaultGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认分组"}}}},"friendDirectory.starredOnly":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅特别关心"}}}},"friendDirectory.privacy":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity is not online status. No exact activity times, locations or private team details are shown. Special care does not enable notifications."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活跃不代表在线，不展示具体时间、位置或队伍私密信息。特别关心不启用通知。"}}}},"friendDirectory.closed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The friend directory is not available in this environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前环境尚未开放好友分区。"}}}},"friendDirectory.refresh":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新"}}}},"friendDirectory.loadFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not read current friends. Refresh to try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取当前好友，请刷新重试。"}}}},"friendDirectory.changed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your friends or filters changed. Refresh before loading more."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友或筛选结果已变化，请刷新后继续查看。"}}}},"friendDirectory.groupGone":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"That group is no longer available. Showing all groups with your other filters unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原分组已不存在，已切回所有分组，其他筛选保持不变。"}}}},"friendDirectory.empty":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"No friends match these filters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此分区暂无符合筛选的好友。"}}}},"friendDirectory.more":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Load more"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看更多"}}}},"friendDirectory.pending":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending verification"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待验证"}}}},"friendDirectory.requestsExplanation":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Received and sent requests stay in the original request list. Accepting, rejecting or withdrawing uses that same request identity."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收到与发出的申请保留在原申请列表，通过、拒绝与撤回均沿用原申请身份。"}}}},"friendDirectory.requests":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to received and sent requests"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回收到与发出申请"}}}},"friendDirectory.detail":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Friend details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友详情"}}}},"friendDirectory.starred":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care: on"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心：开启"}}}},"friendDirectory.notStarred":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care: off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"特别关心：关闭"}}}},"friendDirectory.chat":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open existing conversation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开已有会话"}}}},"friendDirectory.back":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Back to friend directory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回好友分区"}}}},"friendDirectory.unavailablePeer":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This friendship is no longer available. Return to the directory and refresh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此好友关系当前不可用，请返回好友分区刷新。"}}}},"friendDirectory.profile":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"View public profile"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看公开资料"}}}},"friendDirectory.retryPage":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry this page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试此页"}}}},"friendDirectory.pageFailure":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not load the next page. Retry keeps your loaded friends and filters."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一页读取失败。重试将保留已读好友和筛选。"}}}},"friendDirectory.readUnavailable":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The directory cannot currently be read. Refresh to check again; this does not mean your friendships were removed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前无法读取好友分区。请刷新重试，这不代表好友关系已删除。"}}}}},"version":"1.0"}
