{"sourceLanguage":"en","strings":{"friendDirectory.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Browse friends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"好友分区"}}}},"friendDirectory.partition":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Section"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分区"}}}},"friendDirectory.together":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Together"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一起玩"}}}},"friendDirectory.recent":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近期活跃"}}}},"friendDirectory.all":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部"}}}},"friendDirectory.group":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}}}},"friendDirectory.allGroups":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"All groups"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所有分组"}}}},"friendDirectory.defaultGroup":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Default group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认分组"}}}},"friendDirectory.starredOnly":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Special care only"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅特别关心"}}}},"friendDirectory.privacy":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Activity is not online status. No exact activity times, locations or private team details are shown. Special care does not enable notifications."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"活跃不代表在线，不展示具体时间、位置或队伍私密信息。特别关心不启用通知。"}}}},"friendDirectory.closed":{"localizations":{"en":{"stringUnit":{"state":"transl