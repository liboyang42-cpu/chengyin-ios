{
  "sourceLanguage": "en",
  "strings": {
    "walkingAuthor.entry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story walking entrance details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧情步行入口资料"
          }
        }
      }
    },
    "walkingAuthor.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare walking entrances only for this topic’s saved original nodes. This does not change story order, arrival checks, completion or rewards. A map pin is not an entrance. Leave an unknown entrance undeclared; do not copy the pin or assume the site is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅声明本主题已保存原节点的步行入口，不改变剧情顺序、到场判定或完成/奖励。显示图钉不是入口；未知可保留‘未声明入口’，不得抄图钉当入口或推定现场开放。"
          }
        }
      }
    },
    "walkingAuthor.reviewScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original author’s save and submission establish authorship. The original platform topic review is still required. Navigation uses the reviewer and time from the actual approval record. Merchant editing rights, this checkbox and a publication draft are not review approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原本人保存/提交生成作者来源；必须经原平台主题审核，导航只读真实批准记录中的审核人与时间。不将商家编辑权限、自己勾选或发布草稿当审核批准。"
          }
        }
      }
    },
    "walkingAuthor.legacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy node navigation declaration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版原节点导航声明"
          }
        }
      }
    },
    "walkingAuthor.legacy.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 1 contains only nodes, regions and authorization duration, without entrances. Viewing preserves the original content and existing sessions. A new declaration is used only after explicit upgrade, save and the original review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原 v1 只含节点/地区与授权时长，不含入口。查看不会改写旧 hash/旧局；只有明确升级、保存并经原审核后才使用新声明。"
          }
        }
      }
    },
    "walkingAuthor.legacy.upgrade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitly upgrade this draft to entrance declaration v2"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确将此草稿升级为入口声明 v2"
          }
        }
      }
    },
    "walkingAuthor.ttl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation authorization duration (1–300 seconds; required)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原导航授权时长（1–300 秒，须明确填写）"
          }
        }
      }
    },
    "walkingAuthor.node.add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a saved original node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加已保存的原节点"
          }
        }
      }
    },
    "walkingAuthor.acknowledge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked each original node, region, entrance source, coordinate reference and explicit closure status, without inventing unknown details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已逐项复核原节点、地区、入口来源/坐标基准与明确关闭状态；未知内容没有补造"
          }
        }
      }
    },
    "walkingAuthor.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm changes to the original local topic draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认写回原本地主题草稿"
          }
        }
      }
    },
    "walkingAuthor.saveScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page does not save to the server, request permissions or enable location. The original save, review, publication and navigation authorization still apply. New entrances are not added to existing sessions. If an entrance changes or review is withdrawn, the original source must be read again explicitly; no automatic rerouting or task completion occurs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在此保存服务器、申请新权限或启用定位。仍需原保存/审核/发布及原导航许可；旧局不会补入新入口。入口变更或撤审使旧导航来源不可确认时，只能显式回读，不自动绕路或完成任务。"
          }
        }
      }
    },
    "walkingAuthor.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story walking entrances"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧情步行入口"
          }
        }
      }
    },
    "walkingAuthor.region": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit region code (two uppercase letters; not inferred from language)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确地区代码（两位大写；不按语言猜）"
          }
        }
      }
    },
    "walkingAuthor.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrance name"
          }
        },
