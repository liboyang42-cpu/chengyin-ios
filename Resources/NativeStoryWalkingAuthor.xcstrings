    "walkingAuthor.discard.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "walkingAuthor.discard.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page’s entrance changes have not been confirmed in the original local topic draft. Returning clears only this page’s copy. It does not write changes, undo a save or confirm an earlier unconfirmed save."
          }
        },
        "zh-Hans": {
