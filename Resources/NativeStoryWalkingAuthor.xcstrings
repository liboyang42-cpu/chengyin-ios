    "walkingAuthor.discard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this page’s unconfirmed entrance changes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃本页未确认的入口配置？"
          }
        }
      }
    },
    "walkingAuthor.discard.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard changes and return"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
