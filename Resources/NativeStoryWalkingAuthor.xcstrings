            "state": "translated",
            "value": "Information source / reference"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料来源／出处"
          }
        }
      }
    },
    "walkingAuthor.floor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor (leave blank if unknown)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "楼层（未知留空）"
          }
        }
      }
    },
    "walkingAuthor.approach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approach notes (leave blank if unknown)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接近说明（未知留空）"
          }
        }
      }
    },
    "walkingAuthor.longitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrance longitude (not copied from the node)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入口经度（不自动复制节点）"
          }
        }
      }
    },
    "walkingAuthor.latitude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrance latitude"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入口纬度"
          }
        }
      }
    },
    "walkingAuthor.datum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit coordinate reference"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确原坐标基准"
          }
        }
      }
    },
    "walkingAuthor.closed.yes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declared: temporarily closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已声明：临时关闭"
          }
        }
      }
    },
    "walkingAuthor.closed.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declared: not temporarily closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已声明：未临时关闭"
          }
        }
      }
    },
    "walkingAuthor.closed.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit temporary closure status required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须明确临时关闭状态"
          }
        }
      }
    },
    "walkingAuthor.closed.chooseYes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare temporarily closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明临时关闭"
          }
        }
      }
    },
    "walkingAuthor.closed.chooseNo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare not temporarily closed (not verified to be open)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明未临时关闭（不是实测开放保证）"
          }
        }
      }
    },
    "walkingAuthor.businessTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Business hours notes (leave blank if unknown; not an access permit)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营业说明（未知留空；不是接取许可）"
          }
        }
      }
    },
    "walkingAuthor.alternative": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessible alternative notes (leave blank if unknown)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无障碍替代说明（未知留空）"
          }
        }
      }
    },
    "walkingAuthor.entranceScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A closed entrance shows only the source notes and alternative text. It does not start routing or automatically select an alternative. Accessibility notes are an approved declaration, not route certification. Do not promise what is unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭入口只显示源说明/替代文字，不发起路线或自动选替代点。无障碍文字是批准声明，不是路线认证；未知时不填保证。"
          }
        }
      }
    },
    "walkingAuthor.entrance.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this node’s entrance undeclared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此节点改为未声明入口"
          }
        }
      }
    },
    "walkingAuthor.entrance.undeclared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrance undeclared: original node pin behavior and unknown-status notices are retained. This is not a reviewed entrance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未声明入口：保持原节点图钉行为与未知提示，不能认为已审核入口。"
          }
        }
      }
    },
    "walkingAuthor.entrance.add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitly declare a new entrance for this node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此节点明确声明新入口"
          }
        }
      }
    },
    "walkingAuthor.node.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this node from the local navigation declaration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地导航声明移除此节点"
          }
        }
      }
    },
    "walkingAuthor.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original navigation declaration cannot be read or its version is unsupported. Unknown fields have not been overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原导航声明缺失或版本不支持，未覆盖未知字段。"
          }
        }
      }
    },
    "walkingAuthor.saveUnconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the complete original local draft is unconfirmed. This page retains your configuration copy so you can retry. Nothing has been saved to the server, published or run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原完整本地草稿保存未确认；本次配置副本保留，可重试写回。未保存服务器、发布或执行玩法。"
          }
        }
      }
    },
    "walkingAuthor.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original nodes, explicit region and duration, information source, coordinates, coordinate reference and closure status. The original draft has not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复核原节点、明确地区/时长、资料来源、坐标及基准与关闭状态；原草稿未改动。"
          }
        }
      }
    },
    "walkingAuthor.retired.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This editing session has ended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次编辑已结束"
          }
        }
      }
    },
    "walkingAuthor.retired.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this page leaves the foreground or the original draft or editing identity changes, its unconfirmed entrance configuration copy is cleared. Return to the original topic draft and reopen entrance details. This copy will not be restored or written back automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面离开前台、原草稿或编辑身份变化后，本次未确认的入口配置副本已清除。请返回原主题草稿，再重新打开入口资料；不会自动恢复或写回本次副本。"
          }
        }
      }
    },
    "walkingAuthor.return": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the original topic draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回原主题草稿"
          }
        }
      }
    },
    "walkingAuthor.scope.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
