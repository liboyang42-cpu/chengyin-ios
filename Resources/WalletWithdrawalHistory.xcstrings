  "sourceLanguage": "en",
  "strings": {
    "withdrawalHistory.statusFact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record statuses come from the server. Paid out does not independently verify bank receipt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下为服务端记录状态，“已打款”不能单独证明银行卡已到账。"
          }
        }
      }
    },
