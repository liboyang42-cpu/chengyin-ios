{
  "sourceLanguage": "en",
  "strings": {
    "projectStoryVariable.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Append a profile variable…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在末尾添加建档变量…"
          }
        }
      }
    },
    "projectStoryVariable.append": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入"
          }
        }
      }
    },
    "projectStoryVariable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile variables"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建档变量"
          }
        }
      }
    },
    "projectStoryVariable.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No declared profile variables are available in this draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前草稿没有可用的已声明建档变量。"
          }
        }
      }
    },
    "projectStoryVariable.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a variable to add to the end of this text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择变量添加到这段文字末尾。"
          }
        }
      }
    },
    "projectStoryVariable.reason.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text block could not be uniquely identified. Its text is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法唯一识别这段文字，原文保持不变。"
          }
        }
      }
    },
    "projectStoryVariable.reason.declarations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No variables are available yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可用变量。"
          }
        }
      }
    },
    "projectStoryVariable.reason.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Variable append is available for supported nonempty plain-text story blocks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有受支持的非空普通故事文字块可以添加变量。"
          }
        }
      }
    },
    "projectStoryVariable.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choices that would exceed the text length limit are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加后会超出文字长度限制的选项不可用。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
