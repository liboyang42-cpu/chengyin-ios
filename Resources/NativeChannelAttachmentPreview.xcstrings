{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "preview.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原附件预览"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original attachment preview"
          }
        }
      }
    },
    "preview.disclosure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在当前原权限与审核通过后加载短时受权图片；不公开或保存原链接，不按扩展名判断安全。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a short-lived authorized image only after checking current access and review. The original link is not published or saved, and a file extension is not proof of safety."
          }
        }
      }
    },
    "preview.status.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前预览状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current preview status"
          }
        }
      }
    },
    "preview.changed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前权限或消息已变化。请返回原频道，重新读取当前消息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access or the message has changed. Return to the original channel and read the current message again."
          }
        }
      }
    },
    "preview.idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未加载。重新进入会重新读取原授权，不复用旧签名链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not loaded. Reopening requires a fresh authorization check; an old signed link is never reused."
          }
        }
      }
    },
    "preview.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对原审核与受权附件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking original review and attachment authorization"
          }
        }
      }
    },
    "preview.pending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原附件审核中，不能预览或下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original attachment is under review and cannot be previewed or downloaded."
          }
        }
      }
    },
    "preview.rejected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原附件审核已拒绝，不能预览或下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original attachment was rejected and cannot be previewed or downloaded."
          }
        }
      }
    },
    "preview.expired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时链接已失效，已清理显示。需要重新核对原权限后获取新链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The short-lived link expired and the image was cleared. Check current access again to obtain a new link."
          }
        }
      }
    },
    "preview.unsupported": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前文件内容不受支持，未打开外部应用或执行文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file content is not supported. No external app was opened and no file was executed."
          }
        }
      }
    },
    "preview.sourceUnconfirmed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原附件身份尚未确认，未加载文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original attachment identity is unconfirmed. No file was loaded."
          }
        }
      }
    },
    "preview.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原消息已撤回、不可见或当前无权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original message was withdrawn, is unavailable, or is not accessible to you."
          }
        }
      }
    },
    "preview.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原授权或附件结果未知，已停止预览；不会自动使用旧链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization or the attachment result is unknown. Previewing stopped; the old link will not be reused automatically."
          }
        }
      }
    },
    "preview.image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权原图片"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized original image"
          }
        }
      }
    },
    "preview.notConfigured": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前消息的独立预览授权或媒体来源尚未配置；不会读取附件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent preview approval or an approved media origin is not configured for this message. The attachment will not be fetched."
          }
        }
      }
    },
    "preview.load": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确读取原授权并预览"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original authorization and preview"
          }
        }
      }
    },
    "preview.clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本次临时预览"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear this temporary preview"
          }
        }
      }
    }
  },
  "version": "1.0"
}
