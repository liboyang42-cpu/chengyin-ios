{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "preview.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        }
      }
    },
    "preview.disclosure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在当前原权限与审核通过后加载短时受权图片；不公开或保存原链接，不按扩展名判断安全。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a short-lived authorized image only after checking current access and review. The original link is not published or saved, and a file extension is not proof of safety."
          }
        }
      }
    },
    "preview.status.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前预览状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current preview status"
          }
        }
      }
    },
    "preview.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is no longer available. Go back and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已不可用，请返回后重试。"
          }
        }
      }
    },
    "preview.idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image not loaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片尚未加载"
          }
        }
      }
    },
    "preview.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading image…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载图片…"
          }
        }
      }
    },
    "preview.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is still under review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片审核中，暂时不能查看。"
          }
        }
      }
    },
    "preview.rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image didn't pass review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片未通过审核。"
          }
        }
      }
    },
    "preview.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link expired. Load the image again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接已过期，请重新加载。"
          }
        }
      }
    },
    "preview.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type isn't supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此文件类型。"
          }
        }
      }
    },
    "preview.sourceUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image can't be verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认这张图片。"
          }
        }
      }
    },
    "preview.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message was recalled or isn't available to you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已撤回或你无权查看。"
          }
        }
      }
    },
    "preview.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the image. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片加载失败，请重试。"
          }
        }
      }
    },
    "preview.image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片"
          }
        }
      }
    },
    "preview.notConfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images can't be opened right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法查看图片。"
          }
        }
      }
    },
    "preview.load": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载图片"
          }
        }
      }
    },
    "preview.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除图片"
          }
        }
      }
    }
  },
  "version": "1.0"
}
