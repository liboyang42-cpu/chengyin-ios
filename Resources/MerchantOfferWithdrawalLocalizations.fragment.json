  "merchant.offerWithdrawal.confirm.message": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "退出后供给将失效。已有订单与核销保留，不会自动退款；必选章节可能暂停新增报名，参与者可能收到通知。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "After exiting, the supply becomes inactive. Orders and redemptions are retained with no automatic refund; a required chapter may pause new enrolment and participants may be notified."
        }
      }
    }
  },
