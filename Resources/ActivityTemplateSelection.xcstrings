{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose activity template"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择活动玩法模板"
          }
        }
      }
    },
    "search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search my quotable templates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索可引用模板"
          }
        }
      }
    },
    "apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this selected template"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确使用所选模板"
          }
        }
      }
    },
    "create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a template"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建模板"
          }
        }
      }
    },
    "cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选择"
          }
        }
      }
    },
    "return": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to activity template choices"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回活动模板选择"
          }
        }
      }
    },
    "creationNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating a template leaves this activity draft unchanged. Return, refresh the list, then choose explicitly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建模板不会修改本活动草稿。返回后刷新列表，再明确选择。"
          }
        }
      }
    },
    "albumOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums can only be added to a story. Choose another gameplay template."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册只能添加到故事中，请选择其他玩法模板。"
          }
        }
      }
    },
    "unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This template configuration cannot be safely used here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模板配置暂时无法安全用于活动。"
          }
        }
      }
    },
    "status.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a search or choose a new read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入搜索词后重新读取。"
          }
        }
      }
    },
    "status.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading current templates…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前模板…"
          }
        }
      }
    },
    "status.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one template, then confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个模板，再明确确认。"
          }
        }
      }
    },
    "status.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching templates. You may create one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配模板，可创建新模板。"
          }
        }
      }
    },
    "status.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fresh read failed. Cached labels cannot be confirmed. Retry the search."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新读取失败，缓存条目不能确认，请重新搜索。"
          }
        }
      }
    },
    "status.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template reading is not configured for this account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户尚未配置模板读取。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
