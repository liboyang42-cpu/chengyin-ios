{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "notification.global.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        }
      }
    },
    "notification.channel.clubDefault": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部共同默认"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club-wide defaults"
          }
        }
      }
    },
    "notification.channel.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification settings"
          }
        }
      }
    },
    "notification.permission.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notification permission"
          }
        }
      }
    },
    "notification.state.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取通知设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading notification settings"
          }
        }
      }
    },
    "notification.state.saving": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存原请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the original request"
          }
        }
      }
    },
    "notification.state.checkingReceipt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对原请求回执"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the original request receipt"
          }
        }
      }
    },
    "notification.state.outcomeUnknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果待确认。保留了原请求，请先核对回执。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is unconfirmed. The original request is retained; check its receipt first."
          }
        }
      }
    },
    "notification.state.pending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求仍在处理中，请稍后查询。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is still processing. Check again later."
          }
        }
      }
    },
    "notification.state.applied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已保存，已重新读取当前设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request was saved and current settings were reloaded."
          }
        }
      }
    },
    "notification.state.appliedRedacted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已完成；当前权限已变化，历史结果已隐藏。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request completed. Access has changed, so its historical result is hidden."
          }
        }
      }
    },
    "notification.state.refreshFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已完成，但当前设置读取失败，请刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request completed, but current settings could not be loaded. Refresh to try again."
          }
        }
      }
    },
    "notification.state.persistenceFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求本地存储失败。结果尚未完成核对，请重试读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request could not be stored locally. Its result is not verified; try reading it again."
          }
        }
      }
    },
    "notification.state.accessClosed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法访问通知设置，请返回并重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification settings are not accessible. Go back and open this page again."
          }
        }
      }
    },
    "notification.error.invalidInput": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查时间、时区与通知选项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the time, time zone and notification options."
          }
        }
      }
    },
    "notification.error.read": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取失败，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the settings. Try again."
          }
        }
      }
    },
    "notification.error.versionConflict": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已被另一端更新，请读取当前设置并先核对原请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings changed on another device. Reload current settings and check the original request first."
          }
        }
      }
    },
    "notification.level.all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有消息"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages"
          }
        }
      }
    },
    "notification.level.mentions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提及我"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentions only"
          }
        }
      }
    },
    "notification.level.nothing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭普通通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary notifications off"
          }
        }
      }
    },
    "notification.level.inherit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继承上级设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inherit parent settings"
          }
        }
      }
    },
    "notification.effective.inherited": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继承后生效：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effective after inheritance: %@"
          }
        }
      }
    },
    "notification.effective.current": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前生效：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently effective: %@"
          }
        }
      }
    },
    "notification.mute.permanent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本级已永久静音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This level is permanently muted"
          }
        }
      }
    },
    "notification.mute.until": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本级静音截止：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This level is muted until: %@"
          }
        }
      }
    },
    "notification.mute.inherited": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上级设置正在静音；取消本级静音不会取消上级设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A parent setting is muted; unmuting this level will not unmute its parent"
          }
        }
      }
    },
    "notification.mute.none": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有生效的静音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No mute is currently effective"
          }
        }
      }
    },
    "notification.permission.system": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notification permission"
          }
        }
      }
    },
    "notification.permission.waiting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知权限待读取"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notification permission has not been read"
          }
        }
      }
    },
    "notification.permission.loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取系统通知权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading system notification permission"
          }
        }
      }
    },
    "notification.permission.notDetermined": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet chosen"
          }
        }
      }
    },
    "notification.permission.denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知已关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notifications are off"
          }
        }
      }
    },
    "notification.permission.authorized": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统允许通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notifications are allowed"
          }
        }
      }
    },
    "notification.permission.provisional": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许安静送达"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet delivery is allowed"
          }
        }
      }
    },
    "notification.permission.ephemeral": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时授权"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary permission"
          }
        }
      }
    },
    "notification.permission.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统权限状态未知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System permission status is unknown"
          }
        }
      }
    },
    "notification.permission.enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        }
      }
    },
    "notification.permission.disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "notification.permission.unsupported": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not supported on this device"
          }
        }
      }
    },
    "notification.permission.settingUnknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "notification.permission.explanation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以选择是否接收系统提醒。关闭系统提醒后，站内消息和前台未读仍会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose whether to receive system alerts. In-app messages and foreground unread counts remain when system alerts are off."
          }
        }
      }
    },
    "notification.permission.alerts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅与提醒"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners and alerts"
          }
        }
      }
    },
    "notification.permission.sounds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds"
          }
        }
      }
    },
    "notification.permission.badges": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标角标"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App icon badges"
          }
        }
      }
    },
    "notification.permission.request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择系统通知权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose system notification permission"
          }
        }
      }
    },
    "notification.permission.settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系统通知设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system notification settings"
          }
        }
      }
    },
    "notification.permission.delivery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统允许提醒后，是否收到通知还取决于频道设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even with system alerts allowed, whether you get a notification also depends on your channel settings."
          }
        }
      }
    },
    "notification.permission.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read permission again"
          }
        }
      }
    },
    "notification.permission.readFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取系统通知权限，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notification permission could not be read. Try again."
          }
        }
      }
    },
    "notification.permission.requestFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统授权操作未完成，请重新读取权限状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system permission action did not complete. Read the permission status again."
          }
        }
      }
    },
    "notification.permission.settingsFailed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开系统设置，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System settings could not be opened. Try again later."
          }
        }
      }
    },
    "notification.permission.actionUnknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统权限操作状态待确认，请重新读取权限状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system permission action is unconfirmed. Read the permission status again."
          }
        }
      }
    },
    "notification.global.accountDefault": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号默认通知设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account notification defaults"
          }
        }
      }
    },
    "notification.global.serverFallback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前服务端回落"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current server fallback"
          }
        }
      }
    },
    "notification.global.missingDefaults": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前服务未返回完整账号默认设置，不能据回落级别提交修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service did not return complete account defaults. The fallback level cannot authorize changes."
          }
        }
      }
    },
    "notification.global.defaultLevel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认通知级别"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default notification level"
          }
        }
      }
    },
    "notification.global.noOverrides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已保存的可见覆盖设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved, visible overrides."
          }
        }
      }
    },
    "notification.global.savedOverrides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的覆盖设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved overrides"
          }
        }
      }
    },
    "notification.global.overrideBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只列服务端返回且当前仍有权访问的覆盖；不会把空列表解释为所有频道都已开启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only overrides returned by the server and still accessible are listed. An empty list does not mean all channels are enabled."
          }
        }
      }
    },
    "notification.global.channelScope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频道 %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel %@"
          }
        }
      }
    },
    "notification.global.clubScope": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部 %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club %@"
          }
        }
      }
    },
    "notification.global.rowSummary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
