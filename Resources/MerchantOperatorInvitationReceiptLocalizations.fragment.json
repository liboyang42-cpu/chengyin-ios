  "merchant.operatorInvite.recipientInstructions": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The recipient can enter this code in the operator invitation screen, then review and accept the invitation."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "受邀人可在员工邀请页面输入此码，然后查看并接受邀请。"
        }
      }
    }
  },
  "merchant.operatorInvite.memoryLifetime": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This app keeps the code on this screen for up to 10 minutes or until server expiry, whichever comes first. It clears the screen when you leave or put the app in the background."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此页面最多保留邀请码 10 分钟，或在服务器到期时提前清除。离开页面或将应用切到后台时会清除显示。"
        }
      }
    }
  },
  "merchant.operatorInvite.unavailable": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The invitation was created, but this response cannot safely display its code. Reload the team to manage or revoke it."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "邀请已创建，但此响应无法安全显示邀请码。请重新加载团队以管理或撤销邀请。"
        }
      }
    }
  },
  "merchant.operatorInvite.close": {
    "extractionState": "manual",
