    "cityHistory.status.initial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your original server history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取本人的服务端原历史。"
          }
        }
      }
    },
    "cityHistory.status.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History read approval is unavailable or the account changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史读取未获批准或账号上下文已变化。"
          }
        }
      }
    },
    "cityHistory.status.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No original onsite task records for this account and region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号在此区域没有原现场任务记录。"
          }
        }
      }
    },
    "cityHistory.status.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original server records loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取服务端原记录。"
          }
        }
      }
    },
    "cityHistory.status.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original instance and committed attempts loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取原实例与已提交尝试。"
          }
        }
      }
    },
    "cityHistory.status.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original outcome remains unknown; no action was replayed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果仍未知，未重放任何动作。"
          }
        }
      }
    },
    "cityHistory.status.receipt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original receipt read without replaying the action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读取原回执，未重放动作。"
          }
        }
      }
    },
    "cityHistory.status.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to read your own history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录后读取本人历史。"
          }
        }
      }
    },
    "cityHistory.status.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History could not be verified. This is not an empty-history result; retry reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史尚不可核实，这不等于没有记录。请重试读取。"
          }
        }
      }
    },
    "cityHistory.task.active": {
      "extractionState": "manual",
      "localizations": {
