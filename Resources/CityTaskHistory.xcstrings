    "cityHistory.historicalOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained facts do not restore current eligibility. A closed board, paused store or expired proof cannot be bypassed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留历史不恢复当前资格。本页不能绕过板块关闭、门店暂停或证据过期。"
          }
        }
      }
    },
