{
  "sourceLanguage": "en",
  "strings": {
    "cityHistory.entry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My CITY task history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人的 CITY 任务历史"
          }
        }
      }
    },
    "cityHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CITY task history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CITY 任务历史"
          }
        }
      }
    },
    "cityHistory.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal original onsite task records only. This is not a teammate timeline or proof of current presence. No replay, points, rewards or operating rights."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查看本人原现场任务记录，不是队友时间线，也不证明当前到场。不重放动作、不扣发积分或授予经营权。"
          }
        }
      }
    },
    "cityHistory.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新历史"
          }
        }
      }
    },
    "cityHistory.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older records"
