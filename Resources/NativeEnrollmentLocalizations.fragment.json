  "nativeEnrollment.review.create": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Create a persistent Apple App Attest key for this account and app, then obtain a challenge from the activity service and prepare an Apple attestation. You will review before sending the attestation to the service."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "为此账户与应用创建持久的 Apple App Attest 密钥，然后从活动服务获取挑战并准备 Apple 证明。向活动服务发送证明前会再次供你审核。"
        }
      }
    }
  },
  "nativeEnrollment.review.enroll": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Send this prepared Apple attestation and opaque key identifier to the activity service to bind this device key to the displayed account and App ID."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "将准备好的 Apple 证明与不透明密钥标识提交至活动服务，将此设备密钥绑定到所示账户与 App ID。"
        }
      }
    }
  },
  "nativeEnrollment.review.revoke": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Ask the activity service to permanently revoke this account’s selected verification key."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请求活动服务永久撤销此账户所选的验证密钥。"
        }
      }
    }
  },
  "nativeEnrollment.noHardwareProof": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "App Attest verifies app/key/request provenance. It does not independently prove an iPhone hardware class, physical walking or who carried the phone."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "App Attest 验证应用、密钥与请求来源，不能独立证明 iPhone 硬件类别、实际行走或携带手机的人。"
        }
      }
    }
  },
  "nativeEnrollment.keyDurability": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Apple manages the private key. This app stores only its opaque handle and pending proof in device-only Keychain storage. A previous key is never reassigned to another account."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "私钥由 Apple 管理。本应用仅在设备专用钥匙串中保存不透明句柄与待处理证明，旧密钥不会转移给其他账户。"
        }
      }
    }
  },
  "nativeEnrollment.revokeConsequence": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Step-audit assertions using this key will stop working. Revocation cannot reactivate the same key and does not delete the SDK key. A new key requires a separate explicit enrollment."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用此密钥的步数审核凭据将停止工作。撤销后不能重新启用同一密钥，也不会删除 SDK 密钥。新密钥需要另行主动登记。"
        }
      }
    }
  },
