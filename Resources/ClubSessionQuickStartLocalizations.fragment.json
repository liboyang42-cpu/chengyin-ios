{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "club.sessionStart.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a club session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开一场"
          }
        }
      }
    },
    "club.sessionStart.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a manageable topic. The form starts with one session; choose its schedule and lead, then use the existing review and authorization steps. Opening this form creates nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择可开场主题。表单默认单次，请选择排期与领队，再按原有审核和授权流程操作。打开表单不会创建场次。"
          }
        }
      }
    },
    "club.sessionStart.ownerRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current club owner access is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要当前俱乐部主理人身份。"
          }
        }
      }
    },
    "club.sessionStart.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club access or manageable topics could not be checked. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法核对俱乐部权限或可开场主题，请重试。"
          }
        }
      }
    },
    "club.sessionStart.topicUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This topic is no longer in the refreshed list. Choose another topic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选主题已不在刷新后的可开场列表中，请重新选择。"
          }
        }
      }
    },
    "club.sessionStart.chooseTopic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a topic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择可开场主题"
          }
        }
      }
    },
    "club.sessionStart.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no manageable topics in this response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次读取暂无可开场主题。"
          }
        }
      }
    },
    "club.sessionStart.unnamedTopic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed topic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名主题"
          }
        }
      }
    },
    "club.sessionStart.owned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owned by this club"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自有主题"
          }
        }
      }
    },
    "club.sessionStart.cooperative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cooperative topic"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合作主题"
          }
        }
      }
    },
    "club.sessionStart.originUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publisher not provided"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供主题归属"
          }
        }
      }
    },
    "club.sessionStart.startDate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server start date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端开始日期"
          }
        }
      }
    },
    "club.sessionStart.endDate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server end date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端结束日期"
          }
        }
      }
    }
  }
}
