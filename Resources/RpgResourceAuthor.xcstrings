    },
    "rpgResource.issue.50": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original recovery.stageRestLuckFloor exceeds the new luck maximum. The original value is preserved and preview is blocked; recovery amounts are not changed automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原recovery.stageRestLuckFloor超出luck新上限；保留原值并拒绝预览，不自动改恢复量。"
          }
        }
      }
    },
    "rpgResource.issue.51": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration contains fields outside the original resource contract. They will not be deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration含原资源合同之外字段；不会删除它们。"
          }
        }
      }
    },
    "rpgResource.issue.52": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration availability must be an explicit Boolean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration启用配置须为明确布尔值。"
          }
        }
      }
    },
    "rpgResource.issue.53": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration initial value must be a nonnegative integer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration初始值须为非负整数。"
          }
        }
      }
    },
    "rpgResource.issue.54": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration initial value cannot exceed its maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration初始值不能超过该资源上限。"
          }
        }
      }
    },
    "rpgResource.issue.55": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration editing requires explicit availability, maximum and initial value. No defaults are supplied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration本次编辑须明确启用状态、上限和初始值；不代填默认值。"
          }
        }
      }
    },
    "rpgResource.issue.56": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspiration maximum must be an integer from 0 to 1000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "inspiration上限须为0–1000整数。"
          }
        }
      }
    },
    "rpgResource.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves only the local draft. Does not save to the server or publish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存本地草稿，不保存服务器或发布。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
