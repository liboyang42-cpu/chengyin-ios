    "rpgResource.issue.49": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luck maximum must be an integer from 0 to 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "luck上限须为0–5整数。"
