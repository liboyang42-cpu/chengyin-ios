      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View all orders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看全部订单"
          }
        }
      }
    },
    "profile.selfOrders.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
