{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "templateAuthorExit.back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "templateAuthorExit.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开创作编辑？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the editor?"
          }
        }
      }
    },
    "templateAuthorExit.leave": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存，直接离开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave without saving"
          }
        }
      }
    },
    "templateAuthorExit.continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep editing"
          }
        }
      }
    },
    "templateAuthorExit.retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查保存状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recheck saved state"
          }
        }
      }
    },
    "templateAuthorExit.unsaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have changes that aren't saved. If you leave, they may be lost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未保存的修改，离开后可能丢失。"
          }
        }
      }
    },
    "templateAuthorExit.unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm your draft is saved. Check again, keep editing, or leave without saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认草稿已保存。可重新检查、继续编辑，或不保存离开。"
          }
        }
      }
    }
  }
}
