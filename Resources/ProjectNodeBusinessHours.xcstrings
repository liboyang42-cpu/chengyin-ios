{
  "sourceLanguage": "en",
  "strings": {
    "projectNodeHours.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored business hours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "营业时间记录"
          }
        }
      }
    },
    "projectNodeHours.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No business-hours text is stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存营业时间文字。"
          }
        }
      }
    },
    "projectNodeHours.edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit stored hours…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑营业时间…"
          }
        }
      }
    },
    "projectNodeHours.begin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set replacement hours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置新的时间记录"
          }
        }
      }
    },
    "projectNodeHours.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply replacement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用新时间"
          }
        }
      }
    },
    "projectNodeHours.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间"
          }
        }
      }
    },
    "projectNodeHours.end": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间"
          }
        }
      }
    },
    "projectNodeHours.hour": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时"
          }
        }
      }
    },
    "projectNodeHours.minute": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分"
          }
        }
      }
    },
    "projectNodeHours.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening hours shown to players, as HH:mm-HH:mm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向玩家展示的营业时间，格式 HH:mm-HH:mm。"
          }
        }
      }
    },
    "projectNodeHours.reason.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This node cannot be uniquely identified. The stored field is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法唯一识别该节点，原字段保持不变。"
          }
        }
      }
    },
    "projectNodeHours.reason.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This legacy or unsupported value is retained unchanged and cannot be edited with this picker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此历史或不支持的值保持原样，无法用当前选择器修改。"
          }
        }
      }
    },
    "projectNodeHours.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear business hours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除营业时间"
          }
        }
      }
    },
    "projectNodeHours.clearPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Business hours will be cleared when you tap Apply. This does not set opening or availability rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击应用后将清除营业时间。这不会设置开放或可用性规则。"
          }
        }
      }
    },
    "projectNodeHours.keep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep current business hours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留当前营业时间"
          }
        }
      }
    }
  },
  "version": "1.0"
}
