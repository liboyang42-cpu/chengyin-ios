{
  "sourceLanguage": "en",
  "strings": {
    "open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览静态模型"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview static model"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型预览暂不可用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model preview is unavailable"
          }
        }
      }
    },
    "privateOnly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本人短时预览，不代表审核通过。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary owner-only preview. This does not mean approval."
          }
        }
      }
    },
    "staticOnly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持有界静态 GLB。动画、骨骼和扩展模型暂不支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports bounded static GLB only. Animated, skinned and extended models are not supported."
          }
        }
      }
    },
    "limits": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭、离开前台或权限失效会清除本次预览；重试需重新读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing, leaving the foreground or loss of access clears this preview. Retry reads it again."
          }
        }
      }
    },
    "title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人模型预览"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My model preview"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备静态模型…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing static model…"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法预览此模型，请检查支持范围后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model could not be previewed. Check the supported profile before retrying."
          }
        }
      }
    },
    "expired": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次预览已到期"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview has expired"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        }
      }
    },
    "viewport": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静态模型，可用下方按钮旋转"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Static model. Use the button below to rotate."
          }
        }
      }
    },
    "rotate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动 45°"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate 45°"
          }
        }
      }
    }
  },
  "version": "1.0"
}
