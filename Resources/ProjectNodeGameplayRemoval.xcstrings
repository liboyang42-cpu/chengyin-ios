{
  "sourceLanguage": "en",
  "strings": {
    "projectNodeGameplay.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove gameplay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除玩法"
          }
        }
      }
    },
    "projectNodeGameplay.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the gameplay from this stop. The stop and its story stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此地点的玩法，地点和故事保留。"
          }
        }
      }
    },
    "projectNodeGameplay.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop has no gameplay that can be removed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地点没有可在此移除的玩法。"
          }
        }
      }
    },
    "projectNodeGameplay.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this stop's gameplay?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此地点的玩法？"
          }
        }
      }
    },
    "projectNodeGameplay.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "projectNodeGameplay.impact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story or conditions that depend on this gameplay need checking afterwards. The template itself isn't deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖此玩法的故事或条件需要重新检查，模板本身不会删除。"
          }
        }
      }
    },
    "projectNodeGameplay.saveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm the draft was saved. Reopen the draft to check it before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认草稿已保存，请重新打开草稿检查后继续。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
