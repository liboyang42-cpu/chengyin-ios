{
  "sourceLanguage": "en",
  "strings": {
    "projectPendingNodeRemoval.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move nodes to pending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移入待编排区"
          }
        }
      }
    },
    "projectPendingNodeRemoval.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These stops move to the pending area. You can undo for 5 seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些地点会移入待编排区，5 秒内可撤销。"
          }
        }
      }
    },
    "projectPendingNodeRemoval.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to pending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认移入待编排区"
          }
        }
      }
    },
    "projectPendingNodeRemoval.moved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to pending. Undo is available for 5 seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移入待编排区，5 秒内可撤销。"
          }
        }
      }
    },
    "projectPendingNodeRemoval.undo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo move"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销移动"
          }
        }
      }
    },
    "projectPendingNodeRemoval.guest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guest draft stays in memory and is not saved to your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访客草稿仅保留在内存中，不会保存到账户。"
          }
        }
      }
    },
    "projectPendingNodeRemoval.saveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't confirm the draft was saved. Reopen it to check before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认草稿已保存，请重新打开检查后再试。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
