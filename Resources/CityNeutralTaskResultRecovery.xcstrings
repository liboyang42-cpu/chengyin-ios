{
  "sourceLanguage": "en",
  "strings": {
    "cityNeutralResult.original": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request record. This is not current task eligibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求记录，不代表当前任务资格。"
          }
        }
      }
    },
    "cityNeutralResult.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果暂不可用。"
          }
        }
      }
    },
    "cityNeutralResult.refreshFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not refresh. The previously verified original record is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新失败，下面仍显示先前已核实的原请求记录。"
          }
        }
      }
    },
    "cityNeutralResult.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View original request result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看原请求结果"
          }
        }
      }
    },
    "cityNeutralResult.request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求"
          }
        }
      }
    },
    "cityNeutralResult.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this account’s original request is read. No task is retried and no fee, points or reward is granted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅读取本账号的原请求，不重试任务，不产生费用、积分或奖励。"
          }
        }
      }
    },
    "cityNeutralResult.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original request again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取原请求"
          }
        }
      }
    },
    "cityNeutralResult.task": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "cityNeutralResult.instance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original instance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原任务实例"
          }
        }
      }
    },
    "cityNeutralResult.attempts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared attempts at this request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次请求时的共享尝试次数"
          }
        }
      }
    },
    "cityNeutralResult.zeroEffects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This approved neutral task has no point cost, point reward or action cost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此已批准中立任务不消耗积分、不奖励积分、不消耗行动额度。"
          }
        }
      }
    },
    "cityNeutralResult.result": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果"
          }
        }
      }
    },
    "cityNeutralResult.completedAt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result recorded at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果记录时间"
          }
        }
      }
    },
    "cityNeutralResult.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original task result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原任务结果"
          }
        }
      }
    },
    "cityNeutralResult.status.ACTIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded. The task was still in progress after this request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录。本次请求后任务仍进行中。"
          }
        }
      }
    },
    "cityNeutralResult.status.PASSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed in this original request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次原请求已通过任务。"
          }
        }
      }
    },
    "cityNeutralResult.status.EXHAUSTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attempts exhausted in this original request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次原请求已用尽尝试次数。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
