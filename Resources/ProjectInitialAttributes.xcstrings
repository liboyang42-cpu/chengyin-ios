{
  "sourceLanguage": "en",
  "strings": {
    "projectInitialAttributes.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom initial attributes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义初始属性"
          }
        }
      }
    },
    "projectInitialAttributes.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the starting values for this topic. Runs already in progress keep theirs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置本主题的初始属性，进行中的对局保持原设置。"
          }
        }
      }
    },
    "projectInitialAttributes.enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable initial state"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用初始状态"
          }
        }
      }
    },
    "projectInitialAttributes.enabledHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns attributes on or off for this topic. Energy, luck and check settings are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭本主题的属性，精力、幸运与检定设置均保留。"
          }
        }
      }
    },
    "projectInitialAttributes.key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标识"
          }
        }
      }
    },
    "projectInitialAttributes.keyLocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing codes can't be renamed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有标识不能改名。"
          }
        }
      }
    },
    "projectInitialAttributes.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "projectInitialAttributes.initial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial value"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始值"
          }
        }
      }
    },
    "projectInitialAttributes.minimum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下限"
          }
        }
      }
    },
    "projectInitialAttributes.maximum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上限"
          }
        }
      }
    },
    "projectInitialAttributes.visible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible to player"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向玩家展示"
          }
        }
      }
    },
    "projectInitialAttributes.flagHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "clue.* and tag.* use bounds 0 and 1; the initial value must be 0 or 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "clue.* 与 tag.* 的上下限固定为 0 和 1，初始值也须为 0 或 1。"
          }
        }
      }
    },
    "projectInitialAttributes.integerHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use integers from −10000 to 10000. The initial value must be within the minimum and maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写 −10000 至 10000 的整数，初始值须位于上下限之间。"
          }
        }
      }
    },
    "projectInitialAttributes.keysHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 32. Codes start with clue., relation., tag. or counter., then lowercase letters, digits or _. Names up to 24 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 32 项。标识以 clue.、relation.、tag. 或 counter. 开头，后接小写字母、数字或下划线。名称最多 24 字。"
          }
        }
      }
    },
    "projectInitialAttributes.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add declaration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加声明"
          }
        }
      }
    },
    "projectInitialAttributes.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove initial declaration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除初始声明"
          }
        }
      }
    },
    "projectInitialAttributes.removeTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this initial declaration?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此初始声明？"
          }
        }
      }
    },
    "projectInitialAttributes.removeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this attribute from the draft. Places that use it must be fixed before publishing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从草稿中移除此属性，引用它的地方需在发布前修正。"
          }
        }
      }
    },
    "projectInitialAttributes.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到草稿"
          }
        }
      }
    },
    "projectInitialAttributes.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that codes are unique and values are whole numbers within range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查标识不重复，数值为范围内的整数。"
          }
        }
      }
    },
    "projectInitialAttributes.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These imported rules cannot be safely edited here. Their original contents are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导入规则无法在这里安全编辑，原始内容已保留。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
