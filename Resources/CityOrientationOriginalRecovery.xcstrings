{
  "sourceLanguage": "en",
  "strings": {
    "cityOriginalRecovery.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original answer recovery"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原答题请求恢复"
          }
        }
      }
    },
    "cityOriginalRecovery.applied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已完成"
          }
        }
      }
    },
    "cityOriginalRecovery.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request was declined"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求未通过"
          }
        }
      }
    },
    "cityOriginalRecovery.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the original receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对原回执"
          }
        }
      }
    },
    "cityOriginalRecovery.approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is preserved. Receipt access for its original run is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已保留，等待该原局的回执读取权限。"
          }
        }
      }
    },
    "cityOriginalRecovery.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original outcome is still unknown. Check its receipt without resubmitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果仍待确认。仅查询原回执，不重新提交。"
          }
        }
      }
    },
    "cityOriginalRecovery.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure storage is unavailable. The original request will not be replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全存储暂不可用，原请求不会被替换。"
          }
        }
      }
    },
    "cityOriginalRecovery.settled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original receipt acknowledged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对原回执"
          }
        }
      }
    },
    "cityOriginalRecovery.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request recovery is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求恢复未就绪"
          }
        }
      }
    },
    "cityOriginalRecovery.read": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询原回执"
          }
        }
      }
    },
    "cityOriginalRecovery.acknowledge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledge receipt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对"
          }
        }
      }
    }
  },
  "version": "1.0"
}
