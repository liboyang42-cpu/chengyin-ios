      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prepared review is no longer current. Return to the editor and prepare a new review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此审核内容已失效，请返回编辑器重新准备审核。"
          }
        }
      }
    },
