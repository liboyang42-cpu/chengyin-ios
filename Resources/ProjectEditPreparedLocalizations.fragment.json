    "projectPrepared.localSaveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared values are shown, but local saving was not confirmed. Closing this review does not undo a write that may already have completed."
