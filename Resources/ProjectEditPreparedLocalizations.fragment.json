{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "projectPrepared.nodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted chapter nodes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次提交的章节节点"
          }
        }
      }
    },
    "projectPrepared.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These values and their order come from the captured submission request. Image and template references are shown only as text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下数值及顺序来自本次捕获的提交请求。图片与玩法模板引用仅显示为文本。"
          }
        }
      }
    },
    "projectPrepared.draftContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft configuration below is context. It may contain local-only or normalized fields; the submitted nodes and complete prepared fields above show what this request includes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下方草稿配置用于对照，可能含仅本地保留或需规范化的字段；上方提交节点与完整请求字段显示本次请求实际包含的内容。"
          }
        }
      }
    },
    "projectPrepared.omittedChapters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request omits chapters. Existing chapter content is not replaced by this limited update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求不含章节，本次受限更新不会替换既有章节内容。"
          }
        }
      }
    },
    "projectPrepared.emptyChapters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared request contains an empty chapter list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备请求中的章节列表为空。"
          }
        }
      }
    },
    "projectPrepared.emptyNodes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter contains no submitted nodes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此章节不含提交节点。"
          }
        }
      }
    },
