{
  "sourceLanguage": "en",
  "strings": {
    "profile.currentMedia.savedWork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved work images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已保存作品图"
          }
        }
      }
    },
    "profile.currentMedia.savedQR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved contact QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已保存联系二维码"
          }
        }
      }
    },
    "profile.currentMedia.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved image preview is unavailable. Keeping or removing it still requires your selection and save confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前图片预览暂不可用。保留或移除仍需明确选择并确认保存。"
          }
        }
      }
    },
    "profile.currentMedia.savedOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview shows the current saved profile, not staged edits, an upload result, or review status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览来自当前已保存资料，不代表待保存修改、上传结果或审核状态。"
          }
        }
      }
    },
    "profile.currentMedia.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current profile or read access has changed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前资料或读取权限已变化"
          }
        }
      }
    },
    "profile.currentAvatar.saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved avatar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已保存头像"
          }
        }
      }
    },
    "profile.currentAvatar.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
