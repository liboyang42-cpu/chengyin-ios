      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binding theme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定主题"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.unbound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbound draft, not publishable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不绑定主题，仅保留草稿"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.owner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual theme owner member ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真实主题负责人会员 ID"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.owned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed topic. Story approval still belongs to its actual owner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可管理主题。剧情仍须由该主题真实负责人审核。"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.cooperation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved cooperation with an active offer. Permission is checked again when you submit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准合作且供给有效。提交时会再次校验授权。"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.noSelfReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing review rule does not allow the revision author to approve their own story. Another authorized store colleague must author it for this owner to review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "既有审核规则禁止内容作者自审。需由另一名有权店员创作，再交该主题负责人审核。"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.notPublishable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft cannot be published without a currently authorized theme and its owner’s story approval. Your draft is kept; its binding is not changed automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未绑定当前有权主题并取得该主题负责人的剧情审核前，不可发布。草稿保留，不会自动改换绑定。"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the first 100 authorized themes. No other theme is selected automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示前 100 个有权主题，不会自动选择其他主题。"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh authorized themes without discarding this draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新有权主题，保留当前草稿"
          }
        }
      }
    },
    "merchantAuthoring.themeChoice.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The authoritative theme list is unavailable. This is not proof that you have no permission. Refresh when the service is available; this draft stays unpublished."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权威主题列表暂不可用，不代表你没有权限。服务恢复后请刷新，当前草稿保持未发布。"
          }
        }
      }
    },
    "merchantAuthoring.product.new": {
      "localizations": {
