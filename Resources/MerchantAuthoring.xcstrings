      }
    },
    "merchantAuthoring.player.closeExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this local pending marker will be removed. The server reply is not deleted, and AI will not be called again. Any new question is a separate explicit action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除本地待确认标记，不删除服务端回复，也不再次调用 AI。新问题需要另行明确发送。"
          }
        }
      }
    },
    "merchantAuthoring.player.unresolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is still unresolved. Keep its ID; do not send a replacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求仍待确认，请保留原编号，不要用新请求替代。"
          }
        }
      }
    },
