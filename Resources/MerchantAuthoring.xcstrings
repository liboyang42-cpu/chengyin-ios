    "merchantAuthoring.finite.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid finite-copy version or content. Check every branch, reason, variable, and the 160-code-point limit. Unknown versions stay read-only and are not overwritten with legacy content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限分支版本或正文无效。检查全部分支正文、理由、变量和 160 字符限制；未知版本只读保留，不降级覆盖。"
          }
        }
      }
    },
    "merchantAuthoring.finite.frozen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the frozen copy for this review or release version. The model may return only the designated branch and original reason, not new rules or rewritten copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是本次审核或此发布版本的冻结正文。模型只能返回指定分支及原理由，不能生成新规则或改写正文。"
          }
