      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finite branch copy v1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限分支正文 v1"
          }
        }
      }
