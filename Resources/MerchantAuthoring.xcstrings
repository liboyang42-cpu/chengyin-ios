    "merchantAuthoring.player.confirmClose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the verified terminal request?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭已核实的终态请求？"
          }
