    "merchantAuthoring.finite.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit copy and selection reasons only for approved branches. Canonical plot plus rendered copy is limited to 160 Unicode code points. Use only selected time/weather placeholders. Do not change task conditions, routes, time limits, rewards, or product commitments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只编辑已批准分支的正文和选择理由。正文加主线渲染后最多 160 个字符；仅可使用勾选的时段和天气占位符。不改任务条件、路线、时限、奖励或商品承诺。"
          }
        }
      }
    },
    "merchantAuthoring.finite.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分支正文"
          }
        }
      }
    },
    "merchantAuthoring.finite.reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved selection reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已审核选择理由"
          }
        }
      }
    },
    "merchantAuthoring.finite.environment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weather comes only from approved, fresh server observations. Missing or severe weather keeps the fixed safe exit. This configuration does not authorize location access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天气只来自服务端已批准且未过期的观测。缺失或严重天气固定安全退出；此配置不授权获取位置。"
          }
        }
      }
    },
    "merchantAuthoring.finite.legacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft uses the existing contract, not finite branches v1. Existing releases are never automatically rewritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此稿沿用原合同，尚未配置有限分支 v1。原发布不会被自动改写。"
          }
        }
      }
    },
    "merchantAuthoring.finite.enable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure finite copy for this draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为当前草稿配置有限正文"
          }
