    "cityValue.missingSources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public/cooperative goals, visit net points and budget costs lack complete sources. Newcomer/veteran definitions are not established. These remain unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公共/合作目标、访问净积分和预算成本尚无完整真源，新手/老手口径未建立，保持未知。"
          }
