          "stringUnit": {
            "state": "translated",
            "value": "Cooperative goal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合作目标"
          }
        }
      }
    },
    "cityValue.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CITY value access is not enabled for this region. Missing collection is not zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用此区域的城市价值读取，未采集不代表零。"
          }
        }
      }
    },
    "cityValue.entry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit entry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入访问"
          }
        }
      }
    },
    "cityValue.entryNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry is recorded only after you explicitly bind a published location. Browsing, walking and login are not meaningful actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已发布据点并确认绑定后才记录进入。浏览、走路和登录不会被算作有意义动作。"
          }
        }
      }
    },
    "cityValue.exit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End visit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束访问"
          }
        }
      }
    },
    "cityValue.fact.ENTRY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit entry"
          }
        },
        "zh-Hans": {
