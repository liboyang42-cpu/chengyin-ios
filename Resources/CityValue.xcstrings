{
  "sourceLanguage": "en",
  "strings": {
    "cityValue.benefit.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回报表"
          }
        }
      }
    },
    "cityValue.benefit.couponID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted coupon type ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当时发放券种 ID"
          }
        }
      }
    },
    "cityValue.benefit.factID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report fact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报表事实"
          }
        }
      }
    },
    "cityValue.benefit.historyOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This confirms the coupon type granted at that time, not an individual coupon instance or current usability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅回读当时发放的券种，不代表玩家券实例或当前仍可使用。"
          }
        }
      }
    },
    "cityValue.benefit.open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View original benefit record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看原始受益记录"
          }
        }
      }
    },
    "cityValue.benefit.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read this record again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取这条记录"
          }
        }
      }
    },
    "cityValue.benefit.serviceID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published service point"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布服务点"
          }
        }
      }
    },
    "cityValue.benefit.sourceID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original grant record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始发券记录"
          }
        }
      }
    },
    "cityValue.benefit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original benefit record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始受益记录"
          }
        }
      }
    },
    "cityValue.benefit.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original grant evidence is unavailable. This does not mean zero benefit or a new grant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始发券依据缺失或不完整，无法核实；不按零受益或新发券处理。"
          }
        }
      }
    },
    "cityValue.benefit.verified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original committed record confirms this coupon grant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对原始已提交记录，确认当时成功发券。"
          }
        }
      }
    },
    "cityValue.bind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind this service visit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定这次服务访问"
          }
        }
      }
    },
    "cityValue.bindReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bind this visit to the current CITY publication? This records only necessary service facts; it does not complete a challenge or grant a reward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认将本次访问绑定到当前城市发布？只记录必要的服务事实，不自动完成任务或领取奖励。"
          }
        }
      }
    },
    "cityValue.budget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget cost"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预算成本"
          }
        }
      }
    },
    "cityValue.cancel": {
      "localizations": {
