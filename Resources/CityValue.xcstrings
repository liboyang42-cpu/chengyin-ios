            "value": "Source-verified meaningful action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源验证的有意义动作"
          }
        }
      }
    },
    "cityValue.fact.SERVICE_RATING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-party service rating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人服务评分"
          }
        }
      }
    },
    "cityValue.fact.SERVICE_SUCCESS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-confirmed service benefit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源确认的服务获益"
          }
        }
      }
    },
    "cityValue.fact.SKIP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voluntary skip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动跳过"
          }
        }
      }
    },
    "cityValue.factsNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fact pages stay on one immutable snapshot. Retries neither skip nor duplicate rows; late facts require a new query. No player names, locations or answers are shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事实分页固定在同一快照。重试不漏项不重复；迟到事实需重新查询。无玩家姓名、位置或答案。"
          }
        }
      }
    },
    "cityValue.firstChoiceTime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to first effective choice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到首个有效选择的时间"
          }
        }
      }
    },
    "cityValue.from": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间"
          }
        }
      }
    },
    "cityValue.incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This aggregate exceeded its limit. Partial totals are not displayed. Narrow the window; fact pages below are evidence only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据超过本次聚合上限，不展示不完整总数。请缩短时间范围；下方事实分页仅供追溯。"
          }
        }
      }
    },
    "cityValue.issue.BENEFIT_FAILED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read this original record. Your report filters and pages are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始记录暂不可读，报表筛选和已加载分页保持不变。"
          }
        }
      }
    },
    "cityValue.issue.BIND_UNKNOWN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Binding outcome is unknown. Read back or retry the same binding; no success is assumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定结果未知。请先重新读取，或重试相同绑定，不会凭空创建成功。"
          }
        }
      }
    },
    "cityValue.issue.FEEDBACK_UNKNOWN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback outcome is unknown. Retry only the same feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈结果未知，只能重试刚才相同反馈。"
          }
        }
      }
    },
    "cityValue.issue.NOT_CONFIGURED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval is absent or expired. Reads are stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准已失效或未配置，停止读取。"
          }
        }
      }
    },
    "cityValue.issue.NO_PERMISSION": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant permission is missing or has changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前商家权限不足或已变更。"
          }
        }
      }
    },
    "cityValue.issue.PAGE_FAILED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page failed. The cursor was not advanced; retry the same page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本页读取失败，游标未推进，可原位重试。"
          }
        }
      }
    },
    "cityValue.issue.READ_FAILED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read failed; this is not zero. Retry the same request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取失败，不能按零值展示。可重试同一请求。"
          }
        }
      }
    },
    "cityValue.meaningful": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First meaningful action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首个有意义动作"
