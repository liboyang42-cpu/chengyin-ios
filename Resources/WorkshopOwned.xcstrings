    "workshopOwned.publication.LISTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source is listed. This does not enable installation or content use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源仍在架。此状态不会启用安装或内容使用。"
          }
        }
      }
    },
    "workshopOwned.publication.RETIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source retired from acquisition. Retirement alone does not rewrite the original frozen rights."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源已停止新领取。普通下架本身不改变原冻结权利。"
          }
        }
      }
    },
    "workshopOwned.publication.EMERGENCY_BLOCKED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source blocked for safety or legal review. This view does not determine refund or existing-use outcomes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源因安全或法律事项被停用。本页面不决定退款或既有使用的后续处置。"
          }
        }
      }
    },
    "workshopOwned.publication.UNAVAILABLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source status cannot be confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认来源状态。"
          }
        }
      }
    },
