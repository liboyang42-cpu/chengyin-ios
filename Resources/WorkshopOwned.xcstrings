    "workshopOwned.status.UNAVAILABLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current status unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态不可确认"
          }
        }
      }
