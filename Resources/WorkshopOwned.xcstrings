{
  "sourceLanguage": "en",
  "strings": {
    "workshopOwned.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workshop acquisitions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工坊领取记录"
          }
        }
      }
    },
    "workshopOwned.unavailable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workshop records unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工坊记录暂不可用"
          }
        }
      }
    },
    "workshopOwned.unavailable.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account’s Workshop read service is not available yet. No ownership result has been returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号的工坊查询服务尚不可用，当前未取得任何持有结果。"
          }
        }
      }
    },
    "workshopOwned.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading acquisition records…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取领取记录…"
          }
        }
      }
    },
    "workshopOwned.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No free acquisition records were returned. Purchased packages are not included in this view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未查询到免费领取记录。此页面不包含已购买的玩法包。"
          }
        }
      }
    },
    "workshopOwned.hasMore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the latest 50 records. More records exist; further pages are not available in this read view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示最近 50 条记录。还有更多记录，本查询视图暂不支持继续翻页。"
          }
        }
      }
    },
