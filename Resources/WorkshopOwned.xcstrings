    },
    "workshopOwned.status.EXPIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded free-license status: expired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费授权记录状态：已到期"
          }
        }
