    "workshopOwned.contentUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package details, licensed content, editing and installation are not available through this record. Its status does not authorize a new use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本记录暂不提供玩法包详情、授权内容、编辑或安装。此处状态不能作为新增使用的授权。"
          }
        }
      }
    },
    "workshopOwned.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workshop record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工坊记录详情"
          }
        }
      }
    },
    "workshopOwned.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only records of free acquisitions by this individual account. Status reflects the server’s stated check time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查询当前个人账号的免费领取记录。状态对应服务器所示的查询时间。"
          }
        }
      }
    },
    "workshopOwned.purchasesUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchased-package records are not available here yet. Purchased versions retain durable use without subscription renewal; specific scope and lawful withdrawal still follow their frozen terms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处暂不提供已购买玩法包的记录。所购版本可持久使用，不因订阅到期失效；具体范围及合法撤权仍按冻结条款处理。"
          }
        }
      }
    },
    "workshopOwned.status.ACTIVE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded status: active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录状态：有效"
          }
        }
      }
    },
    "workshopOwned.status.SUSPENDED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded status: suspended"
          }
