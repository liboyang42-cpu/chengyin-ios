{
  "sourceLanguage": "en",
  "strings": {
    "back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this draft before leaving"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开前保留草稿"
          }
        }
      }
    },
    "saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft could not be saved on this device. Keep editing, retry the local save, or leave and lose these unsaved changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机草稿保存失败。你可以继续编辑、重试本地保存，或明确离开并放弃本次未保存的修改。"
          }
        }
      }
    },
    "memoryOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guest draft is only in memory. Leaving will lose these changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访客草稿仅保存在当前页面内存中，离开会丢失这些修改。"
          }
        }
      }
    },
    "continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry saving and leave"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试保存后离开"
          }
        }
      }
    },
    "leave": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave without saving these changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃本次未保存修改并离开"
          }
        }
      }
    }
  },
  "version": "1.0"
}
