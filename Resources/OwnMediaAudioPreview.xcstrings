{
  "sourceLanguage": "en",
  "strings": {
    "open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview my audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人预览音频"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview is unavailable. Current access to your media list and separate permission for this audio are required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法预览。需要有效的本人列表及这条音频的独立授权。"
          }
        }
      }
    },
    "privateOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your private preview only. This does not mean the audio is approved or public. Tap Play after loading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供本人预览，不代表审核通过或已公开。加载后仍需点击播放。"
          }
        }
      }
    },
    "limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bounded mp3/m4a/aac/wav files are supported. Preview stops when its access or short window ends, on backgrounding, interruption, headphone or account changes. It never resumes automatically and follows current sound settings; an incompatible audio environment cannot play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持有限大小的 mp3/m4a/aac/wav。预览会随授权或短时窗口到期而停止；后台、中断、耳机或账号变化也会停止，返回后不会自动播放。遵循当前声音设置；音频环境不兼容时无法播放。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your audio…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载本人音频…"
          }
        }
      }
    },
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My audio preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人音频预览"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close and stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭并停止"
          }
        }
      }
    },
    "play": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放"
          }
        }
      }
    },
    "pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        }
      }
    },
    "position": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback position"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放位置"
          }
        }
      }
    },
    "expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview expired. Audio stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已到期，音频已停止。"
          }
        }
      }
    },
    "ended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback ended. Audio was released."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已结束，音频已释放。"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is unavailable or playback was interrupted. You can preview again; playback will not start automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频不可用或播放已中断。可重新预览，但不会自动播放。"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载预览"
          }
        }
      }
    }
  },
  "version": "1.0"
}
