{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "club.seriesLead.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a current member explicitly as the default lead. No owner is assumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请明确选择一位当前成员作为默认负责人，不会自动代选主理人。"
          }
        }
      }
    },
    "club.seriesLead.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose default lead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择默认负责人"
          }
        }
      }
    },
    "club.seriesLead.unselected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择"
          }
        }
      }
    },
    "club.seriesLead.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择"
          }
        }
      }
    },
    "club.seriesLead.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members are available to choose. Refresh the list before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可选成员，请刷新名单后再继续。"
          }
        }
      }
    },
    "club.seriesLead.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous choice is no longer in this member list. Choose again before review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前选择已不在最新成员名单中，请重新选择后再复核。"
          }
        }
      }
    },
    "club.seriesLead.unnamed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名成员"
          }
        }
      }
    }
  }
}
