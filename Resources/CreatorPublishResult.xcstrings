{
  "sourceLanguage": "en",
  "strings": {
    "templatePublishResult.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publication submitted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布提交成功"
          }
        }
      }
    },
    "templatePublishResult.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your template was submitted for review. Publication and availability depend on the review result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品已提交审核，公开与使用状态以审核结果为准。"
          }
        }
      }
    },
    "templatePublishResult.identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member-template ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品模板 ID"
          }
        }
      }
    },
    "templatePublishResult.destination": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening your template library in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将返回我的模板库。"
          }
        }
      }
    },
    "templatePublishResult.openLibrary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open my template library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往我的模板库"
          }
        }
      }
    }
  },
  "version": "1.0"
}
