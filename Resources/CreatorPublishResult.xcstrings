        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your play was submitted for review. It appears once it's approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩法已提交审核，审核通过后展示。"
