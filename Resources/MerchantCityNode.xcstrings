    "merchantCityNode.info.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city node is your store’s interactive check-in point on the roaming map. Players see it on the map only after the platform approves the placement or claim. In store, they complete the template’s phrase, quiz, photo, QR scan or GPS check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "据点就是门店在漫游地图上的互动打卡点。投放或认领申请经平台审核通过后，玩家才会在地图看到；到店可按模板完成暗号、问答、拍照、扫码或 GPS 验证。"
          }
        }
      }
    },
