    "merchantCityNode.confirm.claimBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A claim application is sent for platform review. The node is not yours until it is approved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认领申请将提交平台审核，审核通过前节点不归你所有。"
          }
        }
      }
    },
    "merchantCityNode.confirm.claimTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply to claim this node?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请认领这个节点？"
          }
        }
      }
    },
    "merchantCityNode.confirm.offlineBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players will no longer see it on the map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下线后玩家将不再在地图上看到它。"
          }
        }
      }
    },
    "merchantCityNode.confirm.offlineTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take this node offline?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下线这个据点？"
          }
        }
      }
    },
    "merchantCityNode.confirm.onlineBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server checks your online-node quota again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端会重新校验在架据点配额。"
          }
        }
      }
    },
    "merchantCityNode.confirm.onlineTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put this node online?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上架这个据点？"
          }
        }
      }
    },
    "merchantCityNode.confirm.placeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A successful submission creates a pending application for platform review. It does not put the node online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交成功后形成待平台审核的申请，不代表据点已上线。"
          }
        }
      }
    },
    "merchantCityNode.confirm.placeTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this placement application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交这份投放申请？"
          }
        }
      }
    },
    "merchantCityNode.confirm.withdrawBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending claim is cancelled and the node becomes claimable again. A claim the platform has already taken into review may no longer be withdrawn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回后这条待审认领会被取消，节点重新开放认领；平台已接手审核的申请可能无法撤回。"
          }
        }
      }
    },
    "merchantCityNode.confirm.withdrawTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw this claim application?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回这条认领申请？"
          }
        }
      }
    },
