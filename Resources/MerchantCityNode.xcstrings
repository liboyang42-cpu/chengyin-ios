        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认这个店址"
          }
        }
      }
    },
    "merchantCityNode.create.leaveBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game or address has not been submitted. Leaving now loses this draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩法或店址还没有提交，直接离开会丢失本页草稿。"
          }
        }
      }
    },
    "merchantCityNode.create.leaveCancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "merchantCityNode.create.leaveConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开"
          }
        }
      }
    },
    "merchantCityNode.create.leaveTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard the unsubmitted draft?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃未提交草稿吗"
          }
        }
      }
    },
    "merchantCityNode.create.lede": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just set up a game for your store. Store details come from your merchant profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配一个自己店铺的玩法就行,商家信息用你的入驻资料"
          }
        }
      }
    },
    "merchantCityNode.create.login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to set up a node"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后配置据点"
          }
        }
      }
    },
    "merchantCityNode.create.mapUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map search is unavailable. Your entries are kept; try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图暂时无法打开，已填内容会保留，可以稍后重试。"
          }
        }
      }
    },
    "merchantCityNode.create.markOnMap": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark address on map"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地图上标店址"
          }
        }
      }
    },
    "merchantCityNode.create.myStore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的店"
          }
        }
      }
    },
    "merchantCityNode.create.needAddress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm the store address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认店址"
          }
        }
      }
    },
    "merchantCityNode.create.needConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the store address is accurate first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认店址是否准确"
          }
        }
      }
    },
    "merchantCityNode.create.needTemplate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the store game first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先配置店铺玩法"
          }
        }
      }
    },
    "merchantCityNode.create.noCoordinate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your store profile has no coordinates yet. Mark your shop door on the map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的店铺资料里还没有坐标,得在地图上点一下店门口。"
          }
        }
      }
    },
    "merchantCityNode.create.profileHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the address from your merchant application. Players must be within %lld m of it to arrive. If it is off, they can never check in, so take a look first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你入驻时填的店址。玩家要走到这里 %lld 米内才算到达 —— 偏了他会一直打不了卡,先看一眼对不对。"
          }
        }
      }
    },
    "merchantCityNode.create.readbackFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application submitted, but its review status could not be read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请已提交，但审核状态读取失败"
          }
        }
      }
    },
    "merchantCityNode.create.readbackMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application submitted, but its review status is not synced yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请已提交，审核状态暂未同步"
          }
        }
      }
    },
    "merchantCityNode.create.readbackRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取"
          }
        }
      }
    },
    "merchantCityNode.create.readbackTitle": {
